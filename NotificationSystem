local Players       = game:GetService("Players")
local TweenService  = game:GetService("TweenService")
local TextService   = game:GetService("TextService")
local LocalPlayer   = Players.LocalPlayer
local PlayerGui     = LocalPlayer:WaitForChild("PlayerGui")

local T = {
	bg      = Color3.fromRGB(14, 14, 20),
	elev    = Color3.fromRGB(22, 22, 30),
	acc     = Color3.fromRGB(130, 80, 255),
	txt     = Color3.fromRGB(225, 225, 238),
	sub     = Color3.fromRGB(120, 120, 148),
	success = Color3.fromRGB(48, 205, 145),
	danger  = Color3.fromRGB(245, 100, 100),
	warn    = Color3.fromRGB(248, 185, 30),
	info    = Color3.fromRGB(120, 170, 255),
	white   = Color3.fromRGB(255, 255, 255),
}

local gui = Instance.new("ScreenGui")
gui.Name           = "KrakenNotifs"
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.ResetOnSpawn   = false
gui.DisplayOrder   = 9999
gui.Parent         = PlayerGui

local container = Instance.new("Frame")
container.Name               = "Container"
container.Size               = UDim2.new(0, 320, 1, -40)
container.Position           = UDim2.new(1, -340, 0, 20)
container.BackgroundTransparency = 1
container.BorderSizePixel    = 0
container.ClipsDescendants   = false
container.Parent             = gui

local active = {}
local idCounter = 0

local function tween(obj, props, dur, style, dir)
	if not obj or not obj.Parent then return end
	TweenService:Create(obj, TweenInfo.new(
		dur or 0.3,
		style or Enum.EasingStyle.Quart,
		dir or Enum.EasingDirection.Out
	), props):Play()
end

local meta = {
	success = {Color = T.success, Icon = "✓"},
	error   = {Color = T.danger,  Icon = "✕"},
	warn    = {Color = T.warn,    Icon = "!"},
	info    = {Color = T.info,    Icon = "i"},
}

local function findDuplicate(title, body)
	for _, n in ipairs(active) do
		if n.Alive and n.Title == title and n.Body == body then
			return n
		end
	end
	return nil
end

local function removeById(id)
	for i, n in ipairs(active) do
		if n.Id == id then
			table.remove(active, i)
			return
		end
	end
end

local function recalcPositions(skipIndex)
	local y = 0
	for _, n in ipairs(active) do
		if n.Frame and n.Frame.Parent then
			n.TargetY = y
			y += n.Height + 8
		end
	end
	for i, n in ipairs(active) do
		if i ~= skipIndex and n.Frame and n.Frame.Parent then
			tween(n.Frame, {Position = UDim2.new(0, 0, 0, n.TargetY)}, 0.3, Enum.EasingStyle.Quart)
		end
	end
end

local function Notify(data)
	data = data or {}
	local title    = data.Title    or "Kraken"
	local body     = data.Body     or ""
	local ntype    = data.Type     or "info"
	local duration = data.Duration or 5
	local m        = meta[ntype]   or meta.info

	-- ═══ Spam protection: duplicate counter ═══
	local dup = findDuplicate(title, body)
	if dup then
		dup.Count += 1
		dup.CounterLabel.Text = dup.Count .. "x"
		dup.CounterLabel.Visible = true

		-- reset timer
		dup.TimerId = (dup.TimerId or 0) + 1
		local myTimer = dup.TimerId

		-- bump animation
		tween(dup.Frame, {Size = UDim2.new(0, 310, 0, dup.Height)}, 0.1, Enum.EasingStyle.Back)
		task.delay(0.1, function()
			if dup.Frame and dup.Frame.Parent then
				tween(dup.Frame, {Size = UDim2.new(0, 300, 0, dup.Height)}, 0.15, Enum.EasingStyle.Quart)
			end
		end)

		task.delay(duration, function()
			if not dup.Alive or dup.TimerId ~= myTimer then return end
			local f = dup.Frame
			if f and f.Parent then
				tween(f, {Position = UDim2.new(1, 20, 0, f.Position.Y.Offset)}, 0.3)
				tween(f, {BackgroundTransparency = 1}, 0.25)
				for _, c in ipairs(f:GetDescendants()) do
					if c:IsA("TextLabel") then
						tween(c, {TextTransparency = 1}, 0.2)
					elseif c:IsA("Frame") and c ~= f then
						tween(c, {BackgroundTransparency = 1}, 0.2)
					elseif c:IsA("UIStroke") then
						tween(c, {Transparency = 1}, 0.2)
					end
				end
			end
			task.wait(0.35)
			if f and f.Parent then f:Destroy() end
			dup.Alive = false
			removeById(dup.Id)
			recalcPositions()
		end)
		return
	end

	-- ═══ Build new notification ═══
	idCounter += 1
	local id = idCounter

	local bodyBounds = TextService:GetTextSize(body, 11, Enum.Font.Gotham, Vector2.new(230, 1000))
	local height = math.max(58, 26 + bodyBounds.Y + 14)

	local frame = Instance.new("Frame")
	frame.Name               = "Notif_" .. id
	frame.Size               = UDim2.new(0, 300, 0, height)
	frame.BackgroundColor3   = T.bg
	frame.BorderSizePixel    = 0
	frame.BackgroundTransparency = 0
	frame.ClipsDescendants   = true
	frame.Parent             = container

	local crn = Instance.new("UICorner")
	crn.CornerRadius = UDim.new(0, 10)
	crn.Parent = frame

	local str = Instance.new("UIStroke")
	str.Color        = m.Color
	str.Thickness    = 1.2
	str.Transparency = 0.7
	str.Parent       = frame

	-- accent bar
	local accent = Instance.new("Frame")
	accent.Size             = UDim2.new(0, 3, 1, -14)
	accent.Position         = UDim2.new(0, 8, 0, 7)
	accent.BackgroundColor3 = m.Color
	accent.BorderSizePixel  = 0
	accent.Parent           = frame
	local ac = Instance.new("UICorner")
	ac.CornerRadius = UDim.new(0, 2)
	ac.Parent = accent

	-- icon
	local iFrm = Instance.new("Frame")
	iFrm.Size             = UDim2.new(0, 26, 0, 26)
	iFrm.Position         = UDim2.new(0, 18, 0, 7)
	iFrm.BackgroundColor3 = m.Color
	iFrm.BackgroundTransparency = 0.15
	iFrm.BorderSizePixel  = 0
	iFrm.Parent           = frame
	local ic = Instance.new("UICorner")
	ic.CornerRadius = UDim.new(1, 0)
	ic.Parent = iFrm

	local iLbl = Instance.new("TextLabel")
	iLbl.Size               = UDim2.new(1, 0, 1, 0)
	iLbl.BackgroundTransparency = 1
	iLbl.Text               = m.Icon
	iLbl.TextColor3         = T.white
	iLbl.TextSize           = 13
	iLbl.Font               = Enum.Font.GothamBold
	iLbl.Parent             = iFrm

	-- title
	local tLbl = Instance.new("TextLabel")
	tLbl.Size               = UDim2.new(0, 184, 0, 16)
	tLbl.Position           = UDim2.new(0, 52, 0, 7)
	tLbl.BackgroundTransparency = 1
	tLbl.Text               = title
	tLbl.TextColor3         = T.txt
	tLbl.TextSize           = 12
	tLbl.Font               = Enum.Font.GothamBold
	tLbl.TextXAlignment     = Enum.TextXAlignment.Left
	tLbl.TextTruncate       = Enum.TextTruncate.AtEnd
	tLbl.Parent             = frame

	-- counter (hidden until duplicate)
	local cLbl = Instance.new("TextLabel")
	cLbl.Size               = UDim2.new(0, 44, 0, 16)
	cLbl.Position           = UDim2.new(1, -52, 0, 7)
	cLbl.BackgroundTransparency = 1
	cLbl.Text               = "1x"
	cLbl.TextColor3         = T.sub
	cLbl.TextSize           = 11
	cLbl.Font               = Enum.Font.GothamBold
	cLbl.TextXAlignment     = Enum.TextXAlignment.Right
	cLbl.Visible            = false
	cLbl.Parent             = frame

	-- body
	local bLbl = Instance.new("TextLabel")
	bLbl.Size               = UDim2.new(0, 230, 0, bodyBounds.Y)
	bLbl.Position           = UDim2.new(0, 52, 0, 25)
	bLbl.BackgroundTransparency = 1
	bLbl.Text               = body
	bLbl.TextColor3         = T.sub
	bLbl.TextSize           = 11
	bLbl.Font               = Enum.Font.Gotham
	bLbl.TextXAlignment     = Enum.TextXAlignment.Left
	bLbl.TextYAlignment     = Enum.TextYAlignment.Top
	bLbl.TextWrapped        = true
	bLbl.Parent             = frame

	-- ═══ Stack & animate ═══
	table.insert(active, 1, {
		Id           = id,
		Title        = title,
		Body         = body,
		Frame        = frame,
		CounterLabel = cLbl,
		Count        = 1,
		Height       = height,
		Alive        = true,
		TimerId      = 0,
	})

	recalcPositions(1) -- move old ones down, don't tween the new one yet

	frame.Position = UDim2.new(1, 20, 0, active[1].TargetY)
	tween(frame, {Position = UDim2.new(0, 0, 0, active[1].TargetY)}, 0.35, Enum.EasingStyle.Quart)

	-- ═══ Auto-remove timer ═══
	local timerId = 1
	active[1].TimerId = timerId
	task.delay(duration, function()
		local n = active[1]
		for _, v in ipairs(active) do
			if v.Id == id then n = v; break end
		end
		if not n or not n.Alive or n.TimerId ~= timerId then return end

		local f = n.Frame
		if f and f.Parent then
			tween(f, {Position = UDim2.new(1, 20, 0, f.Position.Y.Offset)}, 0.3)
			tween(f, {BackgroundTransparency = 1}, 0.25)
			for _, c in ipairs(f:GetDescendants()) do
				if c:IsA("TextLabel") then
					tween(c, {TextTransparency = 1}, 0.2)
				elseif c:IsA("Frame") and c ~= f then
					tween(c, {BackgroundTransparency = 1}, 0.2)
				elseif c:IsA("UIStroke") then
					tween(c, {Transparency = 1}, 0.2)
				end
			end
		end
		task.wait(0.35)
		if f and f.Parent then f:Destroy() end
		n.Alive = false
		removeById(id)
		recalcPositions()
	end)
end

return Notify
