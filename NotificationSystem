local TS=game:GetService("TweenService")
local Players=game:GetService("Players")
local Debris=game:GetService("Debris")
local C_acc=Color3.fromRGB(200,100,30)
local C_hi=Color3.fromRGB(240,140,55)
local C_sub=Color3.fromRGB(175,118,65)
local notifyGui,activeNotifs={},{}
local NGAP,NRM,NTS,NMAX=68,16,20,8
local GLOBAL=_G

local function getGP()
	if GLOBAL.NihonGuiParent then return GLOBAL.NihonGuiParent end
	local lp=Players.LocalPlayer
	local ok,cg=pcall(function() return game:GetService("CoreGui") end)
	if ok and cg then return cg end
	return lp:WaitForChild("PlayerGui")
end

local function repos()
	local y=NTS
	for _,n in ipairs(activeNotifs) do
		if n.frame and n.frame.Parent then
			TS:Create(n.frame,TweenInfo.new(0.2,Enum.EasingStyle.Quad),{Position=UDim2.new(1,-NRM,0,y)}):Play()
			y=y+NGAP; if y>500 then break end
		end
	end
end

local function removeN(entry)
	for i,n in ipairs(activeNotifs) do if n==entry then table.remove(activeNotifs,i); break end end
	repos()
end

local timers={}
local function sDelay(s,cb) local t=task.delay(s,cb); timers[t]=true; return t end
local function sCancel(t)
	if t and timers[t] then timers[t]=nil
		if typeof(task.cancel)=="function" then pcall(function() task.cancel(t) end) end
	end
end

local function notify(title,body,dur)
	pcall(function()
		local s=Instance.new("Sound"); s.SoundId="rbxassetid://102658972915929"; s.Volume=0.5; s.Parent=workspace; s:Play(); Debris:AddItem(s,3)
	end)
	local gp=getGP()
	if not notifyGui or not notifyGui.Parent then
		notifyGui=Instance.new("ScreenGui"); notifyGui.Name="NihonNotify"; notifyGui.IgnoreGuiInset=true
		notifyGui.DisplayOrder=1001; notifyGui.ResetOnSpawn=false; notifyGui.Parent=gp
	end
	for _,ex in ipairs(activeNotifs) do
		if ex.title==title and ex.body==body then
			ex.count=ex.count+1
			if ex.countLabel then ex.countLabel.Text=ex.count.."x"; ex.countLabel.Visible=true end
			sCancel(ex.tweenThread)
			ex.tweenThread=sDelay(dur or 2.5,function()
				if ex.frame and ex.frame.Parent then
					TS:Create(ex.frame,TweenInfo.new(0.22,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.new(1,320,0,ex.frame.Position.Y.Offset)}):Play()
					task.wait(0.25); pcall(function() ex.frame:Destroy() end); removeN(ex)
				end
			end); return
		end
	end
	if #activeNotifs>=NMAX then
		local old=activeNotifs[1]
		if old and old.frame then TS:Create(old.frame,TweenInfo.new(0.15),{Position=UDim2.new(1,320,0,old.frame.Position.Y.Offset)}):Play(); task.delay(0.2,function() pcall(function() old.frame:Destroy() end) end) end
		table.remove(activeNotifs,1)
	end
	local nf=Instance.new("Frame"); nf.Size=UDim2.fromOffset(300,60); nf.AnchorPoint=Vector2.new(1,0)
	nf.Position=UDim2.new(1,320,0,NTS); nf.BackgroundColor3=Color3.fromRGB(24,13,6); nf.BorderSizePixel=0; nf.Parent=notifyGui
	Instance.new("UICorner",nf).CornerRadius=UDim.new(0,8)
	local ns=Instance.new("UIStroke",nf); ns.Color=C_acc; ns.Thickness=1; ns.Transparency=0.2
	local nl=Instance.new("Frame",nf); nl.Size=UDim2.new(0,3,1,-8); nl.Position=UDim2.fromOffset(0,4); nl.BackgroundColor3=C_hi; nl.BorderSizePixel=0
	Instance.new("UICorner",nl).CornerRadius=UDim.new(0,3)
	local nt=Instance.new("TextLabel",nf); nt.Size=UDim2.new(1,-42,0,18); nt.Position=UDim2.fromOffset(12,6); nt.BackgroundTransparency=1
	nt.TextColor3=Color3.fromRGB(255,215,160); nt.Font=Enum.Font.GothamBold; nt.TextSize=12; nt.TextXAlignment=Enum.TextXAlignment.Left; nt.Text=title
	local nc=Instance.new("TextLabel",nf); nc.Size=UDim2.new(1,-42,0,28); nc.Position=UDim2.fromOffset(12,24); nc.BackgroundTransparency=1
	nc.TextColor3=C_sub; nc.Font=Enum.Font.Gotham; nc.TextSize=10; nc.TextXAlignment=Enum.TextXAlignment.Left; nc.TextWrapped=true; nc.Text=body
	local badge=Instance.new("TextLabel",nf); badge.Size=UDim2.fromOffset(28,18); badge.Position=UDim2.new(1,-32,0,6)
	badge.BackgroundColor3=Color3.fromRGB(200,80,30); badge.BorderSizePixel=0; badge.TextColor3=Color3.fromRGB(255,240,220)
	badge.Font=Enum.Font.GothamBold; badge.TextSize=9; badge.Text="1x"; badge.Visible=false; badge.Parent=nf
	Instance.new("UICorner",badge).CornerRadius=UDim.new(0,4)
	local entry={frame=nf,title=title,body=body,count=1,countLabel=badge,tweenThread=nil}
	table.insert(activeNotifs,entry); repos()
	local ty=nf.Position.Y.Offset; nf.Position=UDim2.new(1,320,0,ty)
	TS:Create(nf,TweenInfo.new(0.28,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(1,-NRM,0,ty)}):Play()
	entry.tweenThread=sDelay(dur or 2.5,function()
		if nf and nf.Parent then
			TS:Create(nf,TweenInfo.new(0.22,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.new(1,320,0,nf.Position.Y.Offset)}):Play()
			task.wait(0.25); pcall(function() nf:Destroy() end); removeN(entry)
		end
	end)
end

GLOBAL.NihonNotify=notify
