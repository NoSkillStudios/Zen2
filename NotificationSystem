-- Nihon NotificationSystem — Bulletproof Edition
-- PASTE THIS DIRECTLY. Do NOT load from a URL that still has getgenv().

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local C_accent   = Color3.fromRGB(200, 100, 30)
local C_accentHi = Color3.fromRGB(240, 140, 55)
local C_txtSub   = Color3.fromRGB(175, 118, 65)

local notifyGui
local activeNotifs       = {}
local NOTIF_GAP          = 68
local NOTIF_RIGHT_MARGIN = 16
local NOTIF_TOP_START    = 20
local MAX_NOTIFS_VISIBLE = 8

-- ROBUST: No getgenv(). Use _G only.
local GLOBAL = _G

local function getGuiParent()
    if GLOBAL.NihonGuiParent then
        return GLOBAL.NihonGuiParent
    end
    local lp = Players.LocalPlayer
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then
        return cg
    end
    return lp:WaitForChild("PlayerGui")
end

local function repositionNotifs()
    local y = NOTIF_TOP_START
    for _, n in ipairs(activeNotifs) do
        if n.frame and n.frame.Parent then
            TweenService:Create(n.frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                Position = UDim2.new(1, -NOTIF_RIGHT_MARGIN, 0, y)
            }):Play()
            y = y + NOTIF_GAP
            if y > 500 then break end
        end
    end
end

local function removeNotif(entry)
    for i, n in ipairs(activeNotifs) do
        if n == entry then
            table.remove(activeNotifs, i)
            break
        end
    end
    repositionNotifs()
end

-- Safe delay/cancel system that works even if task.cancel is missing
local runningTimers = {}
local function safeDelay(seconds, callback)
    local thread = task.delay(seconds, callback)
    runningTimers[thread] = true
    return thread
end
local function safeCancel(thread)
    if thread and runningTimers[thread] then
        runningTimers[thread] = nil
        if typeof(task.cancel) == "function" then
            pcall(function() task.cancel(thread) end)
        end
    end
end

local function notify(title, body, dur)
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://102658972915929"
        s.Volume = 0.6
        s.Parent = workspace
        s:Play()
        Debris:AddItem(s, 3)
    end)

    local guiParent = getGuiParent()

    if not notifyGui or not notifyGui.Parent then
        notifyGui = Instance.new("ScreenGui")
        notifyGui.Name = "NihonNotify"
        notifyGui.IgnoreGuiInset = true
        notifyGui.DisplayOrder = 1001
        notifyGui.ResetOnSpawn = false
        notifyGui.Parent = guiParent
    end

    for _, existing in ipairs(activeNotifs) do
        if existing.title == title and existing.body == body then
            existing.count = existing.count + 1
            if existing.countLabel then
                existing.countLabel.Text = existing.count .. "x"
                existing.countLabel.Visible = true
                TweenService:Create(existing.frame, TweenInfo.new(0.1, Enum.EasingStyle.Elastic), {
                    Size = UDim2.fromOffset(316, 62)
                }):Play()
                task.delay(0.15, function()
                    TweenService:Create(existing.frame, TweenInfo.new(0.1), {
                        Size = UDim2.fromOffset(300, 60)
                    }):Play()
                end)
            end
            safeCancel(existing.tweenThread)
            existing.tweenThread = safeDelay(dur or 2.5, function()
                if existing.frame and existing.frame.Parent then
                    TweenService:Create(existing.frame,
                        TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                        { Position = UDim2.new(1, 320, 0, existing.frame.Position.Y.Offset) }
                    ):Play()
                    task.wait(0.25)
                    pcall(function() existing.frame:Destroy() end)
                    removeNotif(existing)
                end
            end)
            return
        end
    end

    if #activeNotifs >= MAX_NOTIFS_VISIBLE then
        local oldest = activeNotifs[1]
        if oldest and oldest.frame then
            TweenService:Create(oldest.frame, TweenInfo.new(0.15), {
                Position = UDim2.new(1, 320, 0, oldest.frame.Position.Y.Offset)
            }):Play()
            task.delay(0.2, function() pcall(function() oldest.frame:Destroy() end) end)
        end
        table.remove(activeNotifs, 1)
    end

    local nf = Instance.new("Frame")
    nf.Size = UDim2.fromOffset(300, 60)
    nf.AnchorPoint = Vector2.new(1, 0)
    nf.Position = UDim2.new(1, 320, 0, NOTIF_TOP_START)
    nf.BackgroundColor3 = Color3.fromRGB(24, 13, 6)
    nf.BorderSizePixel = 0
    nf.Parent = notifyGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = nf

    local ns = Instance.new("UIStroke")
    ns.Color = C_accent
    ns.Thickness = 1
    ns.Transparency = 0.2
    ns.Parent = nf

    local nl = Instance.new("Frame")
    nl.Size = UDim2.new(0, 3, 1, -8)
    nl.Position = UDim2.fromOffset(0, 4)
    nl.BackgroundColor3 = C_accentHi
    nl.BorderSizePixel = 0
    nl.Parent = nf

    local nlCorner = Instance.new("UICorner")
    nlCorner.CornerRadius = UDim.new(0, 3)
    nlCorner.Parent = nl

    local nt = Instance.new("TextLabel")
    nt.Size = UDim2.new(1, -42, 0, 18)
    nt.Position = UDim2.fromOffset(12, 6)
    nt.BackgroundTransparency = 1
    nt.TextColor3 = Color3.fromRGB(255, 215, 160)
    nt.Font = Enum.Font.GothamBold
    nt.TextSize = 12
    nt.TextXAlignment = Enum.TextXAlignment.Left
    nt.Text = title
    nt.Parent = nf

    local nc = Instance.new("TextLabel")
    nc.Size = UDim2.new(1, -42, 0, 28)
    nc.Position = UDim2.fromOffset(12, 24)
    nc.BackgroundTransparency = 1
    nc.TextColor3 = C_txtSub
    nc.Font = Enum.Font.Gotham
    nc.TextSize = 10
    nc.TextXAlignment = Enum.TextXAlignment.Left
    nc.TextWrapped = true
    nc.Text = body
    nc.Parent = nf

    local badge = Instance.new("TextLabel")
    badge.Size = UDim2.fromOffset(28, 18)
    badge.Position = UDim2.new(1, -32, 0, 6)
    badge.BackgroundColor3 = Color3.fromRGB(200, 80, 30)
    badge.BorderSizePixel = 0
    badge.TextColor3 = Color3.fromRGB(255, 240, 220)
    badge.Font = Enum.Font.GothamBold
    badge.TextSize = 9
    badge.Text = "1x"
    badge.Visible = false
    badge.Parent = nf

    local badgeCorner = Instance.new("UICorner")
    badgeCorner.CornerRadius = UDim.new(0, 4)
    badgeCorner.Parent = badge

    local entry = {
        frame = nf,
        title = title,
        body = body,
        count = 1,
        countLabel = badge,
        tweenThread = nil,
    }
    table.insert(activeNotifs, entry)
    repositionNotifs()

    local targetY = nf.Position.Y.Offset
    nf.Position = UDim2.new(1, 320, 0, targetY)
    TweenService:Create(nf,
        TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Position = UDim2.new(1, -NOTIF_RIGHT_MARGIN, 0, targetY) }
    ):Play()

    entry.tweenThread = safeDelay(dur or 2.5, function()
        if nf and nf.Parent then
            TweenService:Create(nf,
                TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { Position = UDim2.new(1, 320, 0, nf.Position.Y.Offset) }
            ):Play()
            task.wait(0.25)
            pcall(function() nf:Destroy() end)
            removeNotif(entry)
        end
    end)
end

GLOBAL.NihonNotify = notify
