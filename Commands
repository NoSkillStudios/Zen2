	if attachConn then attachConn:Disconnect(); attachConn=nil end
	notify("🔗 Attach","Detached",1.5)
end

local orbitConn,orbitAngle=nil,0
local function startOrbit(target,radius)
	radius=tonumber(radius) or 10; orbitAngle=0
	if orbitConn then orbitConn:Disconnect() end
	orbitConn=RS.Heartbeat:Connect(function(dt)
		orbitAngle=orbitAngle+dt*2
		if not target or not target.Character then return end
		local hrp=getHRP(); local tHRP=target.Character:FindFirstChild("HumanoidRootPart")
		if hrp and tHRP then
			local x=tHRP.Position.X+math.cos(orbitAngle)*radius
			local z=tHRP.Position.Z+math.sin(orbitAngle)*radius
			hrp.CFrame=CFrame.new(x,tHRP.Position.Y,z)
		end
	end)
	notify("🌀 Orbit","Orbiting "..target.DisplayName,2)
end
