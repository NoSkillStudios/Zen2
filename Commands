	iconLbl.Text           = typeIcon
	iconLbl.TextSize       = 13
	iconLbl.TextColor3     = typeColor
	iconLbl.Font           = Enum.Font.GothamBold
	iconLbl.TextXAlignment = Enum.TextXAlignment.Center
	iconLbl.TextYAlignment = Enum.TextYAlignment.Center
	iconLbl.ZIndex         = 2003

	local titleLbl = Instance.new("TextLabel", nframe)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Size           = u2(1, -58, 0, 16)
	titleLbl.Position       = u2(0, 48, 0, desc ~= "" and 12 or 0)
	titleLbl.AnchorPoint    = desc ~= "" and v2(0,0) or v2(0,0.5)
	if desc == "" then titleLbl.Position = u2(0, 48, 0.5, 0); titleLbl.AnchorPoint = v2(0,0.5) end
	titleLbl.Text           = title
	titleLbl.TextSize       = 13
	titleLbl.TextColor3     = T.txt
