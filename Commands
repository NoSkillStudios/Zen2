CMDS.spam = {
	desc = "Spams a chat message",
	args = "<times> <message>",
	fn = function(args)
		local times = math.min(tonumber(args[1]) or 5, 20)
		table.remove(args, 1)
		local msg = table.concat(args, " ")
		if msg == "" then notify("spam", "Usage: spam <times> <message>") return end
		task.spawn(function()
			for _ = 1, times do
				pcall(function()
					game:GetService("ReplicatedStorage")
						:WaitForChild("DefaultChatSystemChatEvents")
						:WaitForChild("SayMessageRequest")
						:FireServer(msg, "All")
				end)
				task.wait(0.35)
			end
		end)
		notify("spam", times .. "x: " .. msg)
	end
}

