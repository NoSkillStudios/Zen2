	ttl.Position       = u2(0,0,0,8)
	ttl.TextXAlignment = Enum.TextXAlignment.Center
	ttl.ZIndex         = 502

	local sub2 = Instance.new("TextLabel", box)
	sub2.BackgroundTransparency = 1
	sub2.Text           = "Enter tab password"
	sub2.TextSize       = 10
	sub2.TextColor3     = T.sub
	sub2.Font           = Enum.Font.Gotham
	sub2.Size           = u2(1,0,0,14)
	sub2.Position       = u2(0,0,0,32)
	sub2.TextXAlignment = Enum.TextXAlignment.Center
	sub2.ZIndex         = 502

	local inp = Instance.new("TextBox", box)
	inp.Size             = u2(1,-32,0,28)
	inp.Position         = u2(0,16,0,50)
	inp.BackgroundColor3 = T.bgDeep
	inp.TextColor3       = T.txt
	inp.PlaceholderText  = "Password..."
	inp.PlaceholderColor3= T.muted
	inp.TextSize         = 12
	inp.Font             = Enum.Font.Gotham
	inp.ZIndex           = 502
	inp.BorderSizePixel  = 0
	inp.TextXAlignment   = Enum.TextXAlignment.Center
	inp.ClearTextOnFocus = false
	corner(inp, 6)
	stroke(inp, T.bordFaint, 1)

	local errL = Instance.new("TextLabel", box)
	errL.BackgroundTransparency = 1
	errL.Text           = ""
	errL.TextSize       = 10
	errL.TextColor3     = T.danger
	errL.Font           = Enum.Font.Gotham
	errL.Size           = u2(1,0,0,12)
	errL.Position       = u2(0,0,0,82)
	errL.TextXAlignment = Enum.TextXAlignment.Center
	errL.ZIndex         = 502

	local confirm = Instance.new("TextButton", box)
	confirm.Size             = u2(1,-32,0,24)
	confirm.Position         = u2(0,16,0,98)
	confirm.BackgroundColor3 = T.acc
	confirm.Text             = "Unlock"
	confirm.TextColor3       = T.white
	confirm.TextSize         = 11
	confirm.Font             = Enum.Font.GothamBold
	confirm.ZIndex           = 502
	confirm.BorderSizePixel  = 0
	corner(confirm, 6)

	local function attempt()
		if inp.Text == key then
			overlay:Destroy()
			onSuccess()
		else
			errL.Text = "Wrong password."
			local orig = box.Position
			tw(box,{Position=u2(orig.X.Scale,orig.X.Offset-6,orig.Y.Scale,orig.Y.Offset)},0.05)
			task.delay(0.05,function()
				tw(box,{Position=u2(orig.X.Scale,orig.X.Offset+6,orig.Y.Scale,orig.Y.Offset)},0.05)
				task.delay(0.05,function()
					tw(box,{Position=orig},0.08,Enum.EasingStyle.Back)
				end)
			end)
		end
	end

	cn(confirm.MouseButton1Click, attempt)
	cn(inp.FocusLost, function(enter) if enter then attempt() end end)
	task.defer(function() inp:CaptureFocus() end)

	local xB = Instance.new("TextButton", box)
	xB.Size             = u2(0,18,0,18)
	xB.Position         = u2(1,-22,0,4)
	xB.BackgroundTransparency = 1
	xB.Text             = "×"
	xB.TextSize         = 16
	xB.TextColor3       = T.muted
	xB.Font             = Enum.Font.GothamBold
	xB.ZIndex           = 503
	xB.BorderSizePixel  = 0
	cn(xB.MouseButton1Click, function() overlay:Destroy() end)
end

