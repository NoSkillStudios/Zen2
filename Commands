local ti = TweenInfo.new
local c3 = Color3.fromRGB
local u2 = UDim2.new
local v2 = Vector2.new
local ud = UDim.new

local T = {
	bg        = c3(14, 14, 20),
	bgDeep    = c3(8,  8,  13),
	panel     = c3(20, 20, 30),
	elev      = c3(26, 26, 38),
	elevHov   = c3(34, 34, 50),
	sidebar   = c3(10, 10, 16),
	bord      = c3(50, 50, 72),
	bordFaint = c3(30, 30, 44),
	acc       = c3(120, 70, 255),
	accB      = c3(85,  35, 200),
	accGlow   = c3(160, 120, 255),
	accDim    = c3(50,  25, 100),
	txt       = c3(220, 220, 235),
	sub       = c3(110, 110, 140),
	muted     = c3(52,  52,  76),
	success   = c3(45,  200, 135),
	danger    = c3(240, 85,  85),
	warn      = c3(245, 180, 25),
	white     = c3(255, 255, 255),
	black     = c3(0,   0,   0),
	notifBg   = c3(16,  16,  24),
}

local conns = {}

local function cn(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns+1] = c
	return c
end

local function tw(obj, props, dur, sty, dir, cb)
	if not obj or not obj.Parent then return end
	local t = ts:Create(obj, ti(dur or 0.2, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
	if cb then t.Completed:Once(cb) end
	t:Play()
	return t
end

local function corner(p, r)
	local c = Instance.new("UICorner", p)
	c.CornerRadius = ud(0, r or 8)
	return c
end

local function stroke(p, col, th)
	local s = Instance.new("UIStroke", p)
	s.Color = col or T.bord
	s.Thickness = th or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function pad(p, t, b, l, r)
	local d = Instance.new("UIPadding", p)
	d.PaddingTop    = ud(0, t or 8)
	d.PaddingBottom = ud(0, b or 8)
	d.PaddingLeft   = ud(0, l or 8)
	d.PaddingRight  = ud(0, r or 8)
end

local function list(p, dir, sp)
	local l = Instance.new("UIListLayout", p)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder     = Enum.SortOrder.LayoutOrder
	l.Padding       = ud(0, sp or 6)
	return l
end

local function lbl(p, txt, sz, col, font)
	local l = Instance.new("TextLabel", p)
	l.BackgroundTransparency = 1
	l.Text           = txt or ""
	l.TextSize       = sz  or 13
	l.TextColor3     = col or T.txt
	l.Font           = font or Enum.Font.GothamMedium
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.AutomaticSize  = Enum.AutomaticSize.XY
	l.BorderSizePixel= 0
	return l
end

local function scroll(p)
	local sf = Instance.new("ScrollingFrame", p)
	sf.Size                      = u2(1,0,1,0)
	sf.BackgroundTransparency    = 1
	sf.BorderSizePixel           = 0
	sf.ScrollBarThickness        = 3
	sf.ScrollBarImageColor3      = T.acc
	sf.ScrollBarImageTransparency= 0.5
	sf.CanvasSize                = u2(0,0,0,0)
	sf.AutomaticCanvasSize       = Enum.AutomaticSize.Y
	return sf
end

local function makeDraggable(frame, handle)
	local dragging, dragStart, startPos = false, nil, nil
	cn(handle.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging  = true
		dragStart = i.Position
		startPos  = frame.Position
	end)
	cn(uis.InputChanged, function(i)
		if not dragging or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local d = i.Position - dragStart
		frame.Position = u2(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
	end)
	cn(uis.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
end

-- ─── NOTIFICATION SYSTEM ───────────────────────────────────────────────────
local NOTIF_W   = 270
local NOTIF_GAP = 6
local MAX_STACK = 6

local notifGui, notifContainer
local liveNotifs = {}

local function initNotifSystem(parentGui)
	notifGui = parentGui

	notifContainer = Instance.new("Frame", parentGui)
	notifContainer.Name               = "NotifContainer"
	notifContainer.Size               = u2(0, NOTIF_W, 1, 0)
	notifContainer.Position           = u2(1, -(NOTIF_W + 14), 0, 14)
	notifContainer.BackgroundTransparency = 1
	notifContainer.BorderSizePixel    = 0
	notifContainer.ZIndex             = 2000
	notifContainer.ClipsDescendants   = false
end

local function reflow()
	local yOff = 0
	for _, n in ipairs(liveNotifs) do
		if n.frame and n.frame.Parent then
			tw(n.frame, {Position = u2(0, 0, 0, yOff)}, 0.28, Enum.EasingStyle.Quart)
			yOff = yOff + n.h + NOTIF_GAP
		end
	end
end

local function dismissNotif(n, instant)
	for i, v in ipairs(liveNotifs) do
		if v == n then table.remove(liveNotifs, i); break end
	end
	if instant then
		if n.frame and n.frame.Parent then n.frame:Destroy() end
		reflow()
		return
	end
	if n.frame and n.frame.Parent then
		tw(n.frame, {Position = u2(1, 20, n.frame.Position.Y.Scale, n.frame.Position.Y.Offset), BackgroundTransparency = 1}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function()
			if n.frame and n.frame.Parent then n.frame:Destroy() end
		end)
	end
	task.defer(reflow)
end

function K.Notify(cfg)
	cfg = cfg or {}
	local title    = cfg.Title    or "Notification"
	local body     = cfg.Body     or cfg.Description or ""
	local duration = cfg.Duration or 4
	local ntype    = cfg.Type     or "info"
	local icon     = cfg.Icon

	if not notifContainer then return end

	local typeCol = ntype=="success" and T.success or ntype=="error" and T.danger or ntype=="warn" and T.warn or T.acc
	local typeIco = icon or (ntype=="success" and "✓" or ntype=="error" and "✕" or ntype=="warn" and "!" or "i")
	local isImg   = icon and (tostring(icon):find("rbxassetid") or tostring(icon):match("^%d+$")) or false

	-- dedup: same title+body → increment counter
	for _, n in ipairs(liveNotifs) do
		if n.title == title and n.body == body then
			n.count += 1
			if n.countLbl then
				n.countLbl.Text    = n.count.."×"
				n.countLbl.Visible = true
			end
			if n.timer then task.cancel(n.timer) end
			n.timer = task.delay(duration, function()
				dismissNotif(n)
			end)
			if n.prog then
				n.prog:Cancel()
				n.prog = ts:Create(n.progBar, ti(duration, Enum.EasingStyle.Linear), {Size = u2(0, -6, 0, 2)})
				n.prog:Play()
			end
			return
		end
	end

	if #liveNotifs >= MAX_STACK then
		dismissNotif(liveNotifs[1], true)
	end

	local h = body ~= "" and 68 or 46

	-- outer 3D shadow layer
	local shadow = Instance.new("Frame", notifContainer)
	shadow.Size             = u2(1, 4, 0, h+4)
	shadow.Position         = u2(0, -2, 0, 0)
	shadow.BackgroundColor3 = T.black
	shadow.BackgroundTransparency = 0.55
	shadow.BorderSizePixel  = 0
	shadow.ZIndex           = 1998
	corner(shadow, 12)

	local nframe = Instance.new("Frame", notifContainer)
	nframe.Size             = u2(1, 0, 0, h)
	nframe.Position         = u2(1, 24, 0, 0)
	nframe.BackgroundColor3 = T.notifBg
	nframe.BorderSizePixel  = 0
	nframe.ZIndex           = 1999
	nframe.ClipsDescendants = false
	corner(nframe, 10)

	-- top highlight edge (3D feel)
	local topEdge = Instance.new("Frame", nframe)
	topEdge.Size             = u2(1,-20,0,1)
	topEdge.Position         = u2(0,10,0,0)
	topEdge.BackgroundColor3 = c3(80,80,110)
	topEdge.BackgroundTransparency = 0.5
	topEdge.BorderSizePixel  = 0
	topEdge.ZIndex           = 2001
	corner(topEdge, 999)

	-- bottom shadow edge (3D feel)
	local btmEdge = Instance.new("Frame", nframe)
	btmEdge.Size             = u2(1,-20,0,1)
	btmEdge.Position         = u2(0,10,1,-1)
	btmEdge.BackgroundColor3 = T.black
	btmEdge.BackgroundTransparency = 0.3
	btmEdge.BorderSizePixel  = 0
	btmEdge.ZIndex           = 2001
	corner(btmEdge, 999)

	-- left accent bar
	local acLine = Instance.new("Frame", nframe)
	acLine.Size             = u2(0, 3, 1, -16)
	acLine.Position         = u2(0, 0, 0, 8)
	acLine.BackgroundColor3 = typeCol
	acLine.BorderSizePixel  = 0
	acLine.ZIndex           = 2002
	corner(acLine, 999)

	-- icon
	local iconF = Instance.new("Frame", nframe)
	iconF.Size             = u2(0,26,0,26)
	iconF.Position         = u2(0,10,0.5,-13)
	iconF.BackgroundColor3 = typeCol
	iconF.BackgroundTransparency = 0.78
	iconF.BorderSizePixel  = 0
	iconF.ZIndex           = 2002
	corner(iconF, 7)

	if isImg then
		local img = Instance.new("ImageLabel", iconF)
		img.Size               = u2(0,16,0,16)
		img.Position           = u2(0.5,-8,0.5,-8)
		img.BackgroundTransparency = 1
		img.Image              = tostring(icon):find("rbxassetid") and tostring(icon) or "rbxassetid://"..tostring(icon)
		img.ImageColor3        = typeCol
		img.ZIndex             = 2003
	else
		local iL = Instance.new("TextLabel", iconF)
		iL.BackgroundTransparency = 1
		iL.Size           = u2(1,0,1,0)
		iL.Text           = typeIco
		iL.TextSize       = 13
		iL.TextColor3     = typeCol
		iL.Font           = Enum.Font.GothamBold
		iL.TextXAlignment = Enum.TextXAlignment.Center
		iL.TextYAlignment = Enum.TextYAlignment.Center
		iL.ZIndex         = 2003
	end

	local titleLbl2 = Instance.new("TextLabel", nframe)
	titleLbl2.BackgroundTransparency = 1
	titleLbl2.Size           = u2(1,-80,0,14)
	titleLbl2.Position       = body ~= "" and u2(0,44,0,12) or u2(0,44,0.5,-7)
	titleLbl2.Text           = title
	titleLbl2.TextSize       = 12
	titleLbl2.TextColor3     = T.txt
	titleLbl2.Font           = Enum.Font.GothamBold
	titleLbl2.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl2.TextTruncate   = Enum.TextTruncate.AtEnd
	titleLbl2.ZIndex         = 2002

	local countLbl
	if true then
		countLbl = Instance.new("TextLabel", nframe)
		countLbl.BackgroundTransparency = 1
		countLbl.Size           = u2(0,26,0,14)
		countLbl.Position       = u2(1,-28,0,4)
		countLbl.Text           = "1×"
		countLbl.TextSize       = 9
		countLbl.TextColor3     = typeCol
		countLbl.Font           = Enum.Font.GothamBold
		countLbl.TextXAlignment = Enum.TextXAlignment.Center
		countLbl.ZIndex         = 2003
		countLbl.Visible        = false
	end

	if body ~= "" then
		local bodyLbl = Instance.new("TextLabel", nframe)
		bodyLbl.BackgroundTransparency = 1
		bodyLbl.Size           = u2(1,-58,0,12)
		bodyLbl.Position       = u2(0,44,0,30)
		bodyLbl.Text           = body
		bodyLbl.TextSize       = 10
		bodyLbl.TextColor3     = T.sub
		bodyLbl.Font           = Enum.Font.Gotham
		bodyLbl.TextXAlignment = Enum.TextXAlignment.Left
		bodyLbl.TextTruncate   = Enum.TextTruncate.AtEnd
		bodyLbl.ZIndex         = 2002
	end

	local closeBtn2 = Instance.new("TextButton", nframe)
	closeBtn2.Size             = u2(0,16,0,16)
	closeBtn2.Position         = u2(1,-20,0,4)
	closeBtn2.BackgroundTransparency = 1
	closeBtn2.Text             = "×"
	closeBtn2.TextSize         = 14
	closeBtn2.TextColor3       = T.muted
	closeBtn2.Font             = Enum.Font.GothamBold
	closeBtn2.ZIndex           = 2004
	closeBtn2.BorderSizePixel  = 0

	-- progress bar
	local progOuter = Instance.new("Frame", nframe)
	progOuter.Size             = u2(1,-8,0,2)
	progOuter.Position         = u2(0,4,1,-3)
	progOuter.BackgroundColor3 = T.bgDeep
	progOuter.BackgroundTransparency = 0.3
	progOuter.BorderSizePixel  = 0
	progOuter.ZIndex           = 2002
	corner(progOuter, 999)

	local progFill = Instance.new("Frame", progOuter)
	progFill.Size             = u2(1,-2,1,0)
	progFill.Position         = u2(0,1,0,0)
	progFill.BackgroundColor3 = typeCol
	progFill.BackgroundTransparency = 0.3
	progFill.BorderSizePixel  = 0
	progFill.ZIndex           = 2003
	corner(progFill, 999)

	-- sync shadow pos to frame
	local function syncShadow()
		if shadow and shadow.Parent and nframe and nframe.Parent then
			shadow.Position = u2(0, nframe.Position.X.Offset-2, 0, nframe.Position.Y.Offset+3)
		end
	end

	local nobj = {frame=nframe, shadow=shadow, h=h, title=title, body=body, count=1, countLbl=countLbl, progBar=progFill}

	liveNotifs[#liveNotifs+1] = nobj
	reflow()

	-- slide in
	local targetPos = nframe.Position
	tw(nframe, {Position = u2(0, 0, targetPos.Y.Scale, targetPos.Y.Offset)}, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	local prog = ts:Create(progFill, ti(duration, Enum.EasingStyle.Linear), {Size = u2(0,-2,1,0)})
	prog:Play()
	nobj.prog = prog

	cn(rs.RenderStepped, function()
		syncShadow()
	end)

	local function doClose()
		dismissNotif(nobj)
		if nobj.timer then task.cancel(nobj.timer) end
	end

	cn(closeBtn2.MouseButton1Click, doClose)
	cn(closeBtn2.MouseEnter, function() closeBtn2.TextColor3 = T.txt end)
	cn(closeBtn2.MouseLeave, function() closeBtn2.TextColor3 = T.muted end)

	nobj.timer = task.delay(duration, function()
		if nframe and nframe.Parent then doClose() end
	end)
end

