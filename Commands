reg("clear", {"cls"}, "Clear all visuals", "", function()
	clearESP()
	for _, v in ipairs(state.chamObjs) do pcall(function() v:Destroy() end) end
	table.clear(state.chamObjs)
	for _, t in ipairs(state.traceObjs) do pcall(function() t.line.Visible = false; t.line:Remove() end) end
	table.clear(state.traceObjs)
	state.esp = false; state.chams = false; state.tracers = false
	notify("Clear", "All visuals removed", 3, "success")
end)

reg("prefix", {}, "Change prefix", "<char>", function(args)
	if args[1] and #args[1] == 1 then
		state.prefix = args[1]
		notify("Prefix", "→ " .. args[1], 3, "success")
	end
end)

reg("cmds", {"help", "commands"}, "List commands", "", function()
	if getgenv()._lav_show_cmds then getgenv()._lav_show_cmds() end
end)

lp.CharacterAdded:Connect(function()
	task.wait(1.5)
	if state.fly then
		state.fly = false
		task.spawn(function() CMDS["fly"].fn({}) end)
	end
	if state.noclip then
		state.noclip = false
		task.spawn(function() CMDS["noclip"].fn({}) end)
	end
	if state.god then
		local h = getHum()
		if h then h.MaxHealth = math.huge; h.Health = math.huge end
	end
	if state.invisible then
		state.invisible = false
		task.spawn(function() CMDS["invisible"].fn({}) end)
	end
	if state.esp then
		task.wait(0.5)
		for _, p in ipairs(Players:GetPlayers()) do if p ~= lp then applyESP(p) end end
	end
end)

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function()
		task.wait(1)
		if state.esp then applyESP(p) end
		if state.chams and p.Character then
			local hl = Instance.new("Highlight", p.Character)
			hl.Name = "LavCham"
			hl.FillColor = Color3.fromRGB(109, 73, 212)
			hl.FillTransparency = 0.55
			hl.OutlineColor = accentHi
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			table.insert(state.chamObjs, hl)
		end
	end)
end)

getgenv()._lav_cmds = CMDS
getgenv()._lav_run = function(input)
	if not input or input == "" then return end
	local parts = {}
	for w in input:gmatch("%S+") do table.insert(parts, w) end
	local name = table.remove(parts, 1):lower()
	local cmd = CMDS[name]
	if cmd then
		task.spawn(cmd.fn, parts)
	else
		notify("Unknown", name, 2, "error")
	end
end
