	-- Sync pill under active icon
	local function syncTabPill()
		if not main or not main.Parent then return end
		local si = activeTab and sideIcons[activeTab]
		if not si or not si.btn or not si.btn.Parent then return end
		local mp = main.Position
		local ap = si.btn.AbsolutePosition
		local as = si.btn.AbsoluteSize
		local px = mp.X.Offset + 6
		local py = mp.Y.Offset + 44 + (ap.Y - (main.AbsolutePosition.Y + 44)) + as.Y + 6
		tabPill.Position = u2(0, px, 0, py)
		tabCaret.Position = u2(0, px + (SIDEBAR_W-12)/2 - 10, 0, py - 11)
	end

	local function selectTab(name, instant)
		if activeTab == name then return end
		local prev = activeTab
		activeTab  = name
		tabPillLbl.Text = string.upper(name)

		local si = sideIcons[name]
		if si then
			task.defer(function()
				if not main or not main.Parent then return end
				local mp = main.Position
				local ap = si.btn.AbsolutePosition
				local as = si.btn.AbsoluteSize
				local px = mp.X.Offset + 6
				local py = mp.Y.Offset + 44 + (ap.Y - (main.AbsolutePosition.Y + 44)) + as.Y + 6
				if instant then
					tabPill.Position = u2(0,px,0,py)
					tabCaret.Position = u2(0, px+(SIDEBAR_W-12)/2-10, 0, py-11)
				else
					tw(tabPill, {Position=u2(0,px,0,py)}, 0.3, Enum.EasingStyle.Quart)
					tw(tabCaret, {Position=u2(0,px+(SIDEBAR_W-12)/2-10,0,py-11)}, 0.3, Enum.EasingStyle.Quart)
				end
			end)
		end

		for n, pg in pairs(pages) do
			local si2 = sideIcons[n]
			if n == name then
				pg.Visible = true
				if not instant then
					pg.BackgroundTransparency = 1
					pg.Position = u2(0.02,0,0,0)
					tw(pg, {Position=u2(0,0,0,0)}, 0.3, Enum.EasingStyle.Quart)
					ts:Create(pg, ti(0.25, Enum.EasingStyle.Quart), {BackgroundTransparency=1}):Play()
				end
				if si2 then
					tw(si2.btn,  {BackgroundColor3=T.accDim, BackgroundTransparency=0}, 0.2)
					if si2.isImg then tw(si2.icon,{ImageColor3=T.white},0.2)
					else tw(si2.icon,{TextColor3=T.white},0.2) end
					tw(si2.bar, {BackgroundTransparency=0, Size=u2(0,3,0.6,0)}, 0.28, Enum.EasingStyle.Back)
				end
			else
				if si2 then
					tw(si2.btn,  {BackgroundColor3=T.sidebar, BackgroundTransparency=1}, 0.18)
					if si2.isImg then tw(si2.icon,{ImageColor3=T.muted},0.18)
					else tw(si2.icon,{TextColor3=T.muted},0.18) end
					tw(si2.bar, {BackgroundTransparency=1, Size=u2(0,3,0,0)}, 0.18)
				end
				if prev == n and not instant then
					tw(pg, {Position=u2(-0.02,0,0,0)}, 0.22, Enum.EasingStyle.Quart)
					task.delay(0.22, function()
						if activeTab ~= n and pg and pg.Parent then
							pg.Visible = false
							pg.Position = u2(0,0,0,0)
						end
					end)
				else
					pg.Visible = false
					pg.Position = u2(0,0,0,0)
				end
			end
		end
	end

