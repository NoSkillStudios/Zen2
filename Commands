CMDS.pm = {desc="Sends a fake local whisper", args="<player> <message>", fn=function(args)
	local tgt = resolve(args[1]); if not tgt then notify("pm","Player not found") return end
	table.remove(args,1)
	pcall(function()
		game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage",{
			Text="[PM → "..tgt.Name.."] "..table.concat(args," "),
			Color=Color3.fromRGB(200,160,255), Font=Enum.Font.GothamSemibold, TextSize=14,
		})
	end)
end}

CMDS.spam = {desc="Spams a chat message", args="<times> <message>", fn=function(args)
	local times = math.min(tonumber(args[1]) or 5, 20); table.remove(args,1)
	local msg = table.concat(args," "); if msg=="" then notify("spam","Usage: spam <times> <message>") return end
	task.spawn(function()
		for _ = 1, times do
			pcall(function()
				game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents")
					:WaitForChild("SayMessageRequest"):FireServer(msg,"All")
			end)
			task.wait(0.35)
		end
	end)
	notify("spam", times.."x: "..msg)
end}

CMDS.hint = {desc="Shows a local hint", args="<message>", fn=function(args)
	local msg = table.concat(args," "); if msg=="" then notify("hint","Usage: hint <message>") return end
	local h = Instance.new("Hint"); h.Text=msg; h.Parent=workspace
	game:GetService("Debris"):AddItem(h,5); notify("hint",msg)
end}

