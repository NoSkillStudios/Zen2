	local function selectTab(name, instant)
		if activeTab == name then return end
		local prev = activeTab
		activeTab  = name

		for n, pg in pairs(pages) do
			local si = sideIcons[n]
			if n == name then
				pg.Visible = true
				if not instant then
					pg.Position = u2(0.014, 0, 0, 0)
					ts:Create(pg, ti(0.27, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position=u2(0,0,0,0)}):Play()
				end
				if si then
					tw(si.btn, {BackgroundColor3=T.accDim, BackgroundTransparency=0}, 0.18)
					if si.isImg then tw(si.icon,{ImageColor3=T.white},0.18)
					else tw(si.icon,{TextColor3=T.white},0.18) end
					tw(si.bar, {BackgroundTransparency=0, Size=u2(0,3,0.6,0)}, 0.26, Enum.EasingStyle.Back)
				end
			else
				if si then
					tw(si.btn, {BackgroundColor3=T.sidebar, BackgroundTransparency=1}, 0.15)
					if si.isImg then tw(si.icon,{ImageColor3=T.muted},0.15)
					else tw(si.icon,{TextColor3=T.muted},0.15) end
					tw(si.bar, {BackgroundTransparency=1, Size=u2(0,3,0,0)}, 0.15)
				end
				if prev == n and not instant then
					tw(pg, {Position=u2(-0.014,0,0,0)}, 0.2, Enum.EasingStyle.Quart)
					task.delay(0.2, function()
						if activeTab ~= n and pg and pg.Parent then
							pg.Visible = false
							pg.Position = u2(0,0,0,0)
						end
					end)
				else
					pg.Visible = false
					pg.Position = u2(0,0,0,0)
				end
			end
		end
	end

