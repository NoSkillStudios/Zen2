local function parseColor(str)
	if not str then return nil end
	local r,g,b=str:match("^(%d+),(%d+),(%d+)$")
	if r then return Color3.fromRGB(tonumber(r),tonumber(g),tonumber(b)) end
	local names={red=Color3.fromRGB(255,50,50),green=Color3.fromRGB(50,255,50),blue=Color3.fromRGB(50,150,255),
		yellow=Color3.fromRGB(255,255,50),white=Color3.fromRGB(255,255,255),pink=Color3.fromRGB(255,100,200),
		orange=Color3.fromRGB(255,140,30),cyan=Color3.fromRGB(0,255,255),purple=Color3.fromRGB(180,50,255)}
	return names[str:lower()]
end
local function parseKV(args,key)
	for _,a in ipairs(args) do
		local k,v=a:match("^([%a]+):(.+)$")
		if k and k:lower()==key:lower() then return v end
	end
	return nil
end

local function buildAliasMap()
	local map={}
	for _,def in ipairs(COMMAND_LIST) do
		map[def.cmd]=def.cmd
		for _,alias in ipairs(def.aliases) do map[alias]=def.cmd end
	end
	return map
end
local ALIAS_MAP=buildAliasMap()
local function resolveCmd(raw) return ALIAS_MAP[raw:lower()] end
local function suggestCommand(raw)
	local best,bestScore=nil,0; local q=raw:lower()
	for _,def in ipairs(COMMAND_LIST) do
		local function score(s)
			s=s:lower()
			if s==q then return 100 end
			if s:sub(1,#q)==q then return 80 end
			local match=0
			for i=1,math.min(#q,#s) do if q:sub(i,i)==s:sub(i,i) then match=match+1 end end
			return math.floor((match/math.max(#q,#s))*60)
		end
		local sc=score(def.cmd)
		for _,alias in ipairs(def.aliases) do sc=math.max(sc,score(alias)) end
		if sc>bestScore and sc>25 then bestScore=sc; best=def.cmd end
	end
	return best
end

