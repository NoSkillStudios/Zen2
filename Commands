CMDS.players = {desc="Lists players with distance", args="", fn=function()
	local r = getHRP(); local lines = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local dist = "?"
		if r and p.Character then
			local tr = p.Character:FindFirstChild("HumanoidRootPart")
			if tr then dist = math.floor((r.Position-tr.Position).Magnitude).."st" end
		end
		table.insert(lines, p.Name.." ["..dist.."]")
	end
	notify("players ("..#lines..")", table.concat(lines,"  ·  "), 8)
end}

