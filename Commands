	box.ZIndex           = 501
	box.BorderSizePixel  = 0
	corner(box, 12)
	stroke(box, T.acc, 1)

	local ttl = Instance.new("TextLabel", box)
	ttl.BackgroundTransparency = 1
	ttl.Text           = "🔒 " .. tabName
	ttl.TextSize       = 13
	ttl.TextColor3     = T.txt
