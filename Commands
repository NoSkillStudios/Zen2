local conns = {}
local activeDropdowns = {}

local function cn(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns+1] = c
	return c
end

local function tw(obj, props, dur, sty, dir, cb)
	if not obj or not obj.Parent then return end
	local t = ts:Create(obj, ti(dur or 0.2, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
	if cb then t.Completed:Connect(cb) end
	t:Play()
	return t
end

local function corner(p, r)
	local c = Instance.new("UICorner", p)
	c.CornerRadius = ud(0, r or 8)
	return c
end

local function stroke(p, col, th)
	local s = Instance.new("UIStroke", p)
	s.Color = col or T.bord
	s.Thickness = th or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function pad(p, t, b, l, r)
	local d = Instance.new("UIPadding", p)
	d.PaddingTop    = ud(0, t or 8)
	d.PaddingBottom = ud(0, b or 8)
	d.PaddingLeft   = ud(0, l or 8)
	d.PaddingRight  = ud(0, r or 8)
end

local function lst(p, dir, sp)
	local l = Instance.new("UIListLayout", p)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder     = Enum.SortOrder.LayoutOrder
	l.Padding       = ud(0, sp or 6)
	return l
end

local function lbl(p, txt, sz, col, font)
	local l = Instance.new("TextLabel", p)
	l.BackgroundTransparency = 1
	l.Text            = txt or ""
	l.TextSize        = sz  or 13
	l.TextColor3      = col or T.txt
	l.Font            = font or Enum.Font.GothamMedium
	l.TextXAlignment  = Enum.TextXAlignment.Left
	l.AutomaticSize   = Enum.AutomaticSize.XY
	l.BorderSizePixel = 0
	return l
end

local function scrl(p)
	local sf = Instance.new("ScrollingFrame", p)
	sf.Size                       = u2(1,0,1,0)
	sf.BackgroundTransparency     = 1
	sf.BorderSizePixel            = 0
	sf.ScrollBarThickness         = 3
	sf.ScrollBarImageColor3       = T.acc
	sf.ScrollBarImageTransparency = 0.5
	sf.CanvasSize                 = u2(0,0,0,0)
	sf.AutomaticCanvasSize        = Enum.AutomaticSize.Y
	return sf
end

local function makeDraggable(frame, handle)
	local dragging, dragStart, startPos = false
	cn(handle.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging = true; dragStart = i.Position; startPos = frame.Position
	end)
	cn(uis.InputChanged, function(i)
		if not dragging or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local d = i.Position - dragStart
		frame.Position = u2(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
	end)
	cn(uis.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
end

local function closeAllDropdowns(except)
	for _, fn in ipairs(activeDropdowns) do
		if fn ~= except then fn() end
	end
end

-- NOTIFICATION SYSTEM
-- Bottom-right stacked, new pushes up, duplicate counter, 3D shadow depth
local notifGui, notifContainer
local notifStack   = {}
local NOTIF_W      = 260
local NOTIF_PAD    = 6

local function initNotif(parentGui)
	notifGui = parentGui
	notifContainer = Instance.new("Frame", parentGui)
	notifContainer.Name               = "NC"
	notifContainer.AnchorPoint        = v2(1, 1)
	notifContainer.Size               = u2(0, NOTIF_W, 1, -20)
	notifContainer.Position           = u2(1, -16, 1, 0)
	notifContainer.BackgroundTransparency = 1
	notifContainer.BorderSizePixel    = 0
	notifContainer.ZIndex             = 2000
	notifContainer.ClipsDescendants   = false
end

local function repositionStack()
	local y = 0
	for i = #notifStack, 1, -1 do
		local n = notifStack[i]
		if n and n.f and n.f.Parent then
			tw(n.f, {Position = u2(0, 0, 1, -(y + n.h))}, 0.28, Enum.EasingStyle.Quart)
			y = y + n.h + NOTIF_PAD
		end
	end
end

function K.Notify(cfg)
	cfg = cfg or {}
	local title  = cfg.Title    or "Notification"
	local body   = cfg.Body     or cfg.Description or ""
	local dur    = cfg.Duration or 4
	local ntype  = cfg.Type     or "info"
	local iconId = cfg.Icon

	if not notifContainer then return end

	local typeCol = ntype == "success" and T.success
		or ntype == "error" and T.danger
		or ntype == "warn" and T.warn
		or T.acc

	for _, n in ipairs(notifStack) do
		if n.title == title and n.body == body and n.f and n.f.Parent then
			n.count += 1
			if n.cntLbl then
				n.cntLbl.Text    = n.count.."x"
				n.cntLbl.Visible = true
				tw(n.f, {Size = u2(1, 0, 0, n.h)}, 0.1, Enum.EasingStyle.Back)
			end
			if n.killer then task.cancel(n.killer) end
			n.killer = task.delay(dur, function()
				if n.f and n.f.Parent then n.dismiss() end
			end)
			if n.prog then
				ts:Create(n.prog, ti(dur, Enum.EasingStyle.Linear), {Size = u2(0, 0, 1, 0)}):Play()
			end
			return
		end
	end

	local h = body ~= "" and 66 or 46

	local f = Instance.new("Frame", notifContainer)
	f.Size             = u2(1, 0, 0, h)
	f.Position         = u2(1, 20, 1, -(h))
	f.BackgroundColor3 = c3(18, 18, 28)
	f.BorderSizePixel  = 0
	f.ZIndex           = 2001
	f.ClipsDescendants = false
	corner(f, 9)

	for i = 1, 2 do
		local sh = Instance.new("Frame", f)
		sh.Size             = u2(1, i*5, 1, i*3)
		sh.Position         = u2(0, -i*2, 0, i*2)
		sh.BackgroundColor3 = c3(4, 4, 10)
		sh.BackgroundTransparency = 0.3 + i*0.22
		sh.BorderSizePixel  = 0
		sh.ZIndex           = 2000 - i
		corner(sh, 10 + i)
	end

	local bar = Instance.new("Frame", f)
	bar.Size             = u2(0, 3, 1, -14)
	bar.Position         = u2(0, 0, 0, 7)
	bar.BackgroundColor3 = typeCol
	bar.BorderSizePixel  = 0
	bar.ZIndex           = 2002
	corner(bar, 999)

	local iconF = Instance.new("Frame", f)
	iconF.Size             = u2(0, 26, 0, 26)
	iconF.Position         = u2(0, 10, 0.5, -13)
	iconF.BackgroundColor3 = typeCol
	iconF.BackgroundTransparency = 0.82
	iconF.BorderSizePixel  = 0
	iconF.ZIndex           = 2002
	corner(iconF, 6)

	if iconId and type(iconId) == "string" and (#iconId > 4) then
		local img = Instance.new("ImageLabel", iconF)
		img.Size               = u2(1, -6, 1, -6)
		img.Position           = u2(0, 3, 0, 3)
		img.BackgroundTransparency = 1
		img.Image              = iconId
		img.ImageColor3        = typeCol
		img.ZIndex             = 2003
		img.ScaleType          = Enum.ScaleType.Fit
	else
		local sym = ntype == "success" and "✓" or ntype == "error" and "✕" or ntype == "warn" and "⚠" or "ℹ"
		local il = Instance.new("TextLabel", iconF)
		il.BackgroundTransparency = 1
		il.Size            = u2(1, 0, 1, 0)
		il.Text            = sym
		il.TextSize        = 12
		il.TextColor3      = typeCol
		il.Font            = Enum.Font.GothamBold
		il.TextXAlignment  = Enum.TextXAlignment.Center
		il.TextYAlignment  = Enum.TextYAlignment.Center
		il.ZIndex          = 2003
	end

	local tl = Instance.new("TextLabel", f)
	tl.BackgroundTransparency = 1
	tl.Size            = u2(1, -90, 0, 14)
	tl.Position        = body ~= "" and u2(0, 44, 0, 10) or u2(0, 44, 0.5, -7)
	tl.Text            = title
	tl.TextSize        = 12
	tl.TextColor3      = T.txt
	tl.Font            = Enum.Font.GothamBold
	tl.TextXAlignment  = Enum.TextXAlignment.Left
	tl.TextTruncate    = Enum.TextTruncate.AtEnd
	tl.ZIndex          = 2002

	local cntLbl = Instance.new("TextLabel", f)
	cntLbl.BackgroundTransparency = 1
	cntLbl.Text       = "1x"
	cntLbl.TextSize   = 9
	cntLbl.TextColor3 = typeCol
	cntLbl.Font       = Enum.Font.GothamBold
	cntLbl.Size       = u2(0, 24, 0, 14)
	cntLbl.Position   = u2(1, -50, 0, body ~= "" and 10 or 0)
	if body == "" then cntLbl.Position = u2(1, -50, 0.5, -7) end
	cntLbl.TextXAlignment = Enum.TextXAlignment.Center
	cntLbl.ZIndex     = 2003
	cntLbl.Visible    = false

	if body ~= "" then
		local dl = Instance.new("TextLabel", f)
		dl.BackgroundTransparency = 1
		dl.Size           = u2(1, -90, 0, 12)
		dl.Position       = u2(0, 44, 0, 28)
		dl.Text           = body
		dl.TextSize       = 10
		dl.TextColor3     = T.sub
		dl.Font           = Enum.Font.Gotham
		dl.TextXAlignment = Enum.TextXAlignment.Left
		dl.TextTruncate   = Enum.TextTruncate.AtEnd
		dl.ZIndex         = 2002
	end

	local prog = Instance.new("Frame", f)
	prog.Size             = u2(1, -6, 0, 2)
	prog.Position         = u2(0, 3, 1, -3)
	prog.BackgroundColor3 = typeCol
	prog.BackgroundTransparency = 0.5
	prog.BorderSizePixel  = 0
	prog.ZIndex           = 2002
	corner(prog, 999)

	local xBtn = Instance.new("TextButton", f)
	xBtn.Size             = u2(0, 16, 0, 16)
	xBtn.Position         = u2(1, -20, 0, 4)
	xBtn.BackgroundTransparency = 1
	xBtn.Text             = "×"
	xBtn.TextSize         = 14
	xBtn.TextColor3       = T.muted
	xBtn.Font             = Enum.Font.GothamBold
	xBtn.ZIndex           = 2003
	xBtn.BorderSizePixel  = 0
	cn(xBtn.MouseEnter, function() xBtn.TextColor3 = T.txt end)
	cn(xBtn.MouseLeave, function() xBtn.TextColor3 = T.muted end)

	local nobj = {f=f, h=h, title=title, body=body, count=1, cntLbl=cntLbl, prog=prog}
	notifStack[#notifStack+1] = nobj

	repositionStack()

	tw(f, {Position = u2(0, 0, 1, -(h))}, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	ts:Create(prog, ti(dur, Enum.EasingStyle.Linear), {Size = u2(0, 0, 1, 0)}):Play()

	local function dismiss()
		for i, n in ipairs(notifStack) do
			if n == nobj then table.remove(notifStack, i); break end
		end
		tw(f, {Position = u2(1, 20, f.Position.Y.Scale, f.Position.Y.Offset), BackgroundTransparency = 1}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function()
			if f and f.Parent then f:Destroy() end
		end)
		task.defer(repositionStack)
	end

	nobj.dismiss = dismiss
	cn(xBtn.MouseButton1Click, dismiss)
	nobj.killer = task.delay(dur, function()
		if f and f.Parent then dismiss() end
	end)
end

