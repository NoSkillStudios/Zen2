	nframe.Position         = u2(1, 20, 0, 0)
	nframe.BackgroundColor3 = T.notifBg
	nframe.BorderSizePixel  = 0
	nframe.ZIndex           = 2001
	nframe.ClipsDescendants = false
	corner(nframe, 10)
	stroke(nframe, T.bordFaint, 1)

	local accentLine = Instance.new("Frame", nframe)
	accentLine.Size             = u2(0, 3, 1, -16)
	accentLine.Position         = u2(0, 0, 0, 8)
	accentLine.BackgroundColor3 = typeColor
	accentLine.BorderSizePixel  = 0
	accentLine.ZIndex           = 2002
	corner(accentLine, 999)

	local iconF = Instance.new("Frame", nframe)
	iconF.Size             = u2(0, 28, 0, 28)
	iconF.Position         = u2(0, 12, 0.5, -14)
	iconF.BackgroundColor3 = typeColor
	iconF.BackgroundTransparency = 0.8
	iconF.BorderSizePixel  = 0
	iconF.ZIndex           = 2002
	corner(iconF, 7)

	local iconLbl = Instance.new("TextLabel", iconF)
