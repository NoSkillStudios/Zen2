	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.TextTruncate   = Enum.TextTruncate.AtEnd
	titleLbl.ZIndex         = 2002

	if desc ~= "" then
		local descLbl = Instance.new("TextLabel", nframe)
		descLbl.BackgroundTransparency = 1
		descLbl.Size           = u2(1, -58, 0, 14)
		descLbl.Position       = u2(0, 48, 0, 30)
		descLbl.Text           = desc
		descLbl.TextSize       = 11
		descLbl.TextColor3     = T.sub
		descLbl.Font           = Enum.Font.Gotham
		descLbl.TextXAlignment = Enum.TextXAlignment.Left
		descLbl.TextTruncate   = Enum.TextTruncate.AtEnd
		descLbl.ZIndex         = 2002
	end

	local closeBtn = Instance.new("TextButton", nframe)
	closeBtn.Size             = u2(0, 18, 0, 18)
	closeBtn.Position         = u2(1, -24, 0, 6)
	closeBtn.BackgroundTransparency = 1
	closeBtn.Text             = "×"
	closeBtn.TextSize         = 16
	closeBtn.TextColor3       = T.muted
	closeBtn.Font             = Enum.Font.GothamBold
	closeBtn.ZIndex           = 2003
	closeBtn.BorderSizePixel  = 0

	local progress = Instance.new("Frame", nframe)
	progress.Size             = u2(1, -6, 0, 2)
	progress.Position         = u2(0, 3, 1, -4)
	progress.BackgroundColor3 = typeColor
	progress.BackgroundTransparency = 0.4
	progress.BorderSizePixel  = 0
	progress.ZIndex           = 2002
	corner(progress, 999)

	local nobj = {frame=nframe, height=h}
	notifVisible[#notifVisible+1] = nobj

	repositionNotifs()

	tw(nframe, {Position = u2(0, 0, nframe.Position.Y.Scale, nframe.Position.Y.Offset), BackgroundTransparency = 0}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	ts:Create(progress, ti(duration, Enum.EasingStyle.Linear), {Size = u2(0, -6, 0, 2)}):Play()

	local function dismiss()
		for i, nv in ipairs(notifVisible) do
			if nv == nobj then
				table.remove(notifVisible, i)
				break
			end
		end
		tw(nframe, {Position = u2(1, 20, nframe.Position.Y.Scale, nframe.Position.Y.Offset), BackgroundTransparency = 1}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function()
			nframe:Destroy()
		end)
		repositionNotifs()
	end

	closeBtn.MouseButton1Click:Connect(dismiss)
	task.delay(duration, function()
		if nframe and nframe.Parent then dismiss() end
	end)

	cn(closeBtn.MouseEnter, function() closeBtn.TextColor3 = T.txt end)
	cn(closeBtn.MouseLeave, function() closeBtn.TextColor3 = T.muted end)
end

