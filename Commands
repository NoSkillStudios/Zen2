-- FREECAM
local fcConn=nil; local fcCF=CFrame.new(0,20,0); local fcSpeed=30
local function startFreecam()
	if State.freecamActive then return end; State.freecamActive=true
	local cam=workspace.CurrentCamera; local prevType=cam.CameraType
	cam.CameraType=Enum.CameraType.Scriptable; fcCF=cam.CFrame
	local yaw,pitch=0,0; local lastMs=UIS:GetMouseLocation()
	fcConn=RS.RenderStepped:Connect(function(dt)
		if not State.freecamActive then fcConn:Disconnect(); fcConn=nil; cam.CameraType=prevType; return end
		local ms=UIS:GetMouseLocation()
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			local d=ms-lastMs; yaw=yaw-d.X*0.003; pitch=math.clamp(pitch-d.Y*0.003,-1.5,1.5)
		end
		lastMs=ms
		local rot=CFrame.Angles(0,yaw,0)*CFrame.Angles(pitch,0,0); local mv=Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then mv=mv+rot.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then mv=mv-rot.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then mv=mv-rot.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then mv=mv+rot.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.E) then mv=mv+Vector3.new(0,1,0) end
		if UIS:IsKeyDown(Enum.KeyCode.Q) then mv=mv-Vector3.new(0,1,0) end
		local spd=UIS:IsKeyDown(Enum.KeyCode.LeftShift) and fcSpeed*3 or fcSpeed
		if mv.Magnitude>0 then mv=mv.Unit end
		fcCF=fcCF+mv*spd*dt
		cam.CFrame=CFrame.new(fcCF.Position)*CFrame.Angles(0,yaw,0)*CFrame.Angles(pitch,0,0)
	end)
	notify("📷 Freecam","RMB=look WASD=move E/Q=up/down Shift=fast",3)
end
local function stopFreecam()
	State.freecamActive=false
	if fcConn then fcConn:Disconnect(); fcConn=nil end
	workspace.CurrentCamera.CameraType=Enum.CameraType.Custom
	notify("📷 Freecam","Disabled",1.5)
end

