	-- ── TAB SELECTOR ───────────────────────────────────────────────────────
	local function selectTab(name)
		if activeTab == name then return end
		local prev = activeTab
		activeTab  = name

		for n, pg in pairs(pages) do
			local si2 = sideIcons[n]
			if n == name then
				pg.Visible          = true
				pg.Position         = u2(0.04, 0, 0, 0)
				pg.BackgroundTransparency = 1
				tw(pg, {Position = u2(0,0,0,0)}, 0.22, Enum.EasingStyle.Quart)
				if si2 then
					tw(si2.btn,  {BackgroundColor3=T.accDim, BackgroundTransparency=0}, 0.18)
					if si2.isImg then tw(si2.icon,{ImageColor3=T.white},0.18)
					else tw(si2.icon,{TextColor3=T.white},0.18) end
					tw(si2.bar, {BackgroundTransparency=0, Size=u2(0,3,0.6,0)}, 0.28, Enum.EasingStyle.Back)
				end
			else
				if si2 then
					tw(si2.btn,  {BackgroundColor3=T.sidebar, BackgroundTransparency=1}, 0.18)
					if si2.isImg then tw(si2.icon,{ImageColor3=T.muted},0.18)
					else tw(si2.icon,{TextColor3=T.muted},0.18) end
					tw(si2.bar, {BackgroundTransparency=1, Size=u2(0,3,0,0)}, 0.18)
				end
				if prev == n then
					tw(pg, {Position = u2(-0.04,0,0,0)}, 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
					task.delay(0.2, function()
						if activeTab ~= n and pg and pg.Parent then
							pg.Visible   = false
							pg.Position  = u2(0,0,0,0)
						end
					end)
				else
					pg.Visible  = false
					pg.Position = u2(0,0,0,0)
				end
			end
		end
	end

