-- ════════════════════════════════════════════════════════════════════════════
local function parseKV(args, key)
    for _, a in ipairs(args) do
        local k, v = a:match("^([%a]+):(.+)$")
        if k and k:lower() == key:lower() then return v end
    end
    return nil
end

local function parseColor(str)
    if not str then return nil end
    local r, g, b = str:match("^(%d+),(%d+),(%d+)$")
    if r then return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) end
    local names = {
        red    = Color3.fromRGB(255, 50,  50),
        green  = Color3.fromRGB(50,  255, 50),
        blue   = Color3.fromRGB(50,  150, 255),
        yellow = Color3.fromRGB(255, 255, 50),
        white  = Color3.fromRGB(255, 255, 255),
        pink   = Color3.fromRGB(255, 100, 200),
        orange = Color3.fromRGB(255, 140, 30),
    }
    return names[str:lower()]
end

-- ════════════════════════════════════════════════════════════════════════════
--   RUN BAR COMMAND PARSER
-- ════════════════════════════════════════════════════════════════════════════
local showArgPopup = function() end  -- will be overridden by Gui.lua

local function runCommand(raw)
    -- Allow Gui.lua to inject its popup function at runtime
    local argPopupFn = _G.NihonShowArgPopup or showArgPopup
    local ARG_POPUP_SCHEMAS = _G.NihonArgSchemas or {}

    local parts = {}
    for w in raw:gmatch("%S+") do parts[#parts + 1] = w end
    if #parts == 0 then return end
    local cmd  = parts[1]:lower()
    local args = {}
    for i = 2, #parts do args[#args + 1] = parts[i] end
    local rest = table.concat(args, " ")

    -- ── Self movement ────────────────────────────────────────────────────────
    if cmd == "speed" then
        if #args == 0 then
            argPopupFn("speed", ARG_POPUP_SCHEMAS.speed, function(v)
                local n = tonumber(v.value) or 16; local dur = tonumber(v.duration)
                local hum = getHum(); if hum then hum.WalkSpeed = n; notify("⚡ Speed", "→ " .. n, 1.5) end
                if dur and dur > 0 then task.delay(dur, function() local h = getHum(); if h then h.WalkSpeed = 16 end end) end
            end); return
        end
        local hum = getHum(); if hum then hum.WalkSpeed = tonumber(args[1]) or 16; notify("⚡ Speed", "→ " .. (args[1]), 1.5) end

    elseif cmd == "nospeed" then
        local hum = getHum(); if hum then hum.WalkSpeed = 16; notify("⚡ Speed", "Reset to 16", 1.5) end

    elseif cmd == "jumppower" or cmd == "jp" then
        if #args == 0 then
            argPopupFn("jumppower", ARG_POPUP_SCHEMAS.jumppower, function(v)
                local hum = getHum(); if hum then hum.JumpPower = tonumber(v.value) or 70 end
                notify("🍃 JumpPower", "→ " .. (v.value), 1.5)
            end); return
        end
        local hum = getHum(); if hum then hum.JumpPower = tonumber(args[1]) or 70; notify("🍃 JumpPower", "→ " .. (args[1]), 1.5) end

    elseif cmd == "nojumppower" or cmd == "nojp" then
        local hum = getHum(); if hum then hum.JumpPower = 70; notify("🍃 JumpPower", "Reset", 1.5) end

    elseif cmd == "gravity" then
        if #args == 0 then
            argPopupFn("gravity", ARG_POPUP_SCHEMAS.gravity, function(v)
                workspace.Gravity = tonumber(v.value) or 196.2; notify("🍀 Gravity", "→ " .. v.value, 1.5)
            end); return
        end
        workspace.Gravity = tonumber(args[1]) or 196.2; notify("🍀 Gravity", "→ " .. (args[1]), 1.5)

    elseif cmd == "nogravity"   then workspace.Gravity = 196.2; notify("🍀 Gravity", "Reset", 1.5)
    elseif cmd == "zerogravity" then workspace.Gravity = 0;     notify("🍀 Gravity", "Zero!", 1.5)
    elseif cmd == "lowgravity"  then workspace.Gravity = 30;    notify("🍀 Gravity", "Low (30)", 1.5)

    -- ── Fly ──────────────────────────────────────────────────────────────────
    elseif cmd == "fly" then
        if #args == 0 and not State.flyActive then
            argPopupFn("fly", ARG_POPUP_SCHEMAS.fly, function(v) startFly(tonumber(v.speed)) end); return
        end
        startFly(tonumber(args[1]))
    elseif cmd == "unfly" or cmd == "nofly" then stopFly()

    -- ── Noclip ───────────────────────────────────────────────────────────────
    elseif cmd == "noclip"  then startNoclip()
    elseif cmd == "clip" or cmd == "nonoclip" then stopNoclip()

    elseif cmd == "noclipfly" then
        if #args == 0 and not State.noclipFlyActive then
            argPopupFn("noclipfly", ARG_POPUP_SCHEMAS.noclipfly, function(v) startNoclipFly(tonumber(v.speed)) end); return
        end
        startNoclipFly(tonumber(args[1]))
    elseif cmd == "unnoclipfly" or cmd == "nonoclipfly" then stopNoclipFly()

    -- ── Mute ─────────────────────────────────────────────────────────────────
    elseif cmd == "mute" then
        if #args == 0 then
            argPopupFn("mute", ARG_POPUP_SCHEMAS.mute, function(v)
                local t = findPlayer(v.user)
                if t then mutePlayer(t, tonumber(v.duration)) else notify("🔇 Mute", "Player not found", 2) end
            end); return
        end
        local t = findPlayer(parseKV(args, "user") or args[1])
        if t then mutePlayer(t, tonumber(parseKV(args, "duration") or args[2]))
        else notify("🔇 Mute", "Player not found", 2) end
    elseif cmd == "unmute" then
        local t = findPlayer(args[1]); if t then unmutePlayer(t) else notify("🔊 Unmute", "Player not found", 2) end

    -- ── Invisibility ─────────────────────────────────────────────────────────
    elseif cmd == "invis" then
        local c = getChar(); if not c then return end
        for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = 1 end end
        notify("🌙 Invis", "Invisible (client)", 1.5)
    elseif cmd == "vis" then
        local c = getChar(); if not c then return end
        for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = 0 end end
        notify("☀️ Vis", "Visible again", 1.5)

    -- ── Basic self ────────────────────────────────────────────────────────────
    elseif cmd == "sit"      then local hum = getHum(); if hum then hum.Sit = true; notify("🪑 Sit", "Sitting", 1.5) end
    elseif cmd == "freeze"   then local hrp = getHRP(); if hrp then hrp.Anchored = true;  notify("❄️ Freeze",   "Frozen",    1.5) end
    elseif cmd == "unfreeze" then local hrp = getHRP(); if hrp then hrp.Anchored = false; notify("🔥 Unfreeze", "Unfrozen",  1.5) end
    elseif cmd == "tk"  then startTouchKill()
    elseif cmd == "utk" then stopTouchKill()

    -- ── Teleport ──────────────────────────────────────────────────────────────
    elseif cmd == "tp" or cmd == "to" then
        if #args == 0 then
            argPopupFn("tp", ARG_POPUP_SCHEMAS.tp, function(v)
                local t = findPlayer(v.user); if t then teleportTo(t) else notify("✈️ TP", "Not found: " .. v.user, 2) end
            end); return
        end
        local t = findPlayer(rest); if t then teleportTo(t) else notify("✈️ TP", "Not found: " .. rest, 2) end
    elseif cmd == "tpcoords" or cmd == "pos" then
        if args[1] and args[2] and args[3] then teleportToCoords(args[1], args[2], args[3])
        else notify("📍 TpCoords", "Usage: tpcoords x y z", 2) end
    elseif cmd == "copypos" then copyPosition()

    -- ── Bring / Attach / Orbit / WalkTo ──────────────────────────────────────
    elseif cmd == "bring" then
        if #args == 0 then
            argPopupFn("bring", ARG_POPUP_SCHEMAS.bring, function(v)
                for _, p in ipairs(findPlayers(v.user)) do bringPlayer(p) end
            end); return
        end
        for _, p in ipairs(findPlayers(parseKV(args, "user") or rest)) do bringPlayer(p) end

    elseif cmd == "attach" then
        if #args == 0 then
            argPopupFn("attach", ARG_POPUP_SCHEMAS.attach, function(v)
                local t = findPlayer(v.user)
                if t then startAttach(t, tonumber(v.delay)) else notify("🔗 Attach", "Not found", 2) end
            end); return
        end
        local t = findPlayer(parseKV(args, "user") or args[1])
        if not t then notify("🔗 Attach", "Not found", 2); return end
        startAttach(t, tonumber(parseKV(args, "delay")))
    elseif cmd == "noattach" or cmd == "detach" then stopAttach()

    elseif cmd == "orbit" then
        local t = findPlayer(args[1])
        if t then startOrbit(t, args[2]) else notify("🌀 Orbit", "Not found", 2) end
    elseif cmd == "noordit" or cmd == "noorbit" then stopOrbit()

    elseif cmd == "walkto" then
        if #args == 0 then
            argPopupFn("walkto", ARG_POPUP_SCHEMAS.walkto, function(v)
                local t = findPlayer(v.user); if t then startWalkTo(t) else notify("🚶 WalkTo", "Not found", 2) end
            end); return
        end
        local t = findPlayer(rest); if t then startWalkTo(t) else notify("🚶 WalkTo", "Not found", 2) end
    elseif cmd == "unwalkto" or cmd == "stopwalk" then stopWalkTo()

    -- ── Hitbox / ESP / Tracers / Aimbot ───────────────────────────────────────
    elseif cmd == "hitbox" then
        if #args == 0 then
            argPopupFn("hitbox", ARG_POPUP_SCHEMAS.hitbox, function(v)
                applyHitbox(findPlayers(v.user), tonumber(v.size), tonumber(v.transparency))
            end); return
        end
        applyHitbox(findPlayers(parseKV(args, "user") or args[1] or "others"),
            tonumber(parseKV(args, "size")), tonumber(parseKV(args, "transparency")))
    elseif cmd == "nohitbox" then clearHitboxes()

    elseif cmd == "esp" then
        if #args == 0 then
            argPopupFn("esp", ARG_POPUP_SCHEMAS.esp, function(v)
                startEsp(findPlayers(v.user), parseColor(v.color), tonumber(v.duration))
            end); return
        end
        startEsp(findPlayers(parseKV(args, "user") or "others"),
            parseColor(parseKV(args, "color")) or Color3.fromRGB(255, 50, 50),
            tonumber(parseKV(args, "duration")))
    elseif cmd == "noesp" then stopEsp()

    elseif cmd == "tracers" then
        if #args == 0 then
            argPopupFn("tracers", ARG_POPUP_SCHEMAS.tracers, function(v)
                startTracers(findPlayers(v.user), parseColor(v.color))
            end); return
        end
        startTracers(findPlayers(parseKV(args, "user") or "others"), parseColor(parseKV(args, "color")))
    elseif cmd == "notracers" then stopTracers()

    elseif cmd == "aimbot" then
        if #args == 0 then
            argPopupFn("aimbot", ARG_POPUP_SCHEMAS.aimbot, function(v) startAimbot(findPlayers(v.user)) end); return
        end
        startAimbot(findPlayers(parseKV(args, "user") or "others"))
    elseif cmd == "noaimbot" then stopAimbot()

    -- ── Anti-AFK ──────────────────────────────────────────────────────────────
    elseif cmd == "antiafk"   then startAntiAfk()
    elseif cmd == "noantiafk" then stopAntiAfk()

    -- ── Chat ─────────────────────────────────────────────────────────────────
    elseif cmd == "echat" then
        if rest == "" then argPopupFn("echat", ARG_POPUP_SCHEMAS.echat, function(v) editChat(v.user) end); return end
        editChat(rest)
    elseif cmd == "chatspam" then
        if #args == 0 then
            argPopupFn("chatspam", ARG_POPUP_SCHEMAS.chatspam, function(v) chatSpam(v.user, v.duration) end); return
        end
        chatSpam(args[1], args[2])

    -- ── Lighting / Time ───────────────────────────────────────────────────────
    elseif cmd == "light" or cmd == "brightness" then
        if #args == 0 then
            argPopupFn("light", ARG_POPUP_SCHEMAS.light, function(v)
                Lighting.Brightness = tonumber(v.value) or 1; notify("💡 Light", "→ " .. v.value, 1.5)
            end); return
        end
        Lighting.Brightness = tonumber(args[1]) or 1; notify("💡 Light", "→ " .. (args[1]), 1.5)
    elseif cmd == "bright"       then Lighting.Brightness = 10;  notify("💡 Light", "Bright",  1.5)
    elseif cmd == "darkmode"     then Lighting.Brightness = 0.1; notify("💡 Light", "Dark",    1.5)
    elseif cmd == "defaultlight" then Lighting.Brightness = 1;   notify("💡 Light", "Default", 1.5)
    elseif cmd == "fullbright"   then setFullbright(true)
    elseif cmd == "nofullbright" then setFullbright(false)
    elseif cmd == "fog"   then Lighting.FogEnd = 1;      notify("🌫️ Fog", "Enabled",  1.5)
    elseif cmd == "nofog" then Lighting.FogEnd = 100000; notify("🌫️ Fog", "Disabled", 1.5)
    elseif cmd == "timeset" or cmd == "time" then
        if #args == 0 then argPopupFn("timeset", ARG_POPUP_SCHEMAS.timeset, function(v) setTime(tonumber(v.value)) end); return end
        setTime(tonumber(args[1]))
    elseif cmd == "night"  then setNight()
    elseif cmd == "day"    then setDay()
    elseif cmd == "sunset" then setSunset()

    -- ── Camera / FOV ─────────────────────────────────────────────────────────
    elseif cmd == "fov" then
        if #args == 0 then argPopupFn("fov", ARG_POPUP_SCHEMAS.fov, function(v) setFov(v.value) end); return end
        setFov(args[1])
    elseif cmd == "zoom"                           then setZoom(args[1])
    elseif cmd == "thirdperson" or cmd == "tp3"    then setThirdPerson(args[1])
    elseif cmd == "resetcam" or cmd == "nocam"     then resetCamera()

    -- ── Character appearance ──────────────────────────────────────────────────
    elseif cmd == "size" then
        if #args == 0 then argPopupFn("size", ARG_POPUP_SCHEMAS.size, function(v) setSize(v.value) end); return end
        setSize(args[1])
    elseif cmd == "headless"                          then setHeadless(true)
    elseif cmd == "noheadless" or cmd == "showhead"   then setHeadless(false)
    elseif cmd == "nametag" or cmd == "hidenametag"   then hideNameTag()
    elseif cmd == "rainbow"                           then startRainbow()
    elseif cmd == "norainbow"                         then stopRainbow()
    elseif cmd == "rainbowsky"                        then startRainbowSky()
    elseif cmd == "norainbowsky"                      then stopRainbowSky()
    elseif cmd == "spin"   then startSpin(tonumber(args[1]))
    elseif cmd == "nospin" or cmd == "unspin" then stopSpin()

    -- ── Animation / Music ────────────────────────────────────────────────────
    elseif cmd == "animation" or cmd == "anim" then
        if #args == 0 then argPopupFn("animation", ARG_POPUP_SCHEMAS.animation, function(v) playAnimation(v.value) end); return end
        playAnimation(args[1])
    elseif cmd == "music" or cmd == "play" then
        if #args == 0 then argPopupFn("music", ARG_POPUP_SCHEMAS.music, function(v) playMusic(v.value, v.duration) end); return end
        playMusic(args[1], args[2])
    elseif cmd == "stopmusic" or cmd == "nomusic" then stopMusic()

    -- ── SpeedPad / GodMode / Jump ────────────────────────────────────────────
    elseif cmd == "speedpad"               then startSpeedPad(args[1])
    elseif cmd == "nospeedpad"             then stopSpeedPad()
    elseif cmd == "god" or cmd == "godmode" then startGodMode()
    elseif cmd == "nogod" or cmd == "mortal" then stopGodMode()
    elseif cmd == "jump"   then forceJump()
    elseif cmd == "respawn" then lp:LoadCharacter(); notify("🌺 Respawn", "Respawning...", 1.5)

    -- ── Clone ─────────────────────────────────────────────────────────────────
    elseif cmd == "clone" then
        if #args == 0 then
            argPopupFn("clone", ARG_POPUP_SCHEMAS.clone, function(v)
                local t = findPlayer(v.user); if t then cloneAppearance(t) else notify("👥 Clone", "Not found", 2) end
            end); return
        end
        local t = findPlayer(rest); if t then cloneAppearance(t) else notify("👥 Clone", "Not found", 2) end

    -- ── Target commands ───────────────────────────────────────────────────────
    elseif cmd == "kill"   then for _, p in ipairs(findPlayers(rest or "others")) do killPlayer(p) end
    elseif cmd == "kick"   then local t = findPlayer(rest); if t then kickPlayer(t) else notify("👢 Kick", "Not found", 2) end
    elseif cmd == "fling"  then for _, p in ipairs(findPlayers(rest or "others")) do flingTarget(p) end
    elseif cmd == "explode" then for _, p in ipairs(findPlayers(rest or "others")) do explodeAtTarget(p) end

    elseif cmd == "freezetarget" or cmd == "ft" then
        for _, p in ipairs(findPlayers(rest or "others")) do freezeTarget(p) end
    elseif cmd == "unfreezet" or cmd == "uft" then
        for _, p in ipairs(findPlayers(rest or "others")) do unfreezeTarget(p) end

    elseif cmd == "stun" then
        local t   = findPlayer(parseKV(args, "user") or args[1])
        local dur = tonumber(parseKV(args, "duration") or args[2]) or 5
        if t then stunTarget(t, dur) end

    elseif cmd == "forcesit"  then for _, p in ipairs(findPlayers(rest or "others")) do forceSitTarget(p) end
    elseif cmd == "invistgt"  then for _, p in ipairs(findPlayers(rest or "others")) do invisTarget(p) end
    elseif cmd == "vistgt"    then for _, p in ipairs(findPlayers(rest or "others")) do visTarget(p) end

    elseif cmd == "fakechat" or cmd == "fc" then
        local t      = findPlayer(parseKV(args, "user") or args[1])
        local msgArg = parseKV(args, "msg") or table.concat(args, " ", 2)
        if t then fakeChatBubble(t, msgArg) else notify("💬 FakeChat", "Not found", 2) end

    elseif cmd == "tspeed" then
        local spd = tonumber(parseKV(args, "speed") or args[2]) or 16
        for _, p in ipairs(findPlayers(parseKV(args, "user") or args[1] or "others")) do setTargetSpeed(p, spd) end

    elseif cmd == "deltools" or cmd == "removetools" then
        for _, p in ipairs(findPlayers(rest or "others")) do deleteTools(p) end

    elseif cmd == "netowner" or cmd == "netown" then
        local t = findPlayer(rest); if t then setNetOwner(t) else notify("📡 NetOwner", "Not found", 2) end

    elseif cmd == "respawntgt" then
        for _, p in ipairs(findPlayers(rest or "others")) do respawnTarget(p) end

    -- ── Server ────────────────────────────────────────────────────────────────
    elseif cmd == "rejoin"     then notify("🔄 Rejoin", "Rejoining...", 1.5); task.wait(0.5); rejoin()
    elseif cmd == "serverhop"  then serverHop()
    elseif cmd == "serverinfo" then showServerInfo()
    elseif cmd == "infyield"   then runInfYield()
    elseif cmd == "console"    then openConsole()
    elseif cmd == "crash"      then crashSelf()

    elseif cmd == "enable" then
        local what = (args[1] or ""):lower()
        if     what == "shiftlock"  then enableShiftlock()
        elseif what == "resetting"  then enableResetting()
        elseif what == "inventory"  then enableInventory()
        else notify("⚙️ Enable", "Options: shiftlock/resetting/inventory", 2) end

    elseif cmd == "prefix" then
        if #args == 0 then
            argPopupFn("prefix", ARG_POPUP_SCHEMAS.prefix, function(v)
                State.prefix = v.value; notify("⚙️ Prefix", "→ " .. v.value, 1.5)
            end); return
        end
        State.prefix = args[1]; notify("⚙️ Prefix", "→ " .. (args[1]), 1.5)

    else
        notify("❓ Unknown", "Command not recognised: " .. cmd, 2)
    end
end

