CMDS.esp = {
	desc = "Toggles player ESP",
	args = "",
	fn = function()
		state.esp = not state.esp
		if state.esp then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= lp and p.Character then
					local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
					if head then
						local bb = Instance.new("BillboardGui")
						bb.Name = "LavESP"; bb.Adornee = head; bb.AlwaysOnTop = true
						bb.Size = UDim2.fromOffset(100, 30); bb.StudsOffset = Vector3.new(0, 2.5, 0)
						bb.ResetOnSpawn = false; bb.Parent = head
						local nl = Instance.new("TextLabel", bb)
						nl.Size = UDim2.fromScale(1,1); nl.BackgroundTransparency = 1
						nl.TextColor3 = Color3.fromRGB(200,170,255); nl.Font = Enum.Font.GothamBold
						nl.TextSize = 11; nl.TextXAlignment = Enum.TextXAlignment.Center
						nl.Text = p.Name
						local hl = Instance.new("Highlight")
						hl.Name = "LavHL"; hl.FillTransparency = 1
						hl.OutlineColor = Color3.fromRGB(160,120,255); hl.OutlineTransparency = 0
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.Parent = p.Character
						table.insert(state.espObjs, bb)
						table.insert(state.espObjs, hl)
					end
				end
			end
			notify("esp", "Enabled")
		else
			for _, v in ipairs(state.espObjs) do pcall(function() v:Destroy() end) end
			state.espObjs = {}
			notify("esp", "Disabled")
		end
	end
}

