					rStroke.Color = T.bordFaint
					tw(ddFrame, {Size=u2(1,0,0,0)}, 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, function()
						if not open then ddFrame.Visible = false end
					end)
					tw(wrap, {Size=u2(1,0,0,36)}, 0.2, Enum.EasingStyle.Quart)
				end

				local function buildOpt(opt)
					local ob = Instance.new("TextButton")
					ob.Size = u2(1, 0, 0, ITEM_H)
					ob.BackgroundColor3 = c3(16, 16, 26)
					ob.BackgroundTransparency = 1
					ob.Text = ""
					ob.ZIndex = 51
					ob.BorderSizePixel = 0
					ob.Parent = ddScroll
					corner(ob, 5)

					local ol = lbl(ob, opt, 12, T.txt, Enum.Font.Gotham)
					ol.Position = u2(0, 10, 0.5, -6)
					ol.ZIndex = 52

					local ck = Instance.new("TextLabel")
					ck.BackgroundTransparency = 1
					ck.Text = "✓"
					ck.TextSize = 11
					ck.TextColor3 = T.acc
					ck.Font = Enum.Font.GothamBold
					ck.Size = u2(0, 20, 1, 0)
					ck.Position = u2(1, -24, 0, 0)
					ck.TextXAlignment = Enum.TextXAlignment.Center
					ck.TextYAlignment = Enum.TextYAlignment.Center
					ck.TextTransparency = 1
					ck.ZIndex = 52
					ck.Parent = ob

					local function refreshOpt()
						local active = isSel(opt)
						tw(ob, {BackgroundColor3=active and T.accDim or c3(16,16,26), BackgroundTransparency=active and 0 or 1}, 0.12)
						tw(ol, {TextColor3=active and T.white or T.txt}, 0.12)
						tw(ck, {TextTransparency=active and 0 or 1}, 0.12)
					end
					refreshOpt()
					optFns[opt] = refreshOpt

					cn(ob.MouseEnter, function() tw(ob, {BackgroundColor3=T.elev, BackgroundTransparency=0}, 0.08) end)
					cn(ob.MouseLeave, function()
						local active = isSel(opt)
						tw(ob, {BackgroundColor3=active and T.accDim or c3(16,16,26), BackgroundTransparency=active and 0 or 1}, 0.08)
					end)

					cn(ob.MouseButton1Click, function()
						if multi then
							if sel[opt] then sel[opt] = nil else sel[opt] = true end
							refreshOpt(); refreshSelLabel()
							local out = {}
							for k in pairs(sel) do table.insert(out, k) end
							task.spawn(pcall, cb, out)
						else
							sel = opt
							for _, fn in pairs(optFns) do fn() end
							refreshSelLabel()
							task.spawn(pcall, cb, opt)
							task.delay(0.1, closeDD)
						end
					end)
				end

				for _, o in ipairs(opts) do buildOpt(o) end

				local function openDD()
					closeAllDropdowns(closeDD)
					open = true
					local h = math.min(#opts * ITEM_H + 8, MAX_H)
					ddFrame.Visible = true
					ddFrame.Size = u2(1, 0, 0, 0)
					tw(ddFrame, {Size = u2(1, 0, 0, h)}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
					tw(wrap, {Size = u2(1, 0, 0, 38 + h)}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
					tw(arrowLbl, {TextColor3 = T.accGlow}, 0.15)
					arrowLbl.Text = "↑"
					rStroke.Color = T.acc
				end

				cn(r.InputBegan, function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
					if open then closeDD() else openDD() end
				end)

				local obj = {}
				function obj:Set(v)
					if multi then sel = {}; for _, k in ipairs(v) do sel[k] = true end else sel = v end
					for _, fn in pairs(optFns) do fn() end
					refreshSelLabel()
				end
				function obj:Refresh(newOpts)
					for _, c2 in ipairs(ddScroll:GetChildren()) do
						if c2:IsA("TextButton") then c2:Destroy() end
					end
					table.clear(optFns)
					opts = newOpts
					for _, o in ipairs(opts) do buildOpt(o) end
				end
				function obj:Get() return sel end
				return obj
			end

			function S:CreateInput(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb = cfg2.Callback or function() end
				local r = row(36)
				rowLbl(r, cfg2.Title or "Input")

				local box = Instance.new("TextBox")
				box.Size = u2(0, 150, 0, 24)
				box.Position = u2(1, -158, 0.5, -12)
				box.BackgroundColor3 = T.bgDeep
				box.TextColor3 = T.txt
				box.PlaceholderText = cfg2.Placeholder or "Type..."
				box.PlaceholderColor3 = T.muted
				box.Text = cfg2.Default or ""
				box.TextSize = 11
				box.Font = Enum.Font.Gotham
				box.ZIndex = 9
				box.ClearTextOnFocus = false
				box.BorderSizePixel = 0
				box.Parent = r
				corner(box, 5)
				local bStroke = stroke(box, T.bordFaint, 1)

				cn(box.Focused, function()
					tw(box, {BackgroundColor3=c3(18,18,30)}, 0.12)
					bStroke.Color = T.acc
				end)
				cn(box.FocusLost, function(enter)
					tw(box, {BackgroundColor3=T.bgDeep}, 0.12)
					bStroke.Color = T.bordFaint
					if enter then
						local v = cfg2.Numeric and tonumber(box.Text) or box.Text
						if v ~= nil then task.spawn(pcall, cb, v) end
					end
				end)

				local obj = {}
				function obj:Set(v) box.Text = tostring(v) end
				function obj:Get() return box.Text end
				return obj
			end

			function S:CreateKeybind(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb = cfg2.Callback or function() end
				local bound = cfg2.Default or Enum.KeyCode.Unknown
				local listening = false
				local r = row(36)
				rowLbl(r, cfg2.Title or "Keybind")

				local kbtn = Instance.new("TextButton")
				kbtn.Size = u2(0, 72, 0, 26)
				kbtn.Position = u2(1, -80, 0.5, -13)
				kbtn.BackgroundColor3 = T.bgDeep
				kbtn.Text = bound == Enum.KeyCode.Unknown and "Key" or bound.Name
				kbtn.TextColor3 = T.accGlow
				kbtn.TextSize = 11
				kbtn.Font = Enum.Font.GothamBold
				kbtn.ZIndex = 9
				kbtn.BorderSizePixel = 0
				kbtn.Parent = r
				corner(kbtn, 999)
				stroke(kbtn, T.acc, 1)

				cn(kbtn.MouseEnter, function() tw(kbtn, {BackgroundColor3=T.accDim}, 0.12) end)
				cn(kbtn.MouseLeave, function() if not listening then tw(kbtn, {BackgroundColor3=T.bgDeep}, 0.12) end end)
				cn(kbtn.MouseButton1Click, function()
					listening = true
					kbtn.Text = "..."
					kbtn.TextColor3 = T.warn
					tw(kbtn, {BackgroundColor3=T.accDim}, 0.12)
				end)
				cn(uis.InputBegan, function(i, gp)
					if gp then return end
					if listening then
						if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode ~= Enum.KeyCode.Unknown then
							listening = false
							bound = i.KeyCode
							kbtn.Text = i.KeyCode.Name
							kbtn.TextColor3 = T.accGlow
							tw(kbtn, {BackgroundColor3=T.bgDeep}, 0.12)
						end
					elseif i.KeyCode == bound then
						task.spawn(pcall, cb)
					end
				end)

				local obj = {}
				function obj:Set(k) bound = k; kbtn.Text = k.Name end
				function obj:Get() return bound end
				return obj
			end

			function S:CreateColorPicker(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb = cfg2.Callback or function() end
				local def = cfg2.Default or c3(130, 80, 255)
				local hv, sv, vv = Color3.toHSV(def)
				local cur = def
				local pOpen, dSv, dH = false, false, false

				eOrder += 1
				local wrap = Instance.new("Frame")
				wrap.Size = u2(1, 0, 0, 36)
				wrap.BackgroundTransparency = 1
				wrap.LayoutOrder = eOrder
				wrap.ZIndex = 20
				wrap.ClipsDescendants = false
				wrap.BorderSizePixel = 0
				wrap.Parent = secBody

				local r = Instance.new("Frame")
				r.Size = u2(1, 0, 0, 36)
				r.BackgroundColor3 = T.elev
				r.ZIndex = 20
				r.BorderSizePixel = 0
				r.Parent = wrap
				corner(r, 7)
				stroke(r, T.bordFaint, 1)
				cn(r.MouseEnter, function() tw(r, {BackgroundColor3=T.elevHov}, 0.12) end)
				cn(r.MouseLeave, function() tw(r, {BackgroundColor3=T.elev}, 0.12) end)

				local ntl3 = lbl(r, cfg2.Title or "Color", 12, T.txt, Enum.Font.GothamMedium)
				ntl3.AnchorPoint = v2(0, 0.5)
				ntl3.Position = u2(0, 12, 0.5, 0)
				ntl3.ZIndex = 21

				local prev2 = Instance.new("Frame")
				prev2.Size = u2(0, 50, 0, 22)
				prev2.Position = u2(1, -58, 0.5, -11)
				prev2.BackgroundColor3 = cur
				prev2.ZIndex = 21
				prev2.BorderSizePixel = 0
				prev2.Parent = r
				corner(prev2, 5)
				stroke(prev2, T.bord, 1)

				local pkFrame = Instance.new("Frame")
				pkFrame.Size = u2(1, 0, 0, 0)
				pkFrame.Position = u2(0, 0, 0, 38)
				pkFrame.BackgroundColor3 = T.elev
				pkFrame.ZIndex = 22
				pkFrame.Visible = false
				pkFrame.ClipsDescendants = true
				pkFrame.BorderSizePixel = 0
				pkFrame.Parent = wrap
				corner(pkFrame, 9)
				stroke(pkFrame, T.acc, 1)

				local svF = Instance.new("Frame")
				svF.Size = u2(1, -44, 0, 110)
				svF.Position = u2(0, 8, 0, 8)
				svF.ZIndex = 23
				svF.BorderSizePixel = 0
				svF.Parent = pkFrame
				corner(svF, 6)
				local svGrad = Instance.new("UIGradient", svF)
				svGrad.Color = ColorSequence.new{T.white, Color3.fromHSV(hv, 1, 1)}

				local svDark = Instance.new("Frame")
				svDark.Size = u2(1, 0, 1, 0)
				svDark.BackgroundColor3 = T.black
				svDark.ZIndex = 24
				svDark.BorderSizePixel = 0
				svDark.Parent = svF
				corner(svDark, 6)
				local sdg = Instance.new("UIGradient", svDark)
				sdg.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,1), NumberSequenceKeypoint.new(1,0)}
				sdg.Rotation = 90

				local svDot = Instance.new("Frame")
				svDot.Size = u2(0, 12, 0, 12)
				svDot.AnchorPoint = v2(0.5, 0.5)
				svDot.Position = u2(sv, 0, 1-vv, 0)
				svDot.BackgroundColor3 = T.white
				svDot.ZIndex = 26
				svDot.BorderSizePixel = 0
				svDot.Parent = svF
				corner(svDot, 999)
				stroke(svDot, T.white, 2)

				local hBar = Instance.new("Frame")
				hBar.Size = u2(0, 16, 0, 110)
				hBar.Position = u2(1, -28, 0, 8)
				hBar.ZIndex = 23
				hBar.BorderSizePixel = 0
				hBar.Parent = pkFrame
				corner(hBar, 5)
				local hGrad = Instance.new("UIGradient", hBar)
				hGrad.Color = ColorSequence.new{
					c3(255,0,0), c3(255,255,0), c3(0,255,0),
					c3(0,255,255), c3(0,0,255), c3(255,0,255), c3(255,0,0)
				}
				hGrad.Rotation = 90

				local hDot = Instance.new("Frame")
				hDot.Size = u2(1, 6, 0, 5)
				hDot.Position = u2(0, -3, hv, -2.5)
				hDot.BackgroundColor3 = T.white
				hDot.ZIndex = 25
				hDot.BorderSizePixel = 0
				hDot.Parent = hBar
				corner(hDot, 3)

				local hexBox = Instance.new("TextBox")
				hexBox.Size = u2(1, -16, 0, 24)
				hexBox.Position = u2(0, 8, 0, 125)
				hexBox.BackgroundColor3 = T.bgDeep
				hexBox.TextColor3 = T.txt
				hexBox.TextSize = 11
				hexBox.Font = Enum.Font.GothamMedium
				hexBox.ZIndex = 23
				hexBox.BorderSizePixel = 0
				hexBox.TextXAlignment = Enum.TextXAlignment.Center
				hexBox.Parent = pkFrame
				corner(hexBox, 5)
				stroke(hexBox, T.bordFaint, 1)

				local function updatePicker()
					cur = Color3.fromHSV(hv, sv, vv)
					prev2.BackgroundColor3 = cur
					svGrad.Color = ColorSequence.new{T.white, Color3.fromHSV(hv, 1, 1)}
					svDot.Position = u2(sv, 0, 1-vv, 0)
					hDot.Position = u2(0, -3, hv, -2.5)
					local hex = string.format("#%02X%02X%02X", math.floor(cur.R*255), math.floor(cur.G*255), math.floor(cur.B*255))
					hexBox.Text = hex
					task.spawn(pcall, cb, cur)
				end
				updatePicker()

				cn(svF.InputBegan, function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
					dSv = true
					local ap = svF.AbsolutePosition
					local as = svF.AbsoluteSize
					sv = math.clamp((i.Position.X - ap.X) / as.X, 0, 1)
					vv = 1 - math.clamp((i.Position.Y - ap.Y) / as.Y, 0, 1)
					updatePicker()
				end)
				cn(hBar.InputBegan, function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
					dH = true
					local ap = hBar.AbsolutePosition
					local as = hBar.AbsoluteSize
					hv = math.clamp((i.Position.Y - ap.Y) / as.Y, 0, 1)
					updatePicker()
				end)
				cn(uis.InputChanged, function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
					if dSv then
						local ap = svF.AbsolutePosition
						local as = svF.AbsoluteSize
						sv = math.clamp((i.Position.X - ap.X) / as.X, 0, 1)
						vv = 1 - math.clamp((i.Position.Y - ap.Y) / as.Y, 0, 1)
						updatePicker()
					elseif dH then
						local ap = hBar.AbsolutePosition
						local as = hBar.AbsoluteSize
						hv = math.clamp((i.Position.Y - ap.Y) / as.Y, 0, 1)
						updatePicker()
					end
				end)
				cn(uis.InputEnded, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then dSv = false; dH = false end
				end)
				cn(hexBox.FocusLost, function(enter)
					if enter then
						local hex = hexBox.Text:gsub("#", "")
						if #hex == 6 then
							local ok3, rc, gc, bc = pcall(function()
								return tonumber("0x"..hex:sub(1,2)), tonumber("0x"..hex:sub(3,4)), tonumber("0x"..hex:sub(5,6))
							end)
							if ok3 and rc and gc and bc then
								hv, sv, vv = Color3.toHSV(c3(rc, gc, bc))
								updatePicker()
							end
						end
					end
				end)
				cn(r.InputBegan, function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
					pOpen = not pOpen
					if pOpen then
						pkFrame.Visible = true
						pkFrame.Size = u2(1, 0, 0, 0)
						tw(pkFrame, {Size = u2(1, 0, 0, 160)}, 0.26, Enum.EasingStyle.Quart)
						wrap.Size = u2(1, 0, 0, 38 + 160)
					else
						tw(pkFrame, {Size = u2(1, 0, 0, 0)}, 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, function()
							if not pOpen and pkFrame and pkFrame.Parent then pkFrame.Visible = false end
						end)
						wrap.Size = u2(1, 0, 0, 36)
					end
				end)

				local obj = {}
				function obj:Set(c2) cur = c2; hv, sv, vv = Color3.toHSV(c2); updatePicker() end
				function obj:Get() return cur end
				return obj
			end

			function S:CreateLabel(text, color)
				eOrder += 1
				local f = Instance.new("Frame")
				f.Size = u2(1, 0, 0, 18)
				f.BackgroundTransparency = 1
				f.LayoutOrder = eOrder
				f.ZIndex = 8
				f.BorderSizePixel = 0
				f.Parent = secBody
				local l = lbl(f, text or "", 11, color or T.sub, Enum.Font.Gotham)
				l.AnchorPoint = v2(0, 0.5)
				l.Position = u2(0, 4, 0.5, 0)
				l.ZIndex = 9
				local obj = {}
				function obj:Set(t, c2) l.Text = t; if c2 then l.TextColor3 = c2 end end
				return obj
			end

			function S:CreateDivider()
				eOrder += 1
				local d = Instance.new("Frame")
				d.Size = u2(1, 0, 0, 1)
				d.BackgroundColor3 = T.bordFaint
				d.BorderSizePixel = 0
				d.LayoutOrder = eOrder
				d.ZIndex = 8
				d.Parent = secBody
			end

			return S
		end

		return Tab
	end

	local function closeAllDropdowns(except)
		-- handled per-dropdown in this rewrite
	end

	-- Window controls
	local minimized = false
	cn(minBtn.MouseButton1Click, function()
		minimized = not minimized
		tw(main, {Size = minimized and u2(0, winW, 0, 44) or u2(0, winW, 0, winH)}, 0.28, Enum.EasingStyle.Quart)
		tabBar.Visible = not minimized
	end)

	cn(closeBtn.MouseButton1Click, function()
		tw(main, {Size = u2(0, winW, 0, 0), BackgroundTransparency = 1}, 0.22, Enum.EasingStyle.Quart)
		task.delay(0.25, function()
			if gui and gui.Parent then gui:Destroy() end
		end)
	end)

	cn(uis.InputBegan, function(inp, gp)
		if gp then return end
		if inp.KeyCode == toggleKey then
			main.Visible = not main.Visible
		end
	end)

	task.defer(function()
		tw(main, {Size = u2(0, winW, 0, winH)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)

	W._gui = gui
	W._main = main

	function W:Destroy()
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		if gui and gui.Parent then gui:Destroy() end
	end

	function W:SetVisible(v)
		main.Visible = v
	end

	function W:Notify(cfg2)
		K.Notify(cfg2)
	end

	return W
end

return K
