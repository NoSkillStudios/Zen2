local attachActive,attachTarget,attachConn=false,nil,nil
local function startAttach(target,delay_)
	attachActive=true; attachTarget=target
	local ch=lp.Character or lp.CharacterAdded:Wait()
	local hr=ch:WaitForChild("HumanoidRootPart")
	if attachConn then attachConn:Disconnect() end
	attachConn=RS.Heartbeat:Connect(function()
		if not attachActive then attachConn:Disconnect(); attachConn=nil; return end
		if target.Character and target.Character:FindFirstChild("HumanoidRootPart") and hr then
			pcall(function() hr.CFrame=target.Character.HumanoidRootPart.CFrame end)
		end
	end)
	if delay_ and delay_>0 then task.delay(delay_,function() attachActive=false; notify("🔗 Attach","Auto-disabled",2) end) end
	notify("🔗 Attach","Attached to "..target.DisplayName,2)
end
