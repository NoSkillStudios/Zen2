	end

	local typeColor = ntype == "success" and T.success or ntype == "error" and T.danger or ntype == "warn" and T.warn or T.acc
	local typeIcon  = icon or (ntype == "success" and "✓" or ntype == "error" and "✕" or ntype == "warn" and "⚠" or "ℹ")

