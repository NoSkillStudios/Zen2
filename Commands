	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Size = u2(1, -20, 0, 14)
	sub.Position = u2(0, 10, 0, 68)
	sub.Text = "Enter password to continue"
	sub.TextSize = 11
	sub.Font = Enum.Font.Gotham
	sub.TextColor3 = T.sub
	sub.TextXAlignment = Enum.TextXAlignment.Center
	sub.ZIndex = 502
	sub.Parent = box

	local input = Instance.new("TextBox")
	input.Size = u2(1, -40, 0, 32)
	input.Position = u2(0, 20, 0, 92)
	input.BackgroundColor3 = T.bgDeep
	input.TextColor3 = T.txt
	input.PlaceholderText = "Password..."
	input.PlaceholderColor3 = T.muted
	input.TextSize = 12
	input.Font = Enum.Font.GothamBold
	input.TextXAlignment = Enum.TextXAlignment.Center
	input.ZIndex = 502
	input.ClearTextOnFocus = true
	input.Parent = box
	corner(input, 8)
	stroke(input, T.bordFaint, 1)

	local errorLbl = Instance.new("TextLabel")
	errorLbl.BackgroundTransparency = 1
	errorLbl.Size = u2(1, -20, 0, 14)
	errorLbl.Position = u2(0, 10, 0, 130)
	errorLbl.Text = ""
	errorLbl.TextSize = 10
	errorLbl.Font = Enum.Font.GothamBold
	errorLbl.TextColor3 = T.danger
	errorLbl.TextXAlignment = Enum.TextXAlignment.Center
	errorLbl.ZIndex = 502
	errorLbl.Parent = box

	local function tryUnlock()
		if input.Text == password then
			tw(box, {Size = u2(0, 260, 0, 0)}, 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function()
				overlay:Destroy()
			end)
			onSuccess()
		else
			errorLbl.Text = "Incorrect password"
			tw(input, {Position = u2(0, 24, 0, 92)}, 0.05, nil, nil, function()
				tw(input, {Position = u2(0, 16, 0, 92)}, 0.05, nil, nil, function()
					tw(input, {Position = u2(0, 20, 0, 92)}, 0.05)
				end)
			end)
			input.Text = ""
		end
	end

	cn(input.Focused, function()
		stroke(input, T.acc, 1)
	end)
	cn(input.FocusLost, function(entered)
		stroke(input, T.bordFaint, 1)
		if entered then tryUnlock() end
	end)

	tw(box, {Size = u2(0, 260, 0, 160)}, 0.3, Enum.EasingStyle.Back)
end

