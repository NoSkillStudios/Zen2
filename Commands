end}

CMDS.god = {desc="Toggles godmode", args="", fn=function()
	local s = getState(); s.god = not s.god
	if s.godConn then s.godConn:Disconnect(); s.godConn = nil end
	local h = getHum()
	if s.god then
		if h then h.MaxHealth = math.huge; h.Health = math.huge end
		s.godConn = RunService.Heartbeat:Connect(function()
			if not s.god then s.godConn:Disconnect(); s.godConn = nil return end
			local hh = getHum(); if hh then hh.Health = math.huge end
		end)
		notify("god","Enabled")
	else
		if h then h.MaxHealth = 100; h.Health = 100 end
		notify("god","Disabled")
	end
end}

CMDS.esp = {desc="Toggles player ESP", args="", fn=function()
	local s = getState(); s.esp = not s.esp
	if s.esp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and p.Character then
				local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
				if head then
					local bb = Instance.new("BillboardGui"); bb.Name="LavESP"; bb.Adornee=head
					bb.AlwaysOnTop=true; bb.Size=UDim2.fromOffset(100,30); bb.StudsOffset=Vector3.new(0,2.5,0)
					bb.ResetOnSpawn=false; bb.Parent=head
					local nl = Instance.new("TextLabel",bb); nl.Size=UDim2.fromScale(1,1); nl.BackgroundTransparency=1
					nl.TextColor3=Color3.fromRGB(210,185,255); nl.Font=Enum.Font.GothamBold; nl.TextSize=11
					nl.TextXAlignment=Enum.TextXAlignment.Center; nl.Text=p.Name
					local hl = Instance.new("Highlight"); hl.Name="LavHL"; hl.FillTransparency=1
					hl.OutlineColor=Color3.fromRGB(148,100,255); hl.OutlineTransparency=0
					hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent=p.Character
					table.insert(s.espObjs,bb); table.insert(s.espObjs,hl)
				end
			end
		end
		notify("esp","Enabled")
	else
		for _, v in ipairs(s.espObjs) do pcall(function() v:Destroy() end) end
		s.espObjs = {}; notify("esp","Disabled")
	end
end}

