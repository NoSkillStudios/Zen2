				f.LayoutOrder=eOrder; f.ZIndex=8; f.BorderSizePixel=0
				local l=lbl(f,text or "",11,color or T.sub,Enum.Font.Gotham)
				l.AnchorPoint=v2(0,0.5); l.Position=u2(0,4,0.5,0); l.ZIndex=9
				if desc then
					cn(f.MouseEnter,function() setTip(f,desc) end)
					cn(f.MouseLeave,function() clrTip(f) end)
				end
				local obj={}
				function obj:Set(t,c2) l.Text=t; if c2 then l.TextColor3=c2 end end
				return obj
			end

			function S:CreateDivider()
				eOrder+=1
				local d=Instance.new("Frame",secBody)
				d.Size=u2(1,0,0,1); d.BackgroundColor3=T.bordFaint
				d.BorderSizePixel=0; d.LayoutOrder=eOrder; d.ZIndex=8
			end

			return S
		end

		return Tab
	end

	local minimized = false
	cn(minBtn.MouseButton1Click,function()
		minimized=not minimized
		tw(main,{Size=minimized and u2(0,winW,0,44) or u2(0,winW,0,winH)},0.28,Enum.EasingStyle.Quart)
	end)

	cn(closeBtn.MouseButton1Click,function()
		tw(main,{Size=u2(0,winW,0,0),BackgroundTransparency=1},0.22,Enum.EasingStyle.Quart)
		task.delay(0.25,function()
			for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
			if gui and gui.Parent then gui:Destroy() end
		end)
	end)

	cn(uis.InputBegan,function(inp,gp)
		if gp then return end
		if inp.KeyCode==toggleKey then
			main.Visible = not main.Visible
		end
	end)

	cn(rs.RenderStepped,function()
		if tipTarget and tipTarget.Parent then
			local mp = uis:GetMouseLocation()
			local ap = tipTarget.AbsolutePosition
			local as = tipTarget.AbsoluteSize
			if mp.X<ap.X or mp.X>ap.X+as.X or mp.Y<ap.Y or mp.Y>ap.Y+as.Y then
				tipTarget=nil; hideTip()
			end
		end
	end)

	task.defer(function()
		tw(main,{Size=u2(0,winW,0,winH)},0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
	end)

	W._gui  = gui
	W._main = main

	function W:Destroy()
		for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		if gui and gui.Parent then gui:Destroy() end
	end

	function W:SetVisible(v)
		main.Visible = v
	end

	function W:Notify(cfg2)
		K.Notify(cfg2)
	end

	return W
end

return K
