local swimConn=nil
local function startSwim()
	if State.swimActive then return end; State.swimActive=true
	local hrp=getHRP(); if not hrp then return end
	local hum=getHum(); if hum then hum.PlatformStand=true end
	local bv=Instance.new("BodyVelocity"); bv.MaxForce=Vector3.new(1e9,1e9,1e9); bv.Velocity=Vector3.zero; bv.Parent=hrp
	local bg=Instance.new("BodyGyro"); bg.MaxTorque=Vector3.new(1e9,1e9,1e9); bg.P=1e4; bg.CFrame=hrp.CFrame; bg.Parent=hrp
	swimConn=RS.RenderStepped:Connect(function()
		if not State.swimActive then swimConn:Disconnect(); swimConn=nil; pcall(function() bv:Destroy(); bg:Destroy() end); return end
		local cam=workspace.CurrentCamera; local mv=Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then mv=mv+cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then mv=mv-cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then mv=mv-cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then mv=mv+cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then mv=mv+Vector3.new(0,0.5,0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv=mv-Vector3.new(0,0.5,0) end
		if mv.Magnitude>0 then mv=mv.Unit end
		bv.Velocity=mv*18; bg.CFrame=cam.CFrame
	end)
	notify("🏊 Swim","WASD+Space/Ctrl",2)
end
local function stopSwim()
	State.swimActive=false
	if swimConn then swimConn:Disconnect(); swimConn=nil end
	local hum=getHum(); if hum then hum.PlatformStand=false end
	notify("🏊 Swim","Disabled",1.5)
end

