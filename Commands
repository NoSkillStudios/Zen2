	local function selectTab(name, instant)
		if activeTab == name then return end
		local prev = activeTab
		activeTab = name

		for n, pg in pairs(pages) do
			local tbtn = tabBtns[n]
			if n == name then
				pg.Visible = true
				if not instant then
					pg.Position = u2(0, 0, 0.02, 0)
					tw(pg, {Position = u2(0,0,0,0)}, 0.3, Enum.EasingStyle.Quart)
				end
				if tbtn then
					tw(tbtn.btn, {BackgroundColor3 = T.accDim, BackgroundTransparency = 0}, 0.2)
					tw(tbtn.indicator, {BackgroundTransparency = 0, Size = u2(0.6, 0, 0, 2)}, 0.25, Enum.EasingStyle.Back)
					if tbtn.isImg then
						tw(tbtn.icon, {ImageColor3 = T.white}, 0.2)
					else
						tw(tbtn.icon, {TextColor3 = T.white}, 0.2)
					end
					tw(tbtn.label, {TextColor3 = T.white}, 0.2)
				end
			else
				if tbtn then
					tw(tbtn.btn, {BackgroundColor3 = T.bgDeep, BackgroundTransparency = 0}, 0.18)
					tw(tbtn.indicator, {BackgroundTransparency = 1, Size = u2(0.2, 0, 0, 2)}, 0.18)
					if tbtn.isImg then
						tw(tbtn.icon, {ImageColor3 = T.muted}, 0.18)
					else
						tw(tbtn.icon, {TextColor3 = T.muted}, 0.18)
					end
					tw(tbtn.label, {TextColor3 = T.muted}, 0.18)
				end
				if prev == n and not instant then
					tw(pg, {Position = u2(0, 0, -0.02, 0)}, 0.2, Enum.EasingStyle.Quart)
					task.delay(0.2, function()
						if activeTab ~= n and pg and pg.Parent then
							pg.Visible = false
							pg.Position = u2(0,0,0,0)
						end
					end)
				else
					pg.Visible = false
					pg.Position = u2(0,0,0,0)
				end
			end
		end
	end

