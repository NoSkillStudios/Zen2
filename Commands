end

-- ─── NOTIFICATION SYSTEM ───
local notifGui, notifContainer
local activeNotifs = {} -- bottom to top
local spamRegistry = {} -- [hash] = {count, frame, expire}
local MAX_NOTIFS = 5
local NOTIF_W  = 320
local NOTIF_H  = 56
local NOTIF_PAD = 10

local function hashNotif(title, body)
	return tostring(title) .. "::" .. tostring(body)
end

local function repositionNotifs()
	for i, nobj in ipairs(activeNotifs) do
		if nobj and nobj.frame and nobj.frame.Parent then
			local targetY = (i - 1) * (NOTIF_H + NOTIF_PAD)
			tw(nobj.frame, {
				Position = u2(1, -(NOTIF_W + 20), 1, -(targetY + NOTIF_H + 20))
			}, 0.35, Enum.EasingStyle.Quart)
		end
	end
end

local function dismissNotif(nobj)
	for i, v in ipairs(activeNotifs) do
		if v == nobj then
			table.remove(activeNotifs, i)
			break
		end
	end
	if nobj.frame and nobj.frame.Parent then
		tw(nobj.frame, {
			Position = u2(1, 40, nobj.frame.Position.Y.Scale, nobj.frame.Position.Y.Offset),
			BackgroundTransparency = 1,
			Rotation = 8,
			Size = u2(0, NOTIF_W * 0.9, 0, NOTIF_H * 0.85)
		}, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function()
			if nobj.frame and nobj.frame.Parent then nobj.frame:Destroy() end
		end)
	end
	repositionNotifs()
end

function K.Notify(cfg)
	cfg = cfg or {}
	local title    = cfg.Title    or "Notification"
	local body     = cfg.Body     or ""
	local ntype    = cfg.Type     or "info"
	local duration = cfg.Duration or 4
	local icon     = cfg.Icon     -- rbxassetid://...

	local typeColor = ntype == "success" and T.success or ntype == "error" and T.danger or ntype == "warn" and T.warn or T.info
	local hash = hashNotif(title, body)

	-- Spam counter logic
	if spamRegistry[hash] then
		local reg = spamRegistry[hash]
		if reg.frame and reg.frame.Parent then
			reg.count = reg.count + 1
			reg.expire = tick() + duration
			if reg.counterLbl then
				reg.counterLbl.Text = reg.count .. "x"
			end
			-- Small bounce on existing
			tw(reg.frame, {Size = u2(0, NOTIF_W + 10, 0, NOTIF_H)}, 0.1, Enum.EasingStyle.Back, nil, function()
				if reg.frame and reg.frame.Parent then
					tw(reg.frame, {Size = u2(0, NOTIF_W, 0, NOTIF_H)}, 0.15, Enum.EasingStyle.Quart)
				end
			end)
			return
		end
	end

	if not notifContainer then return end

	-- Remove oldest if max reached
	if #activeNotifs >= MAX_NOTIFS then
		local oldest = activeNotifs[#activeNotifs]
		if oldest then dismissNotif(oldest) end
	end

	local nframe = Instance.new("Frame")
	nframe.Size             = u2(0, NOTIF_W, 0, NOTIF_H)
	nframe.Position         = u2(1, 40, 1, -(NOTIF_H + 20)) -- start off-screen right, bottom
	nframe.BackgroundColor3 = T.bgDeep
	nframe.BorderSizePixel  = 0
	nframe.ZIndex           = 2000
	nframe.Rotation         = -6
	nframe.Parent           = notifContainer

	-- 3D perspective container
	local perspective = Instance.new("Frame")
	perspective.Size = u2(1, 0, 1, 0)
	perspective.BackgroundTransparency = 1
	perspective.BorderSizePixel = 0
	perspective.Parent = nframe

	corner(nframe, 12)
	stroke(nframe, T.bordFaint, 1)

	-- Left accent bar
	local accent = Instance.new("Frame")
	accent.Size             = u2(0, 4, 1, -16)
	accent.Position         = u2(0, 6, 0, 8)
	accent.BackgroundColor3 = typeColor
	accent.BorderSizePixel  = 0
	accent.ZIndex           = 2001
	accent.Parent = nframe
	corner(accent, 999)

	-- Icon
	local iconSize = 0
	if icon then
		iconSize = 28
		local iconFrame = Instance.new("ImageLabel")
		iconFrame.Size             = u2(0, iconSize, 0, iconSize)
		iconFrame.Position         = u2(0, 18, 0.5, -iconSize/2)
		iconFrame.BackgroundTransparency = 1
		iconFrame.Image            = icon
		iconFrame.ImageColor3      = typeColor
		iconFrame.ZIndex           = 2001
		iconFrame.Parent = nframe
	else
		iconSize = 0
	end

	-- Title
	local titleLbl = Instance.new("TextLabel")
	titleLbl.BackgroundTransparency = 1
	titleLbl.Size           = u2(1, -(58 + iconSize + (iconSize>0 and 8 or 0)), 0, 16)
	titleLbl.Position       = u2(0, 18 + (iconSize>0 and iconSize+8 or 0), body~="" and 10 or 0.5, body~="" and 0 or -8)
	titleLbl.Text           = title
	titleLbl.TextSize       = 13
	titleLbl.TextColor3     = T.txt
	titleLbl.Font           = Enum.Font.GothamBold
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.ZIndex         = 2001
	titleLbl.Parent = nframe

	-- Body
	if body ~= "" then
		local bodyLbl = Instance.new("TextLabel")
		bodyLbl.BackgroundTransparency = 1
		bodyLbl.Size           = u2(1, -(58 + iconSize + (iconSize>0 and 8 or 0)), 0, 14)
		bodyLbl.Position       = u2(0, 18 + (iconSize>0 and iconSize+8 or 0), 28, 0)
		bodyLbl.Text           = body
		bodyLbl.TextSize       = 11
		bodyLbl.TextColor3     = T.sub
		bodyLbl.Font           = Enum.Font.Gotham
		bodyLbl.TextXAlignment = Enum.TextXAlignment.Left
		bodyLbl.TextTruncate   = Enum.TextTruncate.AtEnd
		bodyLbl.ZIndex         = 2001
		bodyLbl.Parent = nframe
	end

	-- Counter label (for spam)
	local counterLbl = Instance.new("TextLabel")
	counterLbl.BackgroundTransparency = 1
	counterLbl.Size           = u2(0, 40, 0, 14)
	counterLbl.Position       = u2(1, -44, 0, 8)
	counterLbl.Text           = ""
	counterLbl.TextSize       = 10
	counterLbl.TextColor3     = T.sub
	counterLbl.Font           = Enum.Font.GothamBold
	counterLbl.TextXAlignment = Enum.TextXAlignment.Right
	counterLbl.ZIndex         = 2002
	counterLbl.Parent = nframe

	-- Close X
	local closeBtn = Instance.new("TextButton")
	closeBtn.Size             = u2(0, 20, 0, 20)
	closeBtn.Position         = u2(1, -26, 0.5, -10)
	closeBtn.BackgroundTransparency = 1
	closeBtn.Text             = "×"
	closeBtn.TextSize         = 18
	closeBtn.TextColor3       = T.muted
	closeBtn.Font             = Enum.Font.GothamBold
	closeBtn.ZIndex           = 2002
	closeBtn.Parent = nframe

	-- Progress bar
	local progress = Instance.new("Frame")
	progress.Size             = u2(1, -12, 0, 2)
	progress.Position         = u2(0, 6, 1, -5)
	progress.BackgroundColor3 = typeColor
	progress.BackgroundTransparency = 0.5
	progress.BorderSizePixel  = 0
	progress.ZIndex           = 2001
	progress.Parent = nframe
	corner(progress, 999)

	local nobj = {
		frame = nframe,
		counterLbl = counterLbl,
		count = 1,
		expire = tick() + duration,
		hash = hash
	}
	spamRegistry[hash] = nobj
	table.insert(activeNotifs, 1, nobj) -- insert at bottom

	repositionNotifs()

	-- Entrance animation (3D pop from right/bottom)
	nframe.BackgroundTransparency = 1
	tw(nframe, {
		Position = u2(1, -(NOTIF_W + 20), 1, -(NOTIF_H + 20)),
		BackgroundTransparency = 0,
		Rotation = 0,
		Size = u2(0, NOTIF_W, 0, NOTIF_H)
	}, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	-- Progress shrink
	ts:Create(progress, ti(duration, Enum.EasingStyle.Linear), {Size = u2(0, -6, 0, 2)}):Play()

	local function dismiss()
		spamRegistry[hash] = nil
		dismissNotif(nobj)
	end

	closeBtn.MouseButton1Click:Connect(dismiss)
	task.delay(duration, function()
		if nframe and nframe.Parent then dismiss() end
	end)

	cn(closeBtn.MouseEnter, function() closeBtn.TextColor3 = T.txt end)
	cn(closeBtn.MouseLeave, function() closeBtn.TextColor3 = T.muted end)
end

