local function findPlayer(q)
	if not q or q=="" then return nil end
	q=q:lower():gsub("%s","")
	if q=="me" then return lp end
	local best,bestLen=nil,math.huge
	for _,p in ipairs(Players:GetPlayers()) do
		local n=p.Name:lower(); local dn=p.DisplayName:lower()
		if n==q or dn==q then return p end
		if n:sub(1,#q)==q and #n<bestLen then best=p; bestLen=#n end
		if dn:sub(1,#q)==q and #dn<bestLen then best=p; bestLen=#dn end
	end
	return best
end

local function findPlayers(q)
	q=(q or ""):lower():gsub("%s","")
	if q=="all" then return Players:GetPlayers() end
	if q=="others" then local t={}; for _,p in ipairs(Players:GetPlayers()) do if p~=lp then t[#t+1]=p end end; return t end
	if q=="me" then return {lp} end
	local p=findPlayer(q); return p and {p} or {}
end

