-- Export
getgenv()._lav_cmds = CMDS
getgenv()._lav_run = function(input)
    input = input:lower()
    local parts = {}
    for w in input:gmatch("%S+") do table.insert(parts, w) end
    if #parts == 0 then return end
    
    local cmdName = table.remove(parts, 1)
    local cmd = CMDS[cmdName]
    
    if cmd then
        task.spawn(cmd.fn, parts)
    else
        notify("Error", "Unknown: " .. cmdName, 3, "error")
    end
end

