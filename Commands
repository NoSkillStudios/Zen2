			function S:CreateSlider(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb      = cfg2.Callback or function() end
				local mn      = cfg2.Min     or 0
				local mx      = cfg2.Max     or 100
				local suf     = cfg2.Suffix  or ""
				local val     = math.clamp(cfg2.Default or mn, mn, mx)
				local sliding = false
				local desc    = cfg2.Description
				local r       = row(52)
				r.ClipsDescendants = false

				local ntl = lbl(r, cfg2.Title or "Slider", 12, T.txt, Enum.Font.GothamMedium)
				ntl.Position = u2(0,12,0,8)
				ntl.ZIndex   = 9

				if desc then
					cn(r.MouseEnter, function() setTipTarget(r,desc) end)
					cn(r.MouseLeave, function() clearTipTarget(r) end)
				end

				local valPill = Instance.new("Frame", r)
				valPill.Size             = u2(0,76,0,20)
				valPill.Position         = u2(1,-84,0,7)
				valPill.BackgroundColor3 = T.acc
				valPill.ZIndex           = 9
				valPill.BorderSizePixel  = 0
				corner(valPill, 999)
				Instance.new("UIGradient", valPill).Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.acc),ColorSequenceKeypoint.new(1,T.accGlow)}

				local valTxt = Instance.new("TextLabel", valPill)
				valTxt.BackgroundTransparency = 1
				valTxt.Text       = tostring(val)..suf
				valTxt.TextSize   = 10
				valTxt.TextColor3 = T.white
				valTxt.Font       = Enum.Font.GothamBold
				valTxt.Size       = u2(1,0,1,0)
				valTxt.TextXAlignment = Enum.TextXAlignment.Center
				valTxt.TextYAlignment = Enum.TextYAlignment.Center
				valTxt.ZIndex     = 10

				local numBox = Instance.new("TextBox", valPill)
				numBox.Size             = u2(1,0,1,0)
				numBox.BackgroundTransparency = 1
				numBox.TextColor3       = T.white
				numBox.Text             = ""
				numBox.TextSize         = 10
				numBox.Font             = Enum.Font.GothamBold
				numBox.ZIndex           = 11
				numBox.BorderSizePixel  = 0
				numBox.TextXAlignment   = Enum.TextXAlignment.Center
				numBox.ClearTextOnFocus = true
				numBox.Visible          = false

				local trackBg = Instance.new("Frame", r)
				trackBg.Size             = u2(1,-22,0,5)
				trackBg.Position         = u2(0,11,0,36)
				trackBg.BackgroundColor3 = T.bgDeep
				trackBg.ZIndex           = 9
				trackBg.BorderSizePixel  = 0
				corner(trackBg, 999)

				local fill = Instance.new("Frame", trackBg)
				fill.Size             = u2((val-mn)/(mx-mn),0,1,0)
				fill.BackgroundColor3 = T.acc
				fill.ZIndex           = 10
				fill.BorderSizePixel  = 0
				corner(fill, 999)
				Instance.new("UIGradient", fill).Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.acc),ColorSequenceKeypoint.new(1,T.accGlow)}

				local dot = Instance.new("Frame", trackBg)
				dot.Size             = u2(0,13,0,13)
				dot.AnchorPoint      = v2(0.5,0.5)
				dot.Position         = u2((val-mn)/(mx-mn),0,0.5,0)
				dot.BackgroundColor3 = T.white
				dot.ZIndex           = 11
				dot.BorderSizePixel  = 0
				corner(dot, 999)
				local dotStroke2 = stroke(dot, T.acc, 0)
				dotStroke2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

				local function updateDisplay(v2val, instant)
					local pct = (v2val-mn)/(mx-mn)
					if instant then
						fill.Size    = u2(pct,0,1,0)
						dot.Position = u2(pct,0,0.5,0)
					else
						tw(fill,{Size=u2(pct,0,1,0)},0.16,Enum.EasingStyle.Quart)
						tw(dot,{Position=u2(pct,0,0.5,0)},0.16,Enum.EasingStyle.Quart)
					end
					valTxt.Text = tostring(v2val)..suf
				end

				local function setVal(nv, silent, instant)
					local prev = val
					val = math.clamp(math.round(nv), mn, mx)
					updateDisplay(val, instant)
					if not silent and val~=prev then task.spawn(pcall,cb,val) end
				end

				local function mouseSetVal(inp, instant)
					if not trackBg or not trackBg.Parent then return end
					local ax = trackBg.AbsolutePosition.X
					local aw = trackBg.AbsoluteSize.X
					if aw==0 then return end
					local pct = math.clamp((inp.Position.X-ax)/aw,0,1)
					local nv  = math.round(mn+pct*(mx-mn))
					if nv==val then return end
					val = nv; updateDisplay(val,instant)
					task.spawn(pcall,cb,val)
				end

				cn(trackBg.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					sliding=true
					tw(dot,{Size=u2(0,15,0,15)},0.14,Enum.EasingStyle.Back)
					dotStroke2.Thickness=2
					mouseSetVal(i,false)
				end)
				cn(dot.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					sliding=true
					tw(dot,{Size=u2(0,15,0,15)},0.14,Enum.EasingStyle.Back)
					dotStroke2.Thickness=2
				end)
				cn(uis.InputChanged,function(i)
					if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then mouseSetVal(i,true) end
				end)
				cn(uis.InputEnded,function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 and sliding then
						sliding=false
						tw(dot,{Size=u2(0,13,0,13)},0.12)
						dotStroke2.Thickness=0
					end
				end)

				cn(valPill.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					valTxt.Visible=false; numBox.Visible=true; numBox:CaptureFocus()
				end)
				cn(numBox.FocusLost,function(enter)
					numBox.Visible=false; valTxt.Visible=true
					if enter then
						local n2 = tonumber(numBox.Text)
						if n2 then setVal(n2,false,false) end
					end
				end)

				local obj = {}
				function obj:Set(v) setVal(v,false,false) end
				function obj:Get() return val end
				return obj
			end

