local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting         = game:GetService("Lighting")
local TeleportService  = game:GetService("TeleportService")
local Stats            = game:GetService("Stats")
local lp               = Players.LocalPlayer
local cam              = workspace.CurrentCamera

local function getState() return getgenv()._lav_state end
local function notify(t, b, d) if getgenv()._lav_notify then getgenv()._lav_notify(t, b, d) end end
local function getChar() return lp.Character end
local function getHRP() local c = getChar(); return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = getChar(); return c and c:FindFirstChild("Humanoid") end
local function resolve(arg)
	if not arg or arg == "" then return nil end
	local a = arg:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #a) == a then return p end
	end
end

local CMDS = {}

CMDS.speed = {desc="Sets WalkSpeed", args="<value> [player]", fn=function(args)
	local v = tonumber(args[1]); if not v then notify("speed","Usage: speed <value> [player]") return end
	local tgt = (args[2] and resolve(args[2])) or lp; if not tgt then notify("speed","Player not found") return end
	local h = tgt.Character and tgt.Character:FindFirstChild("Humanoid")
	if h then h.WalkSpeed = v; notify("speed", tgt.Name.." → "..v) end
end}

CMDS.jump = {desc="Sets JumpPower", args="<value> [player]", fn=function(args)
	local v = tonumber(args[1]); if not v then notify("jump","Usage: jump <value> [player]") return end
	local tgt = (args[2] and resolve(args[2])) or lp; if not tgt then notify("jump","Player not found") return end
	local h = tgt.Character and tgt.Character:FindFirstChild("Humanoid")
	if h then h.JumpPower = v; notify("jump", tgt.Name.." → "..v) end
end}

CMDS.fly = {desc="Toggles fly mode", args="", fn=function()
	local s = getState(); s.fly = not s.fly
	if s.fly then
		local hum, hrp = getHum(), getHRP()
		if not hum or not hrp then s.fly = false return end
		hum.PlatformStand = true
		if s.flyConn then s.flyConn:Disconnect() end
		s.flyConn = RunService.RenderStepped:Connect(function()
			if not s.fly then
				s.flyConn:Disconnect(); s.flyConn = nil
				local h2 = getHum(); if h2 then h2.PlatformStand = false end
				local r2 = getHRP(); if r2 then r2.AssemblyLinearVelocity = Vector3.zero end
				return
			end
			local r = getHRP(); if not r then return end
			local dir = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
			r.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * (s.flySpeed or 60) or Vector3.zero
			r.CFrame = CFrame.new(r.Position, r.Position + cam.CFrame.LookVector)
		end)
		notify("fly","Enabled")
	else
		local s2 = getState()
		if s2.flyConn then s2.flyConn:Disconnect(); s2.flyConn = nil end
		local h = getHum(); if h then h.PlatformStand = false end
		local r = getHRP(); if r then r.AssemblyLinearVelocity = Vector3.zero end
		notify("fly","Disabled")
	end
end}

CMDS.noclip = {desc="Toggles noclip", args="", fn=function()
	local s = getState(); s.noclip = not s.noclip
	if s.noclip then
		if s.noclipConn then s.noclipConn:Disconnect() end
		s.noclipConn = RunService.Stepped:Connect(function()
			if not s.noclip then
				s.noclipConn:Disconnect(); s.noclipConn = nil
				local c = getChar(); if c then for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end end
				return
			end
			local c = getChar(); if not c then return end
			for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
		end)
		notify("noclip","Enabled")
	else
		if s.noclipConn then s.noclipConn:Disconnect(); s.noclipConn = nil end
		local c = getChar(); if c then for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end end
		notify("noclip","Disabled")
	end
end}

CMDS.invisible = {desc="Toggles local invisibility", args="", fn=function()
	local s = getState(); s.invisible = not s.invisible
	local c = getChar(); if not c then return end
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") then p.LocalTransparencyModifier = s.invisible and 1 or 0 end
	end
	notify("invisible", s.invisible and "Enabled" or "Disabled")
end}

