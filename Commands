						sliding = false
						tw(dot, {Size = u2(0, 13, 0, 13)}, 0.12)
						dotStroke.Thickness = 0
					end
				end)

				local obj = {}
				function obj:Set(v) setVal(v, false) end
				function obj:Get() return val end
				return obj
			end

