--   ESP
-- ════════════════════════════════════════════════════════════════════════════
local function clearEsp()
    for _, t in pairs(espObjects) do
        for _, obj in pairs(t) do pcall(function() obj:Remove() end) end
    end
    espObjects = {}
    for _, obj in pairs(tracerObjs) do pcall(function() obj:Remove() end) end
    tracerObjs = {}
end

local function makeEspForPlayer(p, color)
    color = color or State.espColor
    if not p.Character then return end
    local hrp   = p.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local myHRP = getHRP(); if not myHRP then return end
    local cam   = workspace.CurrentCamera
    local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
    if not onScreen then return end
    local name         = Drawing.new("Text")
    name.Text          = p.DisplayName .. " [" .. math.floor((hrp.Position - myHRP.Position).Magnitude) .. "]"
    name.Size          = 13
    name.Color         = color
    name.Outline       = true
    name.Position      = Vector2.new(pos.X, pos.Y - 14)
    name.Visible       = true
    espObjects[p]      = espObjects[p] or {}
    table.insert(espObjects[p], name)
end

local espConn = nil

local function startEsp(targets, color, dur)
    if espConn then espConn:Disconnect(); espConn = nil end
    clearEsp()
    State.espActive = true
    State.espColor  = color or Color3.fromRGB(255, 50, 50)
    espConn         = RunService.RenderStepped:Connect(function()
        if not State.espActive then espConn:Disconnect(); espConn = nil; return end
        for _, obj in pairs(espObjects) do
            for _, d in pairs(obj) do pcall(function() d:Remove() end) end
        end
        espObjects = {}
        for _, p in ipairs(Players:GetPlayers()) do
            local included = false
            for _, t in ipairs(targets) do if t == p then included = true; break end end
            if included and p.Character and getHRP() then makeEspForPlayer(p, State.espColor) end
        end
    end)
    notify("👁️ ESP", "Enabled for " .. #targets .. " player(s)", 2)
end

local function stopEsp()
    State.espActive = false
    if espConn then espConn:Disconnect(); espConn = nil end
    clearEsp()
    notify("👁️ ESP", "Disabled", 1.5)
end

-- ════════════════════════════════════════════════════════════════════════════
--   TRACERS
-- ════════════════════════════════════════════════════════════════════════════
local tracerConn = nil

local function startTracers(targets, color)
    if tracerConn then tracerConn:Disconnect(); tracerConn = nil end
    for _, o in pairs(tracerObjs) do pcall(function() o:Remove() end) end
    tracerObjs           = {}
    State.tracersActive  = true
    local lines          = {}
    for _, p in ipairs(targets) do
        local l      = Drawing.new("Line")
        l.Thickness  = 1
        l.Color      = color or Color3.fromRGB(255, 50, 50)
        l.Visible    = true
        lines[p]     = l
        table.insert(tracerObjs, l)
    end
    tracerConn = RunService.RenderStepped:Connect(function()
        if not State.tracersActive then
            tracerConn:Disconnect(); tracerConn = nil
            for _, l in pairs(lines) do pcall(function() l:Remove() end) end
            return
        end
        local cam = workspace.CurrentCamera
        local vp  = cam.ViewportSize
        for _, p in ipairs(targets) do
            local l = lines[p]; if not l then continue end
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and getHRP() then
                local sp, on = cam:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                if on then
                    l.From    = Vector2.new(vp.X / 2, vp.Y)
                    l.To      = Vector2.new(sp.X, sp.Y)
                    l.Visible = true
                else
                    l.Visible = false
                end
            else
                l.Visible = false
            end
        end
    end)
    notify("📐 Tracers", "Enabled for " .. #targets .. " player(s)", 2)
end

local function stopTracers()
    State.tracersActive = false
    if tracerConn then tracerConn:Disconnect(); tracerConn = nil end
    for _, o in pairs(tracerObjs) do pcall(function() o:Remove() end) end
    tracerObjs = {}
    notify("📐 Tracers", "Disabled", 1.5)
end

-- ════════════════════════════════════════════════════════════════════════════
--   HITBOX
-- ════════════════════════════════════════════════════════════════════════════
local function applyHitbox(targets, size, transp)
    for _, old in ipairs(hitboxParts) do pcall(function() old:Destroy() end) end
    hitboxParts     = {}
    size            = size or State.hitboxSize
    transp          = transp or State.hitboxTransp
    State.hitboxSize  = size
    State.hitboxTransp = transp
    for _, p in ipairs(targets) do
        if p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local hb          = Instance.new("Part")
                hb.Name           = "NihonHitbox"
                hb.Size           = Vector3.new(size, size, size)
                hb.Transparency   = transp
                hb.Anchored       = false
                hb.CanCollide     = false
                hb.BrickColor     = BrickColor.new("Bright red")
                hb.Parent         = p.Character
                local weld        = Instance.new("WeldConstraint")
                weld.Part0        = hrp
                weld.Part1        = hb
                weld.Parent       = hb
                table.insert(hitboxParts, hb)
            end
        end
    end
    notify("📦 Hitbox", "Applied to " .. #targets .. " player(s) Size:" .. size, 2)
end

local function clearHitboxes()
    for _, p in ipairs(hitboxParts) do pcall(function() p:Destroy() end) end
    hitboxParts = {}
    notify("📦 Hitbox", "Cleared", 1.5)
end

