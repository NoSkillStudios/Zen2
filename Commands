-- ESP SYSTEM
local function clearESP()
    for _, v in ipairs(state.espObjs) do pcall(function() v:Destroy() end) end
    state.espObjs = {}
    state.espTargets = {}
end

local function applyESP(target)
    if target == lp or not target.Character then return end
    local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
    if not head then return end
    
    -- Check existing
    for _, obj in ipairs(state.espObjs) do
        if obj.Adornee and obj.Adornee:IsDescendantOf(target.Character) then return end
    end
    
    local bb = Instance.new("BillboardGui")
    bb.Name = "LavESP"
    bb.Adornee = head
    bb.AlwaysOnTop = true
    bb.Size = UDim2.fromOffset(100, 30)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.ResetOnSpawn = false
    bb.Parent = head
    
    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = C.accentHi
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.Text = target.Name
    
    local hl = Instance.new("Highlight", target.Character)
    hl.Name = "LavHL"
    hl.FillTransparency = 1
    hl.OutlineColor = C.accent
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    table.insert(state.espObjs, bb)
    table.insert(state.espObjs, hl)
    table.insert(state.espTargets, target)
end

register("esp", {"wh", "wallhack"}, "ESP toggle/target", "[all/others/me/player]", function(args)
    if not args[1] then
        state.esp = not state.esp
        if state.esp then
            for _, p in ipairs(Players:GetPlayers()) do if p ~= lp then applyESP(p) end end
            notify("ESP", "All players", 3, "success")
        else
            clearESP()
            notify("ESP", "Cleared", 3, "warning")
        end
    else
        local t = resolvePlayer(args[1])
        if t == "all" then
            for _, p in ipairs(Players:GetPlayers()) do if p ~= lp then applyESP(p) end end
            notify("ESP", "All", 3, "success")
        elseif t == "others" then
            for _, p in ipairs(Players:GetPlayers()) do if p ~= lp then applyESP(p) end end
            notify("ESP", "Others", 3, "success")
        elseif t and typeof(t) == "Instance" then
            applyESP(t)
            notify("ESP", t.Name, 3, "success")
        end
    end
end)

register("unesp", {"noesp"}, "Remove ESP", "[all/player]", function(args)
    if not args[1] or args[1] == "all" then
        clearESP()
        notify("ESP", "Cleared all", 3, "warning")
    else
        local t = resolvePlayer(args[1])
        if t and typeof(t) == "Instance" then
            for i = #state.espObjs, 1, -1 do
                local obj = state.espObjs[i]
                if obj.Adornee and obj.Adornee:IsDescendantOf(t.Character) then
                    pcall(function() obj:Destroy() end)
                    table.remove(state.espObjs, i)
                end
            end
            notify("ESP", "Removed " .. t.Name, 3, "warning")
        end
    end
end)

