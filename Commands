local BASE = "https://raw.githubusercontent.com/NoSkillStudios/Zen2/main"
getgenv()._lav_key = "LavenderAdmin_Secure_2025"

local sg = game:GetService("StarterGui")

local function fetch(path)
	local ok, res = pcall(function() return game:HttpGet(BASE .. "/" .. path) end)
	if not ok or not res or #res < 10 or res:find("^<!") or res:find("^404") then return nil end
	return res
end

local function notify(t, b)
	pcall(function() sg:SetCore("SendNotification", {Title=t, Text=b, Duration=6}) end)
end

local cmdSrc = fetch("Commands")
if not cmdSrc then notify("Lavender", "Failed to fetch Commands.") return end

local cmdFn, cmdErr = loadstring(cmdSrc)
if not cmdFn then notify("Lavender — Parse Error", tostring(cmdErr)) return end
local ok1, e1 = pcall(cmdFn)
if not ok1 then notify("Lavender — Commands Error", tostring(e1)) return end

local src = fetch("Script")
if not src then notify("Lavender", "Failed to fetch Script.") return end

local fn, err = loadstring(src)
if not fn then notify("Lavender — Parse Error", tostring(err)) return end
local ok2, e2 = pcall(fn)
if not ok2 then notify("Lavender — Runtime Error", tostring(e2)) return end
