	elseif cmd=="showgui" then
		local pgui2=lp:WaitForChild("PlayerGui")
		for _,g in ipairs(pgui2:GetChildren()) do if g:IsA("ScreenGui") then g.Enabled=true end end
		notify("🖥️ ShowGUI","All GUIs restored",1.5)
	elseif cmd=="enable" then
		local what=(args[1] or ""):lower()
		if what=="shiftlock" then enableShiftlock()
		elseif what=="resetting" then enableResetting()
		elseif what=="inventory" then enableInventory()
		else notify("⚙️ Enable","Options: shiftlock/resetting/inventory",2) end
	elseif cmd=="prefix" then
		if #args==0 then argPopupFn("prefix",ARG_POPUP_SCHEMAS.prefix,function(v) State.prefix=v.value; notify("⚙️ Prefix","→ "..v.value,1.5) end); return end
		State.prefix=args[1]; notify("⚙️ Prefix","→ "..(args[1]),1.5)
	end
end

