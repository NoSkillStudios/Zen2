-- FLY
local flyConn,flyBV,flyBG=nil,nil,nil
local function startFly(speed)
	if State.flyActive then return end
	speed=speed or State.flySpeed; State.flySpeed=speed; State.flyActive=true
	local hrp=getHRP(); if not hrp then return end
	local hum=getHum(); if hum then hum.PlatformStand=true end
	flyBV=Instance.new("BodyVelocity"); flyBV.MaxForce=Vector3.new(1e9,1e9,1e9); flyBV.Velocity=Vector3.zero; flyBV.Parent=hrp
	flyBG=Instance.new("BodyGyro"); flyBG.MaxTorque=Vector3.new(1e9,1e9,1e9); flyBG.P=1e4; flyBG.CFrame=hrp.CFrame; flyBG.Parent=hrp
	flyConn=RS.RenderStepped:Connect(function()
		if not State.flyActive then flyConn:Disconnect(); flyConn=nil; return end
		local cam=workspace.CurrentCamera; local mv=Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then mv=mv+cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then mv=mv-cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then mv=mv-cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then mv=mv+cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then mv=mv+Vector3.new(0,1,0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.C) then mv=mv-Vector3.new(0,1,0) end
		if mv.Magnitude>0 then mv=mv.Unit end
		if flyBV and flyBV.Parent then flyBV.Velocity=mv*State.flySpeed end
		if flyBG and flyBG.Parent then flyBG.CFrame=cam.CFrame end
	end)
	notify("🪁 Fly","Enabled  Speed:"..speed,2)
end
local function stopFly()
	State.flyActive=false
	if flyConn then flyConn:Disconnect(); flyConn=nil end
	pcall(function() if flyBV then flyBV:Destroy() end end)
	pcall(function() if flyBG then flyBG:Destroy() end end)
	flyBV=nil; flyBG=nil
	local hum=getHum(); if hum then hum.PlatformStand=false end
	notify("🪁 Fly","Disabled",1.5)
end

-- NOCLIP
local noclipConn=nil
local function startNoclip()
	if State.noclipActive then return end; State.noclipActive=true
	noclipConn=RS.Stepped:Connect(function()
		if not State.noclipActive then noclipConn:Disconnect(); noclipConn=nil; return end
		local char=getChar(); if not char then return end
		for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide=false end end
	end)
	notify("👻 Noclip","Enabled",2)
end
local function stopNoclip()
	State.noclipActive=false
	if noclipConn then noclipConn:Disconnect(); noclipConn=nil end
	local char=getChar()
	if char then for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=true end end end
	notify("👻 Noclip","Disabled",1.5)
end

-- NOCLIPFLY
local ncfConn,ncfBV=nil,nil
local function startNoclipFly(speed)
	if State.noclipFlyActive then return end
	speed=speed or State.noclipFlySpeed; State.noclipFlySpeed=speed; State.noclipFlyActive=true
	local hrp=getHRP(); if not hrp then return end
	local hum=getHum(); if hum then hum.PlatformStand=true end
	ncfBV=Instance.new("BodyVelocity"); ncfBV.MaxForce=Vector3.new(1e9,1e9,1e9); ncfBV.Velocity=Vector3.zero; ncfBV.Parent=hrp
	local bg2=Instance.new("BodyGyro"); bg2.MaxTorque=Vector3.new(1e9,1e9,1e9); bg2.P=1e4; bg2.CFrame=hrp.CFrame; bg2.Parent=hrp
	local char=getChar()
	ncfConn=RS.Stepped:Connect(function()
		if not State.noclipFlyActive then ncfConn:Disconnect(); ncfConn=nil; return end
		if char and char.Parent then for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end end
		local cam=workspace.CurrentCamera; local mv=Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then mv=mv+cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then mv=mv-cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then mv=mv-cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then mv=mv+cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then mv=mv+Vector3.new(0,1,0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv=mv-Vector3.new(0,1,0) end
		if mv.Magnitude>0 then mv=mv.Unit end
		if ncfBV and ncfBV.Parent then ncfBV.Velocity=mv*State.noclipFlySpeed end
		if bg2 and bg2.Parent then bg2.CFrame=workspace.CurrentCamera.CFrame end
	end)
	notify("👻 NoclipFly","Enabled  Speed:"..speed,2)
end
local function stopNoclipFly()
	State.noclipFlyActive=false
	if ncfConn then ncfConn:Disconnect(); ncfConn=nil end
	pcall(function() if ncfBV then ncfBV:Destroy() end end); ncfBV=nil
	local hum=getHum(); if hum then hum.PlatformStand=false end
	local char=getChar()
	if char then for _,p in ipairs(char:GetDescendants()) do pcall(function() p.CanCollide=true end) end end
	notify("👻 NoclipFly","Disabled",1.5)
end

-- AIRWALK
local awConn=nil
local function startAirwalk()
	if State.airwalkActive then return end; State.airwalkActive=true
	local hrp=getHRP(); if not hrp then return end
	local bv=Instance.new("BodyVelocity"); bv.MaxForce=Vector3.new(1e9,0,1e9); bv.Velocity=Vector3.zero; bv.Parent=hrp
	awConn=RS.Heartbeat:Connect(function()
		if not State.airwalkActive then awConn:Disconnect(); awConn=nil; pcall(function() bv:Destroy() end); return end
		local h=getHRP(); if not h then return end
		local hum=getHum(); if not hum then return end
		local mv=hum.MoveDirection
		bv.Velocity=mv.Magnitude>0 and Vector3.new(mv.X,0,mv.Z)*(hum.WalkSpeed or 16) or Vector3.zero
		if h.Position.Y<3 then pcall(function() h.CFrame=h.CFrame+Vector3.new(0,5,0) end) end
	end)
	notify("🌊 Airwalk","Walking on air",2)
end
local function stopAirwalk()
	State.airwalkActive=false
	if awConn then awConn:Disconnect(); awConn=nil end
	notify("🌊 Airwalk","Disabled",1.5)
end

