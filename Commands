local conns = {}

local function cn(sig, fn)
	local c = sig:Connect(fn)
	table.insert(conns, c)
	return c
end

local function tw(obj, props, dur, sty, dir, cb)
	if not obj or not obj.Parent then return nil end
	local t = ts:Create(obj, ti(dur or 0.25, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
	if cb then t.Completed:Once(cb) end
	t:Play()
	return t
end

local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = ud(0, r or 8)
	c.Parent = p
	return c
end

local function stroke(p, col, th)
	local s = Instance.new("UIStroke")
	s.Color = col or T.bord
	s.Thickness = th or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
	return s
end

local function pad(p, t, b, l, r)
	local d = Instance.new("UIPadding")
	d.PaddingTop    = ud(0, t or 8)
	d.PaddingBottom = ud(0, b or 8)
	d.PaddingLeft   = ud(0, l or 8)
	d.PaddingRight  = ud(0, r or 8)
	d.Parent = p
end

local function list(p, dir, sp)
	local l = Instance.new("UIListLayout")
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder     = Enum.SortOrder.LayoutOrder
	l.Padding       = ud(0, sp or 6)
	l.Parent = p
	return l
end

local function lbl(p, txt, sz, col, font)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text           = txt or ""
	l.TextSize       = sz  or 13
	l.TextColor3     = col or T.txt
	l.Font           = font or Enum.Font.GothamMedium
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.AutomaticSize  = Enum.AutomaticSize.XY
	l.BorderSizePixel= 0
	l.Parent = p
	return l
end

local function scroll(p)
	local sf = Instance.new("ScrollingFrame")
	sf.Size                      = u2(1,0,1,0)
	sf.BackgroundTransparency    = 1
	sf.BorderSizePixel           = 0
	sf.ScrollBarThickness        = 3
