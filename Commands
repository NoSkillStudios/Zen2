				prev2.Size=u2(0,50,0,22); prev2.Position=u2(1,-58,0.5,-11)
				prev2.BackgroundColor3=cur; prev2.ZIndex=21; prev2.BorderSizePixel=0
				corner(prev2,5); stroke(prev2,T.bord,1)

				local hexTiny=Instance.new("TextLabel",r)
				hexTiny.BackgroundTransparency=1; hexTiny.TextSize=9; hexTiny.TextColor3=T.sub
				hexTiny.Font=Enum.Font.GothamMedium; hexTiny.Position=u2(1,-118,0.5,-5)
				hexTiny.Size=u2(0,56,0,10); hexTiny.TextXAlignment=Enum.TextXAlignment.Center; hexTiny.ZIndex=21

