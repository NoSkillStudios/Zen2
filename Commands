--   PLAYER FINDER
-- ════════════════════════════════════════════════════════════════════════════
local function findPlayer(query)
    if not query or query == "" then return nil end
    query = query:lower():gsub("%s", "")
    if query == "me" then return lp end
    local best, bestLen = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        local n  = p.Name:lower()
        local dn = p.DisplayName:lower()
        if n == query or dn == query then return p end
        if n:sub(1, #query) == query and #n < bestLen then best = p; bestLen = #n end
        if dn:sub(1, #query) == query and #dn < bestLen then best = p; bestLen = #dn end
    end
    return best
end

local function findPlayers(query)
    query = (query or ""):lower():gsub("%s", "")
    if query == "all" then return Players:GetPlayers() end
    if query == "others" then
        local t = {}
        for _, p in ipairs(Players:GetPlayers()) do if p ~= lp then t[#t + 1] = p end end
        return t
    end
    if query == "me" then return { lp } end
    local p = findPlayer(query)
    return p and { p } or {}
end

