	local p = r.Position; notify("pos", math.floor(p.X)..","..math.floor(p.Y)..","..math.floor(p.Z))
end}

CMDS.rejoin = {desc="Rejoins the current game", args="", fn=function()
	TeleportService:Teleport(game.PlaceId, lp)
end}

CMDS.spectate = {desc="Spectates a player", args="[player]", fn=function(args)
	local s = getState()
	if s.specConn then s.specConn:Disconnect(); s.specConn = nil end
	s.spectate = false
	if not args[1] or args[1]=="" then
		cam.CameraType = Enum.CameraType.Custom
		local h = getHum(); if h then cam.CameraSubject = h end
		notify("spectate","Stopped"); return
	end
	local tgt = resolve(args[1]); if not tgt then notify("spectate","Player not found") return end
	s.spectate = true
	s.specConn = RunService.RenderStepped:Connect(function()
		if not s.spectate then s.specConn:Disconnect(); s.specConn = nil return end
		if tgt.Character then
			local th = tgt.Character:FindFirstChild("Humanoid")
			if th then cam.CameraType = Enum.CameraType.Custom; cam.CameraSubject = th end
		end
	end)
	notify("spectate","Watching "..tgt.Name)
end}

getgenv()._lav_cmds = CMDS
