--   AIMBOT
-- ════════════════════════════════════════════════════════════════════════════
local aimbotConn = nil

local function startAimbot(targets)
    if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end
    State.aimbotActive = true
    aimbotConn         = RunService.RenderStepped:Connect(function()
        if not State.aimbotActive then aimbotConn:Disconnect(); aimbotConn = nil; return end
        local cam      = workspace.CurrentCamera
        local bestDist = math.huge
        local bestPos  = nil
        for _, p in ipairs(targets) do
            if p.Character and p ~= lp then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local sp, on = cam:WorldToViewportPoint(head.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - cam.ViewportSize / 2).Magnitude
                        if d < bestDist then bestDist = d; bestPos = head.Position end
                    end
                end
            end
        end
        if bestPos then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, bestPos) end
    end)
    notify("🎯 Aimbot", "Enabled — noaimbot to disable", 2)
end

local function stopAimbot()
    State.aimbotActive = false
    if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end
    notify("🎯 Aimbot", "Disabled", 1.5)
end

