	if r and tr then tr.CFrame = r.CFrame + Vector3.new(3,0,0); notify("bring", tgt.Name.." brought") end
end}

CMDS.fling = {desc="Flings yourself into a player", args="<player>", fn=function(args)
	local tgt = resolve(args[1]); if not tgt then notify("fling","Player not found") return end
	local r = getHRP(); local tr = tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart")
	if r and tr then
		r.CFrame = tr.CFrame
		r.AssemblyLinearVelocity = Vector3.new(math.random(-200,200), math.random(400,800), math.random(-200,200))
		notify("fling", tgt.Name.." flung")
	end
end}

