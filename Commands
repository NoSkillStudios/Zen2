				hBar.ZIndex=23; hBar.BorderSizePixel=0; corner(hBar,5)
				local hGrad=Instance.new("UIGradient",hBar)
				hGrad.Color=ColorSequence.new{
					ColorSequenceKeypoint.new(0,c3(255,0,0)),ColorSequenceKeypoint.new(0.166,c3(255,255,0)),
					ColorSequenceKeypoint.new(0.333,c3(0,255,0)),ColorSequenceKeypoint.new(0.5,c3(0,255,255)),
					ColorSequenceKeypoint.new(0.666,c3(0,0,255)),ColorSequenceKeypoint.new(0.833,c3(255,0,255)),
					ColorSequenceKeypoint.new(1,c3(255,0,0)),
				}; hGrad.Rotation=90

				local hDot=Instance.new("Frame",hBar)
				hDot.Size=u2(1,6,0,5); hDot.Position=u2(0,-3,hv,-2.5)
				hDot.BackgroundColor3=T.white; hDot.ZIndex=25; hDot.BorderSizePixel=0; corner(hDot,3)

				local hexBox=Instance.new("TextBox",pkFrame)
				hexBox.Size=u2(1,-16,0,24); hexBox.Position=u2(0,8,0,125)
				hexBox.BackgroundColor3=T.bgDeep; hexBox.TextColor3=T.txt
				hexBox.TextSize=11; hexBox.Font=Enum.Font.GothamMedium
				hexBox.ZIndex=23; hexBox.BorderSizePixel=0; hexBox.TextXAlignment=Enum.TextXAlignment.Center
				corner(hexBox,5); stroke(hexBox,T.bordFaint,1)

				local function updatePicker()
					cur=Color3.fromHSV(hv,sv,vv)
					prev2.BackgroundColor3=cur
					svGrad.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,T.white),ColorSequenceKeypoint.new(1,Color3.fromHSV(hv,1,1))}
					svDot.Position=u2(sv,0,1-vv,0); hDot.Position=u2(0,-3,hv,-2.5)
					local hex=string.format("#%02X%02X%02X",math.floor(cur.R*255),math.floor(cur.G*255),math.floor(cur.B*255))
					hexBox.Text=hex; hexTiny.Text=hex
					task.spawn(pcall,cb,cur)
				end
				updatePicker()

				cn(svF.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					dSv=true
					local ap=svF.AbsolutePosition; local as=svF.AbsoluteSize
					sv=math.clamp((i.Position.X-ap.X)/as.X,0,1); vv=1-math.clamp((i.Position.Y-ap.Y)/as.Y,0,1); updatePicker()
				end)
				cn(hBar.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					dH=true
					local ap=hBar.AbsolutePosition; local as=hBar.AbsoluteSize
					hv=math.clamp((i.Position.Y-ap.Y)/as.Y,0,1); updatePicker()
				end)
				cn(uis.InputChanged,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseMovement then return end
					if dSv then
						local ap=svF.AbsolutePosition; local as=svF.AbsoluteSize
						sv=math.clamp((i.Position.X-ap.X)/as.X,0,1); vv=1-math.clamp((i.Position.Y-ap.Y)/as.Y,0,1); updatePicker()
					elseif dH then
						local ap=hBar.AbsolutePosition; local as=hBar.AbsoluteSize
						hv=math.clamp((i.Position.Y-ap.Y)/as.Y,0,1); updatePicker()
					end
				end)
				cn(uis.InputEnded,function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then dSv=false; dH=false end
				end)
				cn(hexBox.FocusLost,function(enter)
					if enter then
						local hex=hexBox.Text:gsub("#","")
						if #hex==6 then
							local ok3,rc,gc,bc=pcall(function()
								return tonumber("0x"..hex:sub(1,2)),tonumber("0x"..hex:sub(3,4)),tonumber("0x"..hex:sub(5,6))
							end)
							if ok3 and rc and gc and bc then hv,sv,vv=Color3.toHSV(c3(rc,gc,bc)); updatePicker() end
						end
					end
				end)
				cn(r.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					pOpen=not pOpen
					if pOpen then
						pkFrame.Visible=true; pkFrame.Size=u2(1,0,0,0)
						tw(pkFrame,{Size=u2(1,0,0,160)},0.26,Enum.EasingStyle.Quart)
						wrap.Size=u2(1,0,0,38+160)
					else
						tw(pkFrame,{Size=u2(1,0,0,0)},0.18,Enum.EasingStyle.Quart,Enum.EasingDirection.Out,function()
							if not pOpen and pkFrame and pkFrame.Parent then pkFrame.Visible=false end
						end)
						wrap.Size=u2(1,0,0,36)
					end
				end)

				local obj={}
				function obj:Set(c2) cur=c2; hv,sv,vv=Color3.toHSV(c2); updatePicker() end
				function obj:Get() return cur end
				return obj
			end

			function S:CreateLabel(text, color, desc)
				eOrder+=1
				local f=Instance.new("Frame",secBody)
				f.Size=u2(1,0,0,18); f.BackgroundTransparency=1
				f.LayoutOrder=eOrder; f.ZIndex=8; f.BorderSizePixel=0
				local l=lbl(f,text or "",11,color or T.sub,Enum.Font.Gotham)
				l.AnchorPoint=v2(0,0.5); l.Position=u2(0,4,0.5,0); l.ZIndex=9
				if desc then
					cn(f.MouseEnter,function() setTipTarget(f,desc) end)
					cn(f.MouseLeave,function() clearTipTarget(f) end)
				end
				local obj={}
				function obj:Set(t,c2) l.Text=t; if c2 then l.TextColor3=c2 end end
				return obj
			end

			function S:CreateDivider()
				eOrder+=1
				local d=Instance.new("Frame",secBody)
				d.Size=u2(1,0,0,1); d.BackgroundColor3=T.bordFaint
				d.BorderSizePixel=0; d.LayoutOrder=eOrder; d.ZIndex=8
			end

			return S
		end

		return Tab
	end

	-- WINDOW CONTROLS
	local minimized = false
	cn(minBtn.MouseButton1Click,function()
		minimized=not minimized
		tw(main,{Size=minimized and u2(0,winW,0,44) or u2(0,winW,0,winH)},0.28,Enum.EasingStyle.Quart)
	end)

	cn(closeBtn.MouseButton1Click,function()
		inlineTip.Visible = false
		tw(main,{Size=u2(0,winW,0,0),BackgroundTransparency=1},0.22,Enum.EasingStyle.Quart)
		task.delay(0.25,function()
			if gui and gui.Parent then gui:Destroy() end
		end)
	end)

	cn(uis.InputBegan,function(inp,gp)
		if gp then return end
		if inp.KeyCode==toggleKey then
			main.Visible = not main.Visible
		end
	end)

	cn(rs.RenderStepped,function()
		if tipTarget and tipTarget.Parent then
			local mp = uis:GetMouseLocation()
			local ap = tipTarget.AbsolutePosition
			local as = tipTarget.AbsoluteSize
			if mp.X<ap.X or mp.X>ap.X+as.X or mp.Y<ap.Y or mp.Y>ap.Y+as.Y then
				tipTarget=nil; hideTip()
			end
		end
	end)

	task.defer(function()
		tw(main,{Size=u2(0,winW,0,winH)},0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
	end)

	W._gui  = gui
	W._main = main

	function W:Destroy()
		for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		if gui and gui.Parent then gui:Destroy() end
	end

	function W:SetVisible(v)
		main.Visible = v
	end

	function W:Notify(cfg2)
		K.Notify(cfg2)
	end

	return W
end

return K
