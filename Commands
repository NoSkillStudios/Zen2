--   BRING / TELEPORT / ATTACH / ORBIT / WALKTO
-- ════════════════════════════════════════════════════════════════════════════
local function bringPlayer(p)
    local myHRP = getHRP(); if not myHRP then return end
    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        p.Character.HumanoidRootPart.CFrame = myHRP.CFrame * CFrame.new(2, 0, 0)
        notify("🧲 Bring", p.DisplayName .. " brought", 1.5)
    end
end

local function teleportTo(p)
    local hrp = getHRP(); if not hrp then return end
    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        hrp.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        notify("✈️ Teleport", "Teleported to " .. p.DisplayName, 1.5)
    else
        notify("✈️ Teleport", "Cannot find " .. p.DisplayName .. "'s char", 2)
    end
end

local function startAttach(target, delay_)
    State.attachActive = true
    State.attachTarget = target
    local ch = lp.Character or lp.CharacterAdded:Wait()
    local hr = ch:WaitForChild("HumanoidRootPart")
    task.spawn(function()
        while State.attachActive and RunService.Heartbeat:Wait() do
            if target.Character and target.Character:FindFirstChild("HumanoidRootPart") and hr then
                pcall(function() hr.CFrame = target.Character.HumanoidRootPart.CFrame end)
            end
        end
    end)
    if delay_ and delay_ > 0 then
        task.delay(delay_, function()
            State.attachActive = false
            notify("🔗 Attach", "Auto-disabled after " .. delay_ .. "s", 2)
        end)
    end
    notify("🔗 Attach", "Attached to " .. target.DisplayName, 2)
end

local function stopAttach()
    State.attachActive = false
    State.attachTarget = nil
    notify("🔗 Attach", "Detached", 1.5)
end

local orbitConn   = nil
local orbitTarget = nil
local orbitAngle  = 0

local function startOrbit(target, radius)
    radius      = tonumber(radius) or 10
    orbitTarget = target
    orbitAngle  = 0
    if orbitConn then orbitConn:Disconnect() end
    orbitConn = RunService.Heartbeat:Connect(function(dt)
        orbitAngle = orbitAngle + dt * 2
        if not orbitTarget or not orbitTarget.Character then return end
        local hrp  = getHRP()
        local tHRP = orbitTarget.Character:FindFirstChild("HumanoidRootPart")
        if hrp and tHRP then
            local x = tHRP.Position.X + math.cos(orbitAngle) * radius
            local z = tHRP.Position.Z + math.sin(orbitAngle) * radius
            hrp.CFrame = CFrame.new(x, tHRP.Position.Y, z)
        end
    end)
    notify("🌀 Orbit", "Orbiting " .. target.DisplayName .. " radius:" .. radius, 2)
end

local function stopOrbit()
    if orbitConn then orbitConn:Disconnect(); orbitConn = nil end
    notify("🌀 Orbit", "Stopped", 1.5)
end

local walkToConn = nil

local function startWalkTo(target)
    if walkToConn then walkToConn:Disconnect(); walkToConn = nil end
    local hum = getHum(); if not hum then return end
    walkToConn = RunService.Heartbeat:Connect(function()
        if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            hum:MoveTo(target.Character.HumanoidRootPart.Position)
        end
    end)
    notify("🚶 WalkTo", "Following " .. target.DisplayName .. " — unwalkto to stop", 2)
end

local function stopWalkTo()
    if walkToConn then walkToConn:Disconnect(); walkToConn = nil end
    notify("🚶 WalkTo", "Stopped", 1.5)
end

