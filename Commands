-- Notification function (placeholder until GUI loads)
local function notify(title, body, duration, ntype)
    if getgenv()._lav_notify then
        getgenv()._lav_notify(title, body, duration, ntype)
    else
        print(string.format("[%s] %s: %s", ntype or "info", title, body))
    end
end
getgenv()._lav_notify = notify

-- Smart player resolver (case insensitive, partial match)
local function resolvePlayer(arg)
    if not arg or arg == "" then return nil end
    arg = arg:lower()
    
    if arg == "me" or arg == "local" then return lp end
    if arg == "all" then return "all" end
    if arg == "others" then return "others" end
    if arg == "random" then 
        local list = Players:GetPlayers()
        return list[math.random(1, #list)]
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #arg) == arg or 
           p.DisplayName:lower():sub(1, #arg) == arg then
            return p
        end
    end
    return nil
end
getgenv()._lav_resolve = resolvePlayer

-- Command Registry
local CMDS = {}
local function register(name, aliases, desc, args, fn)
    local cmd = {name = name, aliases = aliases, desc = desc, args = args, fn = fn}
    CMDS[name] = cmd
    for _, alias in ipairs(aliases) do
        CMDS[alias] = cmd
    end
end

-- MOVEMENT
register("speed", {"sp", "ws", "walkspeed"}, "Sets walkspeed", "<num> [target]", function(args)
    local num = tonumber(args[1])
    if not num then notify("Error", "Usage: speed <number> [target]", 3, "error") return end
    
    local target = args[2] and resolvePlayer(args[2]) or lp
    
    local function setSpeed(p)
        local hum = p.Character and p.Character:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = num end
    end
    
    if target == "all" then
        for _, p in ipairs(Players:GetPlayers()) do setSpeed(p) end
        notify("Speed", "Set ALL to " .. num, 3, "success")
    elseif target == "others" then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= lp then setSpeed(p) end end
        notify("Speed", "Set OTHERS to " .. num, 3, "success")
    elseif target then
        setSpeed(target)
        notify("Speed", target.Name .. " → " .. num, 3, "success")
    end
end)

register("jump", {"jp", "jumppower"}, "Sets jumppower", "<num> [target]", function(args)
    local num = tonumber(args[1])
    if not num then notify("Error", "Usage: jump <number>", 3, "error") return end
    local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
