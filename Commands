CMDS.tracers = {desc="Draws lines to all players", args="", fn=function()
	local s = getState(); s.tracers = not s.tracers
	if s.tracers then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and p.Character then
				local r = p.Character:FindFirstChild("HumanoidRootPart"); if not r then return end
				local line = Drawing.new("Line"); line.Thickness=1; line.Color=Color3.fromRGB(148,100,255)
				line.Transparency=0.4; line.Visible=true
				table.insert(s.traceObjs,{line=line,target=r})
			end
		end
		notify("tracers","Enabled")
	else
		for _, v in ipairs(s.traceObjs) do pcall(function() v.line:Remove() end) end
		s.traceObjs = {}; notify("tracers","Disabled")
	end
end}

