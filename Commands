register("goto", {"to", "tp"}, "Teleport to player", "<target>", function(args)
    local t = resolvePlayer(args[1])
    if not t or t == "all" or t == "others" then notify("Error", "Player not found", 3, "error") return end
    local r = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local tr = t.Character and t.Character:FindFirstChild("HumanoidRootPart")
    if r and tr then r.CFrame = tr.CFrame + Vector3.new(0, 3, 0); notify("Goto", t.Name, 3, "success") end
end)

