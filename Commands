		stroke(b, T.bordFaint, 1)
		cn(b.MouseEnter, function() tw(b,{BackgroundColor3=T.elev},0.1) end)
		cn(b.MouseLeave, function() tw(b,{BackgroundColor3=T.bgDeep},0.1) end)
		return b
	end
	local minBtn   = mkCtrl(T.warn,   -62, "–")
	local closeBtn = mkCtrl(T.danger, -32, "✕")

	-- Dragging
	local dragging, dragStart, startPos = false, nil, nil
	cn(topbar.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging  = true
		dragStart = i.Position
		startPos  = main.Position
	end)
	cn(uis.InputChanged, function(i)
		if not dragging or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local d = i.Position - dragStart
		main.Position = u2(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
	end)
	cn(uis.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)

	-- FPS / Ping
	local fpsCount, lastT = 0, tick()
	cn(rs.RenderStepped, function()
		fpsCount += 1
		local now = tick()
