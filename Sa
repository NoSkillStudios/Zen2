	function W:CreateTab(name, icon)
		local iconChar  = icon or "◈"
		local isImgIcon = type(icon)=="string"
			and (icon:find("rbxasset") or icon:find("rbxgameasset"))

		-- Page frame
		local page = Instance.new("Frame", pageContainer)
		page.Size             = u2(1,0,1,0)
		page.BackgroundTransparency = 1
		page.Visible          = false
		page.ZIndex           = 11
		page.ClipsDescendants = true
		page.BorderSizePixel  = 0

		local pgScroll = scroll(page)
		pad(pgScroll, 12, 12, 12, 12)
		list(pgScroll, nil, 10)

		-- Sidebar icon button
		local icoBtn = Instance.new("TextButton", sideScroll)
		icoBtn.Size             = u2(1, 0, 0, 40)
		icoBtn.BackgroundColor3 = T.sidebar
		icoBtn.BackgroundTransparency = 1
		icoBtn.Text             = ""
		icoBtn.ZIndex           = 13
		icoBtn.BorderSizePixel  = 0
		icoBtn.ClipsDescendants = false
		corner(icoBtn, 10)

		-- Active indicator bar
		local actBar = Instance.new("Frame", icoBtn)
		actBar.Size             = u2(0,3,0,0)
		actBar.Position         = u2(0,-1, 0.15, 0)
		actBar.BackgroundColor3 = T.acc
		actBar.BackgroundTransparency = 1
		actBar.BorderSizePixel  = 0
		actBar.ZIndex           = 14
		corner(actBar, 999)
		grad(actBar, T.accGlow, T.accB, 90)

		local icoLbl
		if isImgIcon then
			local img = Instance.new("ImageLabel", icoBtn)
			img.BackgroundTransparency = 1
			img.Image      = iconChar
			img.ImageColor3= T.muted
			img.Size       = u2(0,20,0,20)
			img.Position   = u2(0.5,-10,0.5,-10)
			img.ScaleType  = Enum.ScaleType.Fit
			img.ZIndex     = 14
			icoLbl = img
		else
			icoLbl = Instance.new("TextLabel", icoBtn)
			icoLbl.BackgroundTransparency = 1
			icoLbl.Text       = iconChar
			icoLbl.TextSize   = 18
			icoLbl.TextColor3 = T.muted
			icoLbl.Font       = Enum.Font.GothamMedium
			icoLbl.Size       = u2(1,0,1,0)
			icoLbl.TextXAlignment = Enum.TextXAlignment.Center
			icoLbl.TextYAlignment = Enum.TextYAlignment.Center
			icoLbl.ZIndex     = 14
		end

		-- Tiny notification badge slot (hidden by default)
		local badgeDot = Instance.new("Frame", icoBtn)
		badgeDot.Size             = u2(0,8,0,8)
		badgeDot.Position         = u2(1,-10,0,4)
		badgeDot.BackgroundColor3 = T.danger
		badgeDot.BackgroundTransparency = 1
		badgeDot.BorderSizePixel  = 0
		badgeDot.ZIndex           = 15
		corner(badgeDot, 999)

		_sideIcons[name] = {btn=icoBtn, icon=icoLbl, bar=actBar, iconChar=iconChar, isImage=isImgIcon, badge=badgeDot}
		_pages[name]     = page

		cn(icoBtn.MouseButton1Click, function() selectTab(name) end)
		cn(icoBtn.MouseEnter, function()
			showSideTip(name, icoBtn)
			if _activeTab ~= name then
				tw(icoBtn, {BackgroundTransparency=0, BackgroundColor3=T.elevHov}, 0.15)
				if isImgIcon then tw(icoLbl,{ImageColor3=T.accGlow},0.15)
				else tw(icoLbl,{TextColor3=T.accGlow},0.15) end
			end
		end)
		cn(icoBtn.MouseLeave, function()
			hideSideTip()
			if _activeTab ~= name then
				tw(icoBtn,{BackgroundTransparency=1},0.15)
				if isImgIcon then tw(icoLbl,{ImageColor3=T.muted},0.15)
				else tw(icoLbl,{TextColor3=T.muted},0.15) end
			end
		end)

		if not _activeTab then selectTab(name, true) end

