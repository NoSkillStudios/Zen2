                selLbl.Position = UDim2.new(0, 100, 0, 0)
                selLbl.TextXAlignment = Enum.TextXAlignment.Right
                selLbl.ZIndex = 10
                selLbl.Parent = row

                local arrLbl = Instance.new("TextLabel")
                arrLbl.BackgroundTransparency = 1
                arrLbl.Text = "▾"
                arrLbl.TextSize = 12
                arrLbl.TextColor3 = T.sub
                arrLbl.Font = Enum.Font.GothamBold
                arrLbl.Size = UDim2.new(0, 20, 1, 0)
                arrLbl.Position = UDim2.new(1, -28, 0, 0)
                arrLbl.TextXAlignment = Enum.TextXAlignment.Center
                arrLbl.TextYAlignment = Enum.TextYAlignment.Center
                arrLbl.ZIndex = 10
                arrLbl.Parent = row

                local ddFrame = Instance.new("Frame")
                ddFrame.Size = UDim2.new(1, 0, 0, 0)
                ddFrame.Position = UDim2.new(0, 0, 0, 38)
                ddFrame.BackgroundColor3 = T.elev
                ddFrame.ZIndex = 20
                ddFrame.Visible = false
                ddFrame.ClipsDescendants = true
                ddFrame.BorderSizePixel = 0
                ddFrame.Parent = wrap
                Util.Corner(ddFrame, 7)
                Util.Stroke(ddFrame, T.accent, 1, 0.5)

                local ddScroll = Util.Scroll(ddFrame)
                Util.Pad(ddScroll, 4, 4, 4, 4)
                Util.List(ddScroll, 2)

                local optFns = {}

                local function refreshSel()
                    if multi then
                        local keys = {}
                        for k in pairs(sel) do table.insert(keys, k) end
                        selLbl.Text = #keys == 0 and "None" or table.concat(keys, ", ")
                    else
                        selLbl.Text = sel or "Select..."
                    end
                end

                local function isSelected(opt)
                    return multi and sel[opt] == true or sel == opt
                end

                local function buildOption(opt)
                    local ob = Instance.new("TextButton")
                    ob.Size = UDim2.new(1, 0, 0, 28)
                    ob.BackgroundColor3 = T.elev
                    ob.BackgroundTransparency = 1
                    ob.Text = ""
                    ob.ZIndex = 21
                    ob.BorderSizePixel = 0
                    ob.Parent = ddScroll
                    Util.Corner(ob, 5)

                    local ol = Instance.new("TextLabel")
                    ol.BackgroundTransparency = 1
                    ol.Text = opt
                    ol.TextSize = 12
                    ol.TextColor3 = T.text
                    ol.Font = Enum.Font.Gotham
                    ol.Position = UDim2.new(0, 10, 0.5, -7)
                    ol.AutomaticSize = Enum.AutomaticSize.XY
                    ol.ZIndex = 22
                    ol.Parent = ob

                    local ck = Instance.new("TextLabel")
                    ck.BackgroundTransparency = 1
                    ck.Text = "✓"
                    ck.TextSize = 12
                    ck.TextColor3 = T.accent
                    ck.Font = Enum.Font.GothamBold
                    ck.Size = UDim2.new(0, 20, 1, 0)
                    ck.Position = UDim2.new(1, -26, 0, 0)
                    ck.TextXAlignment = Enum.TextXAlignment.Center
                    ck.TextYAlignment = Enum.TextYAlignment.Center
                    ck.TextTransparency = 1
                    ck.ZIndex = 22
                    ck.Parent = ob

                    local function refresh()
                        local active = isSelected(opt)
                        Util.Tween(ob, {
                            BackgroundColor3 = active and T.accent or T.elev,
                            BackgroundTransparency = active and 0.5 or 1
                        }, 0.1)
                        Util.Tween(ol, {TextColor3 = active and T.white or T.text}, 0.1)
                        Util.Tween(ck, {TextTransparency = active and 0 or 1}, 0.1)
                    end
                    refresh()
                    optFns[opt] = refresh

                    conns:Connect(ob.MouseButton1Click, function()
                        if multi then
                            if sel[opt] then sel[opt] = nil else sel[opt] = true end
                            refresh()
                            refreshSel()
                            local out = {}
                            for k in pairs(sel) do table.insert(out, k) end
                            task.spawn(pcall, cb, out)
                        else
                            sel = opt
                            for _, fn in pairs(optFns) do fn() end
                            refreshSel()
                            task.spawn(pcall, cb, opt)
                        end
                    end)

                    conns:Connect(ob.MouseEnter, function()
                        Util.Tween(ob, {BackgroundTransparency = isSelected(opt) and 0.4 or 0.75}, 0.08)
                    end)
                    conns:Connect(ob.MouseLeave, function()
                        Util.Tween(ob, {BackgroundTransparency = isSelected(opt) and 0.5 or 1}, 0.08)
                    end)
                end

                for _, o in ipairs(opts) do buildOption(o) end

                conns:Connect(row.InputBegan, function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    open = not open
                    if open then
                        local h = math.min(#opts * 30 + 8, 160)
                        ddFrame.Visible = true
                        ddFrame.Size = UDim2.new(1, 0, 0, 0)
                        Util.Tween(ddFrame, {Size = UDim2.new(1, 0, 0, h)}, 0.2, Enum.EasingStyle.Back)
                        Util.Tween(arrLbl, {Rotation = 180}, 0.2)
                        wrap.Size = UDim2.new(1, 0, 0, 38 + h)
                    else
                        Util.Tween(ddFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.14)
                        Util.Tween(arrLbl, {Rotation = 0}, 0.14)
                        task.delay(0.15, function()
                            if not open then ddFrame.Visible = false end
                        end)
                        wrap.Size = UDim2.new(1, 0, 0, 36)
                    end
                end)

                local obj = {}
                function obj:Set(v)
                    if multi then
                        sel = {}
                        for _, k in ipairs(v) do sel[k] = true end
                    else
                        sel = v
                    end
                    for _, fn in pairs(optFns) do fn() end
                    refreshSel()
                end
                function obj:Refresh(newOpts)
                    for _, c in ipairs(ddScroll:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    table.clear(optFns)
                    opts = newOpts
                    for _, o in ipairs(opts) do buildOption(o) end
                end
                function obj:Get() return sel end
                return obj
            end

