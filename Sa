local function tween(obj, props, dur, style, dir)
	ts:Create(obj, ti(dur or 0.18, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props):Play()
end

local function shadow(parent, size, trans)
	local s = Instance.new("ImageLabel", parent)
	s.Name = "_sh"
	s.BackgroundTransparency = 1
	s.Image = "rbxassetid://6014054489"
	s.ImageColor3 = c3(0,0,0)
	s.ImageTransparency = trans or 0.6
	s.ScaleType = Enum.ScaleType.Slice
	s.SliceCenter = Rect.new(49,49,450,450)
	s.Size = u2(1, size or 24, 1, size or 24)
	s.Position = u2(0, -(size or 24)/2, 0, -(size or 24)/2)
	s.ZIndex = parent.ZIndex - 1
	return s
end

local function corner(parent, rad)
	local c = Instance.new("UICorner", parent)
	c.CornerRadius = UDim.new(0, rad or 8)
	return c
end

local function stroke(parent, col, thick, trans)
	local s = Instance.new("UIStroke", parent)
	s.Color = col or theme.border
	s.Thickness = thick or 1
	s.Transparency = trans or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function pad(parent, t, b, l, r)
	local p = Instance.new("UIPadding", parent)
	p.PaddingTop = UDim.new(0, t or 8)
	p.PaddingBottom = UDim.new(0, b or 8)
	p.PaddingLeft = UDim.new(0, l or 8)
	p.PaddingRight = UDim.new(0, r or 8)
	return p
end

local function listLayout(parent, dir, spacing, align)
	local l = Instance.new("UIListLayout", parent)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, spacing or 6)
	if align then l.HorizontalAlignment = align end
	return l
end

local function label(parent, txt, size, col, weight)
	local l = Instance.new("TextLabel", parent)
	l.BackgroundTransparency = 1
	l.Text = txt or ""
	l.TextSize = size or 13
	l.TextColor3 = col or theme.text
	l.Font = weight or Enum.Font.GothamMedium
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.AutomaticSize = Enum.AutomaticSize.XY
	return l
end

local function ripple(btn)
	local rip = Instance.new("Frame", btn)
	rip.Size = u2(0,0,0,0)
	rip.Position = u2(0.5,0,0.5,0)
	rip.AnchorPoint = v2(0.5,0.5)
	rip.BackgroundColor3 = theme.white
	rip.BackgroundTransparency = 0.7
	rip.ZIndex = btn.ZIndex + 5
	corner(rip, 999)
	local sz = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.5
	tween(rip, {Size=u2(0,sz,0,sz), BackgroundTransparency=1}, 0.5, Enum.EasingStyle.Quad)
	task.delay(0.52, function() rip:Destroy() end)
end

local function makeScrollFrame(parent, height)
	local sf = Instance.new("ScrollingFrame", parent)
	sf.Size = u2(1,0,1,height and -height or 0)
	sf.Position = u2(0,0,0,height or 0)
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = 3
	sf.ScrollBarImageColor3 = theme.accent
	sf.ScrollBarImageTransparency = 0.4
	sf.CanvasSize = u2(0,0,0,0)
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	return sf
end

local function accentLine(parent, vert)
	local g = Instance.new("Frame", parent)
	if vert then
		g.Size = u2(0,2,1,0)
		g.Position = u2(0,0,0,0)
	else
		g.Size = u2(1,0,0,2)
		g.Position = u2(0,0,0,0)
	end
	g.BackgroundColor3 = theme.accent
	g.BorderSizePixel = 0
	local grad = Instance.new("UIGradient", g)
	grad.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, theme.accent),
		ColorSequenceKeypoint.new(1, theme.accentGlow)
	}
	if vert then
		grad.Rotation = 90
	end
	return g
end

local connections = {}
local function conn(sig, fn)
	local c = sig:Connect(fn)
	table.insert(connections, c)
	return c
end

local dragging, dragObj, dragStart, startPos = false, nil, nil, nil

local function makeDraggable(frame, handle)
	conn(handle.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragObj = frame
			dragStart = inp.Position
			startPos = frame.Position
		end
	end)
	conn(uis.InputChanged, function(inp)
		if dragging and dragObj == frame and inp.UserInputType == Enum.UserInputType.MouseMovement then
			local d = inp.Position - dragStart
			dragObj.Position = u2(
				startPos.X.Scale,
				startPos.X.Offset + d.X,
				startPos.Y.Scale,
				startPos.Y.Offset + d.Y
			)
		end
	end)
	conn(uis.InputEnded, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			dragObj = nil
		end
	end)
end

