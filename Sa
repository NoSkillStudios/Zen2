				local listening = false

				local row = Instance.new("Frame", secContent)
				row.Size = u2(1,0,0,36)
				row.BackgroundColor3 = theme.elevated
				row.LayoutOrder = so()
				row.ZIndex = 7
				corner(row, 7)
				stroke(row, theme.border, 1, 0.6)

				local lbl = label(row, n, 12, theme.text, Enum.Font.GothamMedium)
				lbl.Position = u2(0,12,0.5,-7)
				lbl.ZIndex = 8

				local kbtn = Instance.new("TextButton", row)
				kbtn.Size = u2(0,90,0,24)
				kbtn.Position = u2(1,-98,0.5,-12)
