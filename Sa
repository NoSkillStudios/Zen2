-- Gradient helper
local function grad(p, c0, c1, rot)
	local g = Instance.new("UIGradient", p)
	g.Color    = ColorSequence.new{
		ColorSequenceKeypoint.new(0, c0),
		ColorSequenceKeypoint.new(1, c1),
	}
	g.Rotation = rot or 135
	return g
end

-- 3-stop gradient
local function grad3(p, c0, c1, c2, rot)
	local g = Instance.new("UIGradient", p)
	g.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0,   c0),
		ColorSequenceKeypoint.new(0.5, c1),
		ColorSequenceKeypoint.new(1,   c2),
	}
	g.Rotation = rot or 135
	return g
end

-- Draggable
local function makeDraggable(frame, handle)
	local dragging, dragStart, startPos = false, nil, nil
	cn(handle.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging  = true
		dragStart = i.Position
		startPos  = frame.Position
		tw(frame, {}, 0) -- interrupt any running tween
	end)
	cn(uis.InputChanged, function(i)
		if not dragging or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local d = i.Position - dragStart
		frame.Position = u2(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end)
	cn(uis.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
end

-- Close all dropdowns except one
local function closeAllDropdowns(except)
	for _, fn in ipairs(_dropdowns) do
		if fn ~= except then pcall(fn) end
	end
end

-- Unique ID
local function uid()
	return tostring(math.random(100000, 999999))
end

-- Hex from Color3
local function toHex(c)
	return string.format("#%02X%02X%02X",
		math.floor(c.R * 255),
		math.floor(c.G * 255),
		math.floor(c.B * 255)
	)
end

-- Color3 from hex string
local function fromHex(h)
	h = h:gsub("#","")
	if #h ~= 6 then return nil end
	local ok, r, g, b = pcall(function()
		return tonumber("0x"..h:sub(1,2)),
		       tonumber("0x"..h:sub(3,4)),
		       tonumber("0x"..h:sub(5,6))
	end)
	if ok and r and g and b then return c3(r,g,b) end
end

