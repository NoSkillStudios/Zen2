				trackBg.Size = u2(1, -76, 0, 4)
				trackBg.Position = u2(0, 10, 0, 42)
				trackBg.ZIndex = 9
				corner(trackBg, 999)

				local fillBar = frame(trackBg, th.acc)
				local pct0 = (val - mn) / (mx - mn)
				fillBar.Size = u2(pct0, 0, 1, 0)
				fillBar.ZIndex = 10
				corner(fillBar, 999)
