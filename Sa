	-- Floating tab header sync
	local function syncTabHeader()
		if not main or not main.Parent then return end
		local mp = main.Position
		local newPos = u2(mp.X.Scale, mp.X.Offset + 60 + 12,
		                  mp.Y.Scale, mp.Y.Offset + 50 + 12)
		tabHeader.Position = newPos
	end

	-- Glow sync
	local function syncGlow()
		if not main or not main.Parent then return end
		local mp = main.Position
		glowBack.Position = u2(mp.X.Scale, mp.X.Offset + winW/2,
		                       mp.Y.Scale, mp.Y.Offset + winH/2)
	end

	local function selectTab(name, instant)
		if _activeTab == name then return end
		local prev = _activeTab
		_activeTab = name
		tabHeaderLabel.Text = name
		local si = _sideIcons[name]
		if si then tabHeaderIcon.Text = si.iconChar end

		for n, pg in pairs(_pages) do
			local s2 = _sideIcons[n]
			if n == name then
				pg.Visible = true
				if not instant then
					pg.Position = u2(0.02, 0, 0.02, 0)
					pg.BackgroundTransparency = 0
					tw(pg, {Position=u2(0,0,0,0)}, 0.28, Enum.EasingStyle.Quart)
				end
				if s2 then
					tw(s2.btn, {BackgroundColor3=T.accDeep, BackgroundTransparency=0}, 0.2)
					tw(s2.icon, {TextColor3=T.white}, 0.2)
					tw(s2.bar, {BackgroundTransparency=0, Size=u2(0,3,0.7,0)}, 0.28, Enum.EasingStyle.Back)
				end
			else
				if s2 then
					tw(s2.btn, {BackgroundTransparency=1}, 0.2)
					tw(s2.icon, {TextColor3=T.muted}, 0.2)
					tw(s2.bar, {BackgroundTransparency=1, Size=u2(0,3,0,0)}, 0.18)
				end
				if prev==n and not instant then
					tw(pg, {Position=u2(-0.02,0,-0.02,0)}, 0.18, Enum.EasingStyle.Quart)
					task.delay(0.2, function()
						if _activeTab~=n and pg and pg.Parent then
							pg.Visible=false
							pg.Position=u2(0,0,0,0)
						end
					end)
				else
					pg.Visible=false
					pg.Position=u2(0,0,0,0)
				end
			end
		end
	end

