				local dot = frame(trackBg, th.white)
				dot.Size = u2(0, 12, 0, 12)
				dot.AnchorPoint = v2(0.5, 0.5)
				dot.Position = u2(pct0, 0, 0.5, 0)
				dot.ZIndex = 11
				corner(dot, 999)

				local function setVal(nv, silent)
					val = math.clamp(math.round(nv), mn, mx)
					local p = (val - mn) / (mx - mn)
					tw(fillBar, {Size = u2(p, 0, 1, 0)}, 0.05)
					tw(dot, {Position = u2(p, 0, 0.5, 0)}, 0.05)
					numInput.Text = tostring(val)
					if not silent then task.spawn(pcall, cb, val) end
				end

				local function mouseToVal(i)
					local ax = trackBg.AbsolutePosition.X
					local aw = trackBg.AbsoluteSize.X
					setVal(mn + math.clamp((i.Position.X - ax) / aw, 0, 1) * (mx - mn))
				end

				gc(trackBg.InputBegan, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then slid=true; mouseToVal(i) end
				end)
				gc(dot.InputBegan, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then slid=true end
				end)
				gc(uis.InputChanged, function(i)
					if slid and i.UserInputType == Enum.UserInputType.MouseMovement then mouseToVal(i) end
				end)
				gc(uis.InputEnded, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then slid=false end
				end)
				gc(numInput.FocusLost, function(enter)
					if enter then
						local n = tonumber(numInput.Text)
						if n then setVal(n) end
					end
					numInput.Text = tostring(val)
				end)

				local obj = {}
				function obj:Set(v) setVal(v, false) end
				function obj:Get() return val end
				return obj
			end

