				local nlbl = label(header, n, 12, theme.text, Enum.Font.GothamMedium)
				nlbl.ZIndex = 9

				local vlbl = label(header, tostring(val)..suffix, 12, theme.accent, Enum.Font.GothamBold)
				vlbl.Size = u2(1,0,1,0)
				vlbl.TextXAlignment = Enum.TextXAlignment.Right
				vlbl.ZIndex = 9

				local trackBg = Instance.new("Frame", row)
				trackBg.Size = u2(1,-24,0,6)
				trackBg.Position = u2(0,12,0,36)
				trackBg.BackgroundColor3 = theme.bg
				trackBg.ZIndex = 8
				corner(trackBg, 999)

				local fill = Instance.new("Frame", trackBg)
				fill.Size = u2((val-min)/(max-min),0,1,0)
				fill.BackgroundColor3 = theme.accent
				fill.ZIndex = 9
				corner(fill, 999)
				local fillGrad = Instance.new("UIGradient", fill)
				fillGrad.Color = ColorSequence.new{
					ColorSequenceKeypoint.new(0, theme.accent),
					ColorSequenceKeypoint.new(1, theme.accentGlow)
				}

				local dot = Instance.new("Frame", trackBg)
				dot.Size = u2(0,14,0,14)
				dot.Position = u2((val-min)/(max-min),0,0.5,-7)
				dot.AnchorPoint = v2(0.5,0.5)
				dot.BackgroundColor3 = theme.white
				dot.ZIndex = 10
				corner(dot, 999)
				shadow(dot, 6, 0.5)

				local function setSlider(newVal, silent)
					val = math.clamp(math.floor(newVal), min, max)
					local pct = (val-min)/(max-min)
					tween(fill, {Size=u2(pct,0,1,0)}, 0.05)
					tween(dot, {Position=u2(pct,0,0.5,-7)}, 0.05)
					vlbl.Text = tostring(val)..suffix
					if not silent then task.spawn(cb, val) end
				end

				local inputBox = Instance.new("TextBox", row)
				inputBox.Size = u2(0,52,0,20)
				inputBox.Position = u2(1,-56, 0, 4)
				inputBox.BackgroundColor3 = theme.bg
				inputBox.TextColor3 = theme.accent
				inputBox.Text = tostring(val)
				inputBox.TextSize = 12
				inputBox.Font = Enum.Font.GothamBold
				inputBox.PlaceholderText = "0"
				inputBox.ZIndex = 9
				corner(inputBox, 5)
				stroke(inputBox, theme.border, 1, 0.5)
				inputBox.TextXAlignment = Enum.TextXAlignment.Center

				conn(inputBox.FocusLost, function(enter)
					if enter then
						local n2 = tonumber(inputBox.Text)
						if n2 then setSlider(n2) end
					end
					inputBox.Text = tostring(val)
				end)

				local function handleDrag(input)
					local abs = trackBg.AbsolutePosition.X
					local szx = trackBg.AbsoluteSize.X
					local pct = math.clamp((input.Position.X - abs) / szx, 0, 1)
					setSlider(min + pct*(max-min))
				end

				conn(trackBg.InputBegan, function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingSlider = true
						handleDrag(inp)
					end
				end)
				conn(uis.InputChanged, function(inp)
					if draggingSlider and inp.UserInputType == Enum.UserInputType.MouseMovement then
						handleDrag(inp)
					end
				end)
				conn(uis.InputEnded, function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingSlider = false
					end
				end)
				conn(dot.InputBegan, function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingSlider = true
					end
				end)
				conn(row.MouseEnter, function() tween(row, {BackgroundColor3=c3(26,26,34)}, 0.1) end)
				conn(row.MouseLeave, function() tween(row, {BackgroundColor3=theme.elevated}, 0.1) end)

				local obj = {Value=val}
				function obj:Set(v) setSlider(v) end
				return obj
			end

			function S:CreateDropdown(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local n = cfg2.Title or "Dropdown"
				local opts = cfg2.Options or {}
				local def = cfg2.Default or opts[1]
				local cb = cfg2.Callback or function() end
				local multi = cfg2.MultiSelect or false

				local selected = multi and {} or def
				local open = false

				local wrap = Instance.new("Frame", secContent)
				wrap.Size = u2(1,0,0,36)
				wrap.BackgroundTransparency = 1
				wrap.LayoutOrder = so()
				wrap.ZIndex = 7
				wrap.ClipsDescendants = false

				local row = Instance.new("Frame", wrap)
				row.Size = u2(1,0,0,36)
				row.BackgroundColor3 = theme.elevated
				row.ZIndex = 7
				corner(row, 7)
				stroke(row, theme.border, 1, 0.6)
				row.ClipsDescendants = true

				local lbl = label(row, n, 12, theme.text, Enum.Font.GothamMedium)
				lbl.Position = u2(0,12,0.5,-7)
				lbl.ZIndex = 8

				local selLbl = label(row, multi and "None" or (def or "Select..."), 12, theme.accent, Enum.Font.Gotham)
				selLbl.Size = u2(1,-90,1,0)
				selLbl.Position = u2(0,90,0,0)
				selLbl.TextXAlignment = Enum.TextXAlignment.Right
				selLbl.ZIndex = 8

				local arr = label(row, "▾", 12, theme.subtext, Enum.Font.GothamBold)
				arr.Size = u2(0,20,1,0)
				arr.Position = u2(1,-28,0,0)
				arr.TextXAlignment = Enum.TextXAlignment.Center
				arr.TextYAlignment = Enum.TextYAlignment.Center
				arr.ZIndex = 8

				local dropdown = Instance.new("Frame", wrap)
				dropdown.Size = u2(1,0,0,0)
				dropdown.Position = u2(0,0,0,38)
				dropdown.BackgroundColor3 = theme.elevated
				dropdown.ZIndex = 15
				dropdown.Visible = false
				dropdown.ClipsDescendants = true
				corner(dropdown, 7)
				stroke(dropdown, theme.accent, 1, 0.5)
				shadow(dropdown, 12, 0.5)

				local dScroll = makeScrollFrame(dropdown, 0)
				dScroll.Size = u2(1,0,1,0)
				pad(dScroll, 4, 4, 4, 4)
				listLayout(dScroll, nil, 2)

				local optBtns = {}

				local function refreshLabel()
					if multi then
						local keys = {}
						for k in pairs(selected) do table.insert(keys, k) end
						selLbl.Text = #keys==0 and "None" or table.concat(keys,", ")
					else
						selLbl.Text = selected or "Select..."
					end
				end

				local function makeOption(opt)
					local ob = Instance.new("TextButton", dScroll)
					ob.Size = u2(1,0,0,28)
					ob.BackgroundColor3 = theme.elevated
					ob.BackgroundTransparency = 1
					ob.Text = ""
					ob.ZIndex = 16
					corner(ob, 5)

					local ol = label(ob, opt, 12, theme.text, Enum.Font.Gotham)
					ol.Position = u2(0,10,0.5,-7)
					ol.ZIndex = 17

					local check = label(ob, "✓", 12, theme.accent, Enum.Font.GothamBold)
					check.Size = u2(0,20,1,0)
					check.Position = u2(1,-26,0,0)
					check.TextXAlignment = Enum.TextXAlignment.Center
					check.TextYAlignment = Enum.TextYAlignment.Center
					check.TextTransparency = 1
					check.ZIndex = 17

					local function isSelected()
						return multi and selected[opt] or selected==opt
					end

					local function refreshOpt()
						local sel = isSelected()
						tween(ob, {BackgroundTransparency = sel and 0.6 or 1}, 0.1)
						tween(ob, {BackgroundColor3 = sel and theme.accentDim or theme.elevated}, 0.1)
						tween(ol, {TextColor3 = sel and theme.white or theme.text}, 0.1)
						tween(check, {TextTransparency = sel and 0 or 1}, 0.1)
					end
					refreshOpt()

					conn(ob.MouseButton1Click, function()
						ripple(ob)
						if multi then
							selected[opt] = not selected[opt] or nil
							refreshOpt()
							refreshLabel()
							local keys = {}
							for k in pairs(selected) do table.insert(keys, k) end
							task.spawn(cb, keys)
						else
							selected = opt
							for _, v in pairs(optBtns) do v() end
							refreshLabel()
							task.spawn(cb, opt)
						end
					end)

					optBtns[opt] = refreshOpt
					conn(ob.MouseEnter, function() tween(ob, {BackgroundTransparency = isSelected() and 0.5 or 0.8}, 0.08) end)
					conn(ob.MouseLeave, function() tween(ob, {BackgroundTransparency = isSelected() and 0.6 or 1}, 0.08) end)
				end

				for _, o in ipairs(opts) do makeOption(o) end

				local function toggleDropdown()
					open = not open
					if open then
						local targetH = math.min(#opts * 30 + 8, 160)
						dropdown.Visible = true
						dropdown.Size = u2(1,0,0,0)
						tween(dropdown, {Size=u2(1,0,0,targetH)}, 0.2, Enum.EasingStyle.Back)
						tween(arr, {Rotation=180}, 0.2)
						wrap.Size = u2(1,0,0, 38 + targetH)
					else
						tween(dropdown, {Size=u2(1,0,0,0)}, 0.15)
						tween(arr, {Rotation=0}, 0.15)
						task.delay(0.16, function() if not open then dropdown.Visible = false end end)
						wrap.Size = u2(1,0,0,36)
					end
				end

				conn(row.InputBegan, function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1 then
						toggleDropdown()
					end
				end)
				conn(row.MouseEnter, function() tween(row, {BackgroundColor3=c3(26,26,34)}, 0.1) end)
				conn(row.MouseLeave, function() tween(row, {BackgroundColor3=theme.elevated}, 0.1) end)

				local obj = {Value=selected}
				function obj:Set(v)
					if multi then selected = {}; for _, k in ipairs(v) do selected[k]=true end
					else selected=v end
					for _, fn in pairs(optBtns) do fn() end
					refreshLabel()
				end
				function obj:Refresh(newOpts)
					for _, c in pairs(dScroll:GetChildren()) do
						if c:IsA("TextButton") then c:Destroy() end
					end
					table.clear(optBtns)
					opts = newOpts
					for _, o in ipairs(opts) do makeOption(o) end
				end
				return obj
			end

