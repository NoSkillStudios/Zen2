				ntl2.Position   = u2(0,12,0.5,-7)
				ntl2.AutomaticSize = Enum.AutomaticSize.XY
				ntl2.ZIndex     = 8

				local selLbl = Instance.new("TextLabel", row)
				selLbl.BackgroundTransparency = 1
				selLbl.Text       = multi and "None" or (sel or "Select...")
				selLbl.TextSize   = 11
				selLbl.TextColor3 = T.acc
				selLbl.Font       = Enum.Font.Gotham
				selLbl.Size       = u2(1,-100,1,0)
				selLbl.Position   = u2(0,100,0,0)
				selLbl.TextXAlignment = Enum.TextXAlignment.Right
				selLbl.ZIndex     = 8

				local arrLbl = Instance.new("TextLabel", row)
				arrLbl.BackgroundTransparency = 1
				arrLbl.Text       = "▾"
				arrLbl.TextSize   = 12
				arrLbl.TextColor3 = T.sub
				arrLbl.Font       = Enum.Font.GothamBold
				arrLbl.Size       = u2(0,20,1,0)
				arrLbl.Position   = u2(1,-28,0,0)
				arrLbl.TextXAlignment = Enum.TextXAlignment.Center
				arrLbl.TextYAlignment = Enum.TextYAlignment.Center
				arrLbl.ZIndex     = 8

				local ddFrame = Instance.new("Frame", wrap)
				ddFrame.Size             = u2(1,0,0,0)
				ddFrame.Position         = u2(0,0,0,38)
				ddFrame.BackgroundColor3 = T.elev
				ddFrame.ZIndex           = 20
				ddFrame.Visible          = false
				ddFrame.ClipsDescendants = true
				ddFrame.BorderSizePixel  = 0
				mkCorner(ddFrame, 7)
				mkStroke(ddFrame, T.acc, 1, 0.5)

				local ddScroll = mkScroll(ddFrame)
				mkPad(ddScroll, 4,4,4,4)
				mkList(ddScroll, nil, 2)

				local optFns = {}

				local function refreshSelLabel()
					if multi then
						local keys = {}
						for k in pairs(sel) do keys[#keys+1] = k end
						selLbl.Text = #keys == 0 and "None" or table.concat(keys, ", ")
					else
						selLbl.Text = sel or "Select..."
					end
				end

				local function isSel(opt)
					return multi and sel[opt] == true or sel == opt
				end

				local function buildOption(opt)
					local ob = Instance.new("TextButton", ddScroll)
					ob.Size             = u2(1,0,0,28)
					ob.BackgroundColor3 = T.elev
					ob.BackgroundTransparency = 1
					ob.Text             = ""
					ob.ZIndex           = 21
					ob.BorderSizePixel  = 0
					mkCorner(ob, 5)

					local ol = Instance.new("TextLabel", ob)
					ol.BackgroundTransparency = 1
					ol.Text       = opt
					ol.TextSize   = 12
					ol.TextColor3 = T.txt
					ol.Font       = Enum.Font.Gotham
					ol.Position   = u2(0,10,0.5,-7)
					ol.AutomaticSize = Enum.AutomaticSize.XY
					ol.ZIndex     = 22

					local ck = Instance.new("TextLabel", ob)
					ck.BackgroundTransparency = 1
					ck.Text       = "✓"
					ck.TextSize   = 12
					ck.TextColor3 = T.acc
					ck.Font       = Enum.Font.GothamBold
					ck.Size       = u2(0,20,1,0)
					ck.Position   = u2(1,-26,0,0)
					ck.TextXAlignment = Enum.TextXAlignment.Center
					ck.TextYAlignment = Enum.TextYAlignment.Center
					ck.TextTransparency = 1
					ck.ZIndex     = 22

					local function refresh()
						local active = isSel(opt)
						tw(ob, {BackgroundColor3 = active and T.accDim or T.elev, BackgroundTransparency = active and 0.5 or 1}, 0.1)
						tw(ol, {TextColor3 = active and T.white or T.txt}, 0.1)
						tw(ck, {TextTransparency = active and 0 or 1}, 0.1)
					end
					refresh()
					optFns[opt] = refresh

					cn(ob.MouseButton1Click, function()
						ripple(ob)
						if multi then
							if sel[opt] then sel[opt] = nil else sel[opt] = true end
							refresh()
							refreshSelLabel()
							local out = {}
							for k in pairs(sel) do out[#out+1] = k end
							task.spawn(pcall, cb, out)
						else
							sel = opt
							for _, fn in pairs(optFns) do fn() end
							refreshSelLabel()
							task.spawn(pcall, cb, opt)
						end
					end)
					cn(ob.MouseEnter, function() tw(ob, {BackgroundTransparency = isSel(opt) and 0.4 or 0.75}, 0.08) end)
					cn(ob.MouseLeave, function() tw(ob, {BackgroundTransparency = isSel(opt) and 0.5 or 1}, 0.08) end)
				end

				for _, o in ipairs(opts) do buildOption(o) end

				cn(row.InputBegan, function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
					open = not open
					if open then
						local h = math.min(#opts * 30 + 8, 160)
						ddFrame.Visible = true
						ddFrame.Size    = u2(1,0,0,0)
						tw(ddFrame, {Size=u2(1,0,0,h)}, 0.2, Enum.EasingStyle.Back)
						tw(arrLbl,  {Rotation=180}, 0.2)
						wrap.Size = u2(1,0,0, 38 + h)
					else
						tw(ddFrame, {Size=u2(1,0,0,0)}, 0.14)
						tw(arrLbl,  {Rotation=0}, 0.14)
						task.delay(0.15, function()
							if not open then ddFrame.Visible = false end
						end)
						wrap.Size = u2(1,0,0,36)
					end
				end)

				local obj = {}
				function obj:Set(v)
					if multi then sel={}; for _,k in ipairs(v) do sel[k]=true end
					else sel=v end
					for _, fn in pairs(optFns) do fn() end
					refreshSelLabel()
				end
				function obj:Refresh(newOpts)
					for _, c2 in ipairs(ddScroll:GetChildren()) do
						if c2:IsA("TextButton") then c2:Destroy() end
					end
					table.clear(optFns)
					opts = newOpts
					for _, o in ipairs(opts) do buildOption(o) end
				end
				function obj:Get() return sel end
				return obj
			end

