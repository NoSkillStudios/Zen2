		if activeTab == name then return end
		activeTab = name
		for n, pg in pairs(pages) do
			local btn = tabBtns[n]
			local lbl = tabLabels[n]
			local bar = tabBars[n]
			if n == name then
				pg.Visible = true
				if btn then tw(btn, {BackgroundColor3=T.elev, BackgroundTransparency=0}, 0.15) end
				if lbl then tw(lbl, {TextColor3=T.txt}, 0.15) end
				if bar then tw(bar, {BackgroundTransparency=0}, 0.15) end
			else
				if btn then tw(btn, {BackgroundColor3=T.side, BackgroundTransparency=1}, 0.15) end
				if lbl then tw(lbl, {TextColor3=T.sub}, 0.15) end
				if bar then tw(bar, {BackgroundTransparency=1}, 0.15) end
				task.delay(0.15, function()
					if activeTab ~= n and pg and pg.Parent then
						pg.Visible = false
					end
				end)
			end
		end
	end

