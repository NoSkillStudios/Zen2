				wrap.ClipsDescendants = false
				wrap.BorderSizePixel  = 0

				local r = Instance.new("Frame", wrap)
				r.Size             = u2(1,0,0,38)
				r.BackgroundColor3 = T.elev
				r.ZIndex           = 30
				r.BorderSizePixel  = 0
				corner(r, 8)
				local rS = stroke(r, T.bordFaint, 1)

				cn(r.MouseEnter, function() tw(r,{BackgroundColor3=T.elevHov},0.14) end)
				cn(r.MouseLeave, function() tw(r,{BackgroundColor3=T.elev},0.14) end)

				rowLabel(r, cfg2.Title or "Dropdown")
				descIcon(r, cfg2.Description)

				local arrowLbl = Instance.new("TextLabel", r)
				arrowLbl.BackgroundTransparency = 1
				arrowLbl.Text       = "⌄"
				arrowLbl.TextSize   = 15
				arrowLbl.TextColor3 = T.sub
				arrowLbl.Font       = Enum.Font.GothamBold
				arrowLbl.Size       = u2(0,22,1,0)
				arrowLbl.Position   = u2(1,-26,0,0)
				arrowLbl.TextXAlignment = Enum.TextXAlignment.Center
				arrowLbl.TextYAlignment = Enum.TextYAlignment.Center
				arrowLbl.ZIndex     = 32

				local selLbl = Instance.new("TextLabel", r)
				selLbl.BackgroundTransparency = 1
				selLbl.Text       = multi and "None" or (sel or "Select…")
				selLbl.TextSize   = 11
				selLbl.TextColor3 = T.accGlow
				selLbl.Font       = Enum.Font.Gotham
				selLbl.Size       = u2(0.42,0,1,0)
				selLbl.Position   = u2(0.42,0,0,0)
				selLbl.TextXAlignment = Enum.TextXAlignment.Right
				selLbl.ZIndex     = 31

				if multi then
					local mt = Instance.new("Frame", r)
					mt.Size             = u2(0,38,0,18)
					mt.Position         = u2(1,-66,0.5,-9)
					mt.BackgroundColor3 = T.accDeep
					mt.ZIndex           = 31
					mt.BorderSizePixel  = 0
					corner(mt, 4)
					local mtl = Instance.new("TextLabel", mt)
					mtl.BackgroundTransparency = 1
					mtl.Text       = "MULTI"
					mtl.TextSize   = 8
					mtl.TextColor3 = T.accGlow
					mtl.Font       = Enum.Font.GothamBold
					mtl.Size       = u2(1,0,1,0)
					mtl.TextXAlignment = Enum.TextXAlignment.Center
					mtl.TextYAlignment = Enum.TextYAlignment.Center
					mtl.ZIndex     = 32
				end

				-- Dropdown panel
				local ddFrame = Instance.new("Frame", wrap)
				ddFrame.Size             = u2(1,0,0,0)
				ddFrame.Position         = u2(0,0,0,41)
				ddFrame.BackgroundColor3 = c3(16,16,26)
				ddFrame.ZIndex           = 50
				ddFrame.Visible          = false
				ddFrame.ClipsDescendants = true
				ddFrame.BorderSizePixel  = 0
				corner(ddFrame, 9)
				stroke(ddFrame, T.acc, 1)

				local ddScroll = scroll(ddFrame)
				pad(ddScroll, 4,4,4,4)
				list(ddScroll, nil, 2)

				local optFns = {}

				local function refreshSelLabel()
					if multi then
						local keys = {}
						for k in pairs(sel) do keys[#keys+1]=k end
						selLbl.Text = #keys==0 and "None"
							or (#keys==1 and keys[1] or #keys.." selected")
					else
						selLbl.Text = sel or "Select…"
					end
				end
				local function isSel(o) return multi and sel[o]==true or sel==o end

				local closeFn
				closeFn = function()
					if not open then return end
					open = false
					tw(arrowLbl, {TextColor3=T.sub, TextSize=15}, 0.15)
					arrowLbl.Text = "⌄"
					rS.Color = T.bordFaint
					tw(ddFrame, {Size=u2(1,0,0,0)}, 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, function()
						if not open and ddFrame and ddFrame.Parent then ddFrame.Visible=false end
					end)
					tw(wrap, {Size=u2(1,0,0,38)}, 0.2, Enum.EasingStyle.Quart)
				end
				_dropdowns[#_dropdowns+1] = closeFn

				local function buildOpt(opt)
					local ob = Instance.new("TextButton", ddScroll)
					ob.Size             = u2(1,0,0,ITEM_H)
					ob.BackgroundColor3 = c3(16,16,26)
					ob.BackgroundTransparency = 1
					ob.Text             = ""
					ob.ZIndex           = 51
					ob.BorderSizePixel  = 0
					corner(ob, 6)

					local ol = lbl(ob, opt, 12, T.txt, Enum.Font.Gotham)
					ol.Position = u2(0,10,0.5,-6)
					ol.ZIndex   = 52

					local ck = Instance.new("TextLabel", ob)
					ck.BackgroundTransparency = 1
					ck.Text       = "✓"
					ck.TextSize   = 11
					ck.TextColor3 = T.acc
					ck.Font       = Enum.Font.GothamBold
					ck.Size       = u2(0,22,1,0)
					ck.Position   = u2(1,-26,0,0)
					ck.TextXAlignment = Enum.TextXAlignment.Center
					ck.TextYAlignment = Enum.TextYAlignment.Center
					ck.TextTransparency = 1
					ck.ZIndex     = 52

					local function refreshOpt()
						local active = isSel(opt)
						tw(ob, {BackgroundColor3=active and T.accDeep or c3(16,16,26), BackgroundTransparency=active and 0 or 1}, 0.13)
						tw(ol, {TextColor3=active and T.white or T.txt}, 0.13)
						tw(ck, {TextTransparency=active and 0 or 1}, 0.13)
					end
					refreshOpt()
					optFns[opt] = refreshOpt

					cn(ob.MouseEnter, function() tw(ob,{BackgroundColor3=T.elev,BackgroundTransparency=0},0.1) end)
					cn(ob.MouseLeave, function()
						local active=isSel(opt)
						tw(ob,{BackgroundColor3=active and T.accDeep or c3(16,16,26),BackgroundTransparency=active and 0 or 1},0.1)
					end)
					cn(ob.MouseButton1Click, function()
						if multi then
							if sel[opt] then sel[opt]=nil else sel[opt]=true end
							refreshOpt(); refreshSelLabel()
							local out={} for k in pairs(sel) do out[#out+1]=k end
							task.spawn(pcall,cb,out)
						else
							sel=opt
							for _,fn in pairs(optFns) do fn() end
							refreshSelLabel()
							task.spawn(pcall,cb,opt)
							task.delay(0.08, closeFn)
						end
					end)
				end
				for _,o in ipairs(opts) do buildOpt(o) end

				local function openDD()
					closeAllDropdowns(closeFn)
					open=true
					local h = math.min(#opts*ITEM_H+8, MAX_H)
					ddFrame.Visible=true; ddFrame.Size=u2(1,0,0,0)
					tw(ddFrame, {Size=u2(1,0,0,h)}, 0.28, Enum.EasingStyle.Back)
					tw(wrap, {Size=u2(1,0,0,42+h)}, 0.28, Enum.EasingStyle.Back)
					tw(arrowLbl, {TextColor3=T.accGlow, TextSize=13}, 0.15)
					arrowLbl.Text = "⌃"
					rS.Color = T.acc
				end

				cn(r.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					if open then closeFn() else openDD() end
				end)

				local obj = {}
				function obj:Set(v)
					if multi then sel={}; for _,k in ipairs(v) do sel[k]=true end else sel=v end
					for _,fn in pairs(optFns) do fn() end; refreshSelLabel()
				end
				function obj:Refresh(newOpts)
					for _,c2 in ipairs(ddScroll:GetChildren()) do
						if c2:IsA("TextButton") then c2:Destroy() end
					end
					table.clear(optFns); opts=newOpts
					for _,o in ipairs(opts) do buildOpt(o) end
				end
				function obj:Get() return sel end
				return obj
			end

