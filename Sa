				local obj = {}
				function obj:Set(c2) cur=c2; h2,s2,v2v=Color3.toHSV(c2); updatePicker() end
				function obj:Get() return cur end
				return obj
			end

			function S:CreateLabel(text, col, ico)
				local row = mkRow(32)
				if ico then rowIcon(row, ico) end
				local l = Instance.new("TextLabel", row)
				l.BackgroundTransparency = 1
				l.Text = text or ""
				l.TextSize = 11
				l.TextColor3 = col or th.sub
				l.Font = Enum.Font.Gotham
				l.Position = u2(0, ico and 36 or 12, 0.5, -7)
				l.ZIndex = 8
				l.BorderSizePixel = 0
				l.AutomaticSize = Enum.AutomaticSize.XY
				local obj = {}
				function obj:Set(t, c2) l.Text=t; if c2 then l.TextColor3=c2 end end
				return obj
			end

			function S:CreateStatDisplay(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local ico = cfg2.Icon or "◎"
				local prefix = cfg2.Prefix or ""
				local suffix = cfg2.Suffix or ""
				local row = mkRow(38)
				rowIcon(row, ico)
				rowLabel(row, cfg2.Title or "Stat", 36)

				local valF = frame(row, th.winDeep)
				valF.Size = u2(0, 110, 0, 24)
				valF.Position = u2(1, -118, 0.5, -12)
				valF.ZIndex = 9
				corner(valF, 5)
				stroke(valF, th.border, 1, 0.5)

				local prefLbl = Instance.new("TextLabel", valF)
				prefLbl.BackgroundTransparency = 1
				prefLbl.Text = prefix
				prefLbl.TextSize = 9
				prefLbl.TextColor3 = th.muted
				prefLbl.Font = Enum.Font.Gotham
				prefLbl.Position = u2(0, 6, 0.5, -6)
				prefLbl.ZIndex = 10
				prefLbl.BorderSizePixel = 0
				prefLbl.AutomaticSize = Enum.AutomaticSize.XY

				local statLbl = Instance.new("TextLabel", valF)
				statLbl.BackgroundTransparency = 1
				statLbl.Text = cfg2.Value or "—"
				statLbl.TextSize = 11
				statLbl.TextColor3 = th.acc
				statLbl.Font = Enum.Font.GothamBold
				statLbl.Size = u2(1, -12, 1, 0)
				statLbl.Position = u2(0, 6, 0, 0)
				if prefix ~= "" then statLbl.Position = u2(0, 28, 0, 0) end
				statLbl.TextXAlignment = Enum.TextXAlignment.Left
				statLbl.TextYAlignment = Enum.TextYAlignment.Center
				statLbl.ZIndex = 10
				statLbl.BorderSizePixel = 0

				local sufLbl = Instance.new("TextLabel", valF)
				sufLbl.BackgroundTransparency = 1
				sufLbl.Text = suffix
				sufLbl.TextSize = 9
				sufLbl.TextColor3 = th.muted
				sufLbl.Font = Enum.Font.Gotham
				sufLbl.Position = u2(1, -6, 0.5, -6)
				sufLbl.AnchorPoint = v2(1, 0)
				sufLbl.ZIndex = 10
				sufLbl.BorderSidePixel = 0
				sufLbl.AutomaticSize = Enum.AutomaticSize.XY
				sufLbl.TextXAlignment = Enum.TextXAlignment.Right

				if cfg2.Change then
					local changeLbl = Instance.new("TextLabel", row)
					changeLbl.BackgroundTransparency = 1
					changeLbl.Text = cfg2.Change
					changeLbl.TextSize = 9
					changeLbl.TextColor3 = th.success
					changeLbl.Font = Enum.Font.Gotham
					changeLbl.Size = u2(0, 60, 0, 14)
					changeLbl.Position = u2(1, -184, 0.5, -7)
					changeLbl.TextXAlignment = Enum.TextXAlignment.Right
					changeLbl.ZIndex = 9
					changeLbl.BorderSizePixel = 0
				end

				local obj = {}
				function obj:Set(v)
					statLbl.Text = tostring(v)
				end
				function obj:Get() return statLbl.Text end
				return obj
			end

			function S:CreateDivider()
				local d = frame(secBody, th.borderLo)
				d.Size = u2(1, -20, 0, 1)
				d.LayoutOrder = eo()
				d.ZIndex = 7
				d.BackgroundTransparency = 0.3
			end

			return S
		end

		return Tab
	end

	local minimized = false
	gc(minBtn.MouseButton1Click, function()
		minimized = not minimized
		tw(win, {Size = minimized and u2(0,winW,0,42) or u2(0,winW,0,winH)}, 0.22, Enum.EasingStyle.Back)
	end)

	gc(closeBtn.MouseButton1Click, function()
		tw(win, {Size = u2(0,winW,0,0), BackgroundTransparency=1}, 0.18)
		task.delay(0.2, function() gui:Destroy() end)
	end)

	gc(uis.InputBegan, function(i, gp)
		if gp then return end
		if i.KeyCode == tKey then
			win.Visible = not win.Visible
		end
	end)

	win.Size = u2(0, winW, 0, 0)
	tw(win, {Size = u2(0, winW, 0, winH)}, 0.28, Enum.EasingStyle.Back)

	W._gui  = gui
	W._win  = win
	return W
end

return KrakenUI
