			function S:CreateColorPicker(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local n = cfg2.Title or "Color"
				local def = cfg2.Default or c3(99,102,241)
				local cb = cfg2.Callback or function() end

				local h,s,v2val = Color3.toHSV(def)
				local currentColor = def
				local pickerOpen = false
				local draggingSv, draggingH = false, false

				local wrap = Instance.new("Frame", secContent)
				wrap.Size = u2(1,0,0,36)
				wrap.BackgroundTransparency = 1
				wrap.LayoutOrder = so()
				wrap.ZIndex = 7
				wrap.ClipsDescendants = false

				local row = Instance.new("Frame", wrap)
				row.Size = u2(1,0,0,36)
				row.BackgroundColor3 = theme.elevated
				row.ZIndex = 7
				corner(row, 7)
				stroke(row, theme.border, 1, 0.6)

				local lbl = label(row, n, 12, theme.text, Enum.Font.GothamMedium)
				lbl.Position = u2(0,12,0.5,-7)
				lbl.ZIndex = 8

				local preview = Instance.new("Frame", row)
				preview.Size = u2(0,60,0,22)
