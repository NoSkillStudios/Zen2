				hitBtn.BackgroundTransparency = 1
				hitBtn.Text             = ""
				hitBtn.ZIndex           = 9
				hitBtn.BorderSizePixel  = 0

				-- RUN label on the right (no button border, just text)
				local runLbl = Instance.new("TextLabel", r)
				runLbl.BackgroundTransparency = 1
				runLbl.Text       = "Button"
				runLbl.TextSize   = 11
				runLbl.TextColor3 = T.sub
				runLbl.Font       = Enum.Font.GothamMedium
				runLbl.Size       = u2(0,60,1,0)
				runLbl.Position   = u2(1,-70,0,0)
				runLbl.TextXAlignment = Enum.TextXAlignment.Right
				runLbl.TextYAlignment = Enum.TextYAlignment.Center
				runLbl.ZIndex     = 9

				-- hover white highlight
				cn(hitBtn.MouseEnter, function()
					tw(r, {BackgroundColor3=c3(38,38,55)}, 0.12)
					tw(runLbl, {TextColor3=T.white}, 0.12)
					if desc then showTip(desc, r) end
				end)
				cn(hitBtn.MouseLeave, function()
					tw(r, {BackgroundColor3=T.elev}, 0.12)
					tw(runLbl, {TextColor3=T.sub}, 0.12)
					hideTip()
				end)
				cn(hitBtn.MouseButton1Click, function()
					ripple(r)
					tw(r, {BackgroundColor3=T.accSel}, 0.1)
					task.delay(0.2, function() if r and r.Parent then tw(r,{BackgroundColor3=T.elev},0.18) end end)
					task.spawn(pcall, cb)
				end)
			end

			-- ── TOGGLE (whole row clickable, toggle on right, text label left) ─
			function S:CreateToggle(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb    = cfg2.Callback or function() end
				local desc  = cfg2.Description
				local state = cfg2.Default  or false
				local r     = row(36)
				rLbl(r, cfg2.Title or "Toggle", 12)

				-- right label (shows "Switch" dimmed)
				local swLbl = Instance.new("TextLabel", r)
				swLbl.BackgroundTransparency = 1
				swLbl.Text       = "Switch"
				swLbl.TextSize   = 11
				swLbl.TextColor3 = T.sub
				swLbl.Font       = Enum.Font.GothamMedium
				swLbl.Size       = u2(0,46,1,0)
				swLbl.Position   = u2(1,-112,0,0)
				swLbl.TextXAlignment = Enum.TextXAlignment.Right
				swLbl.TextYAlignment = Enum.TextYAlignment.Center
				swLbl.ZIndex     = 9

				local track = Instance.new("Frame", r)
				track.Size             = u2(0,44,0,24)
				track.Position         = u2(1,-56,0.5,-12)
				track.BackgroundColor3 = state and T.acc or T.muted
				track.ZIndex           = 9
				track.BorderSizePixel  = 0
				corner(track, 999)

				local knob = Instance.new("Frame", track)
				knob.Size             = u2(0,18,0,18)
				knob.Position         = u2(0,state and 22 or 3,0.5,-9)
				knob.BackgroundColor3 = T.white
				knob.ZIndex           = 10
				knob.BorderSizePixel  = 0
				corner(knob, 999)

				local function set(v, silent)
					state = v
					tw(track,{BackgroundColor3=v and T.acc or T.muted},0.22)
					tw(knob, {Position=u2(0,v and 22 or 3,0.5,-9)},0.25,Enum.EasingStyle.Back)
					if not silent then task.spawn(pcall,cb,v) end
				end
				set(state,true)

				-- entire row hit area
				local hitBtn = Instance.new("TextButton", r)
				hitBtn.Size             = u2(1,0,1,0)
				hitBtn.BackgroundTransparency = 1
				hitBtn.Text             = ""
				hitBtn.ZIndex           = 11
				hitBtn.BorderSizePixel  = 0

				cn(hitBtn.MouseEnter, function()
					tw(r,{BackgroundColor3=c3(28,28,42)},0.12)
					if desc then showTip(desc,r) end
				end)
				cn(hitBtn.MouseLeave, function()
					tw(r,{BackgroundColor3=T.elev},0.12)
					hideTip()
				end)
				cn(hitBtn.MouseButton1Click, function()
					ripple(r)
					set(not state)
				end)

				local obj = {}
				function obj:Set(v) set(v,false) end
				function obj:Get() return state end
				return obj
			end

			-- ── SLIDER (unique style: segmented track + floating value badge) ─
			function S:CreateSlider(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb       = cfg2.Callback or function() end
				local mn       = cfg2.Min    or 0
				local mx       = cfg2.Max    or 100
				local suf      = cfg2.Suffix or ""
				local val      = math.clamp(cfg2.Default or mn, mn, mx)
				local desc     = cfg2.Description
				local sliding  = false

				local r = row(56)
				r.ClipsDescendants = false

				-- title left
				local ntl = lbl(r, cfg2.Title or "Slider", 12, T.txt, Enum.Font.GothamMedium)
				ntl.Position = u2(0,12,0,8)
				ntl.ZIndex   = 9

				-- value badge floating above track (unique style)
				local valBadge = Instance.new("Frame", r)
				valBadge.Size             = u2(0,52,0,20)
				valBadge.BackgroundColor3 = T.accDim
				valBadge.ZIndex           = 12
				valBadge.BorderSizePixel  = 0
				corner(valBadge, 5)
				local valTxt = Instance.new("TextLabel", valBadge)
				valTxt.BackgroundTransparency = 1
				valTxt.Text       = tostring(val)..suf
				valTxt.TextSize   = 11
				valTxt.TextColor3 = T.accGlow
				valTxt.Font       = Enum.Font.GothamBold
				valTxt.Size       = u2(1,0,1,0)
				valTxt.TextXAlignment = Enum.TextXAlignment.Center
				valTxt.TextYAlignment = Enum.TextYAlignment.Center
				valTxt.ZIndex     = 13

				-- numeric input right side
				local numBox = Instance.new("TextBox", r)
				numBox.Size             = u2(0,50,0,20)
				numBox.Position         = u2(1,-58,0,7)
				numBox.BackgroundColor3 = T.bgDeep
				numBox.TextColor3       = T.accGlow
				numBox.Text             = tostring(val)
				numBox.TextSize         = 10
				numBox.Font             = Enum.Font.GothamBold
				numBox.ZIndex           = 9
				numBox.BorderSizePixel  = 0
				numBox.TextXAlignment   = Enum.TextXAlignment.Center
				numBox.ClearTextOnFocus = false
				corner(numBox, 5)
				stroke(numBox, T.bord, 1)

				-- track bg
				local trackBg = Instance.new("Frame", r)
				trackBg.Size             = u2(1,-24,0,5)
				trackBg.Position         = u2(0,12,0,40)
				trackBg.BackgroundColor3 = T.bgDeep
				trackBg.ZIndex           = 9
				trackBg.BorderSizePixel  = 0
				corner(trackBg, 999)

				local fill = Instance.new("Frame", trackBg)
				fill.Size             = u2((val-mn)/(mx-mn),0,1,0)
				fill.BackgroundColor3 = T.acc
				fill.ZIndex           = 10
				fill.BorderSizePixel  = 0
				corner(fill, 999)
				local fg = Instance.new("UIGradient", fill)
				fg.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.acc),ColorSequenceKeypoint.new(1,T.accGlow)}

				-- dot handle
				local dot = Instance.new("Frame", trackBg)
				dot.Size             = u2(0,13,0,13)
				dot.AnchorPoint      = v2(0.5,0.5)
				dot.Position         = u2((val-mn)/(mx-mn),0,0.5,0)
				dot.BackgroundColor3 = T.white
				dot.ZIndex           = 11
				dot.BorderSizePixel  = 0
				corner(dot, 999)
				local dotSt = Instance.new("UIStroke", dot)
				dotSt.Color     = T.acc
				dotSt.Thickness = 0
				dotSt.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

				-- position value badge above dot
				local function repositionBadge(pct)
					local trackW = trackBg.AbsoluteSize.X
					local dotX   = pct * trackW
					valBadge.Position = u2(0, 12 + dotX - 26, 0, 14)
				end

				local function setVal(nv, silent, instant)
					local prev = val
					val = math.clamp(math.round(nv), mn, mx)
					local pct = (val-mn)/(mx-mn)
					if instant then
						fill.Size    = u2(pct,0,1,0)
						dot.Position = u2(pct,0,0.5,0)
					else
						tw(fill, {Size=u2(pct,0,1,0)},      0.2, Enum.EasingStyle.Quart)
						tw(dot,  {Position=u2(pct,0,0.5,0)},0.2, Enum.EasingStyle.Quart)
					end
					valTxt.Text    = tostring(val)..suf
					numBox.Text    = tostring(val)
					repositionBadge(pct)
					if not silent and val~=prev then task.spawn(pcall,cb,val) end
				end

				local function mouseSet(inp)
					if not trackBg or not trackBg.Parent then return end
					local ax = trackBg.AbsolutePosition.X
					local aw = trackBg.AbsoluteSize.X
					if aw==0 then return end
					local pct = math.clamp((inp.Position.X-ax)/aw,0,1)
					local nv  = math.round(mn+pct*(mx-mn))
					if nv==val then return end
					val = nv
					local p2 = (val-mn)/(mx-mn)
					fill.Size    = u2(p2,0,1,0)
					dot.Position = u2(p2,0,0.5,0)
					valTxt.Text  = tostring(val)..suf
					numBox.Text  = tostring(val)
					repositionBadge(p2)
					task.spawn(pcall,cb,val)
				end

				setVal(val, true, true)

				cn(trackBg.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					sliding=true
					tw(dot,{Size=u2(0,15,0,15)},0.12,Enum.EasingStyle.Back)
					tw(dotSt,{Thickness=2},0.12)
					tw(valBadge,{BackgroundColor3=T.acc},0.12)
					mouseSet(i)
				end)
				cn(dot.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					sliding=true
					tw(dot,{Size=u2(0,15,0,15)},0.12,Enum.EasingStyle.Back)
					tw(dotSt,{Thickness=2},0.12)
					tw(valBadge,{BackgroundColor3=T.acc},0.12)
				end)
				cn(uis.InputChanged, function(i)
					if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then mouseSet(i) end
				end)
				cn(uis.InputEnded, function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then
						sliding=false
						tw(dot,{Size=u2(0,13,0,13)},0.14)
						tw(dotSt,{Thickness=0},0.14)
						tw(valBadge,{BackgroundColor3=T.accDim},0.14)
					end
				end)
				cn(numBox.FocusLost, function(enter)
					if enter then
						local n2 = tonumber(numBox.Text)
						if n2 then setVal(n2,false,false) end
					else
						numBox.Text = tostring(val)
					end
				end)

				if desc then
					local hitArea = Instance.new("TextButton", r)
					hitArea.Size             = u2(1,0,1,0)
					hitArea.BackgroundTransparency = 1
					hitArea.Text             = ""
					hitArea.ZIndex           = 8
					hitArea.BorderSizePixel  = 0
					cn(hitArea.MouseEnter, function() showTip(desc,r) end)
					cn(hitArea.MouseLeave, function() hideTip() end)
					cn(hitArea.MouseButton1Click, function() end)
				end

				local obj = {}
				function obj:Set(v) setVal(v,false,false) end
				function obj:Get() return val end
				return obj
			end

			-- ── DROPDOWN (smooth open/close, no instant, closes on single pick) ─
			function S:CreateDropdown(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb    = cfg2.Callback or function() end
				local opts  = cfg2.Options  or {}
				local multi = cfg2.MultiSelect or false
				local sel   = multi and {} or (cfg2.Default or (opts[1] or nil))
				local desc  = cfg2.Description
				local open  = false
				local IH    = 30
				local MH    = 160

				eOrd += 1
				local wrap = Instance.new("Frame", secBody)
				wrap.Size             = u2(1,0,0,36)
				wrap.BackgroundTransparency = 1
				wrap.LayoutOrder      = eOrd
				wrap.ZIndex           = 40
				wrap.ClipsDescendants = false
				wrap.BorderSizePixel  = 0

				local r = Instance.new("Frame", wrap)
				r.Size             = u2(1,0,0,36)
				r.BackgroundColor3 = T.elev
				r.ZIndex           = 40
				r.BorderSizePixel  = 0
				corner(r, 7)
				local rStroke = stroke(r, T.bordFaint, 1)

				cn(r.MouseEnter, function() tw(r,{BackgroundColor3=c3(28,28,42)},0.14) end)
				cn(r.MouseLeave, function() tw(r,{BackgroundColor3=T.elev},0.14) end)

				local ntl = lbl(r, cfg2.Title or "Dropdown", 12, T.txt, Enum.Font.GothamMedium)
				ntl.Position = u2(0,12,0.5,-6)
				ntl.ZIndex   = 41

				local selLbl = Instance.new("TextLabel", r)
				selLbl.BackgroundTransparency = 1
				selLbl.Text       = multi and "None" or (sel or "Select...")
				selLbl.TextSize   = 11
				selLbl.TextColor3 = T.accGlow
				selLbl.Font       = Enum.Font.Gotham
				selLbl.Size       = u2(0.5,0,1,0)
				selLbl.Position   = u2(0.5,0,0,0)
				selLbl.TextXAlignment = Enum.TextXAlignment.Right
				selLbl.ZIndex     = 41

				if multi then
					local mt = Instance.new("Frame", r)
					mt.Size             = u2(0,38,0,17)
					mt.Position         = u2(1,-46,0.5,-8.5)
					mt.BackgroundColor3 = T.accDim
					mt.ZIndex           = 41
					mt.BorderSizePixel  = 0
					corner(mt, 4)
					local ml = Instance.new("TextLabel", mt)
					ml.BackgroundTransparency = 1
					ml.Text       = "MULTI"
					ml.TextSize   = 8
					ml.TextColor3 = T.accGlow
					ml.Font       = Enum.Font.GothamBold
					ml.Size       = u2(1,0,1,0)
					ml.TextXAlignment = Enum.TextXAlignment.Center
					ml.TextYAlignment = Enum.TextYAlignment.Center
					ml.ZIndex     = 42
				end

				-- dropdown panel
				local ddF = Instance.new("Frame", wrap)
				ddF.Size             = u2(1,0,0,0)
				ddF.Position         = u2(0,0,0,38)
				ddF.BackgroundColor3 = T.elev
				ddF.ZIndex           = 60
				ddF.Visible          = false
				ddF.ClipsDescendants = true
				ddF.BorderSizePixel  = 0
				corner(ddF, 8)
				stroke(ddF, T.acc, 1)

				local ddScroll = scroll(ddF)
				pad(ddScroll, 4,4,4,4)
				list(ddScroll, nil, 2)

				local optFns = {}

				local function refreshSel()
					if multi then
						local ks = {}
						for k in pairs(sel) do ks[#ks+1]=k end
						selLbl.Text = #ks==0 and "None" or (#ks==1 and ks[1] or #ks.." selected")
					else
						selLbl.Text = sel or "Select..."
					end
				end

				local function isSel(o) return multi and sel[o]==true or sel==o end

				local closeFn
				closeFn = function()
					if not open then return end
					open = false
					tw(ddF, {Size=u2(1,0,0,0)}, 0.22, Enum.EasingStyle.Quart)
					tw(r,   {BackgroundColor3=T.elev}, 0.18)
					rStroke.Color = T.bordFaint
					task.delay(0.24, function()
						if not open and ddF and ddF.Parent then ddF.Visible=false end
					end)
					wrap.Size = u2(1,0,0,36)
				end
				openDropdowns[#openDropdowns+1] = closeFn

				local function buildOpt(opt)
					local ob = Instance.new("TextButton", ddScroll)
					ob.Size             = u2(1,0,0,IH)
					ob.BackgroundColor3 = T.elev
					ob.BackgroundTransparency = 1
					ob.Text             = ""
					ob.ZIndex           = 61
					ob.BorderSizePixel  = 0
					corner(ob, 5)

					local ol = lbl(ob, opt, 12, T.txt, Enum.Font.Gotham)
					ol.Position = u2(0,10,0.5,-6)
					ol.ZIndex   = 62

					local ck = Instance.new("TextLabel", ob)
					ck.BackgroundTransparency = 1
					ck.Text       = "✓"
					ck.TextSize   = 11
					ck.TextColor3 = T.acc
					ck.Font       = Enum.Font.GothamBold
					ck.Size       = u2(0,20,1,0)
					ck.Position   = u2(1,-24,0,0)
					ck.TextXAlignment = Enum.TextXAlignment.Center
					ck.TextYAlignment = Enum.TextYAlignment.Center
					ck.TextTransparency = 1
					ck.ZIndex     = 62

					local function ref()
						local active = isSel(opt)
						tw(ob, {BackgroundColor3=active and T.accDim or T.elev, BackgroundTransparency=active and 0 or 1}, 0.15)
						tw(ol, {TextColor3=active and T.white or T.txt}, 0.15)
						tw(ck, {TextTransparency=active and 0 or 1}, 0.15)
					end
					ref(); optFns[opt] = ref

					cn(ob.MouseButton1Click, function()
						ripple(ob)
						if multi then
							if sel[opt] then sel[opt]=nil else sel[opt]=true end
							ref(); refreshSel()
							local out={}; for k in pairs(sel) do out[#out+1]=k end
							task.spawn(pcall,cb,out)
						else
							sel=opt
							for _,fn in pairs(optFns) do fn() end
							refreshSel()
							task.spawn(pcall,cb,opt)
							task.delay(0.1, closeFn)
						end
					end)
					cn(ob.MouseEnter, function()
						if not isSel(opt) then tw(ob,{BackgroundTransparency=0.75,BackgroundColor3=T.elevHov},0.1) end
					end)
					cn(ob.MouseLeave, function()
						if not isSel(opt) then tw(ob,{BackgroundTransparency=1},0.1) end
					end)
				end

				for _,o in ipairs(opts) do buildOpt(o) end

				cn(r.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					if open then
						closeFn()
					else
						closeAllDropdowns(closeFn)
						open=true
						local h = math.min(#opts*IH+8, MH)
						ddF.Visible=true
						ddF.Size=u2(1,0,0,0)
						tw(ddF,{Size=u2(1,0,0,h)},0.25,Enum.EasingStyle.Quart)
						tw(r,{BackgroundColor3=T.accSel},0.18)
						rStroke.Color = T.acc
						wrap.Size=u2(1,0,0,38+h)
					end
					if desc then showTip(desc,r) end
				end)

				local obj = {}
				function obj:Set(v)
					if multi then sel={}; for _,k in ipairs(v) do sel[k]=true end else sel=v end
					for _,fn in pairs(optFns) do fn() end; refreshSel()
				end
				function obj:Refresh(newOpts)
					for _,c2 in ipairs(ddScroll:GetChildren()) do
						if c2:IsA("TextButton") then c2:Destroy() end
					end
					table.clear(optFns); opts=newOpts
					for _,o in ipairs(opts) do buildOpt(o) end
				end
				function obj:Get() return sel end
				return obj
			end

			-- ── INPUT ──────────────────────────────────────────────────────────
			function S:CreateInput(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb   = cfg2.Callback or function() end
				local desc = cfg2.Description
				local r    = row(36)
				rLbl(r, cfg2.Title or "Input", 12)

				local box = Instance.new("TextBox", r)
				box.Size             = u2(0,158,0,24)
				box.Position         = u2(1,-166,0.5,-12)
				box.BackgroundColor3 = T.bgDeep
				box.TextColor3       = T.txt
				box.PlaceholderText  = cfg2.Placeholder or "Type..."
				box.PlaceholderColor3= T.muted
				box.Text             = cfg2.Default or ""
				box.TextSize         = 11
				box.Font             = Enum.Font.Gotham
				box.ZIndex           = 9
				box.ClearTextOnFocus = false
				box.BorderSizePixel  = 0
				corner(box, 5)
				local bkSt = stroke(box, T.bordFaint, 1)

				cn(box.Focused,   function() bkSt.Color=T.acc; tw(box,{BackgroundColor3=c3(16,16,26)},0.14) end)
				cn(box.FocusLost, function(enter)
					bkSt.Color=T.bordFaint; tw(box,{BackgroundColor3=T.bgDeep},0.14)
					if enter then
						local v = cfg2.Numeric and tonumber(box.Text) or box.Text
						if v~=nil then task.spawn(pcall,cb,v) end
					end
				end)

				if desc then
					cn(box.MouseEnter, function() showTip(desc,r) end)
					cn(box.MouseLeave, function() hideTip() end)
				end

				local obj = {}
				function obj:Set(v) box.Text=tostring(v) end
				function obj:Get() return box.Text end
				return obj
			end

			-- ── KEYBIND (style: "Key" label right, click to set) ──────────────
			function S:CreateKeybind(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb        = cfg2.Callback or function() end
				local desc      = cfg2.Description
				local bound     = cfg2.Default  or Enum.KeyCode.Unknown
				local listening = false
				local r         = row(36)
				rLbl(r, cfg2.Title or "Keybind", 12)

				-- "Key" dim text label right side (like sc9)
				local keyLabel = Instance.new("TextLabel", r)
				keyLabel.BackgroundTransparency = 1
				keyLabel.Text       = "Key"
				keyLabel.TextSize   = 11
				keyLabel.TextColor3 = T.sub
				keyLabel.Font       = Enum.Font.GothamMedium
				keyLabel.Size       = u2(0,40,1,0)
				keyLabel.Position   = u2(1,-130,0,0)
				keyLabel.TextXAlignment = Enum.TextXAlignment.Right
				keyLabel.TextYAlignment = Enum.TextYAlignment.Center
				keyLabel.ZIndex     = 9

				local kbtn = Instance.new("TextButton", r)
				kbtn.Size             = u2(0,80,0,24)
				kbtn.Position         = u2(1,-88,0.5,-12)
				kbtn.BackgroundColor3 = T.bgDeep
				kbtn.Text             = bound.Name
				kbtn.TextColor3       = T.acc
				kbtn.TextSize         = 10
				kbtn.Font             = Enum.Font.GothamBold
				kbtn.ZIndex           = 9
				kbtn.BorderSizePixel  = 0
				corner(kbtn, 5)
				local kbSt = stroke(kbtn, T.bordFaint, 1)

				local hitBtn = Instance.new("TextButton", r)
				hitBtn.Size             = u2(1,0,1,0)
				hitBtn.BackgroundTransparency = 1
				hitBtn.Text             = ""
				hitBtn.ZIndex           = 10
				hitBtn.BorderSizePixel  = 0

				cn(hitBtn.MouseEnter, function()
					tw(r,{BackgroundColor3=c3(28,28,42)},0.12)
					if desc then showTip(desc,r) end
				end)
				cn(hitBtn.MouseLeave, function()
					tw(r,{BackgroundColor3=T.elev},0.12)
					hideTip()
				end)
				cn(hitBtn.MouseButton1Click, function()
					listening=true
					kbtn.Text="..."
					kbSt.Color=T.acc
					tw(kbtn,{BackgroundColor3=T.accDim},0.14)
				end)
				cn(uis.InputBegan, function(i,gp)
					if gp then return end
					if listening then
						if i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode~=Enum.KeyCode.Unknown then
							listening=false; bound=i.KeyCode
							kbtn.Text=i.KeyCode.Name
							kbSt.Color=T.bordFaint
							tw(kbtn,{BackgroundColor3=T.bgDeep},0.14)
						end
					elseif i.KeyCode==bound then
						task.spawn(pcall,cb)
					end
				end)

				local obj = {}
				function obj:Set(k) bound=k; kbtn.Text=k.Name end
				function obj:Get() return bound end
				return obj
			end

			-- ── COLOR PICKER ──────────────────────────────────────────────────
			function S:CreateColorPicker(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb   = cfg2.Callback or function() end
				local desc = cfg2.Description
				local def  = cfg2.Default  or c3(120,72,252)
				local hv,sv,vv = Color3.toHSV(def)
				local cur  = def
				local pOpen,dSv,dH = false,false,false

				eOrd += 1
				local wrap = Instance.new("Frame", secBody)
				wrap.Size             = u2(1,0,0,36)
				wrap.BackgroundTransparency = 1
				wrap.LayoutOrder      = eOrd
				wrap.ZIndex           = 20
				wrap.ClipsDescendants = false
				wrap.BorderSizePixel  = 0

				local r = Instance.new("Frame", wrap)
				r.Size             = u2(1,0,0,36)
				r.BackgroundColor3 = T.elev
				r.ZIndex           = 20
				r.BorderSizePixel  = 0
				corner(r, 7)
				stroke(r, T.bordFaint, 1)
				cn(r.MouseEnter, function() tw(r,{BackgroundColor3=c3(28,28,42)},0.14) end)
				cn(r.MouseLeave, function() tw(r,{BackgroundColor3=T.elev},0.14) end)

				local ntl3 = lbl(r, cfg2.Title or "Color", 12, T.txt, Enum.Font.GothamMedium)
				ntl3.Position = u2(0,12,0.5,-6)
				ntl3.ZIndex   = 21

				local hexTiny = Instance.new("TextLabel", r)
				hexTiny.BackgroundTransparency = 1
				hexTiny.Text       = ""
				hexTiny.TextSize   = 10
				hexTiny.TextColor3 = T.sub
				hexTiny.Font       = Enum.Font.GothamMedium
				hexTiny.Position   = u2(1,-120,0.5,-5)
				hexTiny.Size       = u2(0,54,0,10)
				hexTiny.TextXAlignment = Enum.TextXAlignment.Center
				hexTiny.ZIndex     = 21

				local prev = Instance.new("Frame", r)
				prev.Size             = u2(0,50,0,22)
				prev.Position         = u2(1,-58,0.5,-11)
				prev.BackgroundColor3 = cur
				prev.ZIndex           = 21
				prev.BorderSizePixel  = 0
				corner(prev, 5)
				stroke(prev, T.bord, 1)

				local pkF = Instance.new("Frame", wrap)
				pkF.Size             = u2(1,0,0,0)
				pkF.Position         = u2(0,0,0,38)
				pkF.BackgroundColor3 = T.elev
				pkF.ZIndex           = 22
				pkF.Visible          = false
				pkF.ClipsDescendants = true
				pkF.BorderSizePixel  = 0
				corner(pkF, 9)
				stroke(pkF, T.acc, 1)

				local svF = Instance.new("Frame", pkF)
				svF.Size             = u2(1,-46,0,115)
				svF.Position         = u2(0,8,0,8)
				svF.ZIndex           = 23
				svF.BorderSizePixel  = 0
				corner(svF, 6)
				local svGrad = Instance.new("UIGradient", svF)
				svGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.white),ColorSequenceKeypoint.new(1,Color3.fromHSV(hv,1,1))}
				local svDark = Instance.new("Frame", svF)
				svDark.Size             = u2(1,0,1,0)
				svDark.BackgroundColor3 = T.black
				svDark.ZIndex           = 24
				svDark.BorderSizePixel  = 0
				corner(svDark, 6)
				local sdg = Instance.new("UIGradient", svDark)
				sdg.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}
				sdg.Rotation = 90
				local svDot = Instance.new("Frame", svF)
				svDot.Size             = u2(0,13,0,13)
				svDot.AnchorPoint      = v2(0.5,0.5)
				svDot.Position         = u2(sv,0,1-vv,0)
				svDot.BackgroundColor3 = T.white
				svDot.ZIndex           = 26
				svDot.BorderSizePixel  = 0
				corner(svDot, 999)
				stroke(svDot, T.white, 2)

				local hBar = Instance.new("Frame", pkF)
				hBar.Size             = u2(0,18,0,115)
				hBar.Position         = u2(1,-30,0,8)
				hBar.ZIndex           = 23
				hBar.BorderSizePixel  = 0
				corner(hBar, 5)
				local hGrad = Instance.new("UIGradient", hBar)
				hGrad.Color = ColorSequence.new{
					ColorSequenceKeypoint.new(0,    c3(255,0,0)),
					ColorSequenceKeypoint.new(0.166,c3(255,255,0)),
					ColorSequenceKeypoint.new(0.333,c3(0,255,0)),
					ColorSequenceKeypoint.new(0.5,  c3(0,255,255)),
					ColorSequenceKeypoint.new(0.666,c3(0,0,255)),
					ColorSequenceKeypoint.new(0.833,c3(255,0,255)),
					ColorSequenceKeypoint.new(1,    c3(255,0,0)),
				}
				hGrad.Rotation = 90
				local hDot = Instance.new("Frame", hBar)
				hDot.Size             = u2(1,6,0,5)
				hDot.Position         = u2(0,-3,hv,-2.5)
				hDot.BackgroundColor3 = T.white
				hDot.ZIndex           = 25
				hDot.BorderSizePixel  = 0
				corner(hDot, 3)

				local hexBox = Instance.new("TextBox", pkF)
				hexBox.Size             = u2(1,-16,0,26)
				hexBox.Position         = u2(0,8,0,130)
				hexBox.BackgroundColor3 = T.bgDeep
				hexBox.TextColor3       = T.txt
				hexBox.TextSize         = 11
				hexBox.Font             = Enum.Font.GothamMedium
				hexBox.ZIndex           = 23
				hexBox.BorderSizePixel  = 0
				hexBox.TextXAlignment   = Enum.TextXAlignment.Center
				corner(hexBox, 5)
				stroke(hexBox, T.bordFaint, 1)

				local function upd()
					cur = Color3.fromHSV(hv,sv,vv)
					prev.BackgroundColor3 = cur
					svGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.white),ColorSequenceKeypoint.new(1,Color3.fromHSV(hv,1,1))}
					svDot.Position = u2(sv,0,1-vv,0)
					hDot.Position  = u2(0,-3,hv,-2.5)
					local hex = string.format("#%02X%02X%02X",math.floor(cur.R*255),math.floor(cur.G*255),math.floor(cur.B*255))
					hexBox.Text=hex; hexTiny.Text=hex
					task.spawn(pcall,cb,cur)
				end
				upd()

				cn(svF.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					dSv=true
					local ap=svF.AbsolutePosition; local as=svF.AbsoluteSize
					sv=math.clamp((i.Position.X-ap.X)/as.X,0,1); vv=1-math.clamp((i.Position.Y-ap.Y)/as.Y,0,1); upd()
				end)
				cn(hBar.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					dH=true
					local ap=hBar.AbsolutePosition; local as=hBar.AbsoluteSize
					hv=math.clamp((i.Position.Y-ap.Y)/as.Y,0,1); upd()
				end)
				cn(uis.InputChanged, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseMovement then return end
					if dSv then
						local ap=svF.AbsolutePosition; local as=svF.AbsoluteSize
						sv=math.clamp((i.Position.X-ap.X)/as.X,0,1); vv=1-math.clamp((i.Position.Y-ap.Y)/as.Y,0,1); upd()
					elseif dH then
						local ap=hBar.AbsolutePosition; local as=hBar.AbsoluteSize
						hv=math.clamp((i.Position.Y-ap.Y)/as.Y,0,1); upd()
					end
				end)
				cn(uis.InputEnded, function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then dSv=false;dH=false end
				end)
				cn(hexBox.FocusLost, function(enter)
					if enter then
						local hex=hexBox.Text:gsub("#","")
						if #hex==6 then
							local ok2,rc,gc,bc=pcall(function()
								return tonumber("0x"..hex:sub(1,2)),tonumber("0x"..hex:sub(3,4)),tonumber("0x"..hex:sub(5,6))
							end)
							if ok2 and rc and gc and bc then hv,sv,vv=Color3.toHSV(c3(rc,gc,bc)); upd() end
						end
					end
				end)
				cn(r.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					pOpen=not pOpen
					if pOpen then
						pkF.Visible=true; pkF.Size=u2(1,0,0,0)
						tw(pkF,{Size=u2(1,0,0,168)},0.25,Enum.EasingStyle.Quart)
						wrap.Size=u2(1,0,0,38+168)
					else
						tw(pkF,{Size=u2(1,0,0,0)},0.2,Enum.EasingStyle.Quart)
						task.delay(0.22,function() if not pOpen and pkF and pkF.Parent then pkF.Visible=false end end)
						wrap.Size=u2(1,0,0,36)
					end
				end)

				local obj = {}
				function obj:Set(c2) cur=c2; hv,sv,vv=Color3.toHSV(c2); upd() end
				function obj:Get() return cur end
				return obj
			end

			-- ── LABEL ─────────────────────────────────────────────────────────
			function S:CreateLabel(text, color)
				eOrd += 1
				local f = Instance.new("Frame", secBody)
				f.Size             = u2(1,0,0,18)
				f.BackgroundTransparency = 1
				f.LayoutOrder      = eOrd
				f.BorderSizePixel  = 0
				local l = lbl(f, text or "", 11, color or T.sub, Enum.Font.Gotham)
				l.Position = u2(0,4,0.5,-5)
				l.ZIndex   = 9
				local obj = {}
				function obj:Set(t,c2) l.Text=t; if c2 then l.TextColor3=c2 end end
				return obj
			end

			-- ── DIVIDER ───────────────────────────────────────────────────────
			function S:CreateDivider()
				eOrd += 1
				local d = Instance.new("Frame", secBody)
				d.Size             = u2(1,0,0,1)
				d.BackgroundColor3 = T.bordFaint
				d.BorderSizePixel  = 0
				d.LayoutOrder      = eOrd
				d.ZIndex           = 8
			end

			return S
		end

		return Tab
	end

	-- WINDOW CONTROLS
	local minimized = false
	cn(minBtn.MouseButton1Click, function()
		minimized=not minimized
		tw(main,{Size=minimized and u2(0,winW,0,48) or u2(0,winW,0,winH)},0.28,Enum.EasingStyle.Quart)
	end)
	cn(closeBtn.MouseButton1Click, function()
		tw(main,{Size=u2(0,winW,0,0),BackgroundTransparency=1},0.22,Enum.EasingStyle.Quart)
		task.delay(0.24,function() if gui and gui.Parent then gui:Destroy() end end)
	end)
	cn(uis.InputBegan, function(inp,gp)
		if gp then return end
		if inp.KeyCode==toggleKey then main.Visible=not main.Visible end
	end)

	task.defer(function()
		tw(main,{Size=u2(0,winW,0,winH)},0.38,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
	end)

	W._gui  = gui
	W._main = main
	function W:Destroy()
		for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		if gui and gui.Parent then gui:Destroy() end
	end
	function W:SetVisible(v) main.Visible=v end

	return W
end

return K
