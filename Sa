				ntl.Size       = u2(0.5,0,1,0)
				ntl.TextXAlignment = Enum.TextXAlignment.Left
				ntl.ZIndex     = 9

				local vtl = Instance.new("TextLabel", hdr2)
				vtl.BackgroundTransparency = 1
				vtl.Text       = tostring(val)..suf
				vtl.TextSize   = 12
				vtl.TextColor3 = T.acc
				vtl.Font       = Enum.Font.GothamBold
				vtl.Size       = u2(0.5,-58,1,0)
				vtl.Position   = u2(0.5,0,0,0)
				vtl.TextXAlignment = Enum.TextXAlignment.Right
				vtl.ZIndex     = 9

				local numBox = Instance.new("TextBox", hdr2)
				numBox.Size             = u2(0,50,0,20)
				numBox.Position         = u2(1,-52,0.5,-10)
				numBox.BackgroundColor3 = T.bg
				numBox.TextColor3       = T.acc
				numBox.Text             = tostring(val)
				numBox.TextSize         = 11
				numBox.Font             = Enum.Font.GothamBold
				numBox.PlaceholderText  = "0"
				numBox.ZIndex           = 9
				numBox.BorderSizePixel  = 0
				numBox.TextXAlignment   = Enum.TextXAlignment.Center
				mkCorner(numBox, 5)
				mkStroke(numBox, T.bord, 1, 0.5)

				local trackBg = Instance.new("Frame", row)
				trackBg.Size             = u2(1,-24,0,6)
				trackBg.Position         = u2(0,12,0,40)
				trackBg.BackgroundColor3 = T.bg
				trackBg.ZIndex           = 8
				trackBg.BorderSizePixel  = 0
				mkCorner(trackBg, 999)

				local fill = Instance.new("Frame", trackBg)
				fill.Size             = u2((val-mn)/(mx-mn),0,1,0)
				fill.BackgroundColor3 = T.acc
				fill.ZIndex           = 9
				fill.BorderSizePixel  = 0
				mkCorner(fill, 999)
				local fillGrad = Instance.new("UIGradient", fill)
				fillGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.acc),ColorSequenceKeypoint.new(1,T.accGlow)}

				local dot = Instance.new("Frame", trackBg)
				dot.Size             = u2(0,14,0,14)
				dot.AnchorPoint      = v2(0.5,0.5)
				dot.Position         = u2((val-mn)/(mx-mn),0,0.5,0)
				dot.BackgroundColor3 = T.white
				dot.ZIndex           = 10
				dot.BorderSizePixel  = 0
				mkCorner(dot, 999)

				local function setVal(nv, silent)
					val = math.clamp(math.round(nv), mn, mx)
					local pct = (val-mn)/(mx-mn)
					tw(fill, {Size=u2(pct,0,1,0)}, 0.05)
					tw(dot,  {Position=u2(pct,0,0.5,0)}, 0.05)
					vtl.Text    = tostring(val)..suf
					numBox.Text = tostring(val)
					if not silent then task.spawn(pcall, cb, val) end
				end

				local function handleMouse(inp)
					local ax = trackBg.AbsolutePosition.X
					local aw = trackBg.AbsoluteSize.X
					local pct = math.clamp((inp.Position.X - ax) / aw, 0, 1)
					setVal(mn + pct*(mx-mn))
				end

				cn(trackBg.InputBegan, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then
						sliding = true; handleMouse(i)
					end
				end)
				cn(dot.InputBegan, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then
						sliding = true
					end
				end)
				cn(uis.InputChanged, function(i)
					if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
						handleMouse(i)
					end
				end)
				cn(uis.InputEnded, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then
						sliding = false
					end
				end)
				cn(numBox.FocusLost, function(enter)
					if enter then
						local n2 = tonumber(numBox.Text)
						if n2 then setVal(n2) end
					end
					numBox.Text = tostring(val)
				end)

				local obj = {}
				function obj:Set(v) setVal(v, false) end
				function obj:Get() return val end
				return obj
			end

			function S:CreateDropdown(cfg2)
