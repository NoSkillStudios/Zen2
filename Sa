            function S:CreateSlider(cfg2)
                cfg2 = type(cfg2) == "string" and {Title = cfg2} or cfg2 or {}
                local cb = cfg2.Callback or function() end
                local mn = cfg2.Min or 0
                local mx = cfg2.Max or 100
                local suf = cfg2.Suffix or ""
                local val = math.clamp(cfg2.Default or mn, mn, mx)
                local sliding = false

                local row = baseRow(58)

                local hdr2 = Instance.new("Frame")
                hdr2.Size = UDim2.new(1, 0, 0, 26)
                hdr2.BackgroundTransparency = 1
                hdr2.ZIndex = 10
