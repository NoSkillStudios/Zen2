local function cn(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns+1] = c
	return c
end

local function tw(obj, props, dur, sty, dir)
	if not obj or not obj.Parent then return end
	ts:Create(obj, ti(dur or 0.2, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props):Play()
end

local function corner(p, r)
	local c = Instance.new("UICorner", p)
	c.CornerRadius = ud(0, r or 8)
	return c
end

local function stroke(p, col, th)
	local s = Instance.new("UIStroke", p)
	s.Color = col or T.bord
	s.Thickness = th or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function pad(p, t, b, l, r)
	local d = Instance.new("UIPadding", p)
	d.PaddingTop    = ud(0, t or 8)
	d.PaddingBottom = ud(0, b or 8)
	d.PaddingLeft   = ud(0, l or 8)
	d.PaddingRight  = ud(0, r or 8)
end

local function list(p, dir, sp)
	local l = Instance.new("UIListLayout", p)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder     = Enum.SortOrder.LayoutOrder
	l.Padding       = ud(0, sp or 6)
	return l
end

local function lbl(p, txt, sz, col, font)
	local l = Instance.new("TextLabel", p)
	l.BackgroundTransparency = 1
	l.Text           = txt or ""
	l.TextSize       = sz  or 13
	l.TextColor3     = col or T.txt
	l.Font           = font or Enum.Font.GothamMedium
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.AutomaticSize  = Enum.AutomaticSize.XY
	l.BorderSizePixel= 0
	return l
end

local function scroll(p)
	local sf = Instance.new("ScrollingFrame", p)
	sf.Size                      = u2(1,0,1,0)
	sf.BackgroundTransparency    = 1
	sf.BorderSizePixel           = 0
	sf.ScrollBarThickness        = 3
	sf.ScrollBarImageColor3      = T.acc
	sf.ScrollBarImageTransparency= 0.4
	sf.CanvasSize                = u2(0,0,0,0)
	sf.AutomaticCanvasSize       = Enum.AutomaticSize.Y
	return sf
end

local function ripple(btn)
	if not btn or not btn.Parent then return end
	local sz = btn.AbsoluteSize
	local r  = Instance.new("Frame", btn)
	r.Size                   = u2(0,0,0,0)
	r.Position               = u2(0.5,0,0.5,0)
	r.AnchorPoint            = v2(0.5,0.5)
	r.BackgroundColor3       = T.white
	r.BackgroundTransparency = 0.78
	r.ZIndex                 = btn.ZIndex + 20
	r.BorderSizePixel        = 0
	corner(r, 999)
	local s = math.max(sz.X, sz.Y) * 2.5
	tw(r, {Size=u2(0,s,0,s), BackgroundTransparency=1}, 0.45, Enum.EasingStyle.Quad)
	task.delay(0.47, function() if r and r.Parent then r:Destroy() end end)
end

-- Global tooltip
local _tooltipGui, _ttFrame, _ttLbl
local function ensureTooltip(gui)
	if _ttFrame then return end
	_tooltipGui = gui
	_ttFrame = Instance.new("Frame", gui)
	_ttFrame.BackgroundColor3 = T.elev
	_ttFrame.BorderSizePixel  = 0
	_ttFrame.ZIndex           = 999
	_ttFrame.Visible          = false
	_ttFrame.Size             = u2(0,0,0,26)
	corner(_ttFrame, 6)
	stroke(_ttFrame, T.acc, 1)
	pad(_ttFrame, 0,0,10,10)
	_ttLbl = Instance.new("TextLabel", _ttFrame)
	_ttLbl.BackgroundTransparency = 1
	_ttLbl.Text       = ""
	_ttLbl.TextSize   = 11
	_ttLbl.TextColor3 = T.txt
	_ttLbl.Font       = Enum.Font.GothamMedium
	_ttLbl.AutomaticSize = Enum.AutomaticSize.XY
	_ttLbl.Position   = u2(0,0,0.5,-6)
	_ttLbl.ZIndex     = 1000
	-- Arrow
	local arr = Instance.new("Frame", _ttFrame)
	arr.Size             = u2(0,8,0,8)
	arr.Position         = u2(0,-3,0.5,-4)
	arr.BackgroundColor3 = T.acc
	arr.BorderSizePixel  = 0
	arr.ZIndex           = 998
	arr.Rotation         = 45
end

local function showTip(txt, anchor)
	if not _ttFrame then return end
	_ttLbl.Text = txt
	task.defer(function()
		if not anchor or not anchor.Parent then return end
		local w = _ttLbl.TextBounds.X + 20
		_ttFrame.Size = u2(0,w,0,26)
		local ap = anchor.AbsolutePosition
		local as = anchor.AbsoluteSize
		_ttFrame.Position = u2(0, ap.X + as.X + 10, 0, ap.Y + as.Y/2 - 13)
		_ttFrame.Visible = true
	end)
end

local function hideTip()
	if _ttFrame then _ttFrame.Visible = false end
end

local function makeDraggable(frame, handle)
	local drag, ds, sp = false, nil, nil
	cn(handle.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		drag = true; ds = i.Position; sp = frame.Position
	end)
	cn(uis.InputChanged, function(i)
		if not drag or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local d = i.Position - ds
		frame.Position = u2(sp.X.Scale, sp.X.Offset+d.X, sp.Y.Scale, sp.Y.Offset+d.Y)
	end)
	cn(uis.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
	end)
end

local function closeAllDropdowns(except)
	for i = #openDropdowns, 1, -1 do
		local fn = openDropdowns[i]
		if fn ~= except then fn() end
	end
end

