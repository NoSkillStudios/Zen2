				local ddScroll = scroll(ddWrap, 2)
				pad(ddScroll, 4, 4, 4, 4)
				list(ddScroll, nil, 2)

				local optCallbacks = {}

				local function isSel(opt)
					return multi and sel[opt] == true or sel == opt
				end

				local function refreshDisplay()
					if multi then
						local ks = {}
						for k in pairs(sel) do ks[#ks+1] = k end
						selDisplay.Text = #ks == 0 and "None" or table.concat(ks, ", ")
					else
						selDisplay.Text = sel or "Select..."
					end
				end

				local function mkOption(opt)
					local ob = Instance.new("TextButton", ddScroll)
					ob.Size = u2(1, 0, 0, 26)
					ob.BackgroundColor3 = th.winDeep
					ob.BackgroundTransparency = 1
					ob.Text = ""
					ob.ZIndex = 26
					ob.BorderSizePixel = 0
					corner(ob, 5)

					local otl = Instance.new("TextLabel", ob)
					otl.BackgroundTransparency = 1
					otl.Text = opt
					otl.TextSize = 11
					otl.TextColor3 = th.txt
					otl.Font = Enum.Font.Gotham
					otl.Position = u2(0, 10, 0.5, -7)
					otl.ZIndex = 27
					otl.BorderSizePixel = 0
					otl.AutomaticSize = Enum.AutomaticSize.XY

					local ock = Instance.new("TextLabel", ob)
					ock.BackgroundTransparency = 1
					ock.Text = "✓"
					ock.TextSize = 11
					ock.TextColor3 = th.acc
					ock.Font = Enum.Font.GothamBold
					ock.Size = u2(0, 18, 1, 0)
					ock.Position = u2(1, -22, 0, 0)
					ock.TextXAlignment = Enum.TextXAlignment.Center
					ock.TextYAlignment = Enum.TextYAlignment.Center
					ock.TextTransparency = 1
					ock.ZIndex = 27
					ock.BorderSizePixel = 0

					local function refreshOpt()
						local active = isSel(opt)
						tw(ob,  {BackgroundColor3 = active and th.row or th.winDeep, BackgroundTransparency = active and 0 or 1}, 0.1)
						tw(otl, {TextColor3 = active and th.white or th.txt}, 0.1)
						tw(ock, {TextTransparency = active and 0 or 1}, 0.1)
					end
					refreshOpt()
					optCallbacks[opt] = refreshOpt

					gc(ob.MouseButton1Click, function()
						ripple(ob)
						if multi then
							sel[opt] = sel[opt] and nil or true
							refreshOpt()
							refreshDisplay()
							local out = {}
							for k in pairs(sel) do out[#out+1] = k end
							task.spawn(pcall, cb, out)
						else
							sel = opt
							for _, fn in pairs(optCallbacks) do fn() end
							refreshDisplay()
							task.spawn(pcall, cb, opt)
						end
					end)
					gc(ob.MouseEnter, function() if not isSel(opt) then tw(ob, {BackgroundColor3=th.row, BackgroundTransparency=0.4}, 0.08) end end)
					gc(ob.MouseLeave, function() if not isSel(opt) then tw(ob, {BackgroundTransparency=1}, 0.08) end end)
				end

				for _, o in ipairs(opts) do mkOption(o) end

				gc(row.InputBegan, function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
					open = not open
					if open then
						local h = math.min(#opts * 28 + 8, 148)
						ddWrap.Visible = true
						ddWrap.Size = u2(1, 0, 0, 0)
						tw(ddWrap, {Size = u2(1, 0, 0, h)}, 0.18, Enum.EasingStyle.Back)
						tw(arrowLbl, {Rotation = 180}, 0.18)
						wrap.Size = u2(1, 0, 0, 39 + h)
					else
						tw(ddWrap, {Size = u2(1, 0, 0, 0)}, 0.13)
						tw(arrowLbl, {Rotation = 0}, 0.13)
						task.delay(0.14, function() if not open then ddWrap.Visible = false end end)
						wrap.Size = u2(1, 0, 0, 38)
					end
				end)

				local obj = {}
				function obj:Set(v)
					if multi then sel={}; for _,k in ipairs(v) do sel[k]=true end
					else sel=v end
					for _, fn in pairs(optCallbacks) do fn() end
					refreshDisplay()
				end
				function obj:Refresh(newOpts)
					for _, c2 in ipairs(ddScroll:GetChildren()) do
						if c2:IsA("TextButton") then c2:Destroy() end
					end
					table.clear(optCallbacks)
					opts = newOpts
					for _, o in ipairs(opts) do mkOption(o) end
				end
				function obj:Get() return sel end
				return obj
			end

