local KrakenUI = {}

local uis     = game:GetService("UserInputService")
local ts      = game:GetService("TweenService")
local players = game:GetService("Players")
local lp      = players.LocalPlayer

local ti = TweenInfo.new
local c3 = Color3.fromRGB
local u2 = UDim2.new
local v2 = Vector2.new
local ud = UDim.new

local th = {
	win      = c3(28, 28, 35),
	winDeep  = c3(20, 20, 26),
	sidebar  = c3(22, 22, 28),
	row      = c3(34, 34, 44),
	rowHov   = c3(40, 40, 52),
	sec      = c3(16, 16, 21),
	border   = c3(52, 52, 68),
	borderLo = c3(38, 38, 50),
	acc      = c3(108, 99, 255),
	accHov   = c3(130, 122, 255),
	accDim   = c3(72, 66, 200),
	accGlow  = c3(168, 85, 247),
	txt      = c3(240, 240, 248),
	sub      = c3(148, 148, 172),
	muted    = c3(80, 80, 104),
	success  = c3(52, 211, 153),
	danger   = c3(239, 68, 68),
	warn     = c3(234, 179, 8),
	white    = c3(255, 255, 255),
	black    = c3(0, 0, 0),
	tOn      = c3(108, 99, 255),
	tOff     = c3(50, 50, 66),
}

local conns = {}
local function gc(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns + 1] = c
	return c
end

local function tw(obj, props, dur, sty, dir)
	ts:Create(obj, ti(dur or 0.16, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props):Play()
end

local function corner(p, r)
	local c = Instance.new("UICorner", p)
	c.CornerRadius = ud(0, r or 8)
end

local function stroke(p, col, th2, tr)
	local s = Instance.new("UIStroke", p)
	s.Color = col or th.border
	s.Thickness = th2 or 1
	s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function pad(p, t, b, l, r)
	local k = Instance.new("UIPadding", p)
	k.PaddingTop    = ud(0, t or 0)
	k.PaddingBottom = ud(0, b or 0)
	k.PaddingLeft   = ud(0, l or 0)
	k.PaddingRight  = ud(0, r or 0)
end

local function list(p, dir, sp)
	local l = Instance.new("UIListLayout", p)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = ud(0, sp or 0)
	return l
end

local function lbl(p, txt, sz, col, font, xa)
	local l = Instance.new("TextLabel", p)
	l.BackgroundTransparency = 1
	l.Text = txt or ""
	l.TextSize = sz or 13
	l.TextColor3 = col or th.txt
	l.Font = font or Enum.Font.Gotham
	l.TextXAlignment = xa or Enum.TextXAlignment.Left
	l.AutomaticSize = Enum.AutomaticSize.XY
	l.BorderSizePixel = 0
	return l
end

local function scroll(p, barW)
	local sf = Instance.new("ScrollingFrame", p)
	sf.Size = u2(1, 0, 1, 0)
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = barW or 2
	sf.ScrollBarImageColor3 = th.acc
	sf.ScrollBarImageTransparency = 0.5
	sf.CanvasSize = u2(0, 0, 0, 0)
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	return sf
end

local function frame(p, bg, zi)
	local f = Instance.new("Frame", p)
	f.BackgroundColor3 = bg or th.win
	f.BorderSizePixel = 0
	f.ZIndex = zi or 1
	return f
end

local function gradient(p, col1, col2, rot)
	local g = Instance.new("UIGradient", p)
	g.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, col1),
		ColorSequenceKeypoint.new(1, col2),
	}
	g.Rotation = rot or 0
	return g
end

local function ripple(parent, x, y)
	local rip = frame(parent, th.white)
	rip.ZIndex = parent.ZIndex + 10
	rip.Size = u2(0, 0, 0, 0)
	rip.BackgroundTransparency = 0.8
	if x and y then
		local abs = parent.AbsolutePosition
		rip.Position = u2(0, x - abs.X, 0, y - abs.Y)
		rip.AnchorPoint = v2(0.5, 0.5)
	else
		rip.Position = u2(0.5, 0, 0.5, 0)
		rip.AnchorPoint = v2(0.5, 0.5)
	end
	corner(rip, 999)
	local sz = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2.2
	tw(rip, {Size = u2(0, sz, 0, sz), BackgroundTransparency = 1}, 0.5, Enum.EasingStyle.Quad)
	task.delay(0.52, rip.Destroy, rip)
end

local dragActive, dragFrame, dragStart, dragOrigPos = false, nil, nil, nil
local function makeDraggable(win, handle)
	gc(handle.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragActive = true; dragFrame = win
		dragStart = i.Position; dragOrigPos = win.Position
	end)
	gc(uis.InputChanged, function(i)
		if not dragActive or dragFrame ~= win then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local d = i.Position - dragStart
		win.Position = u2(dragOrigPos.X.Scale, dragOrigPos.X.Offset + d.X, dragOrigPos.Y.Scale, dragOrigPos.Y.Offset + d.Y)
	end)
	gc(uis.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragActive = false; dragFrame = nil end
	end)
end

local function iconFrame(parent, ico, bg, zi)
	local f = frame(parent, bg or th.acc)
	f.Size = u2(0, 22, 0, 22)
	f.ZIndex = zi or 8
	corner(f, 6)
	local grad = gradient(f, th.acc, th.accGlow, 135)
	local il = Instance.new("TextLabel", f)
	il.BackgroundTransparency = 1
	il.Size = u2(1, 0, 1, 0)
	il.Text = ico or "◈"
	il.TextSize = 11
	il.TextColor3 = th.white
	il.Font = Enum.Font.GothamBold
	il.TextXAlignment = Enum.TextXAlignment.Center
	il.TextYAlignment = Enum.TextYAlignment.Center
	il.ZIndex = zi and zi+1 or 9
	il.BorderSizePixel = 0
	return f, il
end

function KrakenUI.Window(cfg)
	cfg = cfg or {}
	local winW   = cfg.Width   or 520
	local winH   = cfg.Height  or 440
	local title  = cfg.Title   or "Kraken"
	local sub    = cfg.Subtitle or ""
	local tKey   = cfg.ToggleKey or Enum.KeyCode.RightShift

	local gui = Instance.new("ScreenGui")
	gui.Name = "KrakenUI_" .. math.random(1e5, 9e5)
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1000
	gui.Parent = lp:WaitForChild("PlayerGui")

	local win = frame(gui, th.win)
	win.Size = u2(0, winW, 0, winH)
	win.Position = u2(0.5, -winW/2, 0.5, -winH/2)
	win.ClipsDescendants = true
	win.ZIndex = 2
	corner(win, 10)
	stroke(win, th.border, 1, 0.2)

	local topGlow = frame(win, th.acc)
	topGlow.Size = u2(1, 0, 0, 1)
	topGlow.Position = u2(0, 0, 0, 0)
	topGlow.ZIndex = 10
	gradient(topGlow, th.acc, th.accGlow, 0)

	local topbar = frame(win, th.winDeep)
	topbar.Size = u2(1, 0, 0, 42)
	topbar.ZIndex = 5

	local tbFix = frame(topbar, th.winDeep)
	tbFix.Size = u2(1, 0, 0.5, 0)
	tbFix.Position = u2(0, 0, 0.5, 0)
	tbFix.ZIndex = 5

	makeDraggable(win, topbar)

	local logoBox, _ = iconFrame(topbar, string.sub(title, 1, 1):upper(), th.acc, 6)
	logoBox.Size = u2(0, 28, 0, 28)
	logoBox.Position = u2(0, 10, 0.5, -14)

	local titleLbl = lbl(topbar, title, 13, th.txt, Enum.Font.GothamBold)
	titleLbl.Position = u2(0, 46, 0.5, -14)
	titleLbl.ZIndex = 6

	local subLbl = lbl(topbar, sub, 10, th.muted, Enum.Font.Gotham)
	subLbl.Position = u2(0, 46, 0.5, 2)
	subLbl.ZIndex = 6

	local keyHint = lbl(topbar, "["..tKey.Name.."]", 9, th.muted, Enum.Font.GothamMedium, Enum.TextXAlignment.Right)
	keyHint.Size = u2(0, 100, 0, 12)
	keyHint.Position = u2(1, -180, 0.5, -6)
	keyHint.ZIndex = 6
	keyHint.AutomaticSize = Enum.AutomaticSize.None

	local function mkTopBtn(xOff, ico, col)
		local b = Instance.new("TextButton", topbar)
		b.Size = u2(0, 26, 0, 26)
		b.Position = u2(1, xOff, 0.5, -13)
		b.BackgroundColor3 = col
		b.BackgroundTransparency = 0.55
		b.Text = ico
		b.TextColor3 = col
		b.TextSize = 11
		b.Font = Enum.Font.GothamBold
		b.ZIndex = 6
		b.BorderSizePixel = 0
		b.ClipsDescendants = true
		corner(b, 5)
		gc(b.MouseEnter, function() tw(b, {BackgroundTransparency = 0.2}, 0.1) end)
		gc(b.MouseLeave, function() tw(b, {BackgroundTransparency = 0.55}, 0.1) end)
		return b
	end

	local closeBtn = mkTopBtn(-8,  "✕", th.danger)
	local minBtn   = mkTopBtn(-38, "–", th.muted)

	local body = frame(win, th.win)
	body.Position = u2(0, 0, 0, 42)
	body.Size = u2(1, 0, 1, -42)
	body.ZIndex = 3

	local sideW = 130
	local sidebar = frame(body, th.sidebar)
	sidebar.Size = u2(0, sideW, 1, 0)
	sidebar.ZIndex = 4

	local sideLine = frame(sidebar, th.border)
	sideLine.Size = u2(0, 1, 1, 0)
	sideLine.Position = u2(1, -1, 0, 0)
	sideLine.ZIndex = 5

	local sideScroll = scroll(sidebar, 2)
	pad(sideScroll, 6, 6, 0, 0)
	list(sideScroll, nil, 2)

	local contentFrame = frame(body, th.win)
	contentFrame.Position = u2(0, sideW, 0, 0)
	contentFrame.Size = u2(1, -sideW, 1, 0)
	contentFrame.ClipsDescendants = true
	contentFrame.ZIndex = 3

	local W = {}
	local tabPages   = {}
	local tabButtons = {}
	local tabNameLbls= {}
	local tabIcoBgs  = {}
	local activeTab  = nil

	local function switchTab(name)
		if activeTab == name then return end
		activeTab = name
		for n, pg in pairs(tabPages) do
			local btn   = tabButtons[n]
			local nLbl  = tabNameLbls[n]
			local icoBg = tabIcoBgs[n]
			if n == name then
				pg.Visible = true
				if btn   then tw(btn,   {BackgroundColor3 = th.row, BackgroundTransparency = 0}, 0.15) end
				if nLbl  then tw(nLbl,  {TextColor3 = th.txt}, 0.15) end
				if icoBg then tw(icoBg, {BackgroundTransparency = 0}, 0.15) end
			else
				if btn   then tw(btn,   {BackgroundColor3 = th.sidebar, BackgroundTransparency = 1}, 0.12) end
				if nLbl  then tw(nLbl,  {TextColor3 = th.sub}, 0.12) end
				if icoBg then tw(icoBg, {BackgroundTransparency = 0.7}, 0.12) end
				task.delay(0.13, function()
					if activeTab ~= n and pg and pg.Parent then pg.Visible = false end
				end)
			end
		end
	end

	function W:CreateTab(name, icon)
		local page = frame(contentFrame, th.win)
		page.Size = u2(1, 0, 1, 0)
		page.BackgroundTransparency = 1
		page.Visible = false
		page.ZIndex = 4
		page.ClipsDescendants = true

		local pgScroll = scroll(page, 2)
		pad(pgScroll, 8, 8, 8, 8)
		list(pgScroll, nil, 6)

		local tabBtn = Instance.new("TextButton", sideScroll)
		tabBtn.Size = u2(1, -10, 0, 36)
		tabBtn.BackgroundColor3 = th.sidebar
		tabBtn.BackgroundTransparency = 1
		tabBtn.Text = ""
		tabBtn.ZIndex = 5
		tabBtn.ClipsDescendants = true
		tabBtn.BorderSizePixel = 0
		corner(tabBtn, 6)

		pad(tabBtn, 0, 0, 8, 8)

		local icoBoxFrame = frame(tabBtn, th.acc)
		icoBoxFrame.Size = u2(0, 20, 0, 20)
		icoBoxFrame.Position = u2(0, 0, 0.5, -10)
		icoBoxFrame.ZIndex = 6
		icoBoxFrame.BackgroundTransparency = 0.7
		corner(icoBoxFrame, 5)
		gradient(icoBoxFrame, th.acc, th.accGlow, 135)

		local icoTxt = Instance.new("TextLabel", icoBoxFrame)
		icoTxt.BackgroundTransparency = 1
		icoTxt.Size = u2(1, 0, 1, 0)
		icoTxt.Text = icon or "◈"
		icoTxt.TextSize = 10
		icoTxt.TextColor3 = th.white
		icoTxt.Font = Enum.Font.GothamBold
		icoTxt.TextXAlignment = Enum.TextXAlignment.Center
		icoTxt.TextYAlignment = Enum.TextYAlignment.Center
		icoTxt.ZIndex = 7
		icoTxt.BorderSizePixel = 0

		local nameLbl = Instance.new("TextLabel", tabBtn)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = name
		nameLbl.TextSize = 11
		nameLbl.TextColor3 = th.sub
		nameLbl.Font = Enum.Font.GothamMedium
		nameLbl.Size = u2(1, -28, 1, 0)
		nameLbl.Position = u2(0, 28, 0, 0)
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.TextYAlignment = Enum.TextYAlignment.Center
		nameLbl.ZIndex = 6
		nameLbl.BorderSizePixel = 0

		tabPages[name]    = page
		tabButtons[name]  = tabBtn
		tabNameLbls[name] = nameLbl
		tabIcoBgs[name]   = icoBoxFrame

		gc(tabBtn.MouseButton1Click, function()
			ripple(tabBtn)
			switchTab(name)
		end)
		gc(tabBtn.MouseEnter, function()
			if activeTab ~= name then tw(tabBtn, {BackgroundTransparency = 0.6}, 0.1) end
		end)
		gc(tabBtn.MouseLeave, function()
			if activeTab ~= name then tw(tabBtn, {BackgroundTransparency = 1}, 0.1) end
		end)

		if not activeTab then switchTab(name) end

		local Tab = {}
		local secOrd = 0
		local function nextSec() secOrd += 1; return secOrd end

		function Tab:CreateSection(secName)
			local secWrap = frame(pgScroll, th.sec)
			secWrap.Size = u2(1, -2, 0, 0)
			secWrap.AutomaticSize = Enum.AutomaticSize.Y
			secWrap.LayoutOrder = nextSec()
			secWrap.ZIndex = 5
			corner(secWrap, 8)
			stroke(secWrap, th.borderLo, 1, 0)

			local secHdr = frame(secWrap, th.sec)
			secHdr.Size = u2(1, 0, 0, 28)
			secHdr.ZIndex = 6
			corner(secHdr, 8)

			local secFix = frame(secHdr, th.sec)
			secFix.Size = u2(1, 0, 0.5, 0)
			secFix.Position = u2(0, 0, 0.5, 0)
			secFix.ZIndex = 6

			local secBar = frame(secHdr, th.acc)
			secBar.Size = u2(0, 2, 0, 14)
			secBar.Position = u2(0, 10, 0.5, -7)
			secBar.ZIndex = 7
			corner(secBar, 999)
			gradient(secBar, th.acc, th.accGlow, 90)

			local secTitle = Instance.new("TextLabel", secHdr)
			secTitle.BackgroundTransparency = 1
			secTitle.Text = secName or "Section"
			secTitle.TextSize = 10
			secTitle.TextColor3 = th.sub
			secTitle.Font = Enum.Font.GothamBold
			secTitle.Position = u2(0, 18, 0.5, -6)
			secTitle.ZIndex = 7
			secTitle.BorderSizePixel = 0
			secTitle.AutomaticSize = Enum.AutomaticSize.XY

			local divLine = frame(secWrap, th.borderLo)
			divLine.Size = u2(1, -20, 0, 1)
			divLine.Position = u2(0, 10, 0, 28)
			divLine.ZIndex = 6
			divLine.BackgroundTransparency = 0.3

			local secBody = frame(secWrap, th.sec)
			secBody.Size = u2(1, 0, 0, 0)
			secBody.Position = u2(0, 0, 0, 29)
			secBody.AutomaticSize = Enum.AutomaticSize.Y
			secBody.ZIndex = 6
			list(secBody, nil, 1)

			local S = {}
			local eOrd = 0
			local function eo() eOrd += 1; return eOrd end

			local function mkRow(h)
				local row = frame(secBody, th.sec)
				row.Size = u2(1, 0, 0, h or 38)
				row.LayoutOrder = eo()
				row.ZIndex = 7
				row.ClipsDescendants = true

				local rowLine = frame(row, th.borderLo)
				rowLine.Size = u2(1, -20, 0, 1)
				rowLine.Position = u2(0, 10, 1, -1)
				rowLine.ZIndex = 8
				rowLine.BackgroundTransparency = 0.5

				gc(row.MouseEnter, function() tw(row, {BackgroundColor3 = th.row}, 0.1) end)
				gc(row.MouseLeave, function() tw(row, {BackgroundColor3 = th.sec}, 0.1) end)
				return row
			end

			local function rowIcon(row, ico)
				local ibg = frame(row, th.acc)
				ibg.Size = u2(0, 18, 0, 18)
				ibg.Position = u2(0, 10, 0.5, -9)
				ibg.ZIndex = 8
				corner(ibg, 5)
				ibg.BackgroundTransparency = 0.4
				gradient(ibg, th.acc, th.accGlow, 135)
				local it = Instance.new("TextLabel", ibg)
				it.BackgroundTransparency = 1
				it.Size = u2(1, 0, 1, 0)
				it.Text = ico or "◈"
				it.TextSize = 9
				it.TextColor3 = th.white
				it.Font = Enum.Font.GothamBold
				it.TextXAlignment = Enum.TextXAlignment.Center
				it.TextYAlignment = Enum.TextYAlignment.Center
				it.ZIndex = 9
				it.BorderSizePixel = 0
				return ibg
			end

			local function rowLabel(row, txt, xOff)
				local l = Instance.new("TextLabel", row)
				l.BackgroundTransparency = 1
				l.Text = txt or ""
				l.TextSize = 12
				l.TextColor3 = th.txt
				l.Font = Enum.Font.GothamMedium
				l.Position = u2(0, xOff or 36, 0.5, -7)
				l.ZIndex = 8
				l.BorderSizePixel = 0
				l.AutomaticSize = Enum.AutomaticSize.XY
				return l
			end

			local function rowDesc(row, txt, yBase)
				local l = Instance.new("TextLabel", row)
				l.BackgroundTransparency = 1
				l.Text = txt or ""
				l.TextSize = 10
				l.TextColor3 = th.muted
				l.Font = Enum.Font.Gotham
				l.Position = u2(0, 36, 0, yBase or 22)
				l.ZIndex = 8
				l.BorderSizePixel = 0
				l.AutomaticSize = Enum.AutomaticSize.XY
				return l
			end

			function S:CreateButton(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb   = cfg2.Callback or function() end
				local desc = cfg2.Description
				local ico  = cfg2.Icon or "▶"
				local row  = mkRow(desc and 50 or 38)

				rowIcon(row, ico)
				rowLabel(row, cfg2.Title or "Button", 36)
				if desc then rowDesc(row, desc, 22) end

				local execBtn = Instance.new("TextButton", row)
				execBtn.Size = u2(0, 80, 0, 24)
				execBtn.Position = u2(1, -88, 0.5, -12)
				execBtn.BackgroundColor3 = th.acc
				execBtn.Text = cfg2.ButtonText or "Execute"
				execBtn.TextColor3 = th.white
				execBtn.TextSize = 11
				execBtn.Font = Enum.Font.GothamBold
				execBtn.ZIndex = 9
				execBtn.BorderSizePixel = 0
				execBtn.ClipsDescendants = true
				corner(execBtn, 5)
				gradient(execBtn, th.acc, th.accGlow, 135)

				gc(execBtn.MouseButton1Down, function(x, y)
					ripple(execBtn, x, y)
					tw(execBtn, {BackgroundTransparency = 0.35}, 0.06)
					task.delay(0.12, function() tw(execBtn, {BackgroundTransparency = 0}, 0.1) end)
					task.spawn(pcall, cb)
				end)
				gc(execBtn.MouseEnter, function() tw(execBtn, {Size = u2(0,84,0,26), Position = u2(1,-90,0.5,-13)}, 0.1) end)
				gc(execBtn.MouseLeave, function() tw(execBtn, {Size = u2(0,80,0,24), Position = u2(1,-88,0.5,-12)}, 0.1) end)
			end

			function S:CreateToggle(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb    = cfg2.Callback or function() end
				local desc  = cfg2.Description
				local ico   = cfg2.Icon or "◑"
				local state = cfg2.Default == true
				local row   = mkRow(desc and 50 or 38)

				rowIcon(row, ico)
				rowLabel(row, cfg2.Title or "Toggle", 36)
				if desc then rowDesc(row, desc, 22) end

				local track = Instance.new("TextButton", row)
				track.Size = u2(0, 40, 0, 22)
				track.Position = u2(1, -50, 0.5, -11)
				track.BackgroundColor3 = state and th.tOn or th.tOff
				track.Text = ""
				track.ZIndex = 9
				track.BorderSizePixel = 0
				track.ClipsDescendants = false
				corner(track, 999)

				local knob = frame(track, th.white)
				knob.Size = u2(0, 16, 0, 16)
				knob.Position = u2(0, state and 21 or 3, 0.5, -8)
				knob.ZIndex = 10
				corner(knob, 999)

				local knobShadow = Instance.new("UIGradient", knob)
				knobShadow.Transparency = NumberSequence.new{
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(1, 0.3),
				}
				knobShadow.Rotation = 90

				local function applyState(v, silent)
					state = v
					tw(track, {BackgroundColor3 = v and th.tOn or th.tOff}, 0.18, Enum.EasingStyle.Quad)
					tw(knob,  {Position = u2(0, v and 21 or 3, 0.5, -8)}, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
					if not silent then task.spawn(pcall, cb, v) end
				end
				applyState(state, true)

				gc(track.MouseButton1Click, function()
					applyState(not state)
				end)

				local obj = {}
				function obj:Set(v) applyState(v == true, false) end
				function obj:Get() return state end
				return obj
			end

			function S:CreateSlider(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb   = cfg2.Callback or function() end
				local mn   = cfg2.Min or 0
				local mx   = cfg2.Max or 100
				local suf  = cfg2.Suffix or ""
				local ico  = cfg2.Icon or "◧"
				local val  = math.clamp(cfg2.Default or mn, mn, mx)
				local slid = false

				local row = mkRow(54)
				rowIcon(row, ico)
				rowLabel(row, cfg2.Title or "Slider", 36)

