				local open  = false
				local ITEM_H= 32
				local MAX_H = 170
				bumpCount()

				_eOrd += 1
				local wrap = Instance.new("Frame", secBody)
				wrap.Size             = u2(1,0,0,38)
				wrap.BackgroundTransparency = 1
				wrap.LayoutOrder      = _eOrd
