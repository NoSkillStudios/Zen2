				hexBox.Font             = Enum.Font.GothamMedium
				hexBox.ZIndex           = 23
				hexBox.BorderSizePixel  = 0
				hexBox.TextXAlignment   = Enum.TextXAlignment.Center
				corner(hexBox, 6)
				stroke(hexBox, T.bordFaint, 1)

				-- RGB readout
				local rgbLbl = Instance.new("TextLabel", pkFrame)
				rgbLbl.BackgroundTransparency = 1
				rgbLbl.Text       = ""
				rgbLbl.TextSize   = 10
				rgbLbl.TextColor3 = T.sub
				rgbLbl.Font       = Enum.Font.Gotham
				rgbLbl.Size       = u2(1,0,0,14)
				rgbLbl.Position   = u2(0,0,0,160)
				rgbLbl.TextXAlignment = Enum.TextXAlignment.Center
				rgbLbl.ZIndex     = 23

				local function updatePicker()
					cur = Color3.fromHSV(hv,sv,vv)
					swatch.BackgroundColor3 = cur
					svGrad.Color = ColorSequence.new{
						ColorSequenceKeypoint.new(0,T.white),
						ColorSequenceKeypoint.new(1,Color3.fromHSV(hv,1,1))
					}
					svDot.Position = u2(sv,0,1-vv,0)
					hDot.Position  = u2(0,-4,hv,-3)
					local hex = toHex(cur)
					hexBox.Text  = hex
					hexTiny.Text = hex
					rgbLbl.Text  = string.format("rgb(%d, %d, %d)",
						math.floor(cur.R*255),math.floor(cur.G*255),math.floor(cur.B*255))
					task.spawn(pcall,cb,cur)
				end
				updatePicker()

				cn(svF.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					dSv=true
					local ap=svF.AbsolutePosition; local as=svF.AbsoluteSize
					sv=math.clamp((i.Position.X-ap.X)/as.X,0,1)
					vv=1-math.clamp((i.Position.Y-ap.Y)/as.Y,0,1)
					updatePicker()
				end)
				cn(hBar.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					dH=true
					local ap=hBar.AbsolutePosition; local as=hBar.AbsoluteSize
					hv=math.clamp((i.Position.Y-ap.Y)/as.Y,0,1)
					updatePicker()
				end)
				cn(uis.InputChanged, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseMovement then return end
					if dSv then
						local ap=svF.AbsolutePosition; local as=svF.AbsoluteSize
						sv=math.clamp((i.Position.X-ap.X)/as.X,0,1)
						vv=1-math.clamp((i.Position.Y-ap.Y)/as.Y,0,1)
						updatePicker()
					elseif dH then
						local ap=hBar.AbsolutePosition; local as=hBar.AbsoluteSize
						hv=math.clamp((i.Position.Y-ap.Y)/as.Y,0,1)
						updatePicker()
					end
				end)
				cn(uis.InputEnded, function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then dSv=false;dH=false end
				end)
				cn(hexBox.FocusLost, function(enter)
					if not enter then return end
					local nc = fromHex(hexBox.Text)
					if nc then hv,sv,vv=Color3.toHSV(nc); updatePicker() end
				end)
				cn(r.InputBegan, function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					pOpen = not pOpen
					if pOpen then
						pkFrame.Visible=true; pkFrame.Size=u2(1,0,0,0)
						tw(pkFrame,{Size=u2(1,0,0,180)},0.25,Enum.EasingStyle.Quart)
						wrap.Size=u2(1,0,0,40+180)
					else
						tw(pkFrame,{Size=u2(1,0,0,0)},0.18,Enum.EasingStyle.Quart,Enum.EasingDirection.Out,function()
							if not pOpen and pkFrame and pkFrame.Parent then pkFrame.Visible=false end
						end)
						wrap.Size=u2(1,0,0,38)
					end
				end)

				local obj = {}
				function obj:Set(c2) cur=c2; hv,sv,vv=Color3.toHSV(c2); updatePicker() end
				function obj:Get()  return cur end
				return obj
			end

			-- ── LABEL ─────────────────────────────────────────────────────────
			function S:CreateLabel(text, color)
				_eOrd += 1
				local f = Instance.new("Frame", secBody)
				f.Size             = u2(1,0,0,20)
				f.BackgroundTransparency = 1
				f.LayoutOrder      = _eOrd
				f.ZIndex           = 14
				f.BorderSizePixel  = 0
				local l = lbl(f, text or "", 11, color or T.sub, Enum.Font.Gotham)
				l.AnchorPoint = v2(0,0.5)
				l.Position    = u2(0,4,0.5,0)
				l.ZIndex      = 15
				l.RichText    = true

				local obj = {}
				function obj:Set(t, c2) l.Text=t; if c2 then l.TextColor3=c2 end end
				function obj:Get() return l.Text end
				return obj
			end

			-- ── PROGRESS BAR ──────────────────────────────────────────────────
			function S:CreateProgressBar(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local pct = math.clamp(cfg2.Default or 0, 0, 1)
				bumpCount()
				local r = row(48)

				local ntl = lbl(r, cfg2.Title or "Progress", 12, T.txt, Enum.Font.GothamMedium)
				ntl.Position = u2(0,12,0,8); ntl.ZIndex=15

				local pctLbl = Instance.new("TextLabel", r)
				pctLbl.BackgroundTransparency = 1
				pctLbl.Text       = math.floor(pct*100).."%"
				pctLbl.TextSize   = 10
				pctLbl.TextColor3 = T.accGlow
				pctLbl.Font       = Enum.Font.GothamBold
				pctLbl.Size       = u2(0,40,0,14)
				pctLbl.Position   = u2(1,-48,0,8)
				pctLbl.TextXAlignment = Enum.TextXAlignment.Right
				pctLbl.ZIndex     = 15

				local trackBg = Instance.new("Frame", r)
				trackBg.Size             = u2(1,-24,0,8)
				trackBg.Position         = u2(0,12,0,30)
				trackBg.BackgroundColor3 = T.bgDeep
				trackBg.ZIndex           = 15
				trackBg.BorderSizePixel  = 0
				corner(trackBg, 999)

				local fill = Instance.new("Frame", trackBg)
				fill.Size             = u2(pct,0,1,0)
				fill.BackgroundColor3 = T.acc
				fill.ZIndex           = 16
				fill.BorderSizePixel  = 0
				corner(fill, 999)
				grad(fill, T.accC, T.acc, 0)

				-- Shimmer
				local shimmer = Instance.new("Frame", fill)
				shimmer.Size             = u2(0,30,1,0)
				shimmer.BackgroundColor3 = T.white
				shimmer.BackgroundTransparency = 0.8
				shimmer.BorderSizePixel  = 0
				shimmer.ZIndex           = 17
				corner(shimmer, 999)
				local function loopShimmer()
					if not shimmer or not shimmer.Parent then return end
					shimmer.Position = u2(-0.1,0,0,0)
					tw(shimmer, {Position=u2(1.1,0,0,0)}, 1.5, Enum.EasingStyle.Sine)
					task.delay(1.7, loopShimmer)
				end
				task.delay(0.5, loopShimmer)

				local obj = {}
				function obj:Set(v)
					pct = math.clamp(v,0,1)
					tw(fill, {Size=u2(pct,0,1,0)}, 0.35, Enum.EasingStyle.Quart)
					pctLbl.Text = math.floor(pct*100).."%"
				end
				function obj:Get() return pct end
				return obj
			end

			-- ── DIVIDER ───────────────────────────────────────────────────────
			function S:CreateDivider(label)
				_eOrd += 1
				local wrap2 = Instance.new("Frame", secBody)
				wrap2.Size             = u2(1,0,0,14)
				wrap2.BackgroundTransparency = 1
				wrap2.LayoutOrder      = _eOrd
				wrap2.ZIndex           = 14
				wrap2.BorderSizePixel  = 0

				local line = Instance.new("Frame", wrap2)
				line.Size             = u2(1,0,0,1)
				line.Position         = u2(0,0,0.5,0)
				line.BackgroundColor3 = T.bordFaint
				line.BorderSizePixel  = 0
				line.ZIndex           = 14

				if label then
					line.Size = u2(0.35,0,0,1)
					local line2 = Instance.new("Frame", wrap2)
					line2.Size             = u2(0.35,0,0,1)
					line2.Position         = u2(0.65,0,0.5,0)
					line2.BackgroundColor3 = T.bordFaint
					line2.BorderSizePixel  = 0
					line2.ZIndex           = 14

					local dl = Instance.new("TextLabel", wrap2)
					dl.BackgroundTransparency = 1
					dl.Text       = label
					dl.TextSize   = 9
					dl.TextColor3 = T.muted
					dl.Font       = Enum.Font.GothamBold
					dl.Size       = u2(0.3,0,1,0)
					dl.Position   = u2(0.35,0,0,0)
					dl.TextXAlignment = Enum.TextXAlignment.Center
					dl.TextYAlignment = Enum.TextYAlignment.Center
					dl.ZIndex     = 14
				end
			end

			return S
		end -- CreateSection

		return Tab
	end -- CreateTab

	-- ══════════════════════════════════════════════════════════════════════════
	-- W:Notify  (toast notifications)
	-- ══════════════════════════════════════════════════════════════════════════
	function W:Notify(cfg2)
		cfg2 = cfg2 or {}
		local nTitle  = cfg2.Title   or "Notice"
		local nBody   = cfg2.Body    or ""
		local nDur    = cfg2.Duration or 4
		local nType   = cfg2.Type    or "info"  -- "success","danger","warn","info"
		local nIcon   = cfg2.Icon    or (
			nType=="success" and "✓" or
			nType=="danger"  and "✕" or
			nType=="warn"    and "⚠" or "ℹ"
		)
		local nCol = (
			nType=="success" and T.success or
			nType=="danger"  and T.danger  or
			nType=="warn"    and T.warn    or T.info
		)

		local nf = Instance.new("Frame", notifContainer)
		nf.Size             = u2(1,0,0,0)
		nf.AutomaticSize    = Enum.AutomaticSize.Y
		nf.BackgroundColor3 = T.panel
		nf.BorderSizePixel  = 0
		nf.ZIndex           = 3000
		nf.ClipsDescendants = true
		corner(nf, 10)
		stroke(nf, T.bordFaint, 1)

		-- Color strip on left
		local strip = Instance.new("Frame", nf)
		strip.Size             = u2(0,3,1,0)
		strip.BackgroundColor3 = nCol
		strip.BorderSizePixel  = 0
		strip.ZIndex           = 3001

		local inner = Instance.new("Frame", nf)
		inner.Size             = u2(1,-3,0,0)
		inner.Position         = u2(0,3,0,0)
		inner.AutomaticSize    = Enum.AutomaticSize.Y
		inner.BackgroundTransparency = 1
		inner.ZIndex           = 3001
		pad(inner, 10,10,10,10)

		local icoLbl2 = Instance.new("TextLabel", inner)
		icoLbl2.BackgroundTransparency = 1
		icoLbl2.Text       = nIcon
		icoLbl2.TextSize   = 14
		icoLbl2.TextColor3 = nCol
		icoLbl2.Font       = Enum.Font.GothamBold
		icoLbl2.Size       = u2(0,18,0,18)
		icoLbl2.Position   = u2(0,0,0,0)
		icoLbl2.TextXAlignment = Enum.TextXAlignment.Center
		icoLbl2.ZIndex     = 3002

		local titleLbl2 = Instance.new("TextLabel", inner)
		titleLbl2.BackgroundTransparency = 1
		titleLbl2.Text       = nTitle
		titleLbl2.TextSize   = 12
		titleLbl2.TextColor3 = T.txt
		titleLbl2.Font       = Enum.Font.GothamBold
		titleLbl2.Position   = u2(0,24,0,0)
		titleLbl2.Size       = u2(1,-24,0,14)
		titleLbl2.TextXAlignment = Enum.TextXAlignment.Left
		titleLbl2.ZIndex     = 3002

		if nBody ~= "" then
			local bodyLbl2 = Instance.new("TextLabel", inner)
			bodyLbl2.BackgroundTransparency = 1
			bodyLbl2.Text       = nBody
			bodyLbl2.TextSize   = 10
			bodyLbl2.TextColor3 = T.sub
			bodyLbl2.Font       = Enum.Font.Gotham
			bodyLbl2.Position   = u2(0,24,0,18)
			bodyLbl2.Size       = u2(1,-24,0,12)
			bodyLbl2.TextXAlignment = Enum.TextXAlignment.Left
			bodyLbl2.ZIndex     = 3002
			bodyLbl2.TextWrapped = true
		end

		-- Progress bar for duration
		local progBg = Instance.new("Frame", nf)
		progBg.Size             = u2(1,-3,0,2)
		progBg.Position         = u2(0,3,1,-2)
		progBg.BackgroundColor3 = T.ghost
		progBg.BorderSizePixel  = 0
		progBg.ZIndex           = 3001

		local progFill = Instance.new("Frame", progBg)
		progFill.Size             = u2(1,0,1,0)
		progFill.BackgroundColor3 = nCol
		progFill.BorderSizePixel  = 0
		progFill.ZIndex           = 3002

		-- Slide in
		nf.BackgroundTransparency = 1
		tw(nf,{BackgroundTransparency=0},0.2)
		tw(progFill, {Size=u2(0,0,1,0)}, nDur, Enum.EasingStyle.Linear)

		-- Slide out and remove
		task.delay(nDur, function()
			if nf and nf.Parent then
				tw(nf,{BackgroundTransparency=1},0.2,Enum.EasingStyle.Quart,Enum.EasingDirection.Out,function()
					if nf and nf.Parent then nf:Destroy() end
				end)
			end
		end)

		-- Click to dismiss
		local closeNf = Instance.new("TextButton", nf)
		closeNf.Size             = u2(1,0,1,0)
		closeNf.BackgroundTransparency = 1
		closeNf.Text             = ""
		closeNf.ZIndex           = 3003
		cn(closeNf.MouseButton1Click, function()
			if nf and nf.Parent then
				tw(nf,{BackgroundTransparency=1},0.15,Enum.EasingStyle.Quart,Enum.EasingDirection.Out,function()
					if nf and nf.Parent then nf:Destroy() end
				end)
			end
		end)
	end

	-- ══════════════════════════════════════════════════════════════════════════
	-- Window controls
	-- ══════════════════════════════════════════════════════════════════════════
	local minimized   = false
	local _prevH      = winH

	cn(minBtn.MouseButton1Click, function()
		minimized = not minimized
		local targetH = minimized and 50 or _prevH
		tw(main, {Size=u2(0,winW,0,targetH)}, 0.28, Enum.EasingStyle.Quart)
		tabHeader.Visible = not minimized
	end)

	-- Maximize (expand height by 30%)
	cn(maxBtn.MouseButton1Click, function()
		if minimized then return end
		if _prevH == winH then
			_prevH = math.floor(winH * 1.35)
		else
			_prevH = winH
		end
		tw(main, {Size=u2(0,winW,0,_prevH)}, 0.3, Enum.EasingStyle.Quart)
	end)

	cn(closeBtn.MouseButton1Click, function()
		tabHeader.Visible = false
		glowBack.Visible  = false
		tw(main,{Size=u2(0,winW,0,0),BackgroundTransparency=1},0.22,Enum.EasingStyle.Quart)
		task.delay(0.25, function()
			if gui and gui.Parent then gui:Destroy() end
		end)
	end)

	-- Toggle key
	cn(uis.InputBegan, function(inp, gp)
		if gp then return end
		if inp.KeyCode == toggleKey then
			local v = not main.Visible
			main.Visible      = v
			tabHeader.Visible = v and not minimized
			glowBack.Visible  = v
		end
	end)

	-- ── Stats update ──────────────────────────────────────────────────────────
	local fpsCount, fpsLast = 0, tick()
	cn(rs.RenderStepped, function()
		fpsCount += 1
		local now = tick()
		if now - fpsLast >= 0.5 then
			local fps = math.round(fpsCount/(now-fpsLast))
			fpsVal.Text = tostring(fps)
			fpsVal.TextColor3 = fps>=55 and T.success or fps>=30 and T.warn or T.danger
			fpsCount=0; fpsLast=now
		end
	end)

	local ok2, ss = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"] end)
	if ok2 and ss then
		cn(rs.Heartbeat, function()
			local p = math.round(ss.Value)
			pingVal.Text = tostring(p)
			pingVal.TextColor3 = p<80 and T.success or p<150 and T.warn or T.danger
		end)
	end

	-- ── Tooltip tracker ───────────────────────────────────────────────────────
	cn(rs.RenderStepped, function()
		-- Sync glow and tab header every frame
		syncGlow()
		syncTabHeader()

		-- Update tooltip position
		if tipFrame.Visible then
			tipFrame.Position = u2(0, mouseX+16, 0, mouseY-6)
		end

		-- Auto-hide tooltip if mouse left target
		if _tipTarget and _tipTarget.Parent then
			local ap = _tipTarget.AbsolutePosition
			local as = _tipTarget.AbsoluteSize
			if mouseX<ap.X or mouseX>ap.X+as.X or mouseY<ap.Y or mouseY>ap.Y+as.Y then
				_tipTarget=nil; tipFrame.Visible=false
			end
		end
	end)

	-- ── Open animation ────────────────────────────────────────────────────────
	task.defer(function()
		twSpring(main, {Size=u2(0,winW,0,winH)}, 0.42)
	end)

	-- ══════════════════════════════════════════════════════════════════════════
	-- Public W API
	-- ══════════════════════════════════════════════════════════════════════════
	W._gui  = gui
	W._main = main

	function W:Destroy()
		for _, c in ipairs(_conns) do pcall(function() c:Disconnect() end) end
		if gui and gui.Parent then gui:Destroy() end
	end

	function W:SetVisible(v)
		main.Visible      = v
		tabHeader.Visible = v
		glowBack.Visible  = v
	end

	function W:SetTitle(t)
		titleLbl.Text = t
	end

	function W:SetTheme(newT)
		for k,v in pairs(newT) do T[k]=v end
	end

	return W
end

-- ══════════════════════════════════════════════════════════════════════════════
-- K.GetTheme / K.SetTheme (global)
-- ══════════════════════════════════════════════════════════════════════════════
function K.GetTheme() return T end
function K.SetTheme(overrides)
	for k,v in pairs(overrides) do T[k]=v end
end

return K
