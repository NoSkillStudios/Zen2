					ColorSequenceKeypoint.new(0, Color3.new(0,0,0)),
					ColorSequenceKeypoint.new(1, Color3.new(0,0,0))
				}
				svDarkGrad.Transparency = NumberSequence.new{
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(1, 0)
				}
				svDarkGrad.Rotation = 90

				local svDot = Instance.new("Frame", svFrame)
				svDot.Size = u2(0,12,0,12)
				svDot.AnchorPoint = v2(0.5,0.5)
				svDot.Position = u2(s,0,1-v2val,0)
				svDot.BackgroundColor3 = theme.white
				svDot.ZIndex = 19
				corner(svDot, 999)
				stroke(svDot, theme.white, 2, 0)

				local hueBar = Instance.new("Frame", picker)
				hueBar.Size = u2(0,16,0,120)
				hueBar.Position = u2(1,-32,0,8)
				hueBar.ZIndex = 16
				corner(hueBar, 4)

				local hueGrad = Instance.new("UIGradient", hueBar)
				hueGrad.Color = ColorSequence.new{
					ColorSequenceKeypoint.new(0, c3(255,0,0)),
					ColorSequenceKeypoint.new(0.166, c3(255,255,0)),
					ColorSequenceKeypoint.new(0.333, c3(0,255,0)),
					ColorSequenceKeypoint.new(0.5, c3(0,255,255)),
					ColorSequenceKeypoint.new(0.666, c3(0,0,255)),
					ColorSequenceKeypoint.new(0.833, c3(255,0,255)),
					ColorSequenceKeypoint.new(1, c3(255,0,0)),
				}
				hueGrad.Rotation = 90

				local hueDot = Instance.new("Frame", hueBar)
				hueDot.Size = u2(1,4,0,4)
				hueDot.Position = u2(0,-2,h,-2)
				hueDot.BackgroundColor3 = theme.white
				hueDot.ZIndex = 17
				corner(hueDot, 2)

				local hexBox = Instance.new("TextBox", picker)
				hexBox.Size = u2(1,-16,0,28)
				hexBox.Position = u2(0,8,0,136)
				hexBox.BackgroundColor3 = theme.bg
				hexBox.TextColor3 = theme.text
				hexBox.Text = "#"..string.format("%02x%02x%02x", math.floor(currentColor.R*255), math.floor(currentColor.G*255), math.floor(currentColor.B*255)):upper()
				hexBox.TextSize = 12
				hexBox.Font = Enum.Font.GothamMedium
				hexBox.ZIndex = 16
				corner(hexBox, 5)
				stroke(hexBox, theme.border, 1, 0.5)
				pad(hexBox, 0,0,8,8)

				local function updateColor()
					currentColor = Color3.fromHSV(h,s,v2val)
					preview.BackgroundColor3 = currentColor
					svColor.Color = ColorSequence.new{
						ColorSequenceKeypoint.new(0, c3(255,255,255)),
						ColorSequenceKeypoint.new(1, Color3.fromHSV(h,1,1))
					}
					svDot.Position = u2(s,0,1-v2val,0)
					hueDot.Position = u2(0,-2,h,-2)
					hexBox.Text = "#"..string.format("%02x%02x%02x", math.floor(currentColor.R*255), math.floor(currentColor.G*255), math.floor(currentColor.B*255)):upper()
					task.spawn(cb, currentColor)
				end

				conn(svFrame.InputBegan, function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingSv = true
						local abs = svFrame.AbsolutePosition
						local sz = svFrame.AbsoluteSize
						s = math.clamp((inp.Position.X-abs.X)/sz.X,0,1)
						v2val = 1-math.clamp((inp.Position.Y-abs.Y)/sz.Y,0,1)
						updateColor()
					end
				end)
				conn(hueBar.InputBegan, function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingH = true
						local abs = hueBar.AbsolutePosition
						local sz = hueBar.AbsoluteSize
						h = math.clamp((inp.Position.Y-abs.Y)/sz.Y,0,1)
						updateColor()
					end
				end)
				conn(uis.InputChanged, function(inp)
					if inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
					if draggingSv then
						local abs = svFrame.AbsolutePosition
						local sz = svFrame.AbsoluteSize
						s = math.clamp((inp.Position.X-abs.X)/sz.X,0,1)
						v2val = 1-math.clamp((inp.Position.Y-abs.Y)/sz.Y,0,1)
						updateColor()
					elseif draggingH then
						local abs = hueBar.AbsolutePosition
						local sz = hueBar.AbsoluteSize
						h = math.clamp((inp.Position.Y-abs.Y)/sz.Y,0,1)
						updateColor()
					end
				end)
				conn(uis.InputEnded, function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingSv = false; draggingH = false
					end
				end)

				conn(row.InputBegan, function(inp)
					if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
					pickerOpen = not pickerOpen
					if pickerOpen then
						picker.Visible = true
						picker.Size = u2(1,0,0,0)
						tween(picker, {Size=u2(1,0,0,174)}, 0.2, Enum.EasingStyle.Back)
						wrap.Size = u2(1,0,0, 38+174)
					else
						tween(picker, {Size=u2(1,0,0,0)}, 0.15)
						task.delay(0.16, function() if not pickerOpen then picker.Visible=false end end)
						wrap.Size = u2(1,0,0,36)
					end
				end)
				conn(row.MouseEnter, function() tween(row, {BackgroundColor3=c3(26,26,34)}, 0.1) end)
				conn(row.MouseLeave, function() tween(row, {BackgroundColor3=theme.elevated}, 0.1) end)

				local obj = {Value=currentColor}
				function obj:Set(c) currentColor=c; h,s,v2val=Color3.toHSV(c); updateColor() end
				return obj
			end

			function S:CreateLabel(text, color)
				local lf = Instance.new("Frame", secContent)
				lf.Size = u2(1,0,0,24)
				lf.BackgroundTransparency = 1
				lf.LayoutOrder = so()
				lf.ZIndex = 7

				local ll = label(lf, text or "", 12, color or theme.subtext, Enum.Font.Gotham)
				ll.Position = u2(0,12,0.5,-7)
				ll.ZIndex = 8

				local obj = {}
				function obj:Set(t, c) ll.Text=t; if c then ll.TextColor3=c end end
				return obj
			end

			function S:CreateDivider()
				local div = Instance.new("Frame", secContent)
				div.Size = u2(1,0,0,1)
				div.BackgroundColor3 = theme.border
				div.BackgroundTransparency = 0.4
				div.BorderSizePixel = 0
				div.LayoutOrder = so()
				div.ZIndex = 7
			end

			return S
		end

		function T:CreateButton(cfg2) return ({T:CreateSection("__nosec")})[1] and nil end

		T._page = page
		T._scroll = scroll
		return T
	end

	local minimized = false
	conn(minBtn.MouseButton1Click, function()
		minimized = not minimized
		if minimized then
			tween(main, {Size=u2(0,size.X,0,48)}, 0.25, Enum.EasingStyle.Back)
		else
			tween(main, {Size=u2(0,size.X,0,size.Y)}, 0.25, Enum.EasingStyle.Back)
		end
	end)

	conn(closeBtn.MouseButton1Click, function()
		tween(main, {Size=u2(0,size.X,0,0), Position=u2(main.Position.X.Scale, main.Position.X.Offset, main.Position.Y.Scale, main.Position.Y.Offset + size.Y/2)}, 0.2)
		tween(overlay, {BackgroundTransparency=1}, 0.2)
		task.delay(0.22, function() gui:Destroy() end)
	end)

	conn(uis.InputBegan, function(inp, gp)
		if gp then return end
		if inp.KeyCode == toggleKey then
			main.Visible = not main.Visible
		end
	end)

	main.Size = u2(0,size.X,0,0)
	tween(main, {Size=u2(0,size.X,0,size.Y)}, 0.35, Enum.EasingStyle.Back)

	for _, b in ipairs({closeBtn, minBtn}) do
		conn(b.MouseEnter, function() tween(b, {BackgroundTransparency=0.3}, 0.1) end)
		conn(b.MouseLeave, function() tween(b, {BackgroundTransparency=0.6}, 0.1) end)
	end

	W._gui = gui
	W._main = main
	return W
end

return KrakenUI
