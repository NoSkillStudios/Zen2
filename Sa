			div.ZIndex           = 7

			local secBody = Instance.new("Frame", sec)
			secBody.Size          = u2(1,0,0,0)
			secBody.Position      = u2(0,0,0,36)
			secBody.AutomaticSize = Enum.AutomaticSize.Y
			secBody.BackgroundTransparency = 1
			secBody.ZIndex        = 7
			secBody.BorderSizePixel = 0
			pad(secBody, 4,10,10,10)
			list(secBody, nil, 4)

			local S    = {}
			local eOrd = 0

			-- BASE ROW — flat dark, hover → white tint, selected → blue tint
			local function row(h, noHover)
				local r = Instance.new("Frame", secBody)
				r.Size             = u2(1,0,0,h or 36)
				r.BackgroundColor3 = T.elev
				r.LayoutOrder      = (function() eOrd+=1; return eOrd end)()
				r.ZIndex           = 8
				r.BorderSizePixel  = 0
				corner(r, 7)
				stroke(r, T.bordFaint, 1)
				if not noHover then
					cn(r.MouseEnter, function() tw(r,{BackgroundColor3=T.elevHov},0.14) end)
					cn(r.MouseLeave, function() tw(r,{BackgroundColor3=T.elev},0.14) end)
				end
				return r
			end

			local function rLbl(r, txt, yoff)
				local l = lbl(r, txt, 12, T.txt, Enum.Font.GothamMedium)
				l.Position = u2(0,12,0,yoff or 10)
				l.ZIndex   = 9
				return l
			end

			-- ── BUTTON (flat row, hover = white highlight, run btn right) ──────
			function S:CreateButton(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb   = cfg2.Callback or function() end
				local desc = cfg2.Description
				local r    = row(36)
				rLbl(r, cfg2.Title or "Button", 12)

				-- entire row is clickable
