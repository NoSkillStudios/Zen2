		-- icon: image or text
		local icoLbl
		if isAsset then
			local img = Instance.new("ImageLabel", icoBtn)
			img.BackgroundTransparency = 1
			img.Image       = tostring(icon):match("rbxasset") and icon or ("rbxassetid://"..icon)
			img.Size        = u2(0,20,0,20)
			img.Position    = u2(0.5,-10,0.5,-10)
			img.ZIndex      = 7
			img.ImageColor3 = T.muted
			-- wrap for tween compat
			icoLbl = {
				TextColor3 = T.muted,
