local conns = {}
local function cn(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns+1] = c
	return c
end

local function tw(obj, props, dur, sty, dir)
	ts:Create(obj, ti(dur or 0.18, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props):Play()
end

local function mkCorner(p, r)
	local c = Instance.new("UICorner", p)
	c.CornerRadius = UDim.new(0, r or 8)
	return c
end

local function mkStroke(p, col, th, tr)
	local s = Instance.new("UIStroke", p)
	s.Color = col or T.bord
	s.Thickness = th or 1
	s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function mkPad(p, t, b, l, r)
	local pad = Instance.new("UIPadding", p)
	pad.PaddingTop    = UDim.new(0, t or 8)
	pad.PaddingBottom = UDim.new(0, b or 8)
	pad.PaddingLeft   = UDim.new(0, l or 8)
	pad.PaddingRight  = UDim.new(0, r or 8)
end

local function mkList(p, dir, sp)
	local l = Instance.new("UIListLayout", p)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, sp or 6)
	return l
end

local function mkLbl(p, txt, sz, col, font)
	local l = Instance.new("TextLabel", p)
	l.BackgroundTransparency = 1
	l.Text = txt or ""
	l.TextSize = sz or 13
	l.TextColor3 = col or T.txt
	l.Font = font or Enum.Font.GothamMedium
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.AutomaticSize = Enum.AutomaticSize.XY
	return l
end

local function mkScroll(p)
	local sf = Instance.new("ScrollingFrame", p)
	sf.Size = u2(1,0,1,0)
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = 3
	sf.ScrollBarImageColor3 = T.acc
	sf.ScrollBarImageTransparency = 0.4
	sf.CanvasSize = u2(0,0,0,0)
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	return sf
end

local function ripple(btn)
	local r = Instance.new("Frame", btn)
	r.Size = u2(0,0,0,0)
	r.Position = u2(0.5,0,0.5,0)
	r.AnchorPoint = v2(0.5,0.5)
	r.BackgroundColor3 = T.white
	r.BackgroundTransparency = 0.7
	r.ZIndex = btn.ZIndex + 10
	r.BorderSizePixel = 0
	mkCorner(r, 999)
	local sz = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.5
	tw(r, {Size=u2(0,sz,0,sz), BackgroundTransparency=1}, 0.45, Enum.EasingStyle.Quad)
	task.delay(0.47, function() r:Destroy() end)
end

local dragState = {active=false, obj=nil, start=nil, orig=nil}
local function makeDraggable(frame, handle)
	cn(handle.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragState.active = true
		dragState.obj    = frame
		dragState.start  = i.Position
		dragState.orig   = frame.Position
	end)
	cn(uis.InputChanged, function(i)
		if not dragState.active or dragState.obj ~= frame then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local d = i.Position - dragState.start
		frame.Position = u2(
			dragState.orig.X.Scale, dragState.orig.X.Offset + d.X,
			dragState.orig.Y.Scale, dragState.orig.Y.Offset + d.Y
		)
	end)
	cn(uis.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragState.active = false
			dragState.obj    = nil
		end
	end)
end

