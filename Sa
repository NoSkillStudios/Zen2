                ntl.Size = UDim2.new(0.5, 0, 1, 0)
                ntl.TextXAlignment = Enum.TextXAlignment.Left
                ntl.ZIndex = 11
                ntl.Parent = hdr2

                local vtl = Instance.new("TextLabel")
                vtl.BackgroundTransparency = 1
                vtl.Text = tostring(val) .. suf
                vtl.TextSize = 12
                vtl.TextColor3 = T.accent
                vtl.Font = Enum.Font.GothamBold
                vtl.Size = UDim2.new(0.5, -58, 1, 0)
                vtl.Position = UDim2.new(0.5, 0, 0, 0)
                vtl.TextXAlignment = Enum.TextXAlignment.Right
                vtl.ZIndex = 11
                vtl.Parent = hdr2

                local numBox = Instance.new("TextBox")
                numBox.Size = UDim2.new(0, 50, 0, 20)
                numBox.Position = UDim2.new(1, -52, 0.5, -10)
                numBox.BackgroundColor3 = T.bg
                numBox.TextColor3 = T.accent
                numBox.Text = tostring(val)
                numBox.TextSize = 11
                numBox.Font = Enum.Font.GothamBold
                numBox.PlaceholderText = "0"
                numBox.ZIndex = 11
                numBox.BorderSizePixel = 0
                numBox.TextXAlignment = Enum.TextXAlignment.Center
                numBox.Parent = hdr2
                Util.Corner(numBox, 5)
                Util.Stroke(numBox, T.border, 1, 0.5)

                local trackBg = Instance.new("Frame")
                trackBg.Size = UDim2.new(1, -24, 0, 6)
                trackBg.Position = UDim2.new(0, 12, 0, 40)
                trackBg.BackgroundColor3 = T.bg
                trackBg.ZIndex = 10
                trackBg.BorderSizePixel = 0
                trackBg.Parent = row
                Util.Corner(trackBg, 999)

                local fill = Instance.new("Frame")
                fill.Size = UDim2.new((val - mn) / (mx - mn), 0, 1, 0)
                fill.BackgroundColor3 = T.accent
                fill.ZIndex = 11
                fill.BorderSizePixel = 0
                fill.Parent = trackBg
                Util.Corner(fill, 999)

                local fillGrad = Instance.new("UIGradient")
                fillGrad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, T.accent),
                    ColorSequenceKeypoint.new(1, T.accent2),
                })
                fillGrad.Parent = fill

                local dot = Instance.new("Frame")
                dot.Size = UDim2.new(0, 14, 0, 14)
                dot.AnchorPoint = Vector2.new(0.5, 0.5)
                dot.Position = UDim2.new((val - mn) / (mx - mn), 0, 0.5, 0)
                dot.BackgroundColor3 = T.white
                dot.ZIndex = 12
                dot.BorderSizePixel = 0
                dot.Parent = trackBg
                Util.Corner(dot, 999)

                local function setValue(nv, silent)
                    val = math.clamp(math.round(nv), mn, mx)
                    local pct = (val - mn) / (mx - mn)
                    Util.Tween(fill, {Size = UDim2.new(pct, 0, 1, 0)}, 0.05)
                    Util.Tween(dot, {Position = UDim2.new(pct, 0, 0.5, 0)}, 0.05)
                    vtl.Text = tostring(val) .. suf
                    numBox.Text = tostring(val)
                    if not silent then
                        task.spawn(pcall, cb, val)
                    end
                end

                local function handleInput(input)
                    local ax = trackBg.AbsolutePosition.X
                    local aw = trackBg.AbsoluteSize.X
                    local pct = math.clamp((input.Position.X - ax) / aw, 0, 1)
                    setValue(mn + pct * (mx - mn))
                end

                conns:Connect(trackBg.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        handleInput(input)
                    end
                end)

                conns:Connect(dot.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                    end
                end)

                conns:Connect(UserInputService.InputChanged, function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        handleInput(input)
                    end
                end)

                conns:Connect(UserInputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)

                conns:Connect(numBox.FocusLost, function(entered)
                    if entered then
                        local n2 = tonumber(numBox.Text)
                        if n2 then
                            setValue(n2)
                        end
                    end
                    numBox.Text = tostring(val)
                end)

                local obj = {}
                function obj:Set(v) setValue(v, false) end
                function obj:Get() return val end
                return obj
            end

