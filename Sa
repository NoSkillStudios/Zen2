-- ==================== UTILITIES ====================
local Util = {}

function Util.Tween(obj, props, dur, style, dir)
    dur = dur or 0.2
    style = style or Enum.EasingStyle.Quart
    dir = dir or Enum.EasingDirection.Out
    TweenService:Create(obj, TweenInfo.new(dur, style, dir), props):Play()
end

function Util.Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
    return c
end

function Util.Stroke(obj, color, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = color or T.border
    s.Thickness = thick or 1
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end

function Util.Pad(obj, top, bot, left, right)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, top or 8)
    p.PaddingBottom = UDim.new(0, bot or 8)
    p.PaddingLeft = UDim.new(0, left or 8)
    p.PaddingRight = UDim.new(0, right or 8)
    p.Parent = obj
    return p
end

function Util.List(obj, spacing, direction)
    local l = Instance.new("UIListLayout")
    l.FillDirection = direction or Enum.FillDirection.Vertical
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Padding = UDim.new(0, spacing or 6)
    l.Parent = obj
    return l
end

function Util.Scroll(obj)
    local s = Instance.new("ScrollingFrame")
    s.Size = UDim2.new(1, 0, 1, 0)
    s.BackgroundTransparency = 1
    s.BorderSizePixel = 0
    s.ScrollBarThickness = 3
    s.ScrollBarImageColor3 = T.accent
    s.ScrollBarImageTransparency = 0.4
    s.CanvasSize = UDim2.new(0, 0, 0, 0)
    s.AutomaticCanvasSize = Enum.AutomaticSize.Y
    s.Parent = obj
    return s
end

function Util.Label(parent, text, size, color, font, align)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text or ""
    l.TextSize = size or 13
    l.TextColor3 = color or T.text
    l.Font = font or Enum.Font.GothamMedium
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.AutomaticSize = Enum.AutomaticSize.XY
    l.Parent = parent
    return l
end

-- ==================== DRAG SYSTEM ====================
local Drag = {Active = false, Target = nil, Start = nil, Origin = nil}

UserInputService.InputChanged:Connect(function(input)
    if not Drag.Active or not Drag.Target then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - Drag.Start
        Drag.Target.Position = UDim2.new(
            Drag.Origin.X.Scale, Drag.Origin.X.Offset + delta.X,
            Drag.Origin.Y.Scale, Drag.Origin.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Drag.Active = false
        Drag.Target = nil
    end
end)

function Util.MakeDraggable(frame, handle)
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Drag.Active = true
            Drag.Target = frame
            Drag.Start = input.Position
            Drag.Origin = frame.Position
        end
    end)
end

-- ==================== CONNECTION MANAGER ====================
local Connections = {}

function Connections:Connect(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(self, conn)
    return conn
end

function Connections:Cleanup()
    for _, c in ipairs(self) do
        if c and c.Connected then
            pcall(function() c:Disconnect() end)
        end
    end
    table.clear(self)
end

