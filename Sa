	local function selectTab(name)
		if activeTab == name then return end
		local prev = activeTab
		activeTab  = name

		activeTabLabel.Text = name

		for n, pg in pairs(pages) do
			local ico = sideIcons[n]
			if n == name then
				pg.Visible = true
				if ico then
					tw(ico.btn,  {BackgroundColor3=T.acc, BackgroundTransparency=0}, 0.18)
					tw(ico.icon, {TextColor3=T.white}, 0.18)
					tw(ico.bar,  {BackgroundTransparency=0}, 0.18)
				end
			else
				if ico then
					tw(ico.btn,  {BackgroundColor3=T.sidebar, BackgroundTransparency=1}, 0.18)
					tw(ico.icon, {TextColor3=T.muted}, 0.18)
					tw(ico.bar,  {BackgroundTransparency=1}, 0.18)
				end
				if prev == n then
					task.delay(0.18, function()
						if activeTab ~= n and pg and pg.Parent then
							pg.Visible = false
						end
					end)
				else
					pg.Visible = false
				end
			end
		end
