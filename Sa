				end)

				local obj = {}
				function obj:Set(c2) cur=c2; h2,s2,v2v=Color3.toHSV(c2); updatePicker() end
				function obj:Get() return cur end
				return obj
			end

			function S:CreateLabel(text, color)
				local f = Instance.new("Frame", body2)
				f.Size             = u2(1,0,0,22)
				f.BackgroundTransparency = 1
				f.LayoutOrder      = eo()
				f.ZIndex           = 7
				f.BorderSizePixel  = 0
				local l = mkLbl(f, text or "", 11, color or T.sub, Enum.Font.Gotham)
				l.Position = u2(0,4,0.5,-6)
				l.ZIndex   = 8
				local obj = {}
				function obj:Set(t,c2) l.Text=t; if c2 then l.TextColor3=c2 end end
				return obj
			end

			function S:CreateDivider()
				local d = Instance.new("Frame", body2)
				d.Size             = u2(1,0,0,1)
				d.BackgroundColor3 = T.bord
				d.BackgroundTransparency = 0.4
				d.BorderSizePixel  = 0
				d.LayoutOrder      = eo()
				d.ZIndex           = 7
			end

			return S
		end

		return Tab
	end

	local minimized = false
	cn(minBtn.MouseButton1Click, function()
		minimized = not minimized
		tw(main, {Size = minimized and u2(0,winSize.X,0,48) or u2(0,winSize.X,0,winSize.Y)}, 0.25, Enum.EasingStyle.Back)
	end)

	cn(closeBtn.MouseButton1Click, function()
		tw(main, {Size=u2(0,winSize.X,0,0)}, 0.18)
		task.delay(0.2, function() gui:Destroy() end)
	end)

	cn(uis.InputBegan, function(inp, gp)
		if gp then return end
		if inp.KeyCode == toggleKey then
			main.Visible = not main.Visible
		end
	end)

	for _, b in ipairs({closeBtn, minBtn}) do
		cn(b.MouseEnter, function() tw(b, {BackgroundTransparency=0.25}, 0.1) end)
		cn(b.MouseLeave, function() tw(b, {BackgroundTransparency=0.5}, 0.1) end)
	end

	tw(main, {Size=u2(0,winSize.X,0,winSize.Y)}, 0.3, Enum.EasingStyle.Back)
	main.Size = u2(0,winSize.X,0,0)

	W._gui  = gui
	W._main = main
	return W
end

return K
