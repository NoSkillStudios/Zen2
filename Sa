                    svDot.Position = UDim2.new(s2, 0, 1 - v2, 0)
                    hDot.Position = UDim2.new(0, -2, h2, -2)
                    hexBox.Text = "#" .. string.format("%02X%02X%02X", math.floor(cur.R * 255), math.floor(cur.G * 255), math.floor(cur.B * 255))
                    task.spawn(pcall, cb, cur)
                end
                updatePicker()

                conns:Connect(svF.InputBegan, function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    dSv = true
                    local ap = svF.AbsolutePosition
                    local as = svF.AbsoluteSize
                    s2 = math.clamp((input.Position.X - ap.X) / as.X, 0, 1)
                    v2 = 1 - math.clamp((input.Position.Y - ap.Y) / as.Y, 0, 1)
                    updatePicker()
                end)

                conns:Connect(hBar.InputBegan, function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    dH = true
                    local ap = hBar.AbsolutePosition
                    local as = hBar.AbsoluteSize
                    h2 = math.clamp((input.Position.Y - ap.Y) / as.Y, 0, 1)
                    updatePicker()
                end)

                conns:Connect(UserInputService.InputChanged, function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    if dSv then
                        local ap = svF.AbsolutePosition
                        local as = svF.AbsoluteSize
                        s2 = math.clamp((input.Position.X - ap.X) / as.X, 0, 1)
                        v2 = 1 - math.clamp((input.Position.Y - ap.Y) / as.Y, 0, 1)
                        updatePicker()
                    elseif dH then
                        local ap = hBar.AbsolutePosition
                        local as = hBar.AbsoluteSize
                        h2 = math.clamp((input.Position.Y - ap.Y) / as.Y, 0, 1)
                        updatePicker()
                    end
                end)

                conns:Connect(UserInputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dSv = false
                        dH = false
                    end
                end)

                conns:Connect(row.InputBegan, function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    pickerOpen = not pickerOpen
                    if pickerOpen then
                        pkFrame.Visible = true
                        pkFrame.Size = UDim2.new(1, 0, 0, 0)
                        Util.Tween(pkFrame, {Size = UDim2.new(1, 0, 0, 162)}, 0.2, Enum.EasingStyle.Back)
                        wrap.Size = UDim2.new(1, 0, 0, 38 + 162)
                    else
                        Util.Tween(pkFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.14)
                        task.delay(0.15, function()
                            if not pickerOpen then pkFrame.Visible = false end
                        end)
                        wrap.Size = UDim2.new(1, 0, 0, 36)
                    end
                end)

                local obj = {}
                function obj:Set(c2)
                    cur = c2
                    h2, s2, v2 = Color3.toHSV(c2)
                    updatePicker()
                end
                function obj:Get() return cur end
                return obj
            end

            -- ===== LABEL =====
            function S:CreateLabel(text, color)
                local f = Instance.new("Frame")
                f.Size = UDim2.new(1, 0, 0, 22)
                f.BackgroundTransparency = 1
                f.LayoutOrder = eo()
                f.ZIndex = 9
                f.BorderSizePixel = 0
                f.Parent = body2

                local l = Util.Label(f, text or "", 11, color or T.sub, Enum.Font.Gotham)
                l.Position = UDim2.new(0, 4, 0.5, -6)
                l.ZIndex = 10

                local obj = {}
                function obj:Set(t, c2)
                    l.Text = t
                    if c2 then l.TextColor3 = c2 end
                end
                return obj
            end

            -- ===== DIVIDER =====
            function S:CreateDivider()
                local d = Instance.new("Frame")
                d.Size = UDim2.new(1, 0, 0, 1)
                d.BackgroundColor3 = T.border
                d.BackgroundTransparency = 0.4
                d.BorderSizePixel = 0
                d.LayoutOrder = eo()
                d.ZIndex = 9
                d.Parent = body2
            end

            return S
        end

        return Tab
    end

    -- Minimize
    local minimized = false
    conns:Connect(minBtn.MouseButton1Click, function()
        minimized = not minimized
        Util.Tween(main, {Size = minimized and UDim2.new(0, size.X, 0, 52) or UDim2.new(0, size.X, 0, size.Y)}, 0.25, Enum.EasingStyle.Back)
    end)

    -- Close
    conns:Connect(closeBtn.MouseButton1Click, function()
        Util.Tween(main, {Size = UDim2.new(0, size.X, 0, 0)}, 0.18)
        task.delay(0.2, function()
            conns:Cleanup()
            gui:Destroy()
        end)
    end)

    -- Toggle key
    conns:Connect(UserInputService.InputBegan, function(input, gp)
        if gp then return end
        if input.KeyCode == toggleKey then
            main.Visible = not main.Visible
        end
    end)

    -- Button hover effects
    for _, b in ipairs({closeBtn, minBtn}) do
        conns:Connect(b.MouseEnter, function()
            Util.Tween(b, {BackgroundTransparency = 0.25}, 0.1)
        end)
        conns:Connect(b.MouseLeave, function()
            Util.Tween(b, {BackgroundTransparency = 0.5}, 0.1)
        end)
    end

    Window._gui = gui
    Window._main = main
    return Window
end

return Kraken
