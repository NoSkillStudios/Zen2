    local tabUnderlines = {}
    local activeTab = nil
    local conns = setmetatable({}, {__index = Connections})

    local function selectTab(name)
        if activeTab == name then return end
        activeTab = name
        for n, pg in pairs(pages) do
            local btn = tabBtns[n]
            local lbl = tabLabels[n]
            local line = tabUnderlines[n]
            if n == name then
                pg.Visible = true
                if btn then Util.Tween(btn, {BackgroundColor3 = T.elev, BackgroundTransparency = 0.3}, 0.15) end
                if lbl then Util.Tween(lbl, {TextColor3 = T.text}, 0.15) end
                if line then Util.Tween(line, {BackgroundTransparency = 0, Size = UDim2.new(1, 0, 0, 2)}, 0.15) end
            else
                if btn then Util.Tween(btn, {BackgroundColor3 = T.topbar, BackgroundTransparency = 1}, 0.15) end
                if lbl then Util.Tween(lbl, {TextColor3 = T.muted}, 0.15) end
                if line then Util.Tween(line, {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 2)}, 0.15) end
                task.delay(0.15, function()
                    if activeTab ~= n and pg and pg.Parent then
                        pg.Visible = false
                    end
                end)
            end
        end
    end

