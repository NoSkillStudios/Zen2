					if not silent then task.spawn(pcall, cb, v) end
				end
				setToggle(state, true)

				cn(hitBtn.MouseButton1Click, function() setToggle(not state) end)

				local obj = {}
				function obj:Set(v)   setToggle(v, false) end
				function obj:Get()    return state end
				function obj:Toggle() setToggle(not state) end
				return obj
