					tw(knob,  {Position=u2(0, v and 23 or 3, 0.5,-10)}, 0.28, Enum.EasingStyle.Back)
					tw(knobGlow, {BackgroundTransparency=v and 0.4 or 1}, 0.2)
					if v then
						grad(track, T.acc, T.accB, 135)
						trackGrad.Color = ColorSequence.new{
							ColorSequenceKeypoint.new(0,T.acc),
							ColorSequenceKeypoint.new(1,T.accB)}
					else
						trackGrad.Color = ColorSequence.new{
