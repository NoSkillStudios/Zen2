local activeArgPopup = nil
local argPopupGui    = nil

local function closeArgPopup()
    if argPopupGui and argPopupGui.Parent then
        local pf = argPopupGui:FindFirstChild("PopupFrame")
        if pf then
            TweenService:Create(pf,
                TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In),
                { Size = UDim2.fromOffset(280, 0) }
            ):Play()
        end
        task.delay(0.2, function()
            pcall(function() argPopupGui:Destroy() end)
            argPopupGui    = nil
            activeArgPopup = nil
        end)
    end
end

local function showArgPopup(cmdName, schema, onConfirm)
    if activeArgPopup == cmdName and argPopupGui and argPopupGui.Parent then
        closeArgPopup(); return
    end
    if argPopupGui then closeArgPopup() end
    activeArgPopup = cmdName

    argPopupGui                  = Instance.new("ScreenGui")
    argPopupGui.Name             = "NihonArgPopup"
    argPopupGui.IgnoreGuiInset   = true
    argPopupGui.DisplayOrder     = 1002
    argPopupGui.ResetOnSpawn     = false
