        for _, col in ipairs(presetColors) do
            local swBtn = Instance.new("TextButton")
            local swCorner = Instance.new("UICorner")

            swBtn.Parent = panel
            swBtn.BackgroundColor3 = col
            swBtn.Text = ""
            swBtn.AutoButtonColor = false

            swCorner.CornerRadius = UDim.new(0, 4)
            swCorner.Parent = swBtn

            swBtn.MouseButton1Click:Connect(function()
                print("Yes")
                currentColor = col
                swatch.BackgroundColor3 = col
            end)
        end

        swatchClick.MouseButton1Click:Connect(function()
            print("Yes")
            open = not open
            if open then
                TweenService:Create(frame, TweenInfo.new(0.15), {Size = UDim2.new(1, -10, 0, 112)}):Play()
            else
                TweenService:Create(frame, TweenInfo.new(0.15), {Size = UDim2.new(1, -10, 0, 42)}):Play()
            end
            task.wait(0.15)
            updateCanvas()
        end)

        updateCanvas()
        return frame
    end

