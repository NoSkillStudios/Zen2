        if panels.Favorites then
            buildFavoritesPanel(panels.Favorites, favorites, refreshFavsPanel, L)
        end
    end

    buildCommandsPanel(panels.Commands, favorites, refreshFavsPanel)
    buildFavoritesPanel(panels.Favorites, favorites, refreshFavsPanel, L)
    buildSettingsPanel(panels.Settings, tabBtns, tabIcons, L)
    setupDragging(Main, Header)
    switchTab("Commands", true)

    local guiVisible     = true
    local minimizedState = false
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.KeyCode == Enum.KeyCode.RightShift then
            guiVisible = not guiVisible
            if guiVisible then
                Main.Visible = true
                TweenService:Create(Main,
                    TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                    { Size = UDim2.fromOffset(PANEL_W, minimizedState and HEADER_H or PANEL_H) }
                ):Play()
            else
                TweenService:Create(Main,
                    TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                    { Size = UDim2.fromOffset(PANEL_W, 0) }
                ):Play()
                task.delay(0.2, function() if not guiVisible then Main.Visible = false end end)
            end
        end
    end)

    notify("🌺 NihonAdmin", "v2.5 loaded! Fly/Noclip/Mute ready. RightShift=toggle.", 4)
end

