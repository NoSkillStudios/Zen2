        TweenService:Create(rbStroke, TweenInfo.new(0.14), { Color=C.accentHi, Transparency=0 }):Play()
    end)
    RunBox.FocusLost:Connect(function(enter)
        TweenService:Create(rbStroke, TweenInfo.new(0.14), { Color=C.accent, Transparency=0.3 }):Play()
