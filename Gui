--   FLOW LOGIC
-- ════════════════════════════════════════════════════════════════════════════
onFlowComplete = function()
    local steps_ = LANGS[chosenLang].steps
    for i, s in ipairs(stepLabels) do
        stepLabels[i].lbl.Text = steps_[i].icon .. "  " .. steps_[i].line
    end

    task.spawn(function()
        for i, step in ipairs(steps_) do
            loadStatusLbl.Text = step.line
            barPct.Text        = math.floor((i / #steps_) * 100) .. "%"
            for j, s in ipairs(stepLabels) do
                if j < i then
                    TweenService:Create(s.lbl, TweenInfo.new(0.18), { TextColor3=Color3.fromRGB(130,80,30) }):Play()
                    TweenService:Create(s.dot, TweenInfo.new(0.18), { BackgroundColor3=Color3.fromRGB(130,75,25) }):Play()
                elseif j == i then
                    TweenService:Create(s.lbl, TweenInfo.new(0.18), { TextColor3=Color3.fromRGB(255,210,150) }):Play()
                    TweenService:Create(s.dot, TweenInfo.new(0.18), { BackgroundColor3=Color3.fromRGB(220,130,50) }):Play()
                    TweenService:Create(s.row, TweenInfo.new(0.18), { BackgroundTransparency=0.45 }):Play()
                end
            end
            TweenService:Create(BarFill,
                TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Size = UDim2.new(i / #steps_, 0, 1, 0) }
            ):Play()
            task.wait(0.62)
        end
        barPct.Text = "100%"; task.wait(0.28)

        for _, child in ipairs(Card:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                TweenService:Create(child, TweenInfo.new(0.28), { TextTransparency=1 }):Play()
            end
            if child:IsA("Frame") or child:IsA("ScrollingFrame") then
                pcall(function() TweenService:Create(child,TweenInfo.new(0.28),{BackgroundTransparency=1}):Play() end)
            end
            if child:IsA("UIStroke") then
                TweenService:Create(child, TweenInfo.new(0.28), { Transparency=1 }):Play()
            end
        end
        task.wait(0.22)
        TweenService:Create(Card,
            TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.In),
            { Size=UDim2.fromOffset(460,0), Position=UDim2.new(0.5,-230,0.5,180), BackgroundTransparency=1 }
        ):Play()
        task.wait(0.35)
        TweenService:Create(Bg, TweenInfo.new(0.38,Enum.EasingStyle.Quad), { BackgroundTransparency=1 }):Play()
        TweenService:Create(ambientGlow, TweenInfo.new(0.38), { BackgroundTransparency=1 }):Play()
        task.wait(0.4)
        petalConn:Disconnect()
        for _, p in ipairs(petals) do pcall(function() p.obj:Remove() end) end
        petals = {}
        LoadGui:Destroy()
        task.wait(0.1)
        local ok, err = pcall(buildAdminGui)
        if not ok then warn("[NihonAdmin] buildAdminGui error: " .. tostring(err)) end
    end)
end

