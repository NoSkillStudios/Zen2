local function mkBtn(parent, yPos, txt)
	local b = Instance.new("TextButton",parent)
	b.Size=UDim2.new(1,0,0,30); b.Position=UDim2.fromOffset(0,yPos)
	b.BackgroundColor3=C.accent; b.BorderSizePixel=0; b.AutoButtonColor=false
	b.TextColor3=Color3.fromRGB(18,9,3); b.Font=Enum.Font.GothamBold; b.TextSize=12; b.Text=txt
	Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
	local g=Instance.new("UIGradient",b)
	g.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(240,140,55)),ColorSequenceKeypoint.new(1,Color3.fromRGB(195,85,20))})
	b.MouseEnter:Connect(function() TweenService:Create(b,TweenInfo.new(0.13),{BackgroundColor3=Color3.fromRGB(230,130,50)}):Play() end)
	b.MouseLeave:Connect(function() TweenService:Create(b,TweenInfo.new(0.13),{BackgroundColor3=C.accent}):Play() end)
	return b
end

local function slideOut(from, to)
	TweenService:Create(from,TweenInfo.new(0.16,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.fromOffset(-16,0)}):Play()
	task.wait(0.16)
	from.Visible=false; from.Position=UDim2.fromScale(0,0)
	to.Position=UDim2.fromOffset(16,0); to.Visible=true
	TweenService:Create(to,TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(0,0)}):Play()
end

local activeArgPopup, argPopupGui = nil, nil

local function closeArgPopup()
	if argPopupGui and argPopupGui.Parent then
		local pf = argPopupGui:FindFirstChild("PopupFrame")
		if pf then
			TweenService:Create(pf,TweenInfo.new(0.18,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.fromOffset(280,0)}):Play()
		end
		task.delay(0.2,function() pcall(function() argPopupGui:Destroy() end); argPopupGui=nil; activeArgPopup=nil end)
	end
end

local function showArgPopup(cmdName, schema, onConfirm)
	if activeArgPopup==cmdName and argPopupGui and argPopupGui.Parent then closeArgPopup(); return end
	if argPopupGui then closeArgPopup() end
	activeArgPopup=cmdName

	argPopupGui=Instance.new("ScreenGui")
	argPopupGui.Name="NihonArgPopup"; argPopupGui.IgnoreGuiInset=true
	argPopupGui.DisplayOrder=1002; argPopupGui.ResetOnSpawn=false; argPopupGui.Parent=guiParent

	local pf=Instance.new("Frame",argPopupGui)
	pf.Name="PopupFrame"; pf.Size=UDim2.fromOffset(280,0)
	pf.AnchorPoint=Vector2.new(0.5,1); pf.Position=UDim2.new(0.5,0,1,-58)
	pf.BackgroundColor3=Color3.fromRGB(12,7,3); pf.BorderSizePixel=0
	Instance.new("UICorner",pf).CornerRadius=UDim.new(0,10)
	local pfStroke=Instance.new("UIStroke",pf); pfStroke.Color=C.accent; pfStroke.Thickness=1; pfStroke.Transparency=0.1

	local titleBar=Instance.new("Frame",pf); titleBar.Size=UDim2.new(1,0,0,38)
	titleBar.BackgroundColor3=C.panel; titleBar.BorderSizePixel=0
	Instance.new("UICorner",titleBar).CornerRadius=UDim.new(0,10)
	local tbFix=Instance.new("Frame",titleBar); tbFix.Size=UDim2.new(1,0,0,10); tbFix.Position=UDim2.fromOffset(0,28)
	tbFix.BackgroundColor3=C.panel; tbFix.BorderSizePixel=0
	local hLine=Instance.new("Frame",titleBar); hLine.Size=UDim2.new(1,0,0,1); hLine.Position=UDim2.new(0,0,1,-1); hLine.BorderSizePixel=0
	hLine.BackgroundColor3=C.accentHi
	local hLineG=Instance.new("UIGradient",hLine)
	hLineG.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(60,28,6)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(255,185,90)),ColorSequenceKeypoint.new(1,Color3.fromRGB(60,28,6))})
	local titleLbl=Instance.new("TextLabel",titleBar)
	titleLbl.Size=UDim2.new(1,-36,1,0); titleLbl.Position=UDim2.fromOffset(12,0)
	titleLbl.BackgroundTransparency=1; titleLbl.TextColor3=Color3.fromRGB(255,215,160)
	titleLbl.Font=Enum.Font.GothamBold; titleLbl.TextSize=13
	titleLbl.TextXAlignment=Enum.TextXAlignment.Left; titleLbl.Text=schema.title
	local closeBtn=Instance.new("TextButton",titleBar)
	closeBtn.Size=UDim2.fromOffset(22,22); closeBtn.Position=UDim2.new(1,-26,0.5,-11)
	closeBtn.BackgroundTransparency=1; closeBtn.Text="✕"; closeBtn.TextColor3=C.txtFaint
	closeBtn.Font=Enum.Font.GothamBold; closeBtn.TextSize=12; closeBtn.BorderSizePixel=0
	closeBtn.MouseButton1Click:Connect(closeArgPopup)

	local fields={}; local y=44
	for _, fd in ipairs(schema.fields) do
		local lbl=Instance.new("TextLabel",pf)
		lbl.Size=UDim2.new(1,-16,0,14); lbl.Position=UDim2.fromOffset(10,y)
		lbl.BackgroundTransparency=1; lbl.TextColor3=C.txtSub
		lbl.Font=Enum.Font.GothamSemibold; lbl.TextSize=9
		lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Text=fd.name:upper()
		y=y+16
		local box=Instance.new("TextBox",pf)
		box.Size=UDim2.new(1,-16,0,28); box.Position=UDim2.fromOffset(8,y)
		box.BackgroundColor3=Color3.fromRGB(12,7,3); box.BorderSizePixel=0
		box.TextColor3=Color3.fromRGB(230,185,130); box.PlaceholderColor3=Color3.fromRGB(70,42,15)
		box.Font=Enum.Font.Gotham; box.TextSize=11
		box.PlaceholderText=fd.placeholder; box.Text=""; box.ClearTextOnFocus=false
		box.TextXAlignment=Enum.TextXAlignment.Left
		Instance.new("UICorner",box).CornerRadius=UDim.new(0,5)
		local bStroke=Instance.new("UIStroke",box); bStroke.Color=C.stroke; bStroke.Thickness=1
		Instance.new("UIPadding",box).PaddingLeft=UDim.new(0,8)
		box.Focused:Connect(function() TweenService:Create(bStroke,TweenInfo.new(0.12),{Color=C.accent,Transparency=0}):Play() end)
		box.FocusLost:Connect(function() TweenService:Create(bStroke,TweenInfo.new(0.12),{Color=C.stroke,Transparency=0}):Play() end)
		fields[fd.key]=box; y=y+34
	end

	local confirmBtn=Instance.new("TextButton",pf)
	confirmBtn.Size=UDim2.new(1,-16,0,30); confirmBtn.Position=UDim2.fromOffset(8,y+4)
	confirmBtn.BackgroundColor3=C.accent; confirmBtn.BorderSizePixel=0; confirmBtn.AutoButtonColor=false
	confirmBtn.TextColor3=Color3.fromRGB(18,9,3); confirmBtn.Font=Enum.Font.GothamBold
	confirmBtn.TextSize=12; confirmBtn.Text="▶  Run "..cmdName
	Instance.new("UICorner",confirmBtn).CornerRadius=UDim.new(0,6)
	local cfG=Instance.new("UIGradient",confirmBtn)
	cfG.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(240,140,55)),ColorSequenceKeypoint.new(1,Color3.fromRGB(195,85,20))})
	confirmBtn.MouseEnter:Connect(function() TweenService:Create(confirmBtn,TweenInfo.new(0.12),{BackgroundColor3=Color3.fromRGB(230,130,45)}):Play() end)
	confirmBtn.MouseLeave:Connect(function() TweenService:Create(confirmBtn,TweenInfo.new(0.12),{BackgroundColor3=C.accent}):Play() end)
	confirmBtn.MouseButton1Click:Connect(function()
		local vals={}
		for k, box in pairs(fields) do vals[k]=(box.Text~="" and box.Text or box.PlaceholderText) end
		onConfirm(vals)
		TweenService:Create(confirmBtn,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(55,160,65)}):Play()
		task.delay(0.3,closeArgPopup)
	end)

	local finalH=y+44
	TweenService:Create(pf,TweenInfo.new(0.22,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(280,finalH)}):Play()
end

