local function mkDiv(parent, y)
	local d = Instance.new("Frame",parent)
	d.Size=UDim2.new(1,0,0,1); d.Position=UDim2.fromOffset(0,y)
	d.BackgroundColor3=C.divider; d.BorderSizePixel=0
end

local function mkSecLabel(parent, y, txt)
	local l = Instance.new("TextLabel",parent)
	l.Size=UDim2.new(1,0,0,18); l.Position=UDim2.fromOffset(0,y)
	l.BackgroundTransparency=1; l.TextColor3=Color3.fromRGB(175,105,45)
	l.Font=Enum.Font.GothamSemibold; l.TextSize=11
	l.TextXAlignment=Enum.TextXAlignment.Left; l.Text=txt; return l
