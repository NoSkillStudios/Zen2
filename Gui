    RunBox.PlaceholderText    = "Run Bar — speed, fly, tp, mute..."; RunBox.Text=""
    RunBox.ClearTextOnFocus   = false
    RunBox:GetPropertyChangedSignal("Text"):Connect(function()
        local text = RunBox.Text:match("^%s*(%S+)%s*$")
        if text then
            local schema = ARG_POPUP_SCHEMAS[text:lower()]
            if schema then
                showArgPopup(text:lower(), schema, function(vals)
                    local cmdStr = text:lower()
                    for _, f in ipairs(schema.fields) do
                        if vals[f.key] and vals[f.key] ~= f.placeholder then
                            cmdStr = cmdStr .. " " .. f.key .. ":" .. vals[f.key]
                        end
                    end
                    pcall(runCommand, cmdStr); RunBox.Text = ""
                end)
            end
        end
    end)
