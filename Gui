    cfG.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(240,140,55)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(195,85,20)),
    })
    confirmBtn.MouseEnter:Connect(function()
        TweenService:Create(confirmBtn, TweenInfo.new(0.12),
            { BackgroundColor3 = Color3.fromRGB(230,130,45) }):Play()
    end)
    confirmBtn.MouseLeave:Connect(function()
        TweenService:Create(confirmBtn, TweenInfo.new(0.12),
            { BackgroundColor3 = C.accent }):Play()
    end)
    confirmBtn.MouseButton1Click:Connect(function()
        local vals = {}
        for k, box in pairs(fields) do
            vals[k] = (box.Text ~= "") and box.Text or box.PlaceholderText
        end
        onConfirm(vals)
        TweenService:Create(confirmBtn, TweenInfo.new(0.1),
            { BackgroundColor3 = Color3.fromRGB(55,160,65) }):Play()
        task.delay(0.3, closeArgPopup)
    end)

    local finalH = y + 44
    TweenService:Create(pf,
        TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = UDim2.fromOffset(280, finalH) }
    ):Play()
end

