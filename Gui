		end
		if prev and panels[prev] then
			local pOld=panels[prev]
			if not skipAnim then TweenService:Create(pOld,TweenInfo.new(0.13,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.fromOffset(-12,0)}):Play(); task.wait(0.12); pOld.Visible=false; pOld.Position=UDim2.fromScale(0,0)
			else pOld.Visible=false end
		end
		local pNew=panels[name]
		if pNew then
			if not skipAnim then pNew.Position=UDim2.fromOffset(12,0); pNew.Visible=true; TweenService:Create(pNew,TweenInfo.new(0.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(0,0)}):Play()
