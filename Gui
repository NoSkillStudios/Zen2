--[[
    Gui.lua
    Simple Orion-style element library template.
    Every interactive element just prints "Yes" when used - no real functionality.
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Gui = {}

-- Creates the full element-creation API for a given page (tab content frame)
function Gui.new(page, updateCanvas)

    local Elements = {}

    ------------------------------------------------------------
    -- TEXT LABEL
    ------------------------------------------------------------
    function Elements:Label(text)
        text = text or "Label"

        local frame = Instance.new("Frame")
        local corner = Instance.new("UICorner")
        local label = Instance.new("TextLabel")

        frame.Name = "LabelFrame"
        frame.Parent = page
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
        frame.Size = UDim2.new(1, -10, 0, 38)

        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        label.Name = "Label"
        label.Parent = frame
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 12, 0, 0)
        label.Size = UDim2.new(1, -24, 1, 0)
        label.Font = Enum.Font.GothamSemibold
        label.Text = text
        label.TextColor3 = Color3.fromRGB(235, 235, 235)
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left

        updateCanvas()
        return frame
    end

    ------------------------------------------------------------
    -- BUTTON
    ------------------------------------------------------------
    function Elements:Button(text)
        text = text or "Button"

        local frame = Instance.new("Frame")
        local corner = Instance.new("UICorner")
        local btn = Instance.new("TextButton")
        local btnCorner = Instance.new("UICorner")

        frame.Name = "ButtonFrame"
        frame.Parent = page
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
        frame.Size = UDim2.new(1, -10, 0, 42)

        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        btn.Name = "Button"
        btn.Parent = frame
        btn.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
        btn.Position = UDim2.new(0, 8, 0, 6)
        btn.Size = UDim2.new(1, -16, 1, -12)
        btn.Font = Enum.Font.GothamSemibold
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        btn.TextSize = 14
        btn.AutoButtonColor = false

        btnCorner.CornerRadius = UDim.new(0, 5)
        btnCorner.Parent = btn

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(70, 70, 78)}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(55, 55, 62)}):Play()
        end)

        btn.MouseButton1Click:Connect(function()
            print("Yes")
        end)

        updateCanvas()
        return frame
    end

    ------------------------------------------------------------
    -- TOGGLE
    ------------------------------------------------------------
    function Elements:Toggle(text)
        text = text or "Toggle"
        local state = false

        local frame = Instance.new("Frame")
        local corner = Instance.new("UICorner")
        local label = Instance.new("TextLabel")
        local switchBg = Instance.new("Frame")
        local switchCorner = Instance.new("UICorner")
        local knob = Instance.new("Frame")
        local knobCorner = Instance.new("UICorner")
        local clickArea = Instance.new("TextButton")

        frame.Name = "ToggleFrame"
        frame.Parent = page
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
        frame.Size = UDim2.new(1, -10, 0, 42)

        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        label.Name = "Label"
        label.Parent = frame
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 12, 0, 0)
        label.Size = UDim2.new(1, -70, 1, 0)
        label.Font = Enum.Font.GothamSemibold
        label.Text = text
        label.TextColor3 = Color3.fromRGB(235, 235, 235)
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left

        switchBg.Name = "SwitchBg"
        switchBg.Parent = frame
        switchBg.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
        switchBg.Position = UDim2.new(1, -50, 0.5, -10)
        switchBg.Size = UDim2.new(0, 38, 0, 20)

        switchCorner.CornerRadius = UDim.new(1, 0)
        switchCorner.Parent = switchBg

        knob.Name = "Knob"
        knob.Parent = switchBg
        knob.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
        knob.Position = UDim2.new(0, 2, 0.5, -8)
        knob.Size = UDim2.new(0, 16, 0, 16)

        knobCorner.CornerRadius = UDim.new(1, 0)
        knobCorner.Parent = knob

        clickArea.Name = "ClickArea"
        clickArea.Parent = frame
        clickArea.BackgroundTransparency = 1
        clickArea.Size = UDim2.new(1, 0, 1, 0)
        clickArea.Text = ""

        clickArea.MouseButton1Click:Connect(function()
            state = not state
            print("Yes")
            if state then
                TweenService:Create(switchBg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(90, 120, 230)}):Play()
                TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
            else
                TweenService:Create(switchBg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55, 55, 62)}):Play()
                TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
            end
        end)

        updateCanvas()
        return frame
    end

    ------------------------------------------------------------
    -- SLIDER
    ------------------------------------------------------------
    function Elements:Slider(text, min, max)
        text = text or "Slider"
        min = min or 0
        max = max or 100

        local frame = Instance.new("Frame")
        local corner = Instance.new("UICorner")
        local label = Instance.new("TextLabel")
        local valueLabel = Instance.new("TextLabel")
        local track = Instance.new("Frame")
        local trackCorner = Instance.new("UICorner")
        local fill = Instance.new("Frame")
        local fillCorner = Instance.new("UICorner")
        local dragBtn = Instance.new("TextButton")

        frame.Name = "SliderFrame"
        frame.Parent = page
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
        frame.Size = UDim2.new(1, -10, 0, 52)

        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        label.Name = "Label"
        label.Parent = frame
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 12, 0, 4)
        label.Size = UDim2.new(1, -80, 0, 20)
        label.Font = Enum.Font.GothamSemibold
        label.Text = text
        label.TextColor3 = Color3.fromRGB(235, 235, 235)
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left

        valueLabel.Name = "ValueLabel"
        valueLabel.Parent = frame
        valueLabel.BackgroundTransparency = 1
        valueLabel.Position = UDim2.new(1, -60, 0, 4)
        valueLabel.Size = UDim2.new(0, 50, 0, 20)
        valueLabel.Font = Enum.Font.GothamSemibold
        valueLabel.Text = tostring(min) .. "/" .. tostring(max)
        valueLabel.TextColor3 = Color3.fromRGB(160, 160, 230)
        valueLabel.TextSize = 13
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right

        track.Name = "Track"
        track.Parent = frame
        track.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
        track.Position = UDim2.new(0, 12, 0, 32)
        track.Size = UDim2.new(1, -24, 0, 8)

        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent = track

        fill.Name = "Fill"
        fill.Parent = track
        fill.BackgroundColor3 = Color3.fromRGB(90, 120, 230)
        fill.Size = UDim2.new(0, 0, 1, 0)

        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = fill

        dragBtn.Name = "DragBtn"
        dragBtn.Parent = track
        dragBtn.BackgroundTransparency = 1
        dragBtn.Size = UDim2.new(1, 0, 1, 0)
        dragBtn.Text = ""
        dragBtn.AutoButtonColor = false

        local dragging = false

        local function updateFromX(xPos)
            local absPos = track.AbsolutePosition.X
            local absSize = track.AbsoluteSize.X
            local rel = math.clamp((xPos - absPos) / absSize, 0, 1)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            local val = math.floor(min + (max - min) * rel)
            valueLabel.Text = tostring(val) .. "/" .. tostring(max)
        end

        dragBtn.MouseButton1Down:Connect(function(x)
            dragging = true
            print("Yes")
            updateFromX(x)
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updateFromX(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)

        updateCanvas()
        return frame
    end

    ------------------------------------------------------------
    -- DROPDOWN
    ------------------------------------------------------------
    function Elements:Dropdown(text, options)
        text = text or "Dropdown"
        options = options or {"Option 1", "Option 2", "Option 3"}

        local open = false

        local frame = Instance.new("Frame")
        local corner = Instance.new("UICorner")
        local header = Instance.new("Frame")
        local headerCorner = Instance.new("UICorner")
        local label = Instance.new("TextLabel")
        local arrowBtn = Instance.new("ImageButton")
        local list = Instance.new("Frame")
        local listLayout = Instance.new("UIListLayout")
        local listPadding = Instance.new("UIPadding")

        frame.Name = "DropdownFrame"
        frame.Parent = page
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
        frame.ClipsDescendants = true
        frame.Size = UDim2.new(1, -10, 0, 42)

        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        header.Name = "Header"
        header.Parent = frame
        header.BackgroundTransparency = 1
        header.Size = UDim2.new(1, 0, 0, 42)

        headerCorner.CornerRadius = UDim.new(0, 6)
        headerCorner.Parent = header

        label.Name = "Label"
        label.Parent = header
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 12, 0, 0)
        label.Size = UDim2.new(1, -50, 1, 0)
        label.Font = Enum.Font.GothamSemibold
        label.Text = text .. ": " .. options[1]
        label.TextColor3 = Color3.fromRGB(180, 180, 235)
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left

        arrowBtn.Name = "Arrow"
        arrowBtn.Parent = header
        arrowBtn.BackgroundTransparency = 1
        arrowBtn.Position = UDim2.new(1, -34, 0.5, -10)
        arrowBtn.Size = UDim2.new(0, 20, 0, 20)
        arrowBtn.Image = "rbxasset://textures/ui/InGameMenu/icons/ic-dropdown-arrow.png"
        arrowBtn.ImageColor3 = Color3.fromRGB(200, 200, 200)

        list.Name = "List"
        list.Parent = frame
        list.BackgroundTransparency = 1
        list.Position = UDim2.new(0, 0, 0, 42)
        list.Size = UDim2.new(1, 0, 0, #options * 34)
        list.AutomaticSize = Enum.AutomaticSize.None

        listLayout.Parent = list
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 2)

        listPadding.Parent = list
        listPadding.PaddingLeft = UDim.new(0, 8)
        listPadding.PaddingRight = UDim.new(0, 8)

        for _, option in ipairs(options) do
            local optBtn = Instance.new("TextButton")
            local optCorner = Instance.new("UICorner")

            optBtn.Name = "Option"
            optBtn.Parent = list
            optBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            optBtn.Size = UDim2.new(1, -16, 0, 30)
            optBtn.Font = Enum.Font.Gotham
            optBtn.Text = option
            optBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            optBtn.TextSize = 13
            optBtn.AutoButtonColor = false

            optCorner.CornerRadius = UDim.new(0, 4)
            optCorner.Parent = optBtn

            optBtn.MouseButton1Click:Connect(function()
                print("Yes")
                label.Text = text .. ": " .. option
                open = false
                TweenService:Create(frame, TweenInfo.new(0.15), {Size = UDim2.new(1, -10, 0, 42)}):Play()
                task.wait(0.15)
                updateCanvas()
            end)
        end

        arrowBtn.MouseButton1Click:Connect(function()
            print("Yes")
            open = not open
            if open then
                TweenService:Create(frame, TweenInfo.new(0.15), {Size = UDim2.new(1, -10, 0, 42 + #options * 36)}):Play()
                TweenService:Create(arrowBtn, TweenInfo.new(0.15), {Rotation = 180}):Play()
            else
                TweenService:Create(frame, TweenInfo.new(0.15), {Size = UDim2.new(1, -10, 0, 42)}):Play()
                TweenService:Create(arrowBtn, TweenInfo.new(0.15), {Rotation = 0}):Play()
            end
            task.wait(0.15)
            updateCanvas()
        end)

        updateCanvas()
        return frame
    end

    ------------------------------------------------------------
    -- COLOR PICKER
    ------------------------------------------------------------
    function Elements:ColorPicker(text)
        text = text or "Color Picker"
        local open = false
        local currentColor = Color3.fromRGB(90, 120, 230)

        local frame = Instance.new("Frame")
        local corner = Instance.new("UICorner")
        local header = Instance.new("Frame")
        local label = Instance.new("TextLabel")
        local swatch = Instance.new("Frame")
        local swatchCorner = Instance.new("UICorner")
        local panel = Instance.new("Frame")
        local panelLayout = Instance.new("UIGridLayout")
        local panelPadding = Instance.new("UIPadding")

        frame.Name = "ColorPickerFrame"
        frame.Parent = page
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
        frame.ClipsDescendants = true
        frame.Size = UDim2.new(1, -10, 0, 42)

        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        header.Name = "Header"
        header.Parent = frame
        header.BackgroundTransparency = 1
        header.Size = UDim2.new(1, 0, 0, 42)

        label.Name = "Label"
        label.Parent = header
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 12, 0, 0)
        label.Size = UDim2.new(1, -50, 1, 0)
