        panelPadding.Parent = panel
        panelPadding.PaddingLeft = UDim.new(0, 12)
        panelPadding.PaddingTop = UDim.new(0, 4)

        local presetColors = {
            Color3.fromRGB(230, 70, 70), Color3.fromRGB(230, 150, 60), Color3.fromRGB(230, 220, 70),
            Color3.fromRGB(90, 200, 110), Color3.fromRGB(70, 180, 230), Color3.fromRGB(90, 120, 230),
