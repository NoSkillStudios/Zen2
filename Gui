--   KEY PANEL LOGIC
-- ════════════════════════════════════════════════════════════════════════════
local keyAttempts = 0

local function onFlowComplete() end  -- forward ref, defined below

local function tryKey()
    playSound("rbxassetid://139009780109934")
    local input = KeyBox.Text
    local valid = false
    for _, kv in ipairs(VALID_KEYS) do if input == kv then valid = true; break end end
    if valid then
        TweenService:Create(kbs, TweenInfo.new(0.15), { Color=C.keyOk }):Play()
        TweenService:Create(KeyBox, TweenInfo.new(0.15), { TextColor3=C.keyOk }):Play()
        KeyStatus.TextColor3 = C.keyOk
        KeyStatus.Text       = "✓  Key accepted"
        task.delay(0.5, function() slideOut(KeyPanel, LoadPanel) end)
        task.delay(0.7, onFlowComplete)
    else
        keyAttempts = keyAttempts + 1
        local orig  = KeyBox.Position
        for _ = 1, 4 do
            TweenService:Create(KeyBox, TweenInfo.new(0.04), { Position=orig+UDim2.fromOffset(6,0) }):Play(); task.wait(0.04)
            TweenService:Create(KeyBox, TweenInfo.new(0.04), { Position=orig+UDim2.fromOffset(-6,0) }):Play(); task.wait(0.04)
        end
        TweenService:Create(KeyBox, TweenInfo.new(0.04), { Position=orig }):Play()
        TweenService:Create(kbs, TweenInfo.new(0.1), { Color=C.keyErr }):Play()
        KeyStatus.TextColor3 = C.keyErr
        KeyStatus.Text = keyAttempts >= 3
            and ("✗  Invalid  ·  " .. keyAttempts .. " attempts")
            or "✗  Invalid key"
        task.delay(0.75, function()
            TweenService:Create(kbs, TweenInfo.new(0.2), { Color=Color3.fromRGB(75,40,14), Transparency=0.2 }):Play()
            TweenService:Create(KeyBox, TweenInfo.new(0.2), { TextColor3=Color3.fromRGB(230,185,130) }):Play()
            KeyBox.Text = ""
        end)
    end
end

KeyBtn.MouseButton1Click:Connect(tryKey)
KeyBox.FocusLost:Connect(function(enter) if enter then tryKey() end end)

