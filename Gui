local function setupTabs(ContentArea, tabNames, tabIcons, L, panels, PANEL_W, TABS_H)
    local TabBar = Instance.new("Frame", ContentArea)
    TabBar.Size             = UDim2.new(1,0,0,TABS_H); TabBar.BackgroundColor3 = Color3.fromRGB(22,12,5); TabBar.BorderSizePixel=0
    local tabDivB = Instance.new("Frame",TabBar)
    tabDivB.Size = UDim2.new(1,0,0,1); tabDivB.Position = UDim2.new(0,0,1,-1)
    tabDivB.BackgroundColor3 = Color3.fromRGB(50,27,10); tabDivB.BorderSizePixel=0

    local tabBtns          = {}
    local activeIndicators = {}
    local tabW             = math.floor(PANEL_W / #tabNames)

    for i, tname in ipairs(tabNames) do
        local tb = Instance.new("TextButton",TabBar)
        tb.Size              = UDim2.fromOffset(tabW, TABS_H); tb.Position = UDim2.fromOffset((i-1)*tabW, 0)
        tb.BackgroundTransparency = 1; tb.BorderSizePixel=0; tb.AutoButtonColor=false
        tb.TextColor3        = C.txtFaint; tb.Font=Enum.Font.GothamSemibold; tb.TextSize=10
        tb.Text              = tabIcons[i] .. " " .. L.tabs[tname]; tabBtns[tname] = tb
        local ind            = Instance.new("Frame",tb)
        ind.Size             = UDim2.new(0,0,0,2); ind.Position = UDim2.new(0.5,0,1,-2)
        ind.AnchorPoint      = Vector2.new(0.5,0); ind.BackgroundColor3 = C.accentHi; ind.BorderSizePixel=0
        Instance.new("UICorner",ind).CornerRadius = UDim.new(0,1); activeIndicators[tname] = ind
        tb.MouseEnter:Connect(function()
            if tb.TextColor3 == C.txtFaint then TweenService:Create(tb,TweenInfo.new(0.1),{TextColor3=Color3.fromRGB(155,90,35)}):Play() end
        end)
        tb.MouseLeave:Connect(function()
            if tb.TextColor3 ~= Color3.fromRGB(255,215,160) then TweenService:Create(tb,TweenInfo.new(0.1),{TextColor3=C.txtFaint}):Play() end
        end)
    end

    local PanelArea = Instance.new("Frame",ContentArea)
    PanelArea.Position = UDim2.fromOffset(0,TABS_H); PanelArea.BackgroundTransparency=1
    PanelArea.Size = UDim2.new(1,0,1,-TABS_H); PanelArea.BorderSizePixel=0; PanelArea.ClipsDescendants=true

    local panelFrames = {}
    for _, tname in ipairs(tabNames) do
        local p = Instance.new("Frame",PanelArea)
        p.Size = UDim2.fromScale(1,1); p.BackgroundTransparency=1; p.Visible=false; p.BorderSizePixel=0
        panelFrames[tname] = p; panels[tname] = p
    end

    local currentTab = nil
    local function switchTab(name, skipAnim)
        if currentTab == name and not skipAnim then return end
        local prev = currentTab; currentTab = name
        for tname, tb in pairs(tabBtns) do
            if tname == name then
                TweenService:Create(tb,TweenInfo.new(0.15),{TextColor3=Color3.fromRGB(255,215,160)}):Play()
                TweenService:Create(activeIndicators[tname],TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(0.65,0,0,2)}):Play()
            else
                TweenService:Create(tb,TweenInfo.new(0.15),{TextColor3=C.txtFaint}):Play()
                TweenService:Create(activeIndicators[tname],TweenInfo.new(0.14),{Size=UDim2.new(0,0,0,2)}):Play()
            end
        end
        if prev and panels[prev] then
            local pOld = panels[prev]
            if not skipAnim then
                TweenService:Create(pOld,TweenInfo.new(0.13,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.fromOffset(-12,0)}):Play()
                task.wait(0.12); pOld.Visible=false; pOld.Position=UDim2.fromScale(0,0)
            else pOld.Visible=false end
        end
        local pNew = panels[name]
        if pNew then
            if not skipAnim then
                pNew.Position=UDim2.fromOffset(12,0); pNew.Visible=true
                TweenService:Create(pNew,TweenInfo.new(0.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(0,0)}):Play()
            else pNew.Position=UDim2.fromOffset(0,0); pNew.Visible=true end
        end
    end

    for _, tname in ipairs(tabNames) do
        tabBtns[tname].MouseButton1Click:Connect(function() switchTab(tname) end)
    end
    return tabBtns, switchTab, panelFrames
end

