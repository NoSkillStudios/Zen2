        boxCorner.CornerRadius = UDim.new(0, 5)
        boxCorner.Parent = boxBg

        box.Name = "Box"
        box.Parent = boxBg
        box.BackgroundTransparency = 1
        box.Position = UDim2.new(0, 8, 0, 0)
