    hLogo.Text="🌺"; hLogo.TextSize=15; hLogo.Font=Enum.Font.Gotham
    local hTitle = Instance.new("TextLabel",Header)
    hTitle.Size=UDim2.new(1,-80,0,HEADER_H); hTitle.Position=UDim2.fromOffset(34,0); hTitle.BackgroundTransparency=1
    hTitle.TextColor3=Color3.fromRGB(255,215,160); hTitle.Font=Enum.Font.GothamBold; hTitle.TextSize=13
    hTitle.TextXAlignment=Enum.TextXAlignment.Left; hTitle.Text="NihonAdmin v2.5"

    local ContentArea = Instance.new("Frame",Main)
    ContentArea.Position=UDim2.fromOffset(0,HEADER_H); ContentArea.BackgroundTransparency=1
    ContentArea.Size=UDim2.new(1,0,1,-HEADER_H); ContentArea.BorderSizePixel=0; ContentArea.ClipsDescendants=true

