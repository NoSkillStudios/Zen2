        local swatchClick = Instance.new("TextButton")
        swatchClick.Parent = header
        swatchClick.BackgroundTransparency = 1
        swatchClick.Size = UDim2.new(1, 0, 1, 0)
        swatchClick.Text = ""

        panel.Name = "Panel"
        panel.Parent = frame
        panel.BackgroundTransparency = 1
        panel.Position = UDim2.new(0, 0, 0, 42)
        panel.Size = UDim2.new(1, 0, 0, 70)

        panelLayout.Parent = panel
