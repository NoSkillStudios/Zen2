local function mkBtn(parent, yPos, txt)
    local b = Instance.new("TextButton", parent)
    b.Size             = UDim2.new(1, 0, 0, 30)
    b.Position         = UDim2.fromOffset(0, yPos)
    b.BackgroundColor3 = C.accent
    b.BorderSizePixel  = 0
    b.AutoButtonColor  = false
    b.TextColor3       = Color3.fromRGB(18, 9, 3)
    b.Font             = Enum.Font.GothamBold
    b.TextSize         = 12
    b.Text             = txt
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local g = Instance.new("UIGradient", b)
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(240,140,55)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(195,85,20)),
    })
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.13), { BackgroundColor3=Color3.fromRGB(230,130,50) }):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.13), { BackgroundColor3=C.accent }):Play()
    end)
    return b
end

local function slideOut(from, to)
    TweenService:Create(from,
        TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = UDim2.fromOffset(-16, 0) }
    ):Play()
    task.wait(0.16)
    from.Visible  = false
    from.Position = UDim2.fromScale(0, 0)
    to.Position   = UDim2.fromOffset(16, 0)
    to.Visible    = true
    TweenService:Create(to,
        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Position = UDim2.fromOffset(0, 0) }
    ):Play()
end

