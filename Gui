        box.FocusLost:Connect(function()
            TweenService:Create(bStroke, TweenInfo.new(0.12), { Color=C.stroke, Transparency=0 }):Play()
        end)
        fields[fieldDef.key] = box
        y = y + 34
    end

    local confirmBtn           = Instance.new("TextButton", pf)
    confirmBtn.Size            = UDim2.new(1, -16, 0, 30)
