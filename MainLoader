--[[
    MainLoader.lua
    Simple Orion-style window/sidebar/tab loader template.
    No real functionality - this just builds the shell that Gui.lua's
    elements get placed into. Every clickable element prints "Yes".
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

-- Gui.lua is injected as a global by the loader snippet (see LoadZen2.lua)
-- since this file is loaded over HTTP via loadstring, not require().
local Gui = _G.Zen2_Gui

local MainLoader = {}

function MainLoader:CreateLib(windowName)
    windowName = windowName or "Window"

    ------------------------------------------------------------
    -- ROOT
    ------------------------------------------------------------
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MainLoaderUI"
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = game.CoreGui

    local NORMAL_SIZE = UDim2.new(0, 640, 0, 380)
    local NORMAL_POS = UDim2.new(0.5, -320, 0.5, -190)
    local MINI_SIZE = UDim2.new(0, 240, 0, 40)
    local FULLSCREEN_SIZE = UDim2.new(1, -40, 1, -40)
    local FULLSCREEN_POS = UDim2.new(0, 20, 0, 20)

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Position = NORMAL_POS
    MainFrame.Size = NORMAL_SIZE

    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = UDim.new(0, 8)
    mainCorner.Parent = MainFrame

    ------------------------------------------------------------
    -- TITLE BAR (draggable)
    ------------------------------------------------------------
    local TitleBar = Instance.new("Frame")
    TitleBar.Name = "TitleBar"
    TitleBar.Parent = MainFrame
    TitleBar.BackgroundColor3 = Color3.fromRGB(28, 28, 33)
    TitleBar.Size = UDim2.new(1, 0, 0, 40)

    local titleCorner = Instance.new("UICorner")
    titleCorner.CornerRadius = UDim.new(0, 8)
    titleCorner.Parent = TitleBar

    local titleFix = Instance.new("Frame")
    titleFix.Parent = TitleBar
    titleFix.BackgroundColor3 = TitleBar.BackgroundColor3
    titleFix.BorderSizePixel = 0
    titleFix.Position = UDim2.new(0, 0, 1, -8)
    titleFix.Size = UDim2.new(1, 0, 0, 8)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Name = "TitleLabel"
    TitleLabel.Parent = TitleBar
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Position = UDim2.new(0, 16, 0, 0)
    TitleLabel.Size = UDim2.new(1, -140, 1, 0)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = windowName
    TitleLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    TitleLabel.TextSize = 16
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    ------------------------------------------------------------
    -- WINDOW CONTROLS (minimize / maximize / close)
    ------------------------------------------------------------
    local ControlsFrame = Instance.new("Frame")
    ControlsFrame.Name = "Controls"
    ControlsFrame.Parent = TitleBar
    ControlsFrame.BackgroundTransparency = 1
    ControlsFrame.AnchorPoint = Vector2.new(1, 0.5)
    ControlsFrame.Position = UDim2.new(1, -10, 0.5, 0)
    ControlsFrame.Size = UDim2.new(0, 96, 0, 26)

    local controlsLayout = Instance.new("UIListLayout")
    controlsLayout.Parent = ControlsFrame
    controlsLayout.FillDirection = Enum.FillDirection.Horizontal
    controlsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    controlsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    controlsLayout.Padding = UDim.new(0, 6)
    controlsLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local function makeControlButton(order, bgColor, hoverColor, glyphText)
        local btn = Instance.new("TextButton")
        btn.LayoutOrder = order
        btn.Parent = ControlsFrame
        btn.BackgroundColor3 = bgColor
        btn.Size = UDim2.new(0, 26, 0, 26)
        btn.AutoButtonColor = false
        btn.Font = Enum.Font.GothamBold
        btn.Text = glyphText
        btn.TextColor3 = Color3.fromRGB(235, 235, 235)
        btn.TextSize = 13

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = btn

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = hoverColor}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = bgColor}):Play()
        end)

        return btn
    end

    local minimizeBtn = makeControlButton(1, Color3.fromRGB(45, 45, 52), Color3.fromRGB(60, 60, 70), "_")
    local maximizeBtn = makeControlButton(2, Color3.fromRGB(45, 45, 52), Color3.fromRGB(60, 60, 70), "[ ]")
    local closeBtn = makeControlButton(3, Color3.fromRGB(120, 35, 40), Color3.fromRGB(160, 45, 50), "X")

    -- Dragging
    local dragging = false
    local dragInput, mousePos, framePos

    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = input.Position
            framePos = MainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - mousePos
            MainFrame.Position = UDim2.new(
                framePos.X.Scale, framePos.X.Offset + delta.X,
                framePos.Y.Scale, framePos.Y.Offset + delta.Y
            )
        end
    end)

    ------------------------------------------------------------
    -- SIDEBAR
    ------------------------------------------------------------
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Parent = MainFrame
    Sidebar.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
    Sidebar.Position = UDim2.new(0, 0, 0, 40)
    Sidebar.Size = UDim2.new(0, 150, 1, -40)

    local TabList = Instance.new("Frame")
    TabList.Name = "TabList"
    TabList.Parent = Sidebar
    TabList.BackgroundTransparency = 1
    TabList.Position = UDim2.new(0, 0, 0, 10)
    TabList.Size = UDim2.new(1, 0, 1, -10)

    local tabListLayout = Instance.new("UIListLayout")
    tabListLayout.Parent = TabList
    tabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabListLayout.Padding = UDim.new(0, 4)

    local tabListPadding = Instance.new("UIPadding")
    tabListPadding.Parent = TabList
    tabListPadding.PaddingLeft = UDim.new(0, 8)
    tabListPadding.PaddingRight = UDim.new(0, 8)

    ------------------------------------------------------------
    -- CONTENT AREA
    ------------------------------------------------------------
    local ContentArea = Instance.new("Frame")
    ContentArea.Name = "ContentArea"
    ContentArea.Parent = MainFrame
    ContentArea.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    ContentArea.Position = UDim2.new(0, 150, 0, 40)
    ContentArea.Size = UDim2.new(1, -150, 1, -40)

    local PagesFolder = Instance.new("Folder")
    PagesFolder.Name = "Pages"
    PagesFolder.Parent = ContentArea

    ------------------------------------------------------------
    -- WINDOW STATE: minimize / maximize / close
    ------------------------------------------------------------
    local isMinimized = false
    local isMaximized = false

    local function setBodyVisible(visible)
        Sidebar.Visible = visible
        ContentArea.Visible = visible
    end

    minimizeBtn.MouseButton1Click:Connect(function()
        print("Yes")
        isMinimized = not isMinimized

        if isMinimized then
            setBodyVisible(false)
            TweenService:Create(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                Size = MINI_SIZE
            }):Play()
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                Size = isMaximized and FULLSCREEN_SIZE or NORMAL_SIZE
            }):Play()
            task.delay(0.18, function()
                setBodyVisible(true)
            end)
        end
    end)

    maximizeBtn.MouseButton1Click:Connect(function()
        print("Yes")
        if isMinimized then return end
        isMaximized = not isMaximized

        if isMaximized then
            TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                Size = FULLSCREEN_SIZE,
                Position = FULLSCREEN_POS
            }):Play()
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                Size = NORMAL_SIZE,
                Position = NORMAL_POS
            }):Play()
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        print("Yes")
        TweenService:Create(MainFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, MainFrame.AbsoluteSize.X, 0, 0),
            Position = UDim2.new(MainFrame.Position.X.Scale, MainFrame.Position.X.Offset,
                MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset + MainFrame.AbsoluteSize.Y / 2)
        }):Play()
        task.delay(0.15, function()
            ScreenGui:Destroy()
        end)
    end)

    ------------------------------------------------------------
    -- WINDOW OBJECT
    ------------------------------------------------------------
    local Window = {}
    local tabButtons = {}
    local firstTab = true

    function Window:CreateTab(tabName)
        tabName = tabName or "Tab"

        ----------------------------------------------------
        -- Tab button (sidebar)
        ----------------------------------------------------
        local tabBtn = Instance.new("TextButton")
        tabBtn.Name = "Tab_" .. tabName
        tabBtn.Parent = TabList
        tabBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
        tabBtn.Size = UDim2.new(1, 0, 0, 34)
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.Text = "   " .. tabName
        tabBtn.TextColor3 = Color3.fromRGB(180, 180, 185)
        tabBtn.TextSize = 14
        tabBtn.TextXAlignment = Enum.TextXAlignment.Left
        tabBtn.AutoButtonColor = false

        local tabBtnCorner = Instance.new("UICorner")
        tabBtnCorner.CornerRadius = UDim.new(0, 6)
        tabBtnCorner.Parent = tabBtn

        ----------------------------------------------------
        -- Page (content area)
        ----------------------------------------------------
        local page = Instance.new("ScrollingFrame")
        page.Name = "Page_" .. tabName
        page.Parent = PagesFolder
        page.Active = true
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.Size = UDim2.new(1, 0, 1, 0)
        page.ScrollBarThickness = 4
        page.ScrollBarImageColor3 = Color3.fromRGB(90, 120, 230)
        page.Visible = false
        page.CanvasSize = UDim2.new(0, 0, 0, 0)

        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Parent = page
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Padding = UDim.new(0, 6)

        local pagePadding = Instance.new("UIPadding")
        pagePadding.Parent = page
        pagePadding.PaddingLeft = UDim.new(0, 12)
        pagePadding.PaddingRight = UDim.new(0, 12)
        pagePadding.PaddingTop = UDim.new(0, 10)
        pagePadding.PaddingBottom = UDim.new(0, 10)

        local function updateCanvas()
            task.defer(function()
                page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 20)
            end)
        end

        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

        ----------------------------------------------------
        -- Tab switching with smooth animation
        ----------------------------------------------------
        local function selectTab()
            for _, otherPage in ipairs(PagesFolder:GetChildren()) do
                otherPage.Visible = false
            end
            for _, otherBtn in ipairs(tabButtons) do
                TweenService:Create(otherBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                    BackgroundColor3 = Color3.fromRGB(26, 26, 30)
                }):Play()
                TweenService:Create(otherBtn, TweenInfo.new(0.15), {
                    TextColor3 = Color3.fromRGB(180, 180, 185)
                }):Play()
            end

            page.Visible = true
            TweenService:Create(tabBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            }):Play()
            TweenService:Create(tabBtn, TweenInfo.new(0.15), {
                TextColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()

            -- simple fade-in feel via UIStroke transparency trick on page contents
            for _, child in ipairs(page:GetChildren()) do
                if child:IsA("Frame") then
                    child.BackgroundTransparency = 1
                    TweenService:Create(child, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                        BackgroundTransparency = 0
                    }):Play()
                end
            end

            updateCanvas()
        end

        tabBtn.MouseButton1Click:Connect(function()
            print("Yes")
            selectTab()
        end)

        table.insert(tabButtons, tabBtn)

        if firstTab then
            firstTab = false
            selectTab()
        end

        -- Return the element-creation API for this tab, from Gui.lua
        return Gui.new(page, updateCanvas)
    end

    return Window
end

return MainLoader
