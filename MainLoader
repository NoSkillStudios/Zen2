local BASE = "https://raw.githubusercontent.com/NoSkillStudios/Zen2/main"
getgenv()._kraken_key = "Kraken"

local sg = game:GetService("StarterGui")
local function fallbackNotify(t, b)
	pcall(function()
		sg:SetCore("SendNotification", {Title = t, Text = b, Duration = 6})
	end)
end

local function fetch(path)
	local ok, res = pcall(function()
		return game:HttpGet(BASE .. "/" .. path)
	end)
	if not ok or not res or #res < 5 or res:sub(1, 1) == "<" then
		return nil
	end
	return res
end

-- ═══════════════════════════════════════════════════════════
-- 1) Load Notification System
-- ═══════════════════════════════════════════════════════════
local notifSrc = fetch("NotificationSystem")
if not notifSrc then
	fallbackNotify("Kraken", "Failed to load NotificationSystem")
	return
end
local notifFn, notifErr = loadstring(notifSrc)
if not notifFn then
	fallbackNotify("Kraken — Notif Parse", tostring(notifErr))
	return
end
local ok1, Notify = pcall(notifFn)
if not ok1 then
	fallbackNotify("Kraken — Notif Runtime", tostring(Notify))
	return
end
getgenv().KrakenNotify = Notify

-- ═══════════════════════════════════════════════════════════
-- 2) Load Main Script
-- ═══════════════════════════════════════════════════════════
local src = fetch("Script")
if not src then
	fallbackNotify("Kraken", "Failed to load Script")
	return
end
local fn, fe = loadstring(src)
if not fn then
	fallbackNotify("Kraken — Script Parse", tostring(fe))
	return
end
local ok2, e2 = pcall(fn)
if not ok2 then
	fallbackNotify("Kraken — Script Runtime", tostring(e2))
	return
end

-- ═══════════════════════════════════════════════════════════
-- 3) Startup notification
-- ═══════════════════════════════════════════════════════════
task.delay(1.0, function()
	if getgenv().KrakenNotify then
		getgenv().KrakenNotify({
			Title    = "Kraken Loaded",
			Body     = "Press RightShift to toggle the UI.",
			Type     = "success",
			Duration = 5,
		})
	end
end)
