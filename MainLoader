local sub = Instance.new("TextLabel", card)
sub.Size               = UDim2.new(1, -40, 0, 16)
sub.Position           = UDim2.new(0, 20, 0, 42)
sub.BackgroundTransparency = 1
sub.Text               = "Initializing system..."
sub.TextColor3         = Color3.fromRGB(120, 120, 148)
sub.TextSize           = 12
sub.Font               = Enum.Font.Gotham
sub.TextXAlignment     = Enum.TextXAlignment.Center

local barBg = Instance.new("Frame", card)
barBg.Size             = UDim2.new(0, 260, 0, 4)
barBg.Position         = UDim2.new(0.5, -130, 0, 82)
barBg.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
barBg.BorderSizePixel  = 0
Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

local barFill = Instance.new("Frame", barBg)
barFill.Size             = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = Color3.fromRGB(130, 80, 255)
barFill.BorderSizePixel  = 0
Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

local function setProgress(text, pct)
	sub.Text = text
	TweenService:Create(barFill, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = UDim2.new(pct, 0, 1, 0)
	}):Play()
end

local function killLoader()
	TweenService:Create(backdrop, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
	for _, obj in ipairs(card:GetDescendants()) do
		if obj:IsA("TextLabel") then
			TweenService:Create(obj, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
		elseif obj:IsA("Frame") then
			TweenService:Create(obj, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
		end
	end
	task.wait(0.6)
	loadGui:Destroy()
end

local function fallbackNotify(t, b)
	pcall(function()
		sg:SetCore("SendNotification", {Title = t, Text = b, Duration = 6})
	end)
end

local function fetch(path)
	local ok, res = pcall(function()
		return game:HttpGet(BASE .. "/" .. path)
	end)
	if not ok or not res or #res < 5 or res:sub(1, 1) == "<" then
		return nil
	end
	return res
end

-- ═══════════════════════════════════════════════════════════
-- LOAD NOTIFICATION SYSTEM
-- ═══════════════════════════════════════════════════════════
setProgress("Loading core...", 0.2)
local notifSrc = fetch("NotificationSystem")
if not notifSrc then
	fallbackNotify("Kraken", "Failed to load NotificationSystem")
	killLoader()
	return
end

setProgress("Parsing core...", 0.45)
local notifFn, notifErr = loadstring(notifSrc)
if not notifFn then
	fallbackNotify("Kraken", "Notification parse error")
	killLoader()
	return
end

local ok1, Notify = pcall(notifFn)
if not ok1 then
	fallbackNotify("Kraken", "Notification runtime error")
	killLoader()
	return
end
getgenv().KrakenNotify = Notify

-- ═══════════════════════════════════════════════════════════
-- LOAD MAIN SCRIPT
-- ═══════════════════════════════════════════════════════════
setProgress("Loading script...", 0.7)
local src = fetch("Script")
if not src then
	fallbackNotify("Kraken", "Failed to load Script")
	killLoader()
	return
end

setProgress("Executing...", 0.9)
local fn, fe = loadstring(src)
if not fn then
	fallbackNotify("Kraken", "Script parse error")
	killLoader()
	return
end

local ok2, e2 = pcall(fn)
if not ok2 then
	fallbackNotify("Kraken", "Script runtime error: " .. tostring(e2))
	killLoader()
	return
end

setProgress("Ready", 1)
task.wait(0.5)
killLoader()

-- ═══════════════════════════════════════════════════════════
-- STARTUP NOTIFICATION
-- ═══════════════════════════════════════════════════════════
task.delay(0.3, function()
	if getgenv().KrakenNotify then
		getgenv().KrakenNotify({
			Title    = "Kraken Loaded",
			Body     = "Press RightShift to toggle the UI.",
			Type     = "success",
			Duration = 5,
		})
	end
end)
