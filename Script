local function toggleSettings()
	settingsOpen = not settingsOpen
	if settingsOpen then
		panelOpen = false
		TweenService:Create(cmdPanel, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Position=UDim2.new(0.5,0,0,BAR_H+6), BackgroundTransparency=1,
		}):Play()
		task.delay(0.24, function() cmdPanel.Visible = false end)
		settingsPanel.Visible = true
		settingsPanel.Position = UDim2.new(0.5,0,0,BAR_H+6)
		settingsPanel.BackgroundTransparency = 1
		TweenService:Create(settingsPanel, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Position=UDim2.new(0.5,0,0,BAR_H+16), BackgroundTransparency=0,
		}):Play()
	else
		TweenService:Create(settingsPanel, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Position=UDim2.new(0.5,0,0,BAR_H+6), BackgroundTransparency=1,
		}):Play()
		task.delay(0.24, function() settingsPanel.Visible = false end)
	end
end

