-- STEP 1: Inject missing executor functions so ALL modules work
if typeof(getgenv) ~= "function" then
    getgenv = function() return _G end
end
if typeof(gethui) ~= "function" then
    gethui = function() return game:GetService("CoreGui") end
end
if typeof(cloneref) ~= "function" then
    cloneref = function(obj) return obj end
end

-- STEP 2: Your key
local k = "NihonLoader_Key_Real"
getgenv()._nl = k

-- STEP 3: Fixed raw GitHub URL
local base = "https://raw.githubusercontent.com/NoSkillStudios/Zen2/refs/heads/main/"

local modules = { "NotificationSystem", "Commands", "Gui" }

local function notify(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title, Text = text, Duration = 10,
        })
    end)
end

for _, name in ipairs(modules) do
    local ok, err = pcall(function()
        loadstring(game:HttpGet(base .. name))()
    end)
    if not ok then
        notify("Nihon — Error loading " .. name, tostring(err))
        return
    end
end
