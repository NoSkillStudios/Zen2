local function notify(title, body, duration, ntype)
	ntype = ntype or "info"
	local col = ntype == "success" and C.green
		or ntype == "error" and C.red
		or ntype == "warning" and C.yellow
		or C.accentHi

	local fr = newInst("Frame", notifFrame, {
		Size = UDim2.new(0, 280, 0, 0),
		BackgroundColor3 = C.panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	})
	corner(10, fr)
	stroke(col, 1.2, 0.45, fr)

	local bar = newInst("Frame", fr, {
		Size = UDim2.new(0, 3, 1, -16),
		Position = UDim2.new(0, 0, 0, 8),
		BackgroundColor3 = col,
		BorderSizePixel = 0,
	})
	corner(3, bar)

	local ic = newInst("Frame", fr, {
		Size = UDim2.new(0, 30, 0, 30),
		Position = UDim2.new(0, 10, 0, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = col,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
	})
	corner(8, ic)
	newInst("TextLabel", ic, {
		Size = UDim2.fromScale(1,1),
		BackgroundTransparency = 1,
		Text = ntype == "success" and "✓" or ntype == "error" and "✕" or ntype == "warning" and "!" or "i",
		TextColor3 = col,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	})

	newInst("TextLabel", fr, {
		Size = UDim2.new(1, -56, 0, 18),
		Position = UDim2.new(0, 48, 0, 8),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = C.text,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	newInst("TextLabel", fr, {
		Size = UDim2.new(1, -56, 0, 16),
		Position = UDim2.new(0, 48, 0, 26),
		BackgroundTransparency = 1,
		Text = body,
		TextColor3 = C.dim,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-- progress bar
	local prog = newInst("Frame", fr, {
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = col,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
	})

	tween(fr, TI(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 280, 0, 58)})

	task.delay(0.1, function()
		tween(prog, TI(duration or 4, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)})
	end)

	task.delay((duration or 4) + 0.1, function()
		tween(fr, TI(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 280, 0, 0),
			BackgroundTransparency = 1,
		})
		for _, v in ipairs(fr:GetDescendants()) do
			if v:IsA("TextLabel") then tween(v, TI(0.2), {TextTransparency = 1}) end
		end
		task.delay(0.32, function() fr:Destroy() end)
	end)
end
