cmdInput.FocusLost:Connect(function(enter)
	if not enter or cmdInput.Text == "" then return end
	local parts = {}
	for word in cmdInput.Text:gmatch("%S+") do table.insert(parts, word) end
	local cmdName = table.remove(parts, 1):lower()
	cmdInput.Text = ""
	local fn = CMDS[cmdName]
	if fn then
		task.spawn(fn, parts)
	else
		notify("unknown", "/"..cmdName.." is not a valid command")
	end
end)

local panelOpen = false
local function togglePanel()
	panelOpen = not panelOpen
	cmdPanel.Visible = true
	if panelOpen then
		cmdPanel.Position = UDim2.new(0.5, 0, 0, BAR_H + 8)
		cmdPanel.BackgroundTransparency = 1
		TweenService:Create(cmdPanel, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 0, BAR_H + 18),
			BackgroundTransparency = 0,
		}):Play()
		task.delay(0.05, function() cmdInput:CaptureFocus() end)
	else
		TweenService:Create(cmdPanel, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, 0, 0, BAR_H + 8),
			BackgroundTransparency = 1,
		}):Play()
		task.delay(0.26, function() cmdPanel.Visible = false end)
	end
end

