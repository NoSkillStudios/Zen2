local function switchTab(id)
	if activeTab == id then return end
	for tid, btn in pairs(tabs) do
		local on = tid == id
		tween(btn, TI(0.2), {
			BackgroundTransparency = on and 0.3 or 0.6,
			BackgroundColor3 = on and C.accentDk or C.lift,
			TextColor3 = on and C.accentHi or C.dim,
		})
	end
	if tabFrames[activeTab] then tabFrames[activeTab].Visible = false end
	activeTab = id
	if tabFrames[id] then tabFrames[id].Visible = true end
end

