local function corner(p, r) local c = Instance.new("UICorner", p); c.CornerRadius = UDim.new(0, r or 8) end
local function stroke(p, col, th, tr)
	local s = Instance.new("UIStroke", p); s.Color = col; s.Thickness = th or 1; s.Transparency = tr or 0
end
local function gradient(p, c0, c1, rot)
	local g = Instance.new("UIGradient", p)
	g.Color = ColorSequence.new(c0, c1); g.Rotation = rot or 90
end
local function lbl(parent, props)
	local l = Instance.new("TextLabel", parent)
	for k, v in pairs(props) do l[k] = v end
	return l
end
local function frame(parent, props)
	local f = Instance.new("Frame", parent)
	f.BorderSizePixel = 0
	for k, v in pairs(props) do f[k] = v end
	return f
end

