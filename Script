local fpsTimer=0; local fpsBuf={}
RunService.RenderStepped:Connect(function(dt)
	fpsTimer+=dt; fpsBuf[#fpsBuf+1]=1/dt
	if #fpsBuf>30 then table.remove(fpsBuf,1) end
	if fpsTimer<0.5 then return end
	fpsTimer=0
	local sum=0; for _,v in ipairs(fpsBuf) do sum+=v end
	local fps=math.floor(sum/#fpsBuf)
	fpsLbl.Text="FPS "..fps
	local fc=fps>=45 and C.green or fps>=25 and C.yellow or C.red
	fpsLbl.TextColor3=fc; fpsDot.BackgroundColor3=fc
	local ok,ping=pcall(function() return math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
	if ok then
		pingLbl.Text="PING "..ping.."ms"
		local pc=ping<80 and C.green or ping<180 and C.yellow or C.red
		pingLbl.TextColor3=pc; pingDot.BackgroundColor3=pc
	end
end)
