		-- Extend sidebar
		tw(sidebar, TI, {Size = UDim2.new(0, SB_W, 0, BAR_H + PAN_H + 8)})
		
		if activeTab then
			tabs[activeTab].Visible = true
		end
	else
		toggleBtn.Text = "OPEN"
		tw(toggleBtn, 0.2, {BackgroundColor3 = C.SURFH})
		
		-- Hide content
		tw(content, TI, {Size = UDim2.new(0, CW, 0, 0), BackgroundTransparency = 1})
		
		-- Shrink sidebar back to L
		tw(sidebar, TI, {Size = UDim2.new(0, SB_W, 0, BAR_H)})
		
		task.delay(0.25, function()
			if not isOpen then
				anchor.Size = UDim2.new(0, CW + SB_W + 8, 0, BAR_H)
				for _, t in pairs(tabs) do
					if typeof(t) == "Instance" then t.Visible = false end
				end
			end
		end)
	end
end

