-- Toggle Logic
local expanded = false
local function toggle()
    expanded = not expanded
    if expanded then
        TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {Size = UDim2.new(0, 340, 0, 150)}):Play()
        TweenService:Create(panel, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 100)}):Play()
    else
        TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {Size = UDim2.new(0, 340, 0, 50)}):Play()
        TweenService:Create(panel, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 0)}):Play()
        input:ReleaseFocus()
    end
end

cmdBtn.MouseButton1Click:Connect(toggle)

-- Command Execution
input.FocusLost:Connect(function(enter)
    if enter and input.Text ~= "" then
        local text = input.Text
        -- Auto-remove prefix if typed
        if text:sub(1, #state.prefix) == state.prefix then
            text = text:sub(#state.prefix + 1)
        end
        runCmd(text)
        input.Text = ""
    end
end)

-- CHAT HOOK (FIXED - Using Player.Chatted)
local function onChatted(msg)
    if msg:sub(1, #state.prefix) == state.prefix then
        local cmd = msg:sub(#state.prefix + 1)
        if cmd ~= "" then
            runCmd(cmd)
        end
    end
end

lp.Chatted:Connect(onChatted)

-- Also hook legacy chat if present
pcall(function()
    local chatEvents = game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents", 2)
    if chatEvents then
        local sayEvent = chatEvents:WaitForChild("SayMessageRequest")
        local oldSay = sayEvent.FireServer
        sayEvent.FireServer = function(self, msg, channel)
            if msg:sub(1, #state.prefix) == state.prefix then
                local cmd = msg:sub(#state.prefix + 1)
                if cmd ~= "" then
                    runCmd(cmd)
                    return -- Don't send to chat
                end
            end
            return oldSay(self, msg, channel)
        end
    end
end)

-- Stats Loop
task.spawn(function()
    local fps = 60
    local last = tick()
    while task.wait(0.5) do
        local now = tick()
        local delta = now - last
        last = now
        fps = math.floor(1/delta)
        
        local ping = 0
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        
        fpsLbl.Text = fps .. " FPS"
        fpsLbl.TextColor3 = fps > 50 and Color3.fromRGB(134, 239, 172) or fps > 30 and Color3.fromRGB(250, 204, 21) or Color3.fromRGB(248, 113, 113)
        
        pingLbl.Text = ping .. "ms"
        pingLbl.TextColor3 = ping < 100 and Color3.fromRGB(134, 239, 172) or ping < 200 and Color3.fromRGB(250, 204, 21) or Color3.fromRGB(248, 113, 113)
    end
end)

-- Tracers Render
RunService.RenderStepped:Connect(function()
    if not state.tracers then return end
    local cam = workspace.CurrentCamera
    local viewport = cam.ViewportSize
    
    for _, trace in ipairs(state.traceObjs) do
        if trace.target and trace.target.Parent then
            local pos, vis = cam:WorldToViewportPoint(trace.target.Position)
            trace.line.From = Vector2.new(viewport.X/2, viewport.Y)
            trace.line.To = Vector2.new(pos.X, pos.Y)
            trace.line.Visible = vis and pos.Z > 0
        else
            trace.line.Visible = false
        end
    end
end)

