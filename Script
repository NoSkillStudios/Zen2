-- ESP & Visual Commands with Targeting
local function clearESP()
	for _, v in ipairs(state.espObjs) do pcall(function() v:Destroy() end) end
	state.espObjs = {}
	state.targetESP = {}
end

local function applyESP(target)
	if target == lp then return end
	if not target.Character then return end
	
	local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
	if not head then return end
	
	-- Check if already ESP'd
	for _, obj in ipairs(state.espObjs) do
		if obj.Adornee and obj.Adornee:IsDescendantOf(target.Character) then return end
	end
	
	-- Billboard
	local bb = Instance.new("BillboardGui")
	bb.Name = "LavESP"
	bb.Adornee = head
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(100, 30)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.ResetOnSpawn = false
	bb.Parent = head
	
	local nl = Instance.new("TextLabel", bb)
	nl.Size = UDim2.fromScale(1, 1)
	nl.BackgroundTransparency = 1
	nl.TextColor3 = C.accentHi
	nl.Font = Enum.Font.GothamBold
	nl.TextSize = 11
	nl.TextXAlignment = Enum.TextXAlignment.Center
	nl.Text = target.Name
	
	-- Highlight
	local hl = Instance.new("Highlight")
	hl.Name = "LavHL"
	hl.FillTransparency = 1
	hl.OutlineColor = C.accent
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = target.Character
	
	table.insert(state.espObjs, bb)
	table.insert(state.espObjs, hl)
	table.insert(state.targetESP, target)
end

register("esp", {"wallhack", "wh"}, "Toggles ESP", "[me/all/others/player]", function(args)
	if not args[1] or args[1] == "" then
		-- Toggle all ESP
		state.esp = not state.esp
		if state.esp then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= lp then applyESP(p) end
			end
			notify("ESP", "Enabled for all players", 3, "success")
		else
			clearESP()
			notify("ESP", "Disabled", 3, "warning")
		end
	else
		local target = resolvePlayer(args[1])
		if target == "all" then
			state.esp = true
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= lp then applyESP(p) end
			end
			notify("ESP", "Enabled for all", 3, "success")
		elseif target == "others" then
			state.esp = true
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= lp then applyESP(p) end
			end
			notify("ESP", "Enabled for others", 3, "success")
		elseif target and target ~= lp then
			applyESP(target)
			notify("ESP", "Enabled for " .. target.Name, 3, "success")
		end
	end
end)

register("unesp", {"noesp"}, "Removes ESP", "[all/player]", function(args)
	if not args[1] or args[1] == "" or args[1] == "all" then
		clearESP()
		state.esp = false
		notify("ESP", "Cleared all", 3, "warning")
	else
		local target = resolvePlayer(args[1])
		if target and target ~= "all" and target ~= "others" then
			for i = #state.espObjs, 1, -1 do
				local obj = state.espObjs[i]
				if obj and (obj.Adornee and obj.Adornee:IsDescendantOf(target.Character)) or 
				   (obj.Parent and obj.Parent:IsDescendantOf(target.Character)) then
					pcall(function() obj:Destroy() end)
					table.remove(state.espObjs, i)
				end
			end
			notify("ESP", "Removed from " .. target.Name, 3, "warning")
		end
	end
end)

