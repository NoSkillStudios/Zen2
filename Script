local notifStack = {}

local function notify(title, body, ntype, dur)
	dur = dur or 4
	local key = title:lower():gsub("%s+", "_")

	if notifStack[key] then
		local n = notifStack[key]
		n.count += 1
		n.countLbl.Text = n.count .. "x"
		n.countLbl.Visible = true
		task.cancel(n.thread)
		n.thread = task.delay(dur, function()
			tw(n.frame, 0.22, {Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1})
			task.wait(0.25)
			n.frame:Destroy()
			notifStack[key] = nil
		end)
		return
	end

	local typeColors = {
		success = C.GREEN,
		info    = C.ACCENT,
		warn    = C.YELLOW,
		err     = C.RED,
	}
	local accent = typeColors[ntype] or C.ACCENT

	local nf = mk("Frame", {
		Position = UDim2.new(1, 20, 1, -(80 + 66 * (#notifStack))),
		Size = UDim2.new(0, 300, 0, 58),
		BackgroundColor3 = C.SURF,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
		ZIndex = 10,
	}, gui)
	corner(12, nf)
	vstroke(1, accent, 0.6, nf)

	mk("Frame", {
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		ZIndex = 11,
	}, nf)
	corner(3, nf:FindFirstChildOfClass("Frame"))

	mk("TextLabel", {
		Position = UDim2.new(0, 14, 0, 8),
		Size = UDim2.new(1, -90, 0, 20),
		BackgroundTransparency = 1,
		Text = title,
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 11,
	}, nf)

	mk("TextLabel", {
		Position = UDim2.new(0, 14, 0, 30),
		Size = UDim2.new(1, -90, 0, 18),
		BackgroundTransparency = 1,
		Text = body,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextColor3 = C.MUTED,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 11,
	}, nf)

	local countLbl = mk("TextLabel", {
		Position = UDim2.new(1, -54, 0.5, -10),
		Size = UDim2.new(0, 36, 0, 20),
		BackgroundColor3 = Color3.fromRGB(85, 50, 155),
		BackgroundTransparency = 0.5,
		Text = "1x",
		TextSize = 10,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.ACCENT,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		ZIndex = 12,
	}, nf)
	corner(6, countLbl)

	tw(nf, 0.26, {Position = UDim2.new(1, -318, 1, -(80 + 66 * (table.getn(notifStack) or 0)))})

	local entry = {frame = nf, count = 1, countLbl = countLbl, thread = nil}
	notifStack[key] = entry

	entry.thread = task.delay(dur, function()
		tw(nf, 0.22, {Position = UDim2.new(1, 20, nf.Position.Y.Scale, nf.Position.Y.Offset), BackgroundTransparency = 1})
		task.wait(0.25)
		nf:Destroy()
		notifStack[key] = nil
	end)
end

