				local ddFrame = Instance.new("Frame", wrap)
				ddFrame.Size             = u2(1,0,0,0)
				ddFrame.Position         = u2(0,0,0,39)
				ddFrame.BackgroundColor3 = c3(18,18,28)
				ddFrame.ZIndex           = 50
				ddFrame.Visible          = false
				ddFrame.ClipsDescendants = true
				ddFrame.BorderSizePixel  = 0
				corner(ddFrame, 8)
				stroke(ddFrame, T.acc, 1)

				local ddScroll = scroll(ddFrame)
				pad(ddScroll, 4,4,4,4)
				list(ddScroll, nil, 2)

				local optFns = {}

				local function refreshSelLabel()
					if multi then
						local keys = {}
						for k in pairs(sel) do keys[#keys+1]=k end
						selLbl.Text = #keys==0 and "None" or (#keys==1 and keys[1] or #keys.." selected")
					else
						selLbl.Text = sel or "Select..."
					end
				end

				local function isSel(o) return multi and sel[o]==true or sel==o end

				local function closeDD()
					if not open then return end
					open = false
					tw(arrowLbl, {TextColor3=T.sub}, 0.15)
					arrowLbl.Text = "↓"
					rStroke.Color = T.bordFaint
					tw(ddFrame, {Size=u2(1,0,0,0)}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, function()
						if not open then ddFrame.Visible = false end
					end)
					tw(wrap, {Size=u2(1,0,0,36)}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				end

				local closeFn = closeDD
				activeDropdowns[#activeDropdowns+1] = closeFn

				local function buildOpt(opt)
					local ob = Instance.new("TextButton", ddScroll)
					ob.Size             = u2(1,0,0,ITEM_H)
					ob.BackgroundColor3 = c3(18,18,28)
					ob.BackgroundTransparency = 1
					ob.Text             = ""
					ob.ZIndex           = 51
					ob.BorderSizePixel  = 0
					corner(ob, 5)

					local ol = lbl(ob, opt, 12, T.txt, Enum.Font.Gotham)
					ol.Position = u2(0,10,0.5,-6)
					ol.ZIndex   = 52

					local ck = Instance.new("TextLabel", ob)
					ck.BackgroundTransparency = 1
					ck.Text       = "✓"
					ck.TextSize   = 11
					ck.TextColor3 = T.acc
					ck.Font       = Enum.Font.GothamBold
					ck.Size       = u2(0,20,1,0)
					ck.Position   = u2(1,-24,0,0)
					ck.TextXAlignment = Enum.TextXAlignment.Center
					ck.TextYAlignment = Enum.TextYAlignment.Center
					ck.TextTransparency = 1
					ck.ZIndex     = 52

					local function refreshOpt()
						local active = isSel(opt)
						tw(ob,  {BackgroundColor3= active and T.accDim or c3(18,18,28), BackgroundTransparency= active and 0 or 1}, 0.14)
						tw(ol,  {TextColor3= active and T.white or T.txt}, 0.14)
						tw(ck,  {TextTransparency= active and 0 or 1}, 0.14)
					end
					refreshOpt()
					optFns[opt] = refreshOpt

					cn(ob.MouseEnter, function() tw(ob,{BackgroundColor3=T.elev,BackgroundTransparency=0},0.1) end)
					cn(ob.MouseLeave, function()
						local active = isSel(opt)
						tw(ob,{BackgroundColor3=active and T.accDim or c3(18,18,28), BackgroundTransparency=active and 0 or 1},0.1)
					end)

					cn(ob.MouseButton1Click,function()
						if multi then
							if sel[opt] then sel[opt]=nil else sel[opt]=true end
							refreshOpt()
							refreshSelLabel()
							local out={}; for k in pairs(sel) do out[#out+1]=k end
							task.spawn(pcall,cb,out)
						else
							sel = opt
							for _,fn in pairs(optFns) do fn() end
							refreshSelLabel()
							task.spawn(pcall,cb,opt)
							task.delay(0.1, closeDD)
						end
					end)
				end

				for _,o in ipairs(opts) do buildOpt(o) end

				local function openDD()
					closeAllDropdowns(closeFn)
					open = true
					local h = math.min(#opts*ITEM_H+8, MAX_H)
					ddFrame.Visible = true
					ddFrame.Size    = u2(1,0,0,0)
					tw(ddFrame, {Size=u2(1,0,0,h)}, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
					tw(wrap, {Size=u2(1,0,0,40+h)}, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
					tw(arrowLbl, {TextColor3=T.accGlow}, 0.15)
					arrowLbl.Text = "↑"
					rStroke.Color = T.acc

					task.defer(function()
						if not ddFrame or not ddFrame.Parent then return end
						local ap = ddFrame.AbsolutePosition
						local as = ddFrame.AbsoluteSize
						local screenH = gui.AbsoluteSize.Y
						if ap.Y + as.Y > screenH - 20 then
							if pgScroll and pgScroll.Parent then
								local targetCanvas = pgScroll.CanvasPosition.Y + (ap.Y + as.Y - (screenH - 20))
								tw(pgScroll, {CanvasPosition = v2(0, math.max(0, targetCanvas))}, 0.3, Enum.EasingStyle.Quart)
							end
						end
					end)
				end

				cn(r.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					if open then closeDD() else openDD() end
				end)

				local obj = {}
				function obj:Set(v)
					if multi then sel={}; for _,k in ipairs(v) do sel[k]=true end else sel=v end
					for _,fn in pairs(optFns) do fn() end
					refreshSelLabel()
				end
				function obj:Refresh(newOpts)
					for _,c2 in ipairs(ddScroll:GetChildren()) do
						if c2:IsA("TextButton") then c2:Destroy() end
					end
					table.clear(optFns)
					opts = newOpts
					for _,o in ipairs(opts) do buildOpt(o) end
				end
				function obj:Get() return sel end
				return obj
			end

			-- INPUT
			function S:CreateInput(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb = cfg2.Callback or function() end
				local desc = cfg2.Description
				local r  = row(36)
				rowLbl(r, cfg2.Title or "Input")

				if desc then
					cn(r.MouseEnter, function() setTooltipTarget(r, desc) end)
					cn(r.MouseLeave, function() clearTooltipTarget(r) end)
				end

				local box = Instance.new("TextBox", r)
				box.Size             = u2(0,155,0,24)
				box.Position         = u2(1,-163,0.5,-12)
				box.BackgroundColor3 = T.bgDeep
				box.TextColor3       = T.txt
				box.PlaceholderText  = cfg2.Placeholder or "Type..."
				box.PlaceholderColor3= T.muted
				box.Text             = cfg2.Default or ""
				box.TextSize         = 11
				box.Font             = Enum.Font.Gotham
				box.ZIndex           = 9
				box.ClearTextOnFocus = false
				box.BorderSizePixel  = 0
				corner(box, 5)
				local bStroke = stroke(box, T.bordFaint, 1)

				cn(box.Focused,function()
					tw(box,{BackgroundColor3=c3(18,18,30)},0.14)
					bStroke.Color = T.acc
				end)
				cn(box.FocusLost,function(enter)
					tw(box,{BackgroundColor3=T.bgDeep},0.14)
					bStroke.Color = T.bordFaint
					if enter then
						local v = cfg2.Numeric and tonumber(box.Text) or box.Text
						if v~=nil then task.spawn(pcall,cb,v) end
					end
				end)

				local obj = {}
				function obj:Set(v) box.Text=tostring(v) end
				function obj:Get() return box.Text end
				return obj
			end

			-- KEYBIND
			function S:CreateKeybind(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb        = cfg2.Callback or function() end
				local bound     = cfg2.Default  or Enum.KeyCode.Unknown
				local listening = false
				local desc      = cfg2.Description
				local r         = row(36)
				rowLbl(r, cfg2.Title or "Keybind")

				if desc then
					cn(r.MouseEnter, function() setTooltipTarget(r, desc) end)
					cn(r.MouseLeave, function() clearTooltipTarget(r) end)
				end

				local kbtn = Instance.new("TextButton", r)
				kbtn.Size             = u2(0,72,0,26)
				kbtn.Position         = u2(1,-80,0.5,-13)
				kbtn.BackgroundColor3 = T.bgDeep
				kbtn.Text             = bound == Enum.KeyCode.Unknown and "Key" or bound.Name
				kbtn.TextColor3       = T.accGlow
				kbtn.TextSize         = 11
				kbtn.Font             = Enum.Font.GothamBold
				kbtn.ZIndex           = 9
				kbtn.BorderSizePixel  = 0
				corner(kbtn, 999)
				stroke(kbtn, T.acc, 1)

				cn(kbtn.MouseEnter, function() tw(kbtn,{BackgroundColor3=T.accDim},0.14) end)
				cn(kbtn.MouseLeave, function()
					if not listening then tw(kbtn,{BackgroundColor3=T.bgDeep},0.14) end
				end)

				cn(kbtn.MouseButton1Click,function()
					listening = true
					kbtn.Text = "..."
					kbtn.TextColor3 = T.warn
					tw(kbtn,{BackgroundColor3=T.accDim},0.14)
				end)
				cn(uis.InputBegan,function(i,gp)
					if gp then return end
					if listening then
						if i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode~=Enum.KeyCode.Unknown then
							listening=false
							bound=i.KeyCode
							kbtn.Text=i.KeyCode.Name
							kbtn.TextColor3=T.accGlow
							tw(kbtn,{BackgroundColor3=T.bgDeep},0.14)
						end
					elseif i.KeyCode==bound then
						task.spawn(pcall,cb)
					end
				end)

				local obj = {}
				function obj:Set(k) bound=k; kbtn.Text=k.Name end
				function obj:Get() return bound end
				return obj
			end

			-- COLOR PICKER
			function S:CreateColorPicker(cfg2)
				cfg2 = type(cfg2)=="string" and {Title=cfg2} or cfg2
				local cb   = cfg2.Callback or function() end
				local def  = cfg2.Default  or c3(130,80,255)
				local hv,sv,vv = Color3.toHSV(def)
				local cur  = def
				local pOpen, dSv, dH = false, false, false
				local desc = cfg2.Description

				eOrder += 1
				local wrap = Instance.new("Frame", secBody)
				wrap.Size             = u2(1,0,0,36)
				wrap.BackgroundTransparency = 1
				wrap.LayoutOrder      = eOrder
				wrap.ZIndex           = 20
				wrap.ClipsDescendants = false
				wrap.BorderSizePixel  = 0

				local r = Instance.new("Frame", wrap)
				r.Size             = u2(1,0,0,36)
				r.BackgroundColor3 = T.elev
				r.ZIndex           = 20
				r.BorderSizePixel  = 0
				corner(r, 7)
				stroke(r, T.bordFaint, 1)

				cn(r.MouseEnter,function()
					tw(r,{BackgroundColor3=T.elevHov},0.14)
					if desc then setTooltipTarget(r, desc) end
				end)
				cn(r.MouseLeave,function()
					tw(r,{BackgroundColor3=T.elev},0.14)
					if desc then clearTooltipTarget(r) end
				end)

				local ntl3 = lbl(r, cfg2.Title or "Color", 12, T.txt, Enum.Font.GothamMedium)
				ntl3.AnchorPoint = v2(0, 0.5)
				ntl3.Position = u2(0, 12, 0.5, 0)
				ntl3.ZIndex   = 21

				local prev = Instance.new("Frame", r)
				prev.Size             = u2(0,52,0,22)
				prev.Position         = u2(1,-60,0.5,-11)
				prev.BackgroundColor3 = cur
				prev.ZIndex           = 21
				prev.BorderSizePixel  = 0
				corner(prev, 5)
				stroke(prev, T.bord, 1)

				local hexTiny = Instance.new("TextLabel", r)
				hexTiny.BackgroundTransparency = 1
				hexTiny.Text       = ""
				hexTiny.TextSize   = 9
				hexTiny.TextColor3 = T.sub
				hexTiny.Font       = Enum.Font.GothamMedium
				hexTiny.Position   = u2(1,-122,0.5,-5)
				hexTiny.Size       = u2(0,56,0,10)
				hexTiny.TextXAlignment = Enum.TextXAlignment.Center
				hexTiny.ZIndex     = 21

				local pkFrame = Instance.new("Frame", wrap)
				pkFrame.Size             = u2(1,0,0,0)
				pkFrame.Position         = u2(0,0,0,38)
				pkFrame.BackgroundColor3 = T.elev
				pkFrame.ZIndex           = 22
				pkFrame.Visible          = false
				pkFrame.ClipsDescendants = true
				pkFrame.BorderSizePixel  = 0
				corner(pkFrame, 9)
				stroke(pkFrame, T.acc, 1)

				local svF = Instance.new("Frame", pkFrame)
				svF.Size             = u2(1,-46,0,115)
				svF.Position         = u2(0,8,0,8)
				svF.ZIndex           = 23
				svF.BorderSizePixel  = 0
				corner(svF, 6)

				local svGrad = Instance.new("UIGradient", svF)
				svGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.white),ColorSequenceKeypoint.new(1,Color3.fromHSV(hv,1,1))}

				local svDark = Instance.new("Frame", svF)
				svDark.Size             = u2(1,0,1,0)
				svDark.BackgroundColor3 = T.black
				svDark.ZIndex           = 24
				svDark.BorderSizePixel  = 0
				corner(svDark, 6)
				local sdg = Instance.new("UIGradient", svDark)
				sdg.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}
				sdg.Rotation = 90

				local svDot = Instance.new("Frame", svF)
				svDot.Size             = u2(0,13,0,13)
				svDot.AnchorPoint      = v2(0.5,0.5)
				svDot.Position         = u2(sv,0,1-vv,0)
				svDot.BackgroundColor3 = T.white
				svDot.ZIndex           = 26
				svDot.BorderSizePixel  = 0
				corner(svDot, 999)
				stroke(svDot, T.white, 2)

				local hBar = Instance.new("Frame", pkFrame)
				hBar.Size             = u2(0,18,0,115)
				hBar.Position         = u2(1,-30,0,8)
				hBar.ZIndex           = 23
				hBar.BorderSizePixel  = 0
				corner(hBar, 5)
				local hGrad = Instance.new("UIGradient", hBar)
				hGrad.Color = ColorSequence.new{
					ColorSequenceKeypoint.new(0,    c3(255,0,0)),
					ColorSequenceKeypoint.new(0.166,c3(255,255,0)),
					ColorSequenceKeypoint.new(0.333,c3(0,255,0)),
					ColorSequenceKeypoint.new(0.5,  c3(0,255,255)),
					ColorSequenceKeypoint.new(0.666,c3(0,0,255)),
					ColorSequenceKeypoint.new(0.833,c3(255,0,255)),
					ColorSequenceKeypoint.new(1,    c3(255,0,0)),
				}
				hGrad.Rotation = 90

				local hDot = Instance.new("Frame", hBar)
				hDot.Size             = u2(1,6,0,5)
				hDot.Position         = u2(0,-3,hv,-2.5)
				hDot.BackgroundColor3 = T.white
				hDot.ZIndex           = 25
				hDot.BorderSizePixel  = 0
				corner(hDot, 3)

				local hexBox = Instance.new("TextBox", pkFrame)
				hexBox.Size             = u2(1,-16,0,26)
				hexBox.Position         = u2(0,8,0,130)
				hexBox.BackgroundColor3 = T.bgDeep
				hexBox.TextColor3       = T.txt
				hexBox.TextSize         = 11
				hexBox.Font             = Enum.Font.GothamMedium
				hexBox.ZIndex           = 23
				hexBox.BorderSizePixel  = 0
				hexBox.TextXAlignment   = Enum.TextXAlignment.Center
				corner(hexBox, 5)
				stroke(hexBox, T.bordFaint, 1)

				local function updatePicker()
					cur = Color3.fromHSV(hv,sv,vv)
					prev.BackgroundColor3 = cur
					svGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.white),ColorSequenceKeypoint.new(1,Color3.fromHSV(hv,1,1))}
					svDot.Position = u2(sv,0,1-vv,0)
					hDot.Position  = u2(0,-3,hv,-2.5)
					local hex = string.format("#%02X%02X%02X",math.floor(cur.R*255),math.floor(cur.G*255),math.floor(cur.B*255))
					hexBox.Text    = hex
					hexTiny.Text   = hex
					task.spawn(pcall,cb,cur)
				end
				updatePicker()

				cn(svF.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					dSv=true
					local ap=svF.AbsolutePosition; local as=svF.AbsoluteSize
					sv=math.clamp((i.Position.X-ap.X)/as.X,0,1)
					vv=1-math.clamp((i.Position.Y-ap.Y)/as.Y,0,1)
					updatePicker()
				end)
				cn(hBar.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					dH=true
					local ap=hBar.AbsolutePosition; local as=hBar.AbsoluteSize
					hv=math.clamp((i.Position.Y-ap.Y)/as.Y,0,1)
					updatePicker()
				end)
				cn(uis.InputChanged,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseMovement then return end
					if dSv then
						local ap=svF.AbsolutePosition; local as=svF.AbsoluteSize
						sv=math.clamp((i.Position.X-ap.X)/as.X,0,1)
						vv=1-math.clamp((i.Position.Y-ap.Y)/as.Y,0,1)
						updatePicker()
					elseif dH then
						local ap=hBar.AbsolutePosition; local as=hBar.AbsoluteSize
						hv=math.clamp((i.Position.Y-ap.Y)/as.Y,0,1)
						updatePicker()
					end
				end)
				cn(uis.InputEnded,function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then dSv=false;dH=false end
				end)
				cn(hexBox.FocusLost,function(enter)
					if enter then
						local hex=hexBox.Text:gsub("#","")
						if #hex==6 then
							local ok2,rc,gc,bc = pcall(function()
								return tonumber("0x"..hex:sub(1,2)),tonumber("0x"..hex:sub(3,4)),tonumber("0x"..hex:sub(5,6))
							end)
							if ok2 and rc and gc and bc then
								hv,sv,vv = Color3.toHSV(c3(rc,gc,bc)); updatePicker()
							end
						end
					end
				end)

				cn(r.InputBegan,function(i)
					if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
					pOpen = not pOpen
					if pOpen then
						pkFrame.Visible=true
						pkFrame.Size=u2(1,0,0,0)
						tw(pkFrame,{Size=u2(1,0,0,168)},0.25,Enum.EasingStyle.Quart)
						wrap.Size=u2(1,0,0,38+168)
					else
						tw(pkFrame,{Size=u2(1,0,0,0)},0.18,Enum.EasingStyle.Quart,Enum.EasingDirection.Out,function()
							if not pOpen and pkFrame and pkFrame.Parent then pkFrame.Visible=false end
						end)
						wrap.Size=u2(1,0,0,36)
					end
				end)

				local obj = {}
				function obj:Set(c2) cur=c2; hv,sv,vv=Color3.toHSV(c2); updatePicker() end
				function obj:Get() return cur end
				return obj
			end

			-- LABEL
			function S:CreateLabel(text, color, desc)
				eOrder += 1
				local f = Instance.new("Frame", secBody)
				f.Size             = u2(1,0,0,18)
				f.BackgroundTransparency = 1
				f.LayoutOrder      = eOrder
				f.ZIndex           = 8
				f.BorderSizePixel  = 0
				local l = lbl(f, text or "", 11, color or T.sub, Enum.Font.Gotham)
				l.AnchorPoint = v2(0, 0.5)
				l.Position = u2(0, 4, 0.5, 0)
				l.ZIndex   = 9
				if desc then
					cn(f.MouseEnter, function() setTooltipTarget(f, desc) end)
					cn(f.MouseLeave, function() clearTooltipTarget(f) end)
				end
				local obj = {}
				function obj:Set(t,c2) l.Text=t; if c2 then l.TextColor3=c2 end end
				return obj
			end

			-- DIVIDER
			function S:CreateDivider()
				eOrder += 1
				local d = Instance.new("Frame", secBody)
				d.Size             = u2(1,0,0,1)
				d.BackgroundColor3 = T.bordFaint
				d.BorderSizePixel  = 0
				d.LayoutOrder      = eOrder
				d.ZIndex           = 8
			end

			return S
		end

		return Tab
	end

	-- WINDOW CONTROLS
	local minimized = false
	cn(minBtn.MouseButton1Click,function()
		minimized = not minimized
		tw(main,{Size=minimized and u2(0,winW,0,48) or u2(0,winW,0,winH)},0.3,Enum.EasingStyle.Quart)
		tabHeader.Visible = not minimized
		tabShadow.Visible = not minimized
	end)

	cn(closeBtn.MouseButton1Click,function()
		tabHeader.Visible = false
		tabShadow.Visible = false
		bottomDrag.Visible = false
		inlineTooltip.Visible = false
		sideTooltip.Visible = false
		tw(main,{Size=u2(0,winW,0,0),BackgroundTransparency=1},0.22,Enum.EasingStyle.Quart)
		task.delay(0.24,function()
			if gui and gui.Parent then gui:Destroy() end
		end)
	end)

	cn(uis.InputBegan,function(inp,gp)
		if gp then return end
		if inp.KeyCode==toggleKey then
			local v = not main.Visible
			main.Visible   = v
			tabHeader.Visible  = v
			tabShadow.Visible = v
			bottomDrag.Visible = v
		end
	end)

	task.defer(function()
		tw(main,{Size=u2(0,winW,0,winH)},0.38,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
	end)

	-- Combined RenderStepped for drag bar, tab header, and tooltip cleanup
	cn(rs.RenderStepped, function()
		syncDragBar()
		syncTabHeader()
		if tooltipTarget and tooltipTarget.Parent then
			local mousePos = uis:GetMouseLocation()
			local ap = tooltipTarget.AbsolutePosition
			local as = tooltipTarget.AbsoluteSize
			if mousePos.X < ap.X or mousePos.X > ap.X + as.X or
			   mousePos.Y < ap.Y or mousePos.Y > ap.Y + as.Y then
				tooltipTarget = nil
				hideTooltip()
			end
		end
	end)

	W._gui  = gui
	W._main = main

	function W:Destroy()
		for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		if gui and gui.Parent then gui:Destroy() end
	end

	function W:SetVisible(v)
		main.Visible       = v
		tabHeader.Visible  = v
		tabShadow.Visible  = v
		bottomDrag.Visible = v
	end

	return W
end

return K
