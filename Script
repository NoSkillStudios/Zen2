local function togglePanel()
	isOpen = not isOpen
	if isOpen then
		-- OPEN
		togBtn.Text = "close"
		tw(togBtn, 0.15, {TextColor3 = C.TEXT})
		
		anchor.Size = UDim2.new(0, BAR_W, 0, BAR_H + PAN_H + 5)
		tw(panel, TI, {Size = UDim2.new(1, 0, 0, PAN_H), BackgroundTransparency = 0})
		
		if activeTab and tabs[activeTab] then 
			tabs[activeTab].Visible = true 
		end
	else
		-- CLOSE
		togBtn.Text = "open"
		tw(togBtn, 0.15, {TextColor3 = C.MUTED})
		
		tw(panel, TI, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1})
		
		task.delay(0.22, function()
			if not isOpen then
				anchor.Size = UDim2.new(0, BAR_W, 0, BAR_H)
				for _, t in pairs(tabs) do 
					if typeof(t) == "Instance" then t.Visible = false end
				end
			end
		end)
	end
end

