						tw(si2.icon, {TextColor3=T.white}, 0.2)
					end
					tw(si2.bar, {BackgroundTransparency=0, Size=u2(0,3,0.65,0)}, 0.25, Enum.EasingStyle.Back)
				end
			else
				if si2 then
					tw(si2.btn,  {BackgroundColor3=T.sidebar, BackgroundTransparency=1}, 0.2)
					if si2.isImage then
						tw(si2.icon, {ImageColor3=T.muted}, 0.2)
					else
						tw(si2.icon, {TextColor3=T.muted}, 0.2)
					end
					tw(si2.bar, {BackgroundTransparency=1, Size=u2(0,3,0,0)}, 0.2)
				end
				if prev == n and not instant then
					tw(pg, {Position = u2(0, -0.03, 0, -10)}, 0.2, Enum.EasingStyle.Quart)
					task.delay(0.2, function()
						if activeTab ~= n and pg and pg.Parent then 
							pg.Visible = false
							pg.Position = u2(0, 0, 0, 0)
						end
					end)
				else
					pg.Visible = false
					pg.Position = u2(0, 0, 0, 0)
				end
			end
		end
	end

