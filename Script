-- Chat hook via Chatted event
lp.Chatted:Connect(function(msg)
	if msg:sub(1, #state.prefix) == state.prefix then
		local cmd = msg:sub(#state.prefix + 1)
		if cmd ~= "" then runCmd(cmd) end
	end
end)

-- FPS counter (proper — frame delta via RenderStepped)
local fpsBuffer = {}
RunService.RenderStepped:Connect(function(dt)
	table.insert(fpsBuffer, dt)
	if #fpsBuffer > 30 then table.remove(fpsBuffer, 1) end
end)

-- Tracers render
RunService.RenderStepped:Connect(function()
	if not state.tracers then return end
	local cam = workspace.CurrentCamera
	local vp = cam.ViewportSize
	local hr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	for _, t in ipairs(state.traceObjs) do
		if t.target and t.target.Parent and t.line then
			local pos, vis = cam:WorldToViewportPoint(t.target.Position)
			t.line.From = Vector2.new(vp.X / 2, vp.Y)
			t.line.To = Vector2.new(pos.X, pos.Y)
			t.line.Visible = vis and pos.Z > 0
		else
			pcall(function() t.line.Visible = false end)
		end
	end
end)

-- Stats update
task.spawn(function()
	while task.wait(0.75) do
		local fps = 60
		if #fpsBuffer > 0 then
			local sum = 0
			for _, v in ipairs(fpsBuffer) do sum += v end
			fps = math.floor(1 / (sum / #fpsBuffer))
		end

		local ping = 0
		pcall(function()
			ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)

		fpsLbl.Text = fps .. " FPS"
		fpsLbl.TextColor3 = fps >= 50 and C.green or fps >= 30 and C.yellow or C.red

		pingLbl.Text = ping .. " ms"
		pingLbl.TextColor3 = ping < 80 and C.green or ping < 150 and C.yellow or C.red
	end
end)

notify("Lavender", "Loaded · prefix: " .. state.prefix, 4, "success")
