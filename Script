local function switchTab(name)
	if activeTab and tabs[activeTab] then
		tabs[activeTab].page.Visible = false
		tw(tabs[activeTab].btn, 0.18, {BackgroundTransparency = 1, ImageColor3 = C.MUTED})
	end
	activeTab = name
	if tabs[name] then
		tabs[name].page.Visible = true
		tw(tabs[name].btn, 0.18, {BackgroundTransparency = 0.55, ImageColor3 = C.ACCENT})
	end
end

