	s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
end
local function mkGrad(p,c0,c1,rot)
	local g=Instance.new("UIGradient",p); g.Color=ColorSequence.new(c0,c1); g.Rotation=rot or 90
