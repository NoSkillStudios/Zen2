local function getChar() return lp.Character end
local function getHRP() local c = getChar(); return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = getChar(); return c and c:FindFirstChild("Humanoid") end

local function resolvePlayer(arg)
	if not arg or arg == "" then return nil end
	arg = arg:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #arg) == arg then return p end
	end
	return nil
end

local function notify(title, body, duration)
	local nf = pg:FindFirstChild("LavenderAdmin")
	if not nf then return end
	local notifFrame = nf:FindFirstChild("Notif")
	if not notifFrame then return end
	local tag   = notifFrame:FindFirstChild("NotifTag")
	local ttl   = notifFrame:FindFirstChild("NotifTitle")
	local bdy   = notifFrame:FindFirstChild("NotifBody")
	if tag  then tag.Text  = "LAVENDER ADMIN" end
	if ttl  then ttl.Text  = title end
	if bdy  then bdy.Text  = body end
	TweenService:Create(notifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.08,
		Position = UDim2.new(0.5, 0, 0, 72),
	}):Play()
	for _, child in ipairs(notifFrame:GetDescendants()) do
		if child:IsA("TextLabel") then TweenService:Create(child, TweenInfo.new(0.25), {TextTransparency=0}):Play() end
		if child:IsA("Frame") then pcall(function() TweenService:Create(child, TweenInfo.new(0.25), {BackgroundTransparency=0}):Play() end) end
	end
	task.delay(duration or 4, function()
		TweenService:Create(notifFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, 0, 0, 58),
		}):Play()
		for _, child in ipairs(notifFrame:GetDescendants()) do
			if child:IsA("TextLabel") then TweenService:Create(child, TweenInfo.new(0.25), {TextTransparency=1}):Play() end
			if child:IsA("Frame") then pcall(function() TweenService:Create(child, TweenInfo.new(0.25), {BackgroundTransparency=1}):Play() end) end
		end
	end)
end

local function stopFly()
	if state.flyConn then state.flyConn:Disconnect(); state.flyConn = nil end
	local hum = getHum(); local hrp = getHRP()
	if hum then hum.PlatformStand = false end
	if hrp then hrp.Velocity = Vector3.zero end
end

local function startFly()
	stopFly()
	local hum = getHum(); local hrp = getHRP()
	if not hum or not hrp then return end
	hum.PlatformStand = true
	state.flyConn = RunService.RenderStepped:Connect(function()
		if not state.fly then stopFly(); return end
		local dir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
		hrp.Velocity = dir.Magnitude > 0 and dir.Unit * state.flySpeed or Vector3.zero
		hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.CFrame.LookVector)
	end)
end

local function stopNoclip()
	if state.noclipConn then state.noclipConn:Disconnect(); state.noclipConn = nil end
	local c = getChar(); if not c then return end
	for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end
end

local function startNoclip()
	stopNoclip()
	state.noclipConn = RunService.Stepped:Connect(function()
		if not state.noclip then stopNoclip(); return end
		local c = getChar(); if not c then return end
		for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
	end)
end

local function clearESP()
	for _, v in ipairs(state.espObjs) do pcall(function() v:Destroy() end) end
	state.espObjs = {}
end

local function buildESP(plr)
	if plr == lp or not plr.Character then return end
	local head = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
	if not head then return end
	local bb = Instance.new("BillboardGui")
	bb.Name = "LavESP"; bb.Adornee = head; bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(100, 30); bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.ResetOnSpawn = false; bb.Parent = head
	local nl = Instance.new("TextLabel", bb)
	nl.Size = UDim2.fromScale(1,1); nl.BackgroundTransparency = 1
	nl.TextColor3 = LAV.accentGlo; nl.Font = Enum.Font.GothamBold
	nl.TextSize = 11; nl.TextXAlignment = Enum.TextXAlignment.Center
	nl.Text = plr.Name
	local hl = Instance.new("Highlight")
	hl.Name = "LavHL"; hl.FillTransparency = 1
	hl.OutlineColor = LAV.accent; hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = plr.Character
	table.insert(state.espObjs, bb)
	table.insert(state.espObjs, hl)
end

