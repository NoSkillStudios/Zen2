-- Notification System
local notifStack = {}
local notifHeight = 64
local notifGap = 8
local baseY = -20

function notify(title, body, ntype, dur)
	dur = dur or 4
	local key = title:lower():gsub("%s+", "_")
	local colors = {success = C.GREEN, info = C.BLUE, warn = C.YEL, error = C.RED}
	local accent = colors[ntype] or C.BLUE
	
	if notifStack[key] then
		local n = notifStack[key]
		n.count += 1
		n.countLabel.Text = n.count .. "×"
		n.countLabel.Visible = true
		if n.thread then task.cancel(n.thread) end
		n.thread = task.delay(dur, function()
			tw(n.frame, 0.2, {Position = UDim2.new(1, 20, 1, n.targetY)})
			task.wait(0.2)
			n.frame:Destroy()
			notifStack[key] = nil
			restackNotifs()
		end)
		return
	end
	
	local count = 0
	for _ in pairs(notifStack) do count += 1 end
	local targetY = baseY - (count * (notifHeight + notifGap))
	
	local frame = mk("Frame", {
		Position = UDim2.new(1, 20, 1, baseY),
		Size = UDim2.new(0, 300, 0, notifHeight),
		BackgroundColor3 = C.BG,
		BorderSizePixel = 0,
	}, gui)
	corner(10, frame)
	stroke(1, accent, 0.5, frame)
	
	mk("Frame", {Size=UDim2.new(0, 3, 1, 0), BackgroundColor3=accent, BorderSizePixel=0}, frame)
	
	mk("TextLabel", {
		Position = UDim2.new(0, 15, 0, 10),
		Size = UDim2.new(1, -60, 0, 20),
		BackgroundTransparency = 1,
		Text = title,
		TextSize = 13,
		Font = Enum.Font.GothamBlack,
		TextColor3 = C.TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, frame)
	
	mk("TextLabel", {
		Position = UDim2.new(0, 15, 0, 32),
		Size = UDim2.new(1, -60, 0, 20),
		BackgroundTransparency = 1,
		Text = body,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextColor3 = C.MUTED,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, frame)
	
	local countLabel = mk("TextLabel", {
		Position = UDim2.new(1, -45, 0.5, -10),
		Size = UDim2.new(0, 30, 0, 20),
		BackgroundColor3 = C.SURF,
		Text = "1×",
		TextSize = 11,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.TEXT,
		Visible = false,
	}, frame)
	corner(4, countLabel)
	
	local entry = {frame = frame, count = 1, countLabel = countLabel, targetY = targetY, key = key}
	notifStack[key] = entry
	
	tw(frame, 0.3, {Position = UDim2.new(1, -320, 1, targetY)})
	
	entry.thread = task.delay(dur, function()
		tw(frame, 0.2, {Position = UDim2.new(1, 20, 1, targetY)})
		task.wait(0.2)
		frame:Destroy()
		notifStack[key] = nil
		restackNotifs()
	end)
end

function restackNotifs()
	local items = {}
	for _, v in pairs(notifStack) do table.insert(items, v) end
	table.sort(items, function(a, b) return a.targetY > b.targetY end)
	
	for i, item in ipairs(items) do
		local newY = baseY - ((i-1) * (notifHeight + notifGap))
		item.targetY = newY
		tw(item.frame, 0.2, {Position = UDim2.new(1, -320, 1, newY)})
	end
end

