function toggleGUI()
	isOpen = not isOpen
	
	if isOpen then
		toggleBtn.Text = "CLOSE"
		tw(toggleBtn, 0.2, {BackgroundColor3 = C.RED})
		
		-- Expand anchor
		anchor.Size = UDim2.new(0, CW + SB_W + 8, 0, BAR_H + PAN_H + 8)
		
