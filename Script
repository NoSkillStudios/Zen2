local chatConn
local function hookChat()
	local ok, chat = pcall(function() return lp:WaitForChild("PlayerGui"):WaitForChild("Chat", 5) end)
	if not ok or not chat then return end
	local chatMain = chat:FindFirstChildWhichIsA("Frame", true)
	if not chatMain then return end
	local chatInput
	for _, d in ipairs(chatMain:GetDescendants()) do
		if d:IsA("TextBox") then chatInput = d; break end
	end
	if not chatInput then return end
	chatInput.FocusLost:Connect(function(enter)
		if not enter then return end
		local txt = chatInput.Text
		if txt:sub(1, #state.prefix) == state.prefix then
			local cmd = txt:sub(#state.prefix + 1)
			if cmd ~= "" then
				task.defer(function() runCmd(cmd) end)
			end
		end
	end)
end
task.spawn(hookChat)

