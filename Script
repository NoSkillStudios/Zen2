-- Stats loop
local fpsBuf, fpsIdx, fpsAcc = {}, 1, 0
for i = 1, 20 do fpsBuf[i] = 60 end
local lastT = tick()

RunService.Heartbeat:Connect(function()
	local now = tick()
	local dt = now - lastT
	lastT = now
	
	if dt > 0 then
		local s = 1 / dt
		fpsAcc = fpsAcc - fpsBuf[fpsIdx] + s
		fpsBuf[fpsIdx] = s
		fpsIdx = fpsIdx % 20 + 1
		local avg = fpsAcc / 20
		fpsLbl.Text = math.floor(avg) .. " FPS"
		fpsDot.BackgroundColor3 = avg >= 50 and C.GREEN or avg >= 30 and C.YEL or C.RED
	end
	
	if tick() % 1 < 0.05 then
		local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
		if ok then
			pingLbl.Text = math.floor(p) .. " ms"
			pingDot.BackgroundColor3 = p < 80 and C.BLUE or p < 150 and C.YEL or C.RED
		end
	end
end)

