-- FIX: Notification stacking system
local notifStack = {}
local notifHeight = 60
local notifGap = 8
local baseY = -88

local function restackNotifications()
	local currentStack = {}
	for k, v in pairs(notifStack) do
		table.insert(currentStack, v)
	end
	
	table.sort(currentStack, function(a, b) 
		return a.frame.AbsolutePosition.Y > b.frame.AbsolutePosition.Y 
	end)
	
	for i, entry in ipairs(currentStack) do
		local newY = baseY - ((i-1) * (notifHeight + notifGap))
		entry.targetY = newY
		tw(entry.frame, 0.2, {Position = UDim2.new(1, -296, 1, newY)})
	end
end

local function notify(title, body, ntype, dur)
	dur = dur or 4
	local key = title:lower():gsub("%s+", "_")
	local typeCol = {
		success = C.GREEN,
		info    = Color3.fromRGB(150, 150, 150),
		warn    = C.YEL,
		err     = C.RED,
		error   = C.RED,
	}
	local accent = typeCol[ntype] or typeCol.info

	if notifStack[key] then
		local n = notifStack[key]
		n.count += 1
		n.cntLbl.Text = n.count .. "×"
		n.cntLbl.Visible = true
		
		if n.thread then task.cancel(n.thread) end
		
		n.thread = task.delay(dur, function()
			tw(n.frame, 0.2, {Position = UDim2.new(1, 20, 1, n.targetY), BackgroundTransparency = 1})
			task.wait(0.22)
			n.frame:Destroy()
			notifStack[key] = nil
			restackNotifications()
		end)
		return
	end

	local stackPos = 0
	for k, v in pairs(notifStack) do stackPos += 1 end
	local targetY = baseY - (stackPos * (notifHeight + notifGap))

	local nf = mk("Frame", {
		Position = UDim2.new(1, 20, 1, baseY),
		Size = UDim2.new(0, 280, 0, 54),
		BackgroundColor3 = C.BG,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 10,
	}, gui)
	corner(9, nf)
	stroke(1, C.BDR, 0, nf)

	mk("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		ZIndex = 11,
	}, nf)

	mk("TextLabel", {
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -60, 0, 18),
		BackgroundTransparency = 1,
		Text = title,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 11,
	}, nf)

	mk("TextLabel", {
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -60, 0, 16),
		BackgroundTransparency = 1,
		Text = body,
		TextSize = 10,
		Font = Enum.Font.Gotham,
		TextColor3 = C.MUTED,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 11,
	}, nf)

	local cntLbl = mk("TextLabel", {
		Position = UDim2.new(1, -46, 0.5, -10),
		Size = UDim2.new(0, 32, 0, 20),
		BackgroundColor3 = C.SURFH,
		BackgroundTransparency = 0,
		Text = "1×",
		TextSize = 10,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.MUTED,
		Visible = false,
		ZIndex = 12,
	}, nf)
	corner(5, cntLbl)

	local entry = {
		frame = nf, 
		count = 1, 
		cntLbl = cntLbl, 
		thread = nil,
		targetY = targetY,
		key = key
	}
	notifStack[key] = entry

	tw(nf, 0.24, {Position = UDim2.new(1, -296, 1, targetY)})

	entry.thread = task.delay(dur, function()
		tw(nf, 0.2, {Position = UDim2.new(1, 20, 1, targetY), BackgroundTransparency = 1})
		task.wait(0.22)
		nf:Destroy()
		notifStack[key] = nil
		restackNotifications()
	end)
end

