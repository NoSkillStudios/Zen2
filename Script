notifyFn = function(title, body, duration)
	local nf = pg:FindFirstChild("LavenderAdmin")
	if not nf then return end
	local fr = nf:FindFirstChild("Notif"); if not fr then return end
	local tag = fr:FindFirstChild("NotifTag")
	local ttl = fr:FindFirstChild("NotifTitle")
	local bdy = fr:FindFirstChild("NotifBody")
	if tag then tag.Text = "LAVENDER ADMIN" end
	if ttl then ttl.Text = title end
	if bdy then bdy.Text = body end
	TweenService:Create(fr, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		BackgroundTransparency=0.06, Position=UDim2.new(0.5,0,0,BAR_H+32),
	}):Play()
	for _, ch in ipairs(fr:GetDescendants()) do
		if ch:IsA("TextLabel") then TweenService:Create(ch, TweenInfo.new(0.22), {TextTransparency=0}):Play() end
		if ch:IsA("Frame") then pcall(function() TweenService:Create(ch, TweenInfo.new(0.22), {BackgroundTransparency=0}):Play() end) end
	end
	task.delay(duration or 4, function()
		TweenService:Create(fr, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			BackgroundTransparency=1, Position=UDim2.new(0.5,0,0,BAR_H+20),
		}):Play()
		for _, ch in ipairs(fr:GetDescendants()) do
			if ch:IsA("TextLabel") then TweenService:Create(ch, TweenInfo.new(0.22), {TextTransparency=1}):Play() end
			if ch:IsA("Frame") then pcall(function() TweenService:Create(ch, TweenInfo.new(0.22), {BackgroundTransparency=1}):Play() end) end
		end
	end)
end

