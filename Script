-- FPS + ping loop
local fpsBuf, fpsIdx, fpsAcc = {}, 1, 0
for i = 1, 20 do fpsBuf[i] = 60 end
local lastT, pingTick = os.clock(), 0

RunService.Heartbeat:Connect(function()
	local now = os.clock()
	local dt = now - lastT
	lastT = now
	if dt > 0 then
		local s = math.floor(1 / dt)
		fpsAcc = fpsAcc - fpsBuf[fpsIdx] + s
		fpsBuf[fpsIdx] = s
		fpsIdx = fpsIdx % 20 + 1
		local avg = fpsAcc / 20
		fpsLbl.Text = math.floor(avg) .. " FPS"
		local col = avg >= 50 and C.GREEN or avg >= 30 and C.YEL or C.RED
		fpsDot.BackgroundColor3 = col
		fpsLbl.TextColor3 = col
	end
	pingTick += 1
	if pingTick >= 20 then
		pingTick = 0
		local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
		if ok then
			pingLbl.Text = "PING " .. math.floor(p) .. " ms"
			pingDot.BackgroundColor3 = p < 80 and C.BLUE or p < 150 and C.YEL or C.RED
		end
	end
end)

