local TI = TweenInfo.new
local function tween(obj, t, props) TweenService:Create(obj, t, props):Play() end
local function newInst(cls, parent, props)
	local i = Instance.new(cls)
	if props then for k, v in pairs(props) do i[k] = v end end
	if parent then i.Parent = parent end
	return i
end
local function corner(r, parent)
	return newInst("UICorner", parent, {CornerRadius = UDim.new(0, r)})
end
local function stroke(c, th, tr, parent)
	return newInst("UIStroke", parent, {Color = c, Thickness = th, Transparency = tr})
end

