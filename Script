	else closePanel(cmdPanel) end
end
local function toggleSettings()
	settingsOpen=not settingsOpen
	if settingsOpen then
		if panelOpen then panelOpen=false; closePanel(cmdPanel) end
		openPanel(settingsPanel)
	else closePanel(settingsPanel) end
end

local function pulse(btn)
	tween(btn,TweenInfo.new(0.07),{BackgroundTransparency=0.05})
	task.delay(0.09,function() tween(btn,TweenInfo.new(0.18),{BackgroundTransparency=0.4}) end)
end

cmdBtn.InputBegan:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1 then pulse(cmdBtn); toggleCmd() end
end)
settingsBtn.InputBegan:Connect(function(i)
