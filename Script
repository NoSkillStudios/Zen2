-- Toggle Function
function togglePanel()
	isOpen = not isOpen
	
	if isOpen then
		-- EXPAND: Show panel below, extend sidebar down
		togBtn.Text = "CLOSE"
		tw(togBtn, 0.2, {BackgroundColor3 = C.RED, BackgroundTransparency = 0.3})
		
		-- Resize anchor to fit everything
		anchor.Size = UDim2.new(0, CW + SB_W + 10, 0, BAR_H + PAN_H + 10)
		
		-- Animate panel
		tw(panel, TI, {Size = UDim2.new(0, CW, 0, PAN_H), BackgroundTransparency = 0})
		
		-- Extend sidebar down
		tw(sidebar, TI, {Size = UDim2.new(0, SB_W, 0, BAR_H + PAN_H + 10)})
		
		if activeTab then
			tabs[activeTab].Visible = true
		end
	else
		-- COLLAPSE: Hide panel, shrink sidebar to L-shape
		togBtn.Text = "OPEN"
		tw(togBtn, 0.2, {BackgroundColor3 = C.SURFH, BackgroundTransparency = 0})
		
		tw(panel, TI, {Size = UDim2.new(0, CW, 0, 0), BackgroundTransparency = 1})
		tw(sidebar, TI, {Size = UDim2.new(0, SB_W, 0, BAR_H)})
		
		task.delay(0.22, function()
			if not isOpen then
				anchor.Size = UDim2.new(0, CW + SB_W + 10, 0, BAR_H)
				for _, t in pairs(tabs) do t.Visible = false end
			end
		end)
	end
end

