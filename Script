local fpsTimer = 0
local fpsSamples = {}
RunService.RenderStepped:Connect(function(dt)
	fpsTimer += dt
	table.insert(fpsSamples, 1 / dt)
	if #fpsSamples > 30 then table.remove(fpsSamples, 1) end
	if fpsTimer >= 0.5 then
		fpsTimer = 0
		local sum = 0
		for _, v in ipairs(fpsSamples) do sum += v end
		local fps = math.floor(sum / #fpsSamples)
		fpsLbl.Text = "FPS "..fps
		local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		pingLbl.Text = "PING "..ping.."ms"
		local pc = ping < 80 and LAV.green or ping < 180 and LAV.yellow or LAV.red
		pingLbl.TextColor3 = pc; pingDot.BackgroundColor3 = pc
		local fc = fps >= 45 and LAV.green or fps >= 25 and LAV.yellow or LAV.red
		fpsLbl.TextColor3 = fc; fpsDot.BackgroundColor3 = fc
	end
end)
