register("speed", {"walkspeed", "sp", "ws"}, "Sets WalkSpeed", "<value> [player]", function(args)
	local v = tonumber(args[1])
	if not v then notify("Error", "Usage: speed <value> [player]", 3, "error") return end
	local target = args[2] and resolvePlayer(args[2]) or lp
	if target == "all" then
		for _, p in ipairs(Players:GetPlayers()) do
			local h = p.Character and p.Character:FindFirstChild("Humanoid")
			if h then h.WalkSpeed = v end
		end
		notify("Speed", "Set all players speed to " .. v, 3, "success")
	elseif target == "others" then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp then
				local h = p.Character and p.Character:FindFirstChild("Humanoid")
				if h then h.WalkSpeed = v end
			end
		end
		notify("Speed", "Set others speed to " .. v, 3, "success")
	elseif target and target ~= lp then
		local h = target.Character and target.Character:FindFirstChild("Humanoid")
		if h then h.WalkSpeed = v; notify("Speed", target.Name .. " → " .. v, 3, "success") end
	else
		local h = lp.Character and lp.Character:FindFirstChild("Humanoid")
		if h then h.WalkSpeed = v; notify("Speed", "You → " .. v, 3, "success") end
	end
end)

