-- Create Command Row Function
local commandRows = {}

local function createCommandRow(name, cmdData, index)
	local row = create("Frame", {
		Size = UDim2.new(1, -10, 0, 50),
		BackgroundColor3 = Colors.Background,
		BorderSizePixel = 0,
		LayoutOrder = index
	}, scroll)
	
	corner(6, row)
	
	-- Command Name
	local nameLabel = create("TextLabel", {
		Size = UDim2.new(0, 150, 1, 0),
		Position = UDim2.new(0, 15, 0, 0),
		BackgroundTransparency = 1,
		Text = name:upper(),
		TextColor3 = Colors.Accent,
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left
	}, row)
	
	-- Description
	local descLabel = create("TextLabel", {
		Size = UDim2.new(1, -280, 1, 0),
		Position = UDim2.new(0, 175, 0, 0),
		BackgroundTransparency = 1,
		Text = cmdData.desc or "No description",
		TextColor3 = Colors.TextMuted,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd
	}, row)
	
	-- Args format
	if cmdData.argfmt and cmdData.argfmt ~= "" then
		local argsLabel = create("TextLabel", {
			Size = UDim2.new(0, 100, 0, 20),
			Position = UDim2.new(0, 175, 0, 28),
			BackgroundTransparency = 1,
			Text = cmdData.argfmt,
			TextColor3 = Colors.AccentLight,
			TextSize = 10,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left
		}, row)
	end
	
	-- Run Button
	local runBtn = create("TextButton", {
		Size = UDim2.new(0, 70, 0, 32),
		Position = UDim2.new(1, -85, 0.5, -16),
		BackgroundColor3 = Colors.Success,
		Text = "RUN",
		TextColor3 = Colors.Text,
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false
	}, row)
	
	corner(6, runBtn)
	
	-- Hover effects
	row.MouseEnter:Connect(function()
		tween(row, 0.2, {BackgroundColor3 = Colors.SurfaceHover})
	end)
	
	row.MouseLeave:Connect(function()
		tween(row, 0.2, {BackgroundColor3 = Colors.Background})
	end)
	
	runBtn.MouseEnter:Connect(function()
		tween(runBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(80, 200, 120)})
	end)
	
	runBtn.MouseLeave:Connect(function()
		tween(runBtn, 0.2, {BackgroundColor3 = Colors.Success})
	end)
	
	-- Click to copy to input
	row.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and input.Target ~= runBtn then
			cmdInput.Text = state.prefix .. name .. " "
			cmdInput:CaptureFocus()
		end
	end)
	
	-- Run button click
	runBtn.MouseButton1Click:Connect(function()
		-- Visual feedback
		tween(runBtn, 0.1, {Size = UDim2.new(0, 66, 0, 28), Position = UDim2.new(1, -83, 0.5, -14)})
		task.wait(0.1)
		tween(runBtn, 0.1, {Size = UDim2.new(0, 70, 0, 32), Position = UDim2.new(1, -85, 0.5, -16)})
		
		-- Execute
		runCmd(name)
		
		-- Visual success indicator
		local originalColor = runBtn.BackgroundColor3
		runBtn.BackgroundColor3 = Colors.Accent
		runBtn.Text = "✓"
		task.wait(0.5)
		runBtn.Text = "RUN"
		runBtn.BackgroundColor3 = originalColor
	end)
	
	table.insert(commandRows, {row = row, name = name, data = cmdData})
	return row
end

-- Populate command list
local index = 1
local seen = {}
for name, cmd in pairs(CMDS) do
	if cmd.name == name and not seen[cmd] then -- Avoid duplicates from aliases
		seen[cmd] = true
		createCommandRow(name, cmd, index)
		index += 1
	end
end

-- Execute from input
local function executeInput()
	local text = cmdInput.Text
	if text and text ~= "" then
		-- Remove prefix if present
		if text:sub(1, #state.prefix) == state.prefix then
			text = text:sub(#state.prefix + 1)
		end
		runCmd(text)
		cmdInput.Text = ""
	end
end

execBtn.MouseButton1Click:Connect(executeInput)
cmdInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		executeInput()
	end
end)

-- Make frame draggable
local dragging = false
local dragStart = nil
local startPos = nil

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

