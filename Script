-- FIX: tw function now handles both number and TweenInfo
local function tw(obj, timeOrTweenInfo, props)
	local tweenInfo
	if typeof(timeOrTweenInfo) == "number" then
		tweenInfo = TweenInfo.new(timeOrTweenInfo, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	else
		tweenInfo = timeOrTweenInfo -- It's already a TweenInfo
	end
	TweenServ:Create(obj, tweenInfo, props):Play()
end

local function mk(cls, props, parent)
	local i = Instance.new(cls)
	for k, v in props do i[k] = v end
	if parent then i.Parent = parent end
	return i
end
local function corner(r, p) mk("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function stroke(t, c, tr, p)
	mk("UIStroke", {
		Thickness = t, Color = c, Transparency = tr,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	}, p)
end

