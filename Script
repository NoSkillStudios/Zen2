task.spawn(function()
	local chat = lp:WaitForChild("PlayerGui"):WaitForChild("Chat",8)
	if not chat then return end
	local function hookInput(tb)
		tb.FocusLost:Connect(function(enter)
			if not enter then return end
			local txt=tb.Text
			if txt:sub(1,#state.prefix)==state.prefix then
				local cmd=txt:sub(#state.prefix+1)
				if cmd~="" then task.defer(runCmd,cmd) end
			end
		end)
	end
	for _, d in ipairs(chat:GetDescendants()) do
		if d:IsA("TextBox") then hookInput(d) end
	end
	chat.DescendantAdded:Connect(function(d)
		if d:IsA("TextBox") then task.wait(); hookInput(d) end
	end)
end)

