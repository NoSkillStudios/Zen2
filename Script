local function tw(obj, t, props)
	TweenServ:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

local function mk(cls, props, parent)
	local i = Instance.new(cls)
	for k, v in props do i[k] = v end
	if parent then i.Parent = parent end
	return i
end
local function corner(r, p) mk("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function vstroke(t, c, tr, p) mk("UIStroke", {Thickness=t, Color=c, Transparency=tr, ApplyStrokeMode=Enum.ApplyStrokeMode.Border, LineJoinMode=Enum.LineJoinMode.Round}, p) end

