-- FPS Counter
local fpsBuffer = {}
local fpsIndex = 1
for i = 1, 30 do fpsBuffer[i] = 60 end
local lastTime = tick()

RunService.Heartbeat:Connect(function()
	local now = tick()
	local dt = now - lastTime
	lastTime = now
	
	if dt > 0 then
		local fps = 1 / dt
		fpsBuffer[fpsIndex] = fps
		fpsIndex = (fpsIndex % 30) + 1
		
		local avg = 0
		for _, v in ipairs(fpsBuffer) do
			avg = avg + v
		end
		avg = math.floor(avg / 30)
		
		fpsLabel.Text = avg .. " FPS"
		fpsLabel.TextColor3 = avg >= 50 and Colors.Success or avg >= 30 and Colors.Warning or Colors.Error
	end
	
	-- Update ping every second
	if math.floor(now) ~= math.floor(now - dt) then
		local success, ping = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		if success and ping then
			pingLabel.Text = math.floor(ping) .. " ms"
		end
	end
end)

-- Notification system override
getgenv()._lav_notify = function(title, body, duration, ntype)
	duration = duration or 4
	local notifFrame = create("Frame", {
		Size = UDim2.new(0, 300, 0, 60),
		Position = UDim2.new(1, 320, 1, -80),
		BackgroundColor3 = Colors.Surface,
		BorderSizePixel = 0
	}, gui)
	
	corner(8, notifFrame)
	create("UIStroke", {Color = ntype == "error" and Colors.Error or ntype == "success" and Colors.Success or Colors.Accent, Thickness = 1}, notifFrame)
	
	create("TextLabel", {
		Size = UDim2.new(1, -20, 0, 25),
		Position = UDim2.new(0, 10, 0, 8),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = Colors.Text,
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left
	}, notifFrame)
	
	create("TextLabel", {
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.new(0, 10, 0, 32),
		BackgroundTransparency = 1,
		Text = body,
		TextColor3 = Colors.TextMuted,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left
	}, notifFrame)
	
	-- Animate in
	tween(notifFrame, 0.4, {Position = UDim2.new(1, -320, 1, -80)})
	
	task.delay(duration, function()
		tween(notifFrame, 0.4, {Position = UDim2.new(1, 320, 1, -80)})
		task.wait(0.4)
		notifFrame:Destroy()
	end)
end

