-- Chat Hook (Fixed)
local function hookChat()
	-- Wait for chat to load
	local chatGui = lp:WaitForChild("PlayerGui"):WaitForChild("Chat", 10)
	if not chatGui then return end
	
	local function processMessage(text)
		if text:sub(1, #state.prefix) == state.prefix then
			local cmd = text:sub(#state.prefix + 1)
			if cmd ~= "" then
				runCmd(cmd)
				return true -- Block message
			end
		end
		return false
	end
	
	-- Hook into chat bar
	local function setupChatBar(bar)
		local conn
		conn = bar.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				local text = bar.Text
				if processMessage(text) then
					bar.Text = "" -- Clear if it was a command
				end
			end
		end)
	end
	
	-- Find existing chat bars
	for _, obj in ipairs(chatGui:GetDescendants()) do
		if obj:IsA("TextBox") and obj.Name:lower():find("bar") then
			setupChatBar(obj)
		end
	end
	
	-- Hook future ones
	chatGui.DescendantAdded:Connect(function(desc)
		if desc:IsA("TextBox") and desc.Name:lower():find("bar") then
			task.wait(0.1)
			setupChatBar(desc)
		end
	end)
end

-- Tracers Render Loop
RunService.RenderStepped:Connect(function()
	if not state.tracers then return end
	local viewport = cam.ViewportSize
	for _, trace in ipairs(state.traceObjs) do
		if trace.target and trace.target.Parent then
			local pos, visible = cam:WorldToViewportPoint(trace.target.Position)
			trace.line.From = Vector2.new(viewport.X/2, viewport.Y)
			trace.line.To = Vector2.new(pos.X, pos.Y)
			trace.line.Visible = visible and pos.Z > 0
		else
			trace.line.Visible = false
		end
	end
end)

