CMDS.spectate = function(args)
	local tgt = resolvePlayer(args[1])
	if not tgt then
		if state.specConn then state.specConn:Disconnect(); state.specConn = nil end
		state.spectate = false
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = getHum()
		notify("spectate", "Stopped")
		return
	end
	state.spectate = true; state.specTarget = tgt
	if state.specConn then state.specConn:Disconnect() end
	state.specConn = RunService.RenderStepped:Connect(function()
		if not state.spectate then state.specConn:Disconnect(); state.specConn = nil; return end
		if tgt.Character then
			local th = tgt.Character:FindFirstChild("Humanoid")
			if th then cam.CameraType = Enum.CameraType.Custom; cam.CameraSubject = th end
		end
	end)
	notify("spectate", "Watching "..tgt.Name)
end

RunService.RenderStepped:Connect(function()
	if state.tracers then
		local vp = cam.ViewportSize
		for _, t in ipairs(state.traceObjs) do
			if t.target and t.target.Parent then
				local pos, vis = cam:WorldToViewportPoint(t.target.Position)
				t.line.From = Vector2.new(vp.X / 2, vp.Y)
				t.line.To   = Vector2.new(pos.X, pos.Y)
				t.line.Visible = vis and pos.Z > 0
			end
		end
	end
end)

