-- Smart Player Resolver (Partial name matching, case insensitive)
local function resolvePlayer(arg)
	if not arg or arg == "" then return nil end
	arg = arg:lower()
	
	-- Special keywords
	if arg == "me" or arg == "local" then return lp end
	if arg == "all" then return "all" end
	if arg == "others" then return "others" end
	if arg == "random" then 
		local list = Players:GetPlayers()
		return list[math.random(1, #list)]
	end
	
	-- Partial name matching (case insensitive)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #arg) == arg or p.DisplayName:lower():sub(1, #arg) == arg then
			return p
		end
	end
	return nil
end

-- Command Registry with Aliases
local CMDS = {}
local function register(name, aliases, desc, args, fn)
	CMDS[name] = {name = name, aliases = aliases, desc = desc, args = args, fn = fn}
	for _, alias in ipairs(aliases) do
		CMDS[alias] = CMDS[name]
	end
end

