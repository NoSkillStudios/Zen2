		if filter and filter ~= "" then
			local match = r.name:find(filter:lower(), 1, true)
			r.frame.Visible = match ~= nil
		else
			r.frame.Visible = true
		end
	end
	scroll.CanvasSize = UDim2.fromOffset(0, sList.AbsoluteContentSize.Y + 8)
end

