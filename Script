local function cn(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns+1] = c
	return c
end

local function tw(obj, props, dur, sty, dir, callback)
	if not obj or not obj.Parent then return end
	local t = ts:Create(obj, ti(dur or 0.2, sty or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
	if callback then t.Completed:Connect(callback) end
	t:Play()
	return t
end

local function corner(p, r)
	local c = Instance.new("UICorner", p)
	c.CornerRadius = ud(0, r or 8)
	return c
end

local function stroke(p, col, th)
	local s = Instance.new("UIStroke", p)
	s.Color = col or T.bord
	s.Thickness = th or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function pad(p, t, b, l, r)
	local d = Instance.new("UIPadding", p)
	d.PaddingTop    = ud(0, t or 8)
	d.PaddingBottom = ud(0, b or 8)
	d.PaddingLeft   = ud(0, l or 8)
	d.PaddingRight  = ud(0, r or 8)
end

local function list(p, dir, sp)
	local l = Instance.new("UIListLayout", p)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder     = Enum.SortOrder.LayoutOrder
	l.Padding       = ud(0, sp or 6)
	return l
end

local function lbl(p, txt, sz, col, font)
	local l = Instance.new("TextLabel", p)
	l.BackgroundTransparency = 1
	l.Text           = txt or ""
	l.TextSize       = sz  or 13
	l.TextColor3     = col or T.txt
	l.Font           = font or Enum.Font.GothamMedium
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.AutomaticSize  = Enum.AutomaticSize.XY
	l.BorderSizePixel= 0
	return l
end

local function scroll(p)
	local sf = Instance.new("ScrollingFrame", p)
	sf.Size                      = u2(1,0,1,0)
	sf.BackgroundTransparency    = 1
	sf.BorderSizePixel           = 0
	sf.ScrollBarThickness        = 3
	sf.ScrollBarImageColor3      = T.acc
	sf.ScrollBarImageTransparency= 0.4
	sf.CanvasSize                = u2(0,0,0,0)
	sf.AutomaticCanvasSize       = Enum.AutomaticSize.Y
	return sf
end

local function makeDraggable(frame, handle)
	local dragging, dragStart, startPos = false, nil, nil
	cn(handle.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging = true
		dragStart = i.Position
		startPos  = frame.Position
	end)
	cn(uis.InputChanged, function(i)
		if not dragging or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local d = i.Position - dragStart
		frame.Position = u2(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
	end)
	cn(uis.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
end

local function closeAllDropdowns(except)
	for _, fn in ipairs(activeDropdowns) do
		if fn ~= except then fn() end
	end
end

