-- notification system
local notifStack = {}

local function notify(title, body, ntype, dur)
	dur = dur or 4
	local key = title:lower():gsub("%s+", "_")
	local accentCol = ({success=C.GREEN, info=C.DIM, warn=C.YEL, err=C.RED})[ntype] or C.DIM

	if notifStack[key] then
		local n = notifStack[key]
		n.count += 1
		n.cntLbl.Text = n.count .. "×"
		n.cntLbl.Visible = true
		task.cancel(n.thread)
		n.thread = task.delay(dur, function()
			tw(n.frame, 0.2, {Position=UDim2.new(1,20,n.frame.Position.Y.Scale,n.frame.Position.Y.Offset), BackgroundTransparency=1})
			task.wait(0.22); n.frame:Destroy(); notifStack[key]=nil
		end)
		return
	end

	local nf = mk("Frame", {
		Position = UDim2.new(1, 20, 1, -82),
		Size = UDim2.new(0, 260, 0, 50),
		BackgroundColor3 = C.BG,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 10,
	}, gui)
	corner(8, nf)
	bdr(nf)
	mk("Frame", {Size=UDim2.new(0,2,1,0),BackgroundColor3=accentCol,BorderSizePixel=0,ZIndex=11}, nf)
	corner(2, nf:FindFirstChildOfClass("Frame"))
	mk("TextLabel", {Position=UDim2.new(0,12,0,7),Size=UDim2.new(1,-54,0,18),BackgroundTransparency=1,Text=title,TextSize=12,Font=Enum.Font.GothamBold,TextColor3=C.TEXT,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11}, nf)
	mk("TextLabel", {Position=UDim2.new(0,12,0,26),Size=UDim2.new(1,-54,0,14),BackgroundTransparency=1,Text=body,TextSize=10,Font=Enum.Font.Gotham,TextColor3=C.MUTED,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11}, nf)
	local cntLbl = mk("TextLabel", {Position=UDim2.new(1,-42,0.5,-9),Size=UDim2.new(0,32,0,18),BackgroundColor3=C.SURF,Text="1×",TextSize=10,Font=Enum.Font.GothamBold,TextColor3=C.MUTED,Visible=false,ZIndex=12}, nf)
	corner(4, cntLbl)

	tw(nf, 0.22, {Position=UDim2.new(1,-276,1,-82)})

	local entry = {frame=nf, count=1, cntLbl=cntLbl, thread=nil}
	notifStack[key] = entry
	entry.thread = task.delay(dur, function()
		tw(nf, 0.2, {Position=UDim2.new(1,20,1,-82), BackgroundTransparency=1})
		task.wait(0.22); nf:Destroy(); notifStack[key]=nil
	end)
end

getgenv()._lav_notify = notify

