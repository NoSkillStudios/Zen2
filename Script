-- switchTab + togglePanel defined BEFORE button clicks
local function switchTab(name)
	if activeTab then
		if tabs[activeTab] then tabs[activeTab].Visible = false end
		if tabBtns[activeTab] then tw(tabBtns[activeTab], 0.15, {BackgroundTransparency=1, ImageColor3=C.MUTED}) end
	end
	activeTab = name
	if tabs[name] then tabs[name].Visible = true end
	if tabBtns[name] then tw(tabBtns[name], 0.15, {BackgroundTransparency=0.6, ImageColor3=C.TEXT}) end
end

local function togglePanel()
	isOpen = not isOpen
	if isOpen then
		tw(panel, TI, {Size=UDim2.new(0,PAN_W,0,PAN_H), BackgroundTransparency=0})
		togBtn.Text = "close"
		if activeTab and tabs[activeTab] then tabs[activeTab].Visible = true end
	else
		tw(panel, TI, {Size=UDim2.new(0,PAN_W,0,0), BackgroundTransparency=1})
		togBtn.Text = "open"
	end
end

togBtn.MouseButton1Click:Connect(togglePanel)

