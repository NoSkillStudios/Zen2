local function runCmd(input)
	local parts = {}
	for w in input:gmatch("%S+") do table.insert(parts, w) end
	if #parts == 0 then return end
	local name = table.remove(parts,1):lower()
	local cmd = CMDS[name]
	if cmd then task.spawn(cmd.fn, parts)
	else notify("unknown","/"..name.." not found") end
end

