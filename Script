				numBox.PlaceholderText  = tostring(val)
				numBox.Visible          = false

				if desc then
					cn(r.MouseEnter, function() setTooltipTarget(r, desc) end)
					cn(r.MouseLeave, function() clearTooltipTarget(r) end)
				end

				local trackBg = Instance.new("Frame", r)
				trackBg.Size             = u2(1,-24,0,6)
				trackBg.Position         = u2(0,12,0,38)
				trackBg.BackgroundColor3 = T.bgDeep
				trackBg.ZIndex           = 9
				trackBg.BorderSizePixel  = 0
				corner(trackBg, 999)

				local fill = Instance.new("Frame", trackBg)
				fill.Size             = u2((val-mn)/(mx-mn),0,1,0)
				fill.BackgroundColor3 = T.acc
				fill.ZIndex           = 10
				fill.BorderSizePixel  = 0
				corner(fill, 999)
				local fg = Instance.new("UIGradient", fill)
				fg.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,T.acc),ColorSequenceKeypoint.new(1,T.accGlow)}

				local dot = Instance.new("Frame", trackBg)
				dot.Size             = u2(0,14,0,14)
				dot.AnchorPoint      = v2(0.5,0.5)
				dot.Position         = u2((val-mn)/(mx-mn),0,0.5,0)
				dot.BackgroundColor3 = T.white
				dot.ZIndex           = 11
				dot.BorderSizePixel  = 0
				corner(dot, 999)

				local dotGlow = Instance.new("UIStroke", dot)
				dotGlow.Color = T.acc
				dotGlow.Thickness = 0
				dotGlow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

				local function updateDisplay(v2val, instant)
					local pct = (v2val-mn)/(mx-mn)
					if instant then
						fill.Size    = u2(pct,0,1,0)
						dot.Position = u2(pct,0,0.5,0)
					else
						tw(fill, {Size=u2(pct,0,1,0)}, 0.18, Enum.EasingStyle.Quart)
						tw(dot,  {Position=u2(pct,0,0.5,0)}, 0.18, Enum.EasingStyle.Quart)
					end
					valTxt.Text = tostring(v2val)..suf
					numBox.PlaceholderText = tostring(v2val)
				end

				local function setVal(nv, silent, instant)
					local prev = val
					val = math.clamp(math.round(nv), mn, mx)
					updateDisplay(val, instant)
					if not silent and val ~= prev then task.spawn(pcall,cb,val) end
				end

				local function mouseSetVal(inp, instant)
					if not trackBg or not trackBg.Parent then return end
					local ax = trackBg.AbsolutePosition.X
					local aw = trackBg.AbsoluteSize.X
					if aw==0 then return end
					local pct = math.clamp((inp.Position.X-ax)/aw,0,1)
					local newV = math.round(mn+pct*(mx-mn))
					if newV == val then return end
					val = newV
					updateDisplay(val, instant)
					task.spawn(pcall,cb,val)
				end

				cn(trackBg.InputBegan,function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then
						sliding=true
						tw(dot,{Size=u2(0,16,0,16)},0.15,Enum.EasingStyle.Back)
						tw(dotGlow,{Thickness=2},0.12)
						tw(valPill,{Size=u2(0,88,0,24),Position=u2(1,-94,0,6)},0.12,Enum.EasingStyle.Back)
						mouseSetVal(i, false)
					end
				end)
				cn(dot.InputBegan,function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then
						sliding=true
						tw(dot,{Size=u2(0,16,0,16)},0.15,Enum.EasingStyle.Back)
						tw(dotGlow,{Thickness=2},0.12)
						tw(valPill,{Size=u2(0,88,0,24),Position=u2(1,-94,0,6)},0.12,Enum.EasingStyle.Back)
					end
				end)
				cn(uis.InputChanged,function(i)
					if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then
						mouseSetVal(i, true)
					end
				end)
				cn(uis.InputEnded,function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then
						if sliding then
							sliding=false
							tw(dot,{Size=u2(0,14,0,14)},0.12)
							tw(dotGlow,{Thickness=0},0.12)
							tw(valPill,{Size=u2(0,80,0,22),Position=u2(1,-90,0,7)},0.12)
						end
					end
				end)

				cn(valPill.InputBegan,function(i)
					if i.UserInputType==Enum.UserInputType.MouseButton1 then
						valTxt.Visible = false
						numBox.Visible = true
						numBox:CaptureFocus()
					end
				end)
				cn(numBox.FocusLost,function(enter)
					numBox.Visible = false
					valTxt.Visible = true
					if enter then
						local n2 = tonumber(numBox.Text)
						if n2 then setVal(n2,false,false) end
					end
				end)

				local obj = {}
				function obj:Set(v) setVal(v,false,false) end
				function obj:Get() return val end
				return obj
			end

